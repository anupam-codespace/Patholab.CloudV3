<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Schedule Scan Appointment"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#0F172A" />
        <ImageView
            android:id="@+id/btnNewScanClose"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_close" />
    </LinearLayout>

    <EditText
        android:id="@+id/inputNewScanPatient"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_input_field"
        android:hint="Patient Name (Required)"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/inputNewScanUhid"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_input_field"
        android:hint="UHID / Phone Number"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/inputNewScanModality"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_input_field"
        android:hint="Modality (e.g. X-Ray, CT, MRI, USG)"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">
        <EditText
            android:id="@+id/inputNewScanDate"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_input_field"
            android:hint="Date (YYYY-MM-DD)"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textSize="13sp" />
        <EditText
            android:id="@+id/inputNewScanTime"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_input_field"
            android:hint="Time (e.g. 10:30 AM)"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textSize="13sp" />
    </LinearLayout>

    <EditText
        android:id="@+id/inputNewScanDoctor"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_input_field"
        android:hint="Referring Doctor"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/inputNewScanNotes"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_input_field"
        android:hint="Clinical Notes / Protocol"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:gravity="top"
        android:paddingTop="8dp"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/lblNewScanError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#DC2626"
        android:textSize="12sp"
        android:visibility="gone" />

    <Button
        android:id="@+id/btnBookScan"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_btn_primary"
        android:text="Schedule Appointment"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />

    <ProgressBar
        android:id="@+id/progressBookScan"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="8dp"
        android:visibility="gone" />
</LinearLayout>
