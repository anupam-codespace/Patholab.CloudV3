<?xml version="1.0" encoding="utf-8"?>
<!-- ══ Clean & Professional Lab Owner Executive Dashboard (Android) ══ -->
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipeRefreshDashboard"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ══════════════════════════════════════════════════════════════
                 HEADER SECTION — Deep Sapphire Gradient & Date Filter
                 ══════════════════════════════════════════════════════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_billing_header"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="24dp"
                android:paddingBottom="18dp">

                <!-- Top Action Bar -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <FrameLayout
                        android:id="@+id/btnDashboardBack"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_glass_back_btn"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_back_arrow"
                            android:tint="#FFFFFF"
                            app:tint="#FFFFFF" />

                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Dashboard Overview"
                            android:textSize="18.5sp"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF" />

                        <TextView
                            android:id="@+id/lblDashboardBranch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:text="Care Diagnostic Hub • Main Branch"
                            android:textSize="11.5sp"
                            android:textColor="#93C5FD" />

                    </LinearLayout>

                    <FrameLayout
                        android:id="@+id/btnDashboardRefresh"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_glass_back_btn"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:id="@+id/imgDashboardRefreshIcon"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_refresh_cw"
                            android:tint="#FFFFFF"
                            app:tint="#FFFFFF" />

                    </FrameLayout>

                </LinearLayout>

                <!-- Modern Date Range Dropdown Selector -->
                <LinearLayout
                    android:id="@+id/containerRangeDropdownRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="end|center_vertical"
                    android:layout_marginTop="6dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp">

                    <!-- The Dropdown Capsule Button -->
                    <LinearLayout
                        android:id="@+id/btnRangeDropdown"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_dashboard_dropdown_capsule"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="14dp"
                        android:paddingEnd="12dp"
                        android:elevation="3dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@drawable/ic_calendar_clock"
                            android:tint="#2563EB"
                            app:tint="#2563EB"
                            android:layout_marginEnd="6dp" />

                        <TextView
                            android:id="@+id/lblSelectedRangeName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Last 30 Days"
                            android:textColor="#0F172A"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginStart="5dp"
                            android:src="@drawable/ic_chevron_down"
                            android:tint="#2563EB"
                            app:tint="#2563EB" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <!-- ══════════════════════════════════════════════════════════════
                 MAIN BODY CONTENT
                 ══════════════════════════════════════════════════════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="16dp"
                android:paddingBottom="40dp">

                <!-- ── 1. PRIMARY METRICS BENTO GRID (Row 1: Wallet & Revenue) ── -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <!-- Wallet Balance Card -->
                    <LinearLayout
                        android:id="@+id/cardWalletBalance"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_dashboard_bento"
                        android:orientation="vertical"
                        android:padding="14dp"
                        android:elevation="1dp"
                        android:layout_marginEnd="6dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <FrameLayout
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:background="@drawable/bg_mod_icon_indigo">
                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_wallet"
                                    android:tint="#4F46E5"
                                    app:tint="#4F46E5" />
                            </FrameLayout>

                            <View
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:layout_weight="1" />

                            <TextView
                                android:id="@+id/btnRechargeWallet"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Recharge"
                                android:textSize="10.5sp"
                                android:textStyle="bold"
                                android:textColor="#FFFFFF"
                                android:background="@drawable/bg_btn_primary"
                                android:paddingStart="8dp"
                                android:paddingEnd="8dp"
                                android:paddingTop="3dp"
                                android:paddingBottom="3dp"
                                android:clickable="true"
                                android:focusable="true" />

                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="WALLET BALANCE"
                            android:textSize="9.5sp"
                            android:textStyle="bold"
                            android:textColor="#64748B"
                            android:letterSpacing="0.04" />

                        <TextView
                            android:id="@+id/lblDashWalletBal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="₹0"
                            android:textSize="22sp"
                            android:fontFamily="sans-serif-black"
                            android:textFontWeight="900"
                            android:textStyle="bold"
                            android:textColor="#312E81" />

                        <TextView
                            android:id="@+id/lblDashWalletStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Pay-As-You-Go Active"
                            android:textSize="10.5sp"
                            android:textColor="#4F46E5" />

                    </LinearLayout>

                    <!-- Total Revenue Card -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_dashboard_bento"
                        android:orientation="vertical"
                        android:padding="14dp"
                        android:elevation="1dp"
                        android:layout_marginStart="6dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <FrameLayout
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:background="@drawable/bg_mod_icon_emerald">
                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_chart"
                                    android:tint="#059669"
                                    app:tint="#059669" />
                            </FrameLayout>

                            <View
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:layout_weight="1" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Collected"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:textColor="#059669"
                                android:background="@drawable/bg_tag_emerald"
                                android:paddingStart="6dp"
                                android:paddingEnd="6dp"
                                android:paddingTop="2dp"
                                android:paddingBottom="2dp" />

                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="TOTAL REVENUE"
                            android:textSize="9.5sp"
                            android:textStyle="bold"
                            android:textColor="#64748B"
                            android:letterSpacing="0.04" />

                        <TextView
                            android:id="@+id/lblDashRevenue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="₹0"
                            android:textSize="20sp"
                            android:fontFamily="sans-serif-black"
                            android:textStyle="bold"
                            android:textColor="#059669" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="In selected period"
                            android:textSize="10.5sp"
                            android:textColor="#94A3B8" />

                    </LinearLayout>

                </LinearLayout>

                <!-- ── 2. PRIMARY METRICS BENTO GRID (Row 2: Tests & Inventory Alerts) ── -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <!-- Tests Performed Card -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_dashboard_bento"
                        android:orientation="vertical"
                        android:padding="14dp"
                        android:elevation="1dp"
                        android:layout_marginEnd="6dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <FrameLayout
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:background="@drawable/bg_mod_icon_blue">
                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_flask"
                                    android:tint="#0D6EFD"
                                    app:tint="#0D6EFD" />
                            </FrameLayout>

                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="TESTS PERFORMED"
                            android:textSize="9.5sp"
                            android:textStyle="bold"
                            android:textColor="#64748B"
                            android:letterSpacing="0.04" />

                        <TextView
                            android:id="@+id/lblDashTestsCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="0"
                            android:textSize="20sp"
                            android:fontFamily="sans-serif-black"
                            android:textStyle="bold"
                            android:textColor="#0F172A" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Diagnostics completed"
                            android:textSize="10.5sp"
                            android:textColor="#94A3B8" />

                    </LinearLayout>

                    <!-- Critical Inventory Alerts Card -->
                    <LinearLayout
                        android:id="@+id/cardInventoryAlerts"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_dashboard_bento"
                        android:orientation="vertical"
                        android:padding="14dp"
                        android:elevation="1dp"
                        android:layout_marginStart="6dp"
                        android:clickable="true"
                        android:focusable="true">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <FrameLayout
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:background="@drawable/bg_mod_icon_amber">
                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_box"
                                    android:tint="#D97706"
                                    app:tint="#D97706" />
                            </FrameLayout>

                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="INVENTORY ALERTS"
                            android:textSize="9.5sp"
                            android:textStyle="bold"
                            android:textColor="#64748B"
                            android:letterSpacing="0.04" />

                        <TextView
                            android:id="@+id/lblDashInventoryAlerts"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="0"
                            android:textSize="20sp"
                            android:fontFamily="sans-serif-black"
                            android:textStyle="bold"
                            android:textColor="#D97706" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Low stock items"
                            android:textSize="10.5sp"
                            android:textColor="#94A3B8" />

                    </LinearLayout>

                </LinearLayout>

                <!-- ── 3. OPERATIONAL PULSE ROW ────────────────────────────── -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_dashboard_bento"
                    android:padding="12dp"
                    android:elevation="1dp"
                    android:layout_marginBottom="18dp"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/lblPulseSamplesToday"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="#0F172A" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Samples Today"
                            android:textSize="10sp"
                            android:textColor="#64748B" />

                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="24dp"
                        android:background="#E2E8F0" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/lblPulsePendingSamples"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="#D97706" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="In Progress"
                            android:textSize="10sp"
                            android:textColor="#64748B" />

                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="24dp"
                        android:background="#E2E8F0" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.2"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/lblPulsePendingReports"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="#0D6EFD" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pending Approval"
                            android:textSize="10sp"
                            android:textColor="#64748B" />

                    </LinearLayout>

                </LinearLayout>

                <!-- ── 4. REVENUE TREND AREA CHART CARD ───────────────────── -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_dashboard_bento"
                    android:padding="16dp"
                    android:elevation="1dp"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Revenue Trend"
                            android:textSize="14.5sp"
                            android:textStyle="bold"
                            android:textColor="#0F172A" />

                        <View
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/bg_dot_emerald"
                            android:layout_marginEnd="5dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Revenue"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="#059669" />

                    </LinearLayout>

                    <cloud.patholab.app.ui.SimpleAreaChartView
                        android:id="@+id/chartRevenueTrend"
                        android:layout_width="match_parent"
                        android:layout_height="180dp" />

                </LinearLayout>

                <!-- ── 5. TEST VOLUME TREND BAR CHART CARD ────────────────── -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_dashboard_bento"
                    android:padding="16dp"
                    android:elevation="1dp"
                    android:layout_marginBottom="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Test Volume Trend"
                            android:textSize="14.5sp"
                            android:textStyle="bold"
                            android:textColor="#0F172A" />

                        <View
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/bg_mod_icon_blue"
                            android:layout_marginEnd="5dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tests"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="#0D6EFD" />

                    </LinearLayout>

                    <cloud.patholab.app.ui.SimpleBarChartView
                        android:id="@+id/chartTestVolume"
                        android:layout_width="match_parent"
                        android:layout_height="180dp" />

                </LinearLayout>

                <!-- ── 6. RECENT PATIENTS SECTION ──────────────────────────── -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Recent Patients"
                        android:textSize="14.5sp"
                        android:textStyle="bold"
                        android:textColor="#0F172A" />

                    <TextView
                        android:id="@+id/btnViewAllPatients"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="View All &gt;"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#0D6EFD"
                        android:padding="4dp"
                        android:clickable="true"
                        android:focusable="true" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/containerRecentPatients"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/lblPatientsEmptyState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="No recent patients registered"
                    android:textSize="12.5sp"
                    android:textColor="#94A3B8"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp"
                    android:visibility="gone" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
