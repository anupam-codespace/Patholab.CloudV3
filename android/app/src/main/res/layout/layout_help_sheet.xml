<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/helpSheetRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet_dark"
    android:paddingBottom="16dp">

    <!-- Drag Handle Indicator -->
    <View
        android:id="@+id/helpDragHandle"
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"
        android:background="#D1D5DB" />

    <!-- Header Section with Title, Subtitle, and Close button -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:layout_marginBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toStartOf="@+id/btnHelpClose"
            android:layout_marginEnd="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtHelpTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Help &amp; Support"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtHelpSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Get direct assistance or create a support ticket."
                android:textColor="#94A3B8"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnHelpClose"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_close_circle"
            android:clickable="true"
            android:focusable="true" />
    </RelativeLayout>

    <!-- Divider Line -->
    <View
        android:id="@+id/helpDivider"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="#334155"
        android:layout_marginBottom="10dp" />

    <!-- 1. Call Support Row -->
    <RelativeLayout
        android:id="@+id/btnHelpCall"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="60dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:padding="10dp"
        android:background="@drawable/bg_help_row_dark"
        android:clickable="true"
        android:focusable="true">

        <FrameLayout
            android:id="@+id/iconCallContainer"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            android:background="@drawable/bg_help_icon_circle">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_phone"
                app:tint="#4F46E5" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/iconCallContainer"
            android:layout_toStartOf="@+id/chevronCall"
            android:layout_centerVertical="true"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/lblCallTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Call Support"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/lblCallSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="+91 8402010207 • Tap to call"
                android:textColor="#94A3B8"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/chevronCall"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="4dp"
            android:src="@drawable/ic_chevron_right"
            app:tint="#94A3B8" />
    </RelativeLayout>

    <!-- 2. WhatsApp Support Row -->
    <RelativeLayout
        android:id="@+id/btnHelpWhatsApp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="60dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:padding="10dp"
        android:background="@drawable/bg_help_row_dark"
        android:clickable="true"
        android:focusable="true">

        <FrameLayout
            android:id="@+id/iconWhatsAppContainer"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            android:background="@android:color/transparent">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_whatsapp_official"
                android:scaleType="fitCenter" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/iconWhatsAppContainer"
            android:layout_toStartOf="@+id/chevronWhatsApp"
            android:layout_centerVertical="true"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/lblWhatsAppTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WhatsApp Support"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/lblWhatsAppSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="+91 8402010207 • Chat on WhatsApp"
                android:textColor="#94A3B8"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/chevronWhatsApp"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="4dp"
            android:src="@drawable/ic_chevron_right"
            app:tint="#94A3B8" />
    </RelativeLayout>

    <!-- 3. Email Support Row -->
    <RelativeLayout
        android:id="@+id/btnHelpEmail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="60dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:padding="10dp"
        android:background="@drawable/bg_help_row_dark"
        android:clickable="true"
        android:focusable="true">

        <FrameLayout
            android:id="@+id/iconEmailContainer"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            android:background="@android:color/transparent">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_gmail_official"
                android:scaleType="fitCenter" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/iconEmailContainer"
            android:layout_toStartOf="@+id/chevronEmail"
            android:layout_centerVertical="true"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/lblEmailTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Email Support"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/lblEmailSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="support@patholab.cloud • Pre-drafted ticket"
                android:textColor="#94A3B8"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/chevronEmail"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="4dp"
            android:src="@drawable/ic_chevron_right"
            app:tint="#94A3B8" />
    </RelativeLayout>

    <!-- 4. Report a Bug Row -->
    <RelativeLayout
        android:id="@+id/btnHelpBug"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="60dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="4dp"
        android:padding="10dp"
        android:background="@drawable/bg_help_row_dark"
        android:clickable="true"
        android:focusable="true">

        <FrameLayout
            android:id="@+id/iconBugContainer"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            android:background="@drawable/bg_help_icon_circle">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_support_lifebuoy"
                app:tint="#4F46E5" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/iconBugContainer"
            android:layout_toStartOf="@+id/chevronBug"
            android:layout_centerVertical="true"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/lblBugTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Report a Bug"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/lblBugSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="Create a new support ticket"
                android:textColor="#94A3B8"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/chevronBug"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="4dp"
            android:src="@drawable/ic_chevron_right"
            app:tint="#94A3B8" />
    </RelativeLayout>
</LinearLayout>
