<?xml version="1.0" encoding="utf-8"?>
<!-- Doctor / Agency Selection Row -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootDoctorItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <FrameLayout
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_mod_icon_blue">

        <ImageView
            android:id="@+id/imgDocIcon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_stethoscope"
            android:tint="#0D6EFD" />

    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp">

        <TextView
            android:id="@+id/lblDocName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dr. Arvind Sharma"
            android:textSize="14.5sp"
            android:textStyle="bold"
            android:textColor="#0F172A" />

        <TextView
            android:id="@+id/lblDocSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="MBBS, MD • City Hospital"
            android:textSize="12sp"
            android:textColor="#64748B" />

    </LinearLayout>

    <ImageView
        android:id="@+id/imgDocCheck"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:src="@drawable/ic_check_bold"
        android:tint="#0D6EFD"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/imgDocArrow"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/ic_arrow_right"
        android:tint="#CBD5E1"
        android:visibility="visible" />

</LinearLayout>
