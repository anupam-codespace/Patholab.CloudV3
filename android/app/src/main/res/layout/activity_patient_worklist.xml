<?xml version="1.0" encoding="utf-8"?>
<!-- Native Independent Patient Visit Worklist & Clinical Queue Console -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8FAFC">

    <!-- ── TOP CURVED SAPPHIRE HEADER WITH EMBEDDED FROSTED BENTO CARDS ───── -->
    <FrameLayout
        android:id="@+id/worklistHeaderLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_home_header"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="32dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Tier 1: Action Navigation Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <FrameLayout
                    android:id="@+id/btnWorklistBack"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_glass_back_btn"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_back_arrow"
                        android:tint="#FFFFFF"
                        app:tint="#FFFFFF" />

                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Patient Worklist"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:letterSpacing="-0.02" />

                    <TextView
                        android:id="@+id/lblWorklistSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Live Accessions • TAT Monitoring"
                        android:textSize="11.5sp"
                        android:textColor="#C7DFFF"
                        android:singleLine="true"
                        android:ellipsize="end" />

                </LinearLayout>

                <!-- Refresh Button -->
                <FrameLayout
                    android:id="@+id/btnRefreshWorklist"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_glass_back_btn"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/imgRefreshWorklistIcon"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_refresh"
                        android:tint="#FFFFFF"
                        app:tint="#FFFFFF" />

                </FrameLayout>

            </LinearLayout>

            <!-- Tier 2: 4 Frosted Glass Bento KPI Stat Cards -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginTop="16dp"
                android:clipToPadding="false">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- KPI 1: Total Visits -->
                    <LinearLayout
                        android:layout_width="155dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/bg_billing_kpi_card"
                        android:paddingStart="13dp"
                        android:paddingEnd="13dp"
                        android:paddingTop="11dp"
                        android:paddingBottom="11dp"
                        android:layout_marginEnd="10dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <View
                                android:layout_width="6dp"
                                android:layout_height="6dp"
                                android:background="@drawable/bg_dot_active"
                                android:layout_marginEnd="6dp" />

                            <TextView
                                android:text="TOTAL VISITS"
                                android:textSize="9.5sp"
                                android:textStyle="bold"
                                android:textColor="#C7DFFF"
                                android:letterSpacing="0.04"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/lblKpiTotalVisits"
                            android:text="0"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF"
                            android:layout_marginTop="4dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                        <TextView
                            android:text="Accessioned Today"
                            android:textSize="10.5sp"
                            android:textColor="#C7DFFF"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                    </LinearLayout>

                    <!-- KPI 2: In Progress -->
                    <LinearLayout
                        android:layout_width="155dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/bg_billing_kpi_card"
                        android:paddingStart="13dp"
                        android:paddingEnd="13dp"
                        android:paddingTop="11dp"
                        android:paddingBottom="11dp"
                        android:layout_marginEnd="10dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <View
                                android:layout_width="6dp"
                                android:layout_height="6dp"
                                android:background="@drawable/bg_dot_amber"
                                android:layout_marginEnd="6dp" />

                            <TextView
                                android:text="IN PROGRESS"
                                android:textSize="9.5sp"
                                android:textStyle="bold"
                                android:textColor="#C7DFFF"
                                android:letterSpacing="0.04"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/lblKpiInProgressVisits"
                            android:text="0"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF"
                            android:layout_marginTop="4dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                        <TextView
                            android:text="Testing Underway"
                            android:textSize="10.5sp"
                            android:textColor="#C7DFFF"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                    </LinearLayout>

                    <!-- KPI 3: Completed & Ready -->
                    <LinearLayout
                        android:layout_width="155dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/bg_billing_kpi_card"
                        android:paddingStart="13dp"
                        android:paddingEnd="13dp"
                        android:paddingTop="11dp"
                        android:paddingBottom="11dp"
                        android:layout_marginEnd="10dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <View
                                android:layout_width="6dp"
                                android:layout_height="6dp"
                                android:background="@drawable/bg_dot_emerald"
                                android:layout_marginEnd="6dp" />

                            <TextView
                                android:text="COMPLETED &amp; READY"
                                android:textSize="9.5sp"
                                android:textStyle="bold"
                                android:textColor="#C7DFFF"
                                android:letterSpacing="0.04"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/lblKpiCompletedVisits"
                            android:text="0"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF"
                            android:layout_marginTop="4dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                        <TextView
                            android:text="Authorized Reports"
                            android:textSize="10.5sp"
                            android:textColor="#C7DFFF"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                    </LinearLayout>

                    <!-- KPI 4: Registered Only -->
                    <LinearLayout
                        android:layout_width="155dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/bg_billing_kpi_card"
                        android:paddingStart="13dp"
                        android:paddingEnd="13dp"
                        android:paddingTop="11dp"
                        android:paddingBottom="11dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <View
                                android:layout_width="6dp"
                                android:layout_height="6dp"
                                android:background="@drawable/bg_dot_cyan"
                                android:layout_marginEnd="6dp" />

                            <TextView
                                android:text="REGISTERED ONLY"
                                android:textSize="9.5sp"
                                android:textStyle="bold"
                                android:textColor="#C7DFFF"
                                android:letterSpacing="0.04"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/lblKpiRegisteredVisits"
                            android:text="0"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF"
                            android:layout_marginTop="4dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                        <TextView
                            android:text="Awaiting Billing / Tests"
                            android:textSize="10.5sp"
                            android:textColor="#C7DFFF"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                    </LinearLayout>

                </LinearLayout>

            </HorizontalScrollView>

        </LinearLayout>

    </FrameLayout>

    <!-- ── SEARCH OMNIBAR ─────────────────────────────────────────── -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_search_input_field"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_search"
                android:tint="#64748B"
                app:tint="#64748B" />

            <EditText
                android:id="@+id/inputSearchWorklist"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="Search patient, UHID, invoice, phone, or test..."
                android:textColorHint="#94A3B8"
                android:textColor="#0F172A"
                android:textSize="13.5sp"
                android:layout_marginStart="10dp"
                android:singleLine="true"
                android:imeOptions="actionSearch" />

            <ImageView
                android:id="@+id/btnClearSearchWorklist"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_close"
                android:tint="#94A3B8"
                app:tint="#94A3B8"
                android:visibility="gone"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

    </FrameLayout>

    <!-- ── STATUS FILTER CHIPS (Horizontal Scroll) ────────────────── -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="6dp"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/containerWorklistFilterChips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />

    </HorizontalScrollView>

    <!-- ── LIST CONTAINER & EMPTY STATE ───────────────────────────── -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp">

        <!-- Progress Bar -->
        <ProgressBar
            android:id="@+id/progressWorklist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="#0D6EFD"
            android:visibility="gone" />

        <!-- Recycler View -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerWorklist"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingBottom="20dp"
            android:clipToPadding="false" />

        <!-- Empty State View -->
        <LinearLayout
            android:id="@+id/emptyStateWorklist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_pill_white"
                android:backgroundTint="#F1F5F9">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_mod_clean_worklist"
                    android:tint="#94A3B8"
                    app:tint="#94A3B8" />

            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="No Patient Visits Found"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#0F172A" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="No accession records matched your search query or filter."
                android:textSize="13sp"
                android:textColor="#64748B"
                android:gravity="center" />

        </LinearLayout>

    </FrameLayout>

</LinearLayout>
