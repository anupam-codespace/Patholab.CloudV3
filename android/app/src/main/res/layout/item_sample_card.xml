<?xml version="1.0" encoding="utf-8"?>
<!-- Native Bento Specimen Card Layout -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="5dp"
    android:paddingBottom="5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_setting_item"
        android:padding="16dp"
        android:elevation="2dp">

        <!-- Top Header Row: Tube Color Badge + Barcode + Status Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Tube Type Pill -->
            <LinearLayout
                android:id="@+id/containerTubeTypeBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_pill_white"
                android:backgroundTint="#F3E8FF"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp">

                <ImageView
                    android:id="@+id/lblTubeColorIndicator"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginEnd="2dp"
                    android:src="@drawable/ic_tube_indicator" />

                <TextView
                    android:id="@+id/lblTubeTypeName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="EDTA Blood"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#7E22CE" />

            </LinearLayout>

            <!-- Barcode Pill -->
            <TextView
                android:id="@+id/lblSampleBarcode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_pill_white"
                android:backgroundTint="#F1F5F9"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:text="SMP-10928"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:textColor="#334155" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Status Badge -->
            <TextView
                android:id="@+id/lblSampleStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_white"
                android:backgroundTint="#ECFDF5"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:text="Collected"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#059669" />

        </LinearLayout>

        <!-- Patient Demographics Row with Standardized Avatar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="10dp">

            <!-- Standardized Patient Avatar -->
            <ImageView
                android:id="@+id/lblSamplePatientAvatar"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:src="@drawable/ic_patient_avatar"
                android:scaleType="centerCrop" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="10dp">

                <TextView
                    android:id="@+id/lblSamplePatientName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PRATIMA GHOSH"
                    android:textSize="15.5sp"
                    android:textStyle="bold"
                    android:textColor="#0F172A" />

                <TextView
                    android:id="@+id/lblSamplePatientDetails"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="45 Yrs • Female • UHID: P-00096"
                    android:textSize="11.5sp"
                    android:textColor="#64748B" />

            </LinearLayout>

        </LinearLayout>

        <!-- Investigation Tests Assigned Box -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#F8FAFC"
            android:padding="10dp"
            android:layout_marginTop="8dp"
            android:elevation="0dp">

            <TextView
                android:id="@+id/lblSampleTestsList"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Complete Blood Count (CBC), ESR (Westergren)"
                android:textSize="12.5sp"
                android:textStyle="bold"
                android:textColor="#1E293B" />

            <TextView
                android:id="@+id/lblSampleDepartment"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Hematology &amp; Clinical Pathology"
                android:textSize="11sp"
                android:textColor="#64748B" />

        </LinearLayout>

        <!-- Phlebotomy Collection Timeline -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ic_calendar"
                android:tint="#64748B"
                app:tint="#64748B"
                android:layout_marginEnd="5dp" />

            <TextView
                android:id="@+id/lblSampleCollectionInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="01 Sept 2026, 11:30 am • Phleb. Rajesh Kumar"
                android:textSize="11sp"
                android:textColor="#64748B" />

        </LinearLayout>

        <!-- Action Buttons Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical">

            <!-- Print Barcode Label -->
            <TextView
                android:id="@+id/btnSamplePrintBarcode"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_pill_white"
                android:backgroundTint="#EFF6FF"
                android:gravity="center"
                android:text="Barcode"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#0D6EFD"
                android:clickable="true"
                android:focusable="true" />

            <!-- Collect / Accept Specimen -->
            <TextView
                android:id="@+id/btnSampleCollectAccept"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.2"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_pill_white"
                android:backgroundTint="#059669"
                android:gravity="center"
                android:text="Collect"
                android:textSize="12.5sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:clickable="true"
                android:focusable="true" />

            <!-- Reject / Hemolysis Button -->
            <FrameLayout
                android:id="@+id/btnSampleReject"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_pill_white"
                android:backgroundTint="#FEF2F2"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_alert_triangle"
                    android:tint="#DC2626"
                    app:tint="#DC2626" />

            </FrameLayout>

            <!-- More Details Button -->
            <FrameLayout
                android:id="@+id/btnSampleDetails"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_pill_white"
                android:backgroundTint="#F1F5F9"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_info"
                    android:tint="#64748B"
                    app:tint="#64748B" />

            </FrameLayout>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
