<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet">

    <!-- Drag Handle -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="6dp"
        android:background="#D1D5DB" />

    <!-- Sheet Title -->
    <TextView
        android:id="@+id/txtMoreTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="All Modules"
        android:textColor="#0F172A"
        android:textSize="18sp"
        android:textStyle="bold"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="4dp" />

    <TextView
        android:id="@+id/txtMoreSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tap any module to navigate"
        android:textColor="#94A3B8"
        android:textSize="12sp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp" />

    <!-- Separator -->
    <View
        android:id="@+id/moreDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#F1F5F9"
        android:layout_marginBottom="4dp" />

    <!-- Scrollable module list -->
    <ScrollView
        android:id="@+id/moreSettingsScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="8dp">

            <!-- ── OVERVIEW ────────────────────────────── -->
            <TextView
                android:id="@+id/lblOverviewHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="OVERVIEW"
                android:textColor="#4338CA"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:paddingStart="4dp"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:id="@+id/containerOverview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="20dp" />

            <!-- ── CLINICAL OPERATIONS ─────────────────── -->
            <TextView
                android:id="@+id/lblClinicalHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="CLINICAL OPERATIONS"
                android:textColor="#4338CA"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:paddingStart="4dp"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:id="@+id/containerClinical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="20dp" />

            <!-- ── RADIOLOGY (RIS) ─────────────────────── -->
            <TextView
                android:id="@+id/lblRadiologyHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="RADIOLOGY (RIS)"
                android:textColor="#4338CA"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:paddingStart="4dp"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:id="@+id/containerRadiology"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="20dp" />

            <!-- ── RESOURCES &amp; LOGISTICS ──────────── -->
            <TextView
                android:id="@+id/lblLogisticsHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="RESOURCES &amp; LOGISTICS"
                android:textColor="#4338CA"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:paddingStart="4dp"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:id="@+id/containerLogistics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="20dp" />

            <!-- ── MACHINE &amp; AI ────────────────────── -->
            <TextView
                android:id="@+id/lblMachineHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="MACHINE &amp; AI"
                android:textColor="#4338CA"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:paddingStart="4dp"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:id="@+id/containerMachine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="20dp" />

            <!-- ── B2B &amp; GROWTH ────────────────────── -->
            <TextView
                android:id="@+id/lblB2BHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="B2B &amp; GROWTH"
                android:textColor="#4338CA"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:paddingStart="4dp"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:id="@+id/containerB2B"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="20dp" />

            <!-- ── ADMINISTRATION ──────────────────────── -->
            <TextView
                android:id="@+id/lblAdminHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ADMINISTRATION"
                android:textColor="#4338CA"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:paddingStart="4dp"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:id="@+id/containerAdmin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="20dp" />

            <!-- ── LEGAL &amp; POLICIES ────────────────── -->
            <TextView
                android:id="@+id/lblLegalHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="LEGAL &amp; POLICIES"
                android:textColor="#4338CA"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:paddingStart="4dp"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:id="@+id/containerLegal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="20dp" />

        </LinearLayout>

    </ScrollView>

    <!-- Separator above Sign Out -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#F1F5F9" />

    <!-- Sign Out Button -->
    <Button
        android:id="@+id/btnMoreLogout"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="24dp"
        android:text="Sign Out"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        android:background="@drawable/bg_logout_btn" />

</LinearLayout>
