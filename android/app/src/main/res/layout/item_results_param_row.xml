<?xml version="1.0" encoding="utf-8"?>
<!-- Parameter entry row for Clinical Results Entry workstation -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <!-- Top line: Parameter Name + Unit & Ref Range -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/lblParamName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Hemoglobin"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#0F172A" />

        <TextView
            android:id="@+id/lblParamUnitRef"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="g/dL (13.0 - 17.0)"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:textColor="#64748B" />

    </LinearLayout>

    <!-- Bottom line: Editable Input Field + Evaluation Flag Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp">

        <EditText
            android:id="@+id/inputParamValue"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_pill_white"
            android:backgroundTint="#FFFFFF"
            android:hint="Observed Value (e.g. 14.2)"
            android:textColorHint="#94A3B8"
            android:textColor="#0F172A"
            android:textSize="14.5sp"
            android:textStyle="bold"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:singleLine="true"
            android:inputType="text" />

        <TextView
            android:id="@+id/lblParamFlag"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="10dp"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="NORMAL"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone"
            android:background="@drawable/bg_pill_white"
            android:backgroundTint="#ECFDF5"
            android:textColor="#059669" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#F1F5F9"
        android:layout_marginTop="12dp" />

</LinearLayout>
