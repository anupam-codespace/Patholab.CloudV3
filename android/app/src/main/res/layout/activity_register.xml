<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_auth_gradient"
    android:orientation="vertical">

    <View
        android:id="@+id/statusBarSpacer"
        android:layout_width="match_parent"
        android:layout_height="0dp" />

    <!-- Header -->
    <LinearLayout
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingTop="16dp"
        android:paddingBottom="18dp">

        <!-- Improved Glass Back button -->
        <FrameLayout
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_glass_back_btn"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_back_arrow"
                android:tint="#FFFFFF"
                app:tint="#FFFFFF" />

        </FrameLayout>

        <!-- Side-by-side title and subtitle -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Create Account"
                android:textColor="#FFFFFF"
                android:textSize="32sp"
                android:textStyle="bold"
                android:letterSpacing="-0.03"
                android:fontFamily="sans-serif-black"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Start your lab's digital journey today."
                android:textColor="#C7D2FE"
                android:textSize="13.5sp" />

        </LinearLayout>

    </LinearLayout>

    <!-- White card -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_white_card_top"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="22dp"
            android:paddingBottom="32dp">

            <!-- Error banner -->
            <LinearLayout
                android:id="@+id/errorBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_error_banner"
                android:padding="14dp"
                android:visibility="gone"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/tvError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/errorRed"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- ROW 1: Lab / Organization Name & Full Name in one row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <!-- Left Column: Lab Name -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Lab / Org Name *"
                        android:textColor="@color/textPrimary"
                        android:textSize="13.5sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp" />

                    <EditText
                        android:id="@+id/etLabName"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_input"
                        android:hint="Apex Diagnostics"
                        android:inputType="textCapWords"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:textColor="@color/textPrimary"
                        android:textColorHint="@color/textHint"
                        android:textSize="14sp"
                        android:singleLine="true" />

                    <TextView
                        android:id="@+id/tvLabNameError"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/errorRed"
                        android:textSize="11.5sp"
                        android:visibility="gone"
                        android:layout_marginTop="3dp" />
                </LinearLayout>

                <!-- Right Column: Full Name -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Full Name *"
                        android:textColor="@color/textPrimary"
                        android:textSize="13.5sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp" />

                    <EditText
                        android:id="@+id/etFullName"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_input"
                        android:hint="Dr. John Doe"
                        android:inputType="textPersonName|textCapWords"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:textColor="@color/textPrimary"
                        android:textColorHint="@color/textHint"
                        android:textSize="14sp"
                        android:singleLine="true" />

                    <TextView
                        android:id="@+id/tvNameError"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/errorRed"
                        android:textSize="11.5sp"
                        android:visibility="gone"
                        android:layout_marginTop="3dp" />
                </LinearLayout>

            </LinearLayout>

            <!-- ROW 2: Phone Number & Email Address in one row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false"
                android:layout_marginTop="14dp">

                <!-- Left Column: Phone -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Phone Number *"
                        android:textColor="@color/textPrimary"
                        android:textSize="13.5sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp" />

                    <EditText
                        android:id="@+id/etPhone"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_input"
                        android:hint="98765 43210"
                        android:inputType="phone"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:textColor="@color/textPrimary"
                        android:textColorHint="@color/textHint"
                        android:textSize="14sp"
                        android:singleLine="true"
                        android:maxLength="15" />

                    <TextView
                        android:id="@+id/tvPhoneError"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/errorRed"
                        android:textSize="11.5sp"
                        android:visibility="gone"
                        android:layout_marginTop="3dp" />
                </LinearLayout>

                <!-- Right Column: Email Address -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Email Address *"
                        android:textColor="@color/textPrimary"
                        android:textSize="13.5sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp" />

                    <EditText
                        android:id="@+id/etEmail"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_input"
                        android:hint="admin@lab.com"
                        android:inputType="textEmailAddress"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:textColor="@color/textPrimary"
                        android:textColorHint="@color/textHint"
                        android:textSize="14sp"
                        android:singleLine="true" />

                    <TextView
                        android:id="@+id/tvEmailError"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/errorRed"
                        android:textSize="11.5sp"
                        android:visibility="gone"
                        android:layout_marginTop="3dp" />
                </LinearLayout>

            </LinearLayout>

            <!-- ROW 3: Password & Confirm Password in one row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false"
                android:layout_marginTop="14dp">

                <!-- Left Column: Password -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Password *"
                        android:textColor="@color/textPrimary"
                        android:textSize="13.5sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp" />

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp">
                        <EditText
                            android:id="@+id/etPassword"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_input"
                            android:hint="Min. 8 chars"
                            android:inputType="textPassword"
                            android:paddingStart="14dp"
                            android:paddingEnd="42dp"
                            android:textColor="@color/textPrimary"
                            android:textColorHint="@color/textHint"
                            android:textSize="14sp"
                            android:singleLine="true" />
                        <ImageView
                            android:id="@+id/ivTogglePassword"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:layout_marginEnd="2dp"
                            android:padding="10dp"
                            android:src="@drawable/ic_eye_closed"
                            android:tint="@color/textHint"
                            android:contentDescription="Toggle Password" />
                    </RelativeLayout>

                    <TextView
                        android:id="@+id/tvPasswordError"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/errorRed"
                        android:textSize="11.5sp"
                        android:visibility="gone"
                        android:layout_marginTop="3dp" />
                </LinearLayout>

                <!-- Right Column: Confirm Password -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Confirm Password *"
                        android:textColor="@color/textPrimary"
                        android:textSize="13.5sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp" />

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp">
                        <EditText
                            android:id="@+id/etConfirmPassword"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_input"
                            android:hint="Re-enter"
                            android:inputType="textPassword"
                            android:paddingStart="14dp"
                            android:paddingEnd="42dp"
                            android:textColor="@color/textPrimary"
                            android:textColorHint="@color/textHint"
                            android:textSize="14sp"
                            android:singleLine="true" />
                        <ImageView
                            android:id="@+id/ivToggleConfirmPassword"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:layout_marginEnd="2dp"
                            android:padding="10dp"
                            android:src="@drawable/ic_eye_closed"
                            android:tint="@color/textHint"
                            android:contentDescription="Toggle Confirm Password" />
                    </RelativeLayout>

                    <TextView
                        android:id="@+id/tvConfirmPasswordError"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/errorRed"
                        android:textSize="11.5sp"
                        android:visibility="gone"
                        android:layout_marginTop="3dp" />
                </LinearLayout>

            </LinearLayout>

            <!-- Password strength bar -->
            <LinearLayout
                android:id="@+id/strengthContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:visibility="gone">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="3.5dp"
                    android:orientation="horizontal">
                    <View android:id="@+id/bar1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#e5e7eb" android:layout_marginEnd="3dp" />
                    <View android:id="@+id/bar2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#e5e7eb" android:layout_marginEnd="3dp" />
                    <View android:id="@+id/bar3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#e5e7eb" android:layout_marginEnd="3dp" />
                    <View android:id="@+id/bar4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#e5e7eb" />
                </LinearLayout>
                <TextView
                    android:id="@+id/tvStrength"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Interactive Terms & Privacy Agreement Checkbox Card -->
            <LinearLayout
                android:id="@+id/termsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_legal_consent"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="top">

                    <androidx.appcompat.widget.AppCompatCheckBox
                        android:id="@+id/cbTerms"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginTop="1dp"
                        android:buttonTint="@color/indigoMid"
                        android:checked="false" />

                    <TextView
                        android:id="@+id/tvLegalConsent"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:textColor="@color/textSecondary"
                        android:textSize="12sp"
                        android:lineSpacingExtra="2dp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvTermsError"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Please accept the Terms &amp; Conditions and Privacy Policy to continue"
                    android:textColor="@color/errorRed"
                    android:textSize="11.5sp"
                    android:visibility="gone"
                    android:layout_marginStart="32dp"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

            <!-- Create Account button -->
            <Button
                android:id="@+id/btnRegister"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_btn_primary"
                android:text="Create Account"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="normal"
                android:fontFamily="sans-serif-medium"
                android:textAllCaps="false"
                android:letterSpacing="0.01"
                android:stateListAnimator="@null" />

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="12dp"
                android:indeterminateTint="@color/indigoMid"
                android:visibility="gone" />

            <!-- Login link -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_marginTop="24dp"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Already have an account? "
                    android:textColor="@color/textSecondary"
                    android:textSize="14sp" />
                <TextView
                    android:id="@+id/tvLogin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Log in"
                    android:textColor="@color/indigoMid"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Legal Links -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvTerms"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Terms &amp; Conditions"
                    android:textColor="@color/textSecondary"
                    android:textSize="11sp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:text="•"
                    android:textColor="@color/textHint"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/tvPrivacy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Privacy Policy"
                    android:textColor="@color/textSecondary"
                    android:textSize="11sp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:text="•"
                    android:textColor="@color/textHint"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/tvRefunds"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Refund Policy"
                    android:textColor="@color/textSecondary"
                    android:textSize="11sp"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="© 2026 Globizhub India Pvt. Ltd. · All rights reserved"
                android:textColor="@color/textHint"
                android:textSize="12sp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
