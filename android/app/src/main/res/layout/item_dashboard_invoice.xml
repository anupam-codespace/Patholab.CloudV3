<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_tx_card_ripple"
    android:orientation="vertical"
    android:padding="14dp"
    android:layout_marginBottom="8dp"
    android:elevation="1dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Standardized Patient Avatar -->
        <ImageView
            android:id="@+id/lblDashItemPatientAvatar"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:src="@drawable/ic_patient_avatar"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="10dp">

            <TextView
                android:id="@+id/lblDashItemPatientName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SRISTIDHAR HUI"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#0F172A" />

            <TextView
                android:id="@+id/lblDashItemDateMethod"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="30 Aug, 08:07 am • UPI"
                android:textSize="11.5sp"
                android:textColor="#64748B" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">

            <TextView
                android:id="@+id/lblDashItemGrandTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹550.00"
                android:textSize="15sp"
                android:fontFamily="sans-serif-black"
                android:textStyle="bold"
                android:textColor="#0F172A" />

            <TextView
                android:id="@+id/lblDashItemStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="PAID"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#059669"
                android:background="@drawable/bg_tag_emerald"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="1.5dp"
                android:paddingBottom="1.5dp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
