<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainParentLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <!-- 1. Web view content container (Full screen behind header & wallet card) -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentTop="true"
        android:layout_above="@id/floatingNavBarCard">

        <FrameLayout
            android:id="@+id/webViewContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- 0. Subtle Blurred Gradient Backdrop for Header & Wallet (extends halfway over wallet box) -->
    <View
        android:id="@+id/headerBlurGradientView"
        android:layout_width="match_parent"
        android:layout_height="115dp"
        android:layout_alignParentTop="true" />

    <!-- Vertical container for Header + Wallet Card -->
    <LinearLayout
        android:id="@+id/topLayoutContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:orientation="vertical"
        android:background="@android:color/transparent"
        android:elevation="0dp">

        <!-- 0. Native top header bar -->
        <RelativeLayout
            android:id="@+id/topHeaderBar"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@android:color/transparent"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <!-- Left: menu icon ••• -->
            <LinearLayout
                android:id="@+id/btnHeaderMenu"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    android:id="@+id/txtHeaderMenu"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="•••"
                    android:textColor="#475569"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_gravity="center" />
            </LinearLayout>

            <!-- Center Title Stack -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/btnHeaderMenu"
                android:layout_toStartOf="@+id/rightHeaderActions"
                android:layout_centerVertical="true"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="8dp"
                android:orientation="vertical"
                android:gravity="start">

                <TextView
                    android:id="@+id/lblHeaderSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Main Branch"
                    android:textColor="#94A3B8"
                    android:textSize="9.5sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.12"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/lblHeaderTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="Analytics"
                    android:textColor="#0F172A"
                    android:textSize="15.5sp"
                    android:textStyle="bold"
                    android:letterSpacing="-0.01"
                    android:singleLine="true"
                    android:ellipsize="end" />

            </LinearLayout>

            <!-- Right: bell, theme, support -->
            <LinearLayout
                android:id="@+id/rightHeaderActions"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignParentEnd="true"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Notifications Bell -->
                <RelativeLayout
                    android:id="@+id/btnHeaderNotification"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_marginEnd="4dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/imgHeaderBell"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_centerInParent="true"
                        android:src="@drawable/ic_bell"
                        android:tint="#475569" />

                    <!-- Unread Badge -->
                    <TextView
                        android:id="@+id/txtNotificationBadge"
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:background="@drawable/bg_notification_badge"
                        android:textColor="#FFFFFF"
                        android:textSize="8.5sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:visibility="gone"
                        android:layout_alignParentTop="true"
                        android:layout_alignParentEnd="true"
                        android:layout_marginTop="1dp"
                        android:layout_marginEnd="1dp" />

                </RelativeLayout>

                <!-- Sun / Theme toggle -->
                <LinearLayout
                    android:id="@+id/btnHeaderTheme"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:gravity="center"
                    android:layout_marginEnd="4dp"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageView
                        android:id="@+id/imgHeaderTheme"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_sun"
                        android:tint="#475569" />
                </LinearLayout>

                <!-- Support Help -->
                <LinearLayout
                    android:id="@+id/btnHeaderSupport"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_help"
                        android:tint="#475569" />
                </LinearLayout>

            </LinearLayout>

        </RelativeLayout>

        <!-- Header / Wallet separator -->
        <View
            android:id="@+id/headerDivider"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="#0A000000" />

        <!-- ── Wallet Card ─────────────────────────────────────────────────── -->
        <!-- Proportions, sizing (54dp height, 27dp radius), spacing match iOS exactly -->
        <RelativeLayout
            android:id="@+id/walletCard"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:layout_marginTop="1dp"
            android:layout_marginBottom="3dp"
            android:paddingStart="10dp"
            android:paddingEnd="12dp"
            android:visibility="gone">

            <!-- Left: Slim circular icon (36dp x 36dp with 26dp icon) -->
            <FrameLayout
                android:id="@+id/walletIconContainer"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_wallet_circle_white">
                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_wallet_logo"
                    android:layout_gravity="center" />
            </FrameLayout>

            <!-- Center: Balance + status stack -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/walletIconContainer"
                android:layout_toStartOf="@+id/btnWalletTopUp"
                android:layout_centerVertical="true"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="8dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtWalletBalance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="₹0.00"
                    android:textColor="#FFFFFF"
                    android:textSize="18.5sp"
                    android:fontFamily="sans-serif-black"
                    android:textFontWeight="900"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="12sp"
                    android:autoSizeMaxTextSize="18.5sp"
                    android:autoSizeStepGranularity="0.5sp" />

                <TextView
                    android:id="@+id/txtWalletStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="●  ACTIVE • FUNDED"
                    android:textColor="#94A3B8"
                    android:textSize="9.5sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04" />

            </LinearLayout>

            <!-- Right: Subtle Chevron Icon (Shown when balance >= 49) -->
            <ImageView
                android:id="@+id/walletChevron"
                android:layout_width="12dp"
                android:layout_height="16dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="2dp"
                android:src="@drawable/ic_chevron_right"
                app:tint="#94A3B8"
                android:visibility="gone" />

            <!-- Right: Pill Top Up Button (28dp height, shown when balance < 49) -->
            <LinearLayout
                android:id="@+id/btnWalletTopUp"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_top_up_button"
                android:paddingStart="13dp"
                android:paddingEnd="13dp"
                android:gravity="center"
                android:clickable="false"
                android:focusable="false"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Top Up"
                    android:textColor="#FFFFFF"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </RelativeLayout>

        <!-- Bottom rule line -->
        <View
            android:id="@+id/dividerLineTop"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="#0A000000" />

    </LinearLayout>




    <!-- 3. Offline Overlay -->
    <LinearLayout
        android:id="@+id/offlineOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/topLayoutContainer"
        android:layout_above="@id/floatingNavBarCard"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#F8FAFC"
        android:visibility="gone"
        android:padding="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No Connection"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#0F172A"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Check your internet connection and try again."
            android:textSize="14sp"
            android:textColor="#64748B"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnRetry"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="Retry"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:background="@drawable/bg_btn_primary" />

    </LinearLayout>

    <!-- Full-screen Skeleton Overlay (below header only) -->
    <FrameLayout
        android:id="@+id/skeletonContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/topLayoutContainer"
        android:layout_above="@id/floatingNavBarCard"
        android:background="#F8FAFC"
        android:visibility="gone">
        <include layout="@layout/layout_skeletons" />
    </FrameLayout>

    <!-- 5. Floating Action Button — New Registration (shown on /patients page) -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabNewRegistration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:layout_marginBottom="96dp"
        android:layout_marginEnd="20dp"
        android:backgroundTint="#4F46E5"
        android:src="@android:drawable/ic_input_add"
        android:contentDescription="New Registration"
        android:visibility="gone"
        android:elevation="8dp"
        app:fabSize="normal"
        app:maxImageSize="28dp"
        app:rippleColor="#7C3AED"
        app:tint="@android:color/white" />

    <!-- 5. Native Home Screen (shown instead of WebView when Home tab is active) -->
    <include
        layout="@layout/layout_home_screen"
        android:id="@+id/nativeHomeScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentTop="true"
        android:layout_above="@id/floatingNavBarCard" />

    <!-- 4. Floating Glassmorphic Pill Navigation Bar -->
    <androidx.cardview.widget.CardView
        android:id="@+id/floatingNavBarCard"
        android:layout_width="match_parent"
        android:layout_height="66dp"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="33dp"
        app:cardElevation="14dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardPreventCornerOverlap="false">

        <LinearLayout
            android:id="@+id/floatingNavItemsLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:baselineAligned="false"
            android:background="@drawable/bg_floating_glass_navbar"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <!-- Tab 0: Home -->
            <LinearLayout
                android:id="@+id/navTabHome"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/imgNavHome"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_nav_dashboard"
                    android:tint="#0D6EFD" />

                <TextView
                    android:id="@+id/txtNavHome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Home"
                    android:textSize="10.5sp"
                    android:textStyle="bold"
                    android:textColor="#0D6EFD" />
            </LinearLayout>

            <!-- Tab 1: Patients -->
            <LinearLayout
                android:id="@+id/navTabPatients"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/imgNavPatients"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_nav_patients"
                    android:tint="#94A3B8" />

                <TextView
                    android:id="@+id/txtNavPatients"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Patients"
                    android:textSize="10.5sp"
                    android:textStyle="normal"
                    android:textColor="#94A3B8" />
            </LinearLayout>

            <!-- Tab Center: Elevated Glowing Card / Action Button -->
            <FrameLayout
                android:id="@+id/navTabCenter"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true">

                <FrameLayout
                    android:id="@+id/navCenterCircle"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_nav_center_circle"
                    android:elevation="6dp">

                    <ImageView
                        android:id="@+id/imgNavCenter"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_nav_card_center"
                        android:tint="#FFFFFF" />

                </FrameLayout>
            </FrameLayout>

            <!-- Tab 2: Reports -->
            <LinearLayout
                android:id="@+id/navTabReports"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/imgNavReports"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_document"
                    android:tint="#94A3B8" />

                <TextView
                    android:id="@+id/txtNavReports"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Reports"
                    android:textSize="10.5sp"
                    android:textStyle="normal"
                    android:textColor="#94A3B8" />
            </LinearLayout>

            <!-- Tab 3: More -->
            <LinearLayout
                android:id="@+id/navTabMore"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/imgNavMore"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_nav_categories"
                    android:tint="#94A3B8" />

                <TextView
                    android:id="@+id/txtNavMore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="More"
                    android:textSize="10.5sp"
                    android:textStyle="normal"
                    android:textColor="#94A3B8" />
            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</RelativeLayout>