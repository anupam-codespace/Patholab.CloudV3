<?xml version="1.0" encoding="utf-8"?>
<!-- Sapphire Bento Diagnostic Test Catalog & LIMS Management Hub -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8FAFC">

    <!-- ── TOP CURVED SAPPHIRE HEADER (EXACT MATCH WITH PATIENT REGISTRATION) ── -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_home_header"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="32dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Top Row: Back + Title + Persistent Add Action -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <FrameLayout
                    android:id="@+id/btnTestBack"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_bell_btn"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_back_arrow"
                        android:tint="#0D6EFD" />

                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="14dp">

                    <TextView
                        android:id="@+id/lblCatalogTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Test Management"
                        android:textSize="19.5sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:letterSpacing="-0.02" />

                    <TextView
                        android:id="@+id/lblCatalogSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Diagnostic Catalog &amp; Price Control"
                        android:textSize="12sp"
                        android:textColor="#C7DFFF" />

                </LinearLayout>

                <TextView
                    android:id="@+id/btnAddNewTestHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_wallet_pill"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="+ Add Test"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:visibility="visible"
                    android:clickable="true"
                    android:focusable="true" />

                <FrameLayout
                    android:id="@+id/btnRefreshTestCatalog"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_wallet_pill"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/imgRefreshTestCatalogIcon"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_refresh_cw"
                        android:tint="#FFFFFF"
                        app:tint="#FFFFFF" />

                </FrameLayout>

            </LinearLayout>

            <!-- 7-Tab Horizontal Segmented Capsule Selector -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_wallet_pill"
                android:padding="3dp">

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scrollbars="none"
                    android:fillViewport="true">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:orientation="horizontal">

                        <!-- 1. Tests & Pricing -->
                        <TextView
                            android:id="@+id/tabTestsPricing"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:background="@drawable/bg_pill_white"
                            android:text="Tests &amp; Pricing"
                            android:textSize="12.5sp"
                            android:textStyle="bold"
                            android:textColor="#0D6EFD"
                            android:elevation="2dp"
                            android:clickable="true"
                            android:focusable="true" />

                        <!-- 2. Parameters -->
                        <TextView
                            android:id="@+id/tabParameters"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:background="@android:color/transparent"
                            android:text="Parameters"
                            android:textSize="12.5sp"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF"
                            android:clickable="true"
                            android:focusable="true" />

                        <!-- 3. Custom Fields -->
                        <TextView
                            android:id="@+id/tabCustomFields"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:background="@android:color/transparent"
                            android:text="Custom Fields"
                            android:textSize="12.5sp"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF"
                            android:clickable="true"
                            android:focusable="true" />

                        <!-- 4. Headings -->
                        <TextView
                            android:id="@+id/tabHeadings"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:background="@android:color/transparent"
                            android:text="Headings"
                            android:textSize="12.5sp"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF"
                            android:clickable="true"
                            android:focusable="true" />

                        <!-- 5. Containers -->
                        <TextView
                            android:id="@+id/tabContainers"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:background="@android:color/transparent"
                            android:text="Containers"
                            android:textSize="12.5sp"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF"
                            android:clickable="true"
                            android:focusable="true" />

                        <!-- 6. Sample Types -->
                        <TextView
                            android:id="@+id/tabSampleTypes"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:background="@android:color/transparent"
                            android:text="Sample Types"
                            android:textSize="12.5sp"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF"
                            android:clickable="true"
                            android:focusable="true" />

                        <!-- 7. Departments -->
                        <TextView
                            android:id="@+id/tabDepartments"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:background="@android:color/transparent"
                            android:text="Departments"
                            android:textSize="12.5sp"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF"
                            android:clickable="true"
                            android:focusable="true" />

                    </LinearLayout>

                </HorizontalScrollView>

            </FrameLayout>

        </LinearLayout>

    </FrameLayout>

    <!-- ── TAB 1: TESTS & PRICING CONTENT ─────────────────────────── -->
    <LinearLayout
        android:id="@+id/containerTabTests"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="visible">

        <!-- Search Bar & Scope Filters -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="10dp"
            android:paddingBottom="4dp">

            <!-- Search Input Box -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_input_field"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:elevation="1dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_search"
                    android:tint="#94A3B8" />

                <EditText
                    android:id="@+id/inputSearchTests"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:background="@android:color/transparent"
                    android:hint="Search tests by code, name, department..."
                    android:inputType="text"
                    android:textSize="13.5sp"
                    android:textColor="#0F172A"
                    android:textColorHint="#94A3B8"
                    android:singleLine="true" />

                <ImageView
                    android:id="@+id/btnClearSearchTests"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_close_cross"
                    android:tint="#94A3B8"
                    android:visibility="gone"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

            <!-- Horizontal Filter Chips -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/containerDeptFilterChips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />

            </HorizontalScrollView>

        </LinearLayout>

        <!-- Loading Spinner -->
        <ProgressBar
            android:id="@+id/progressTests"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            android:indeterminateTint="#0D6EFD"
            android:visibility="gone" />

        <!-- Tests List Recycler (Wider 8dp padding) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerTestsList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="16dp"
            android:clipToPadding="false" />

        <!-- Empty State -->
        <LinearLayout
            android:id="@+id/emptyStateTests"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:background="@drawable/bg_mod_icon_blue"
                android:layout_marginBottom="12dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_flask"
                    android:tint="#0D6EFD" />

            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No Diagnostic Tests Found"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#0F172A"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No tests matched your current filter or search criteria."
                android:textSize="13sp"
                android:textColor="#64748B"
                android:gravity="center" />

        </LinearLayout>

    </LinearLayout>

    <!-- ── TAB 2: PARAMETERS CONTENT ───────────────────────────────── -->
    <LinearLayout
        android:id="@+id/containerTabParameters"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Search Bar & Scope Filters -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="10dp"
            android:paddingBottom="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_input_field"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:elevation="1dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_search"
                    android:tint="#94A3B8" />

                <EditText
                    android:id="@+id/inputSearchParameters"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:background="@android:color/transparent"
                    android:hint="Search parameters by name, code, method..."
                    android:inputType="text"
                    android:textSize="13.5sp"
                    android:textColor="#0F172A"
                    android:textColorHint="#94A3B8"
                    android:singleLine="true" />

                <ImageView
                    android:id="@+id/btnClearSearchParameters"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_close_cross"
                    android:tint="#94A3B8"
                    android:visibility="gone"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

            <!-- Parameter Scope Filter Chips -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/containerParamFilterChips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />

            </HorizontalScrollView>

        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressParameters"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            android:indeterminateTint="#7C3AED"
            android:visibility="gone" />

        <!-- Parameters Recycler (Wider 8dp padding) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerParametersList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="16dp"
            android:clipToPadding="false" />

        <!-- Empty State for Parameters -->
        <LinearLayout
            android:id="@+id/emptyStateParameters"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:background="@drawable/bg_mod_icon_purple"
                android:layout_marginBottom="12dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_microscope"
                    android:tint="#7C3AED" />

            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No Parameters Found"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#0F172A"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No parameters matched your search or scope filter."
                android:textSize="13sp"
                android:textColor="#64748B"
                android:gravity="center" />

        </LinearLayout>

    </LinearLayout>

    <!-- ── TAB 3: CUSTOM FIELDS CONTENT ───────────────────────────── -->
    <LinearLayout
        android:id="@+id/containerTabCustomFields"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/progressCustomFields"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            android:indeterminateTint="#0D9488"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerCustomFieldsList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="8dp"
            android:paddingBottom="16dp"
            android:clipToPadding="false" />

    </LinearLayout>

    <!-- ── TAB 4: HEADINGS CONTENT ────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/containerTabHeadings"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/progressHeadings"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            android:indeterminateTint="#4F46E5"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerHeadingsList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="8dp"
            android:paddingBottom="16dp"
            android:clipToPadding="false" />

    </LinearLayout>

    <!-- ── TAB 5: CONTAINERS (SPECIMEN TUBES) CONTENT ──────────────── -->
    <LinearLayout
        android:id="@+id/containerTabContainers"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/progressContainers"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            android:indeterminateTint="#7C3AED"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerContainersList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="8dp"
            android:paddingBottom="16dp"
            android:clipToPadding="false" />

    </LinearLayout>

    <!-- ── TAB 6: SAMPLE TYPES CONTENT ────────────────────────────── -->
    <LinearLayout
        android:id="@+id/containerTabSampleTypes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/progressSampleTypes"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            android:indeterminateTint="#E11D48"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerSampleTypesList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="8dp"
            android:paddingBottom="16dp"
            android:clipToPadding="false" />

    </LinearLayout>

    <!-- ── TAB 7: DEPARTMENTS CONTENT ─────────────────────────────── -->
    <LinearLayout
        android:id="@+id/containerTabDepartments"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/progressDepartments"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            android:indeterminateTint="#0D6EFD"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerDepartmentsList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="8dp"
            android:paddingBottom="16dp"
            android:clipToPadding="false" />

    </LinearLayout>

</LinearLayout>
