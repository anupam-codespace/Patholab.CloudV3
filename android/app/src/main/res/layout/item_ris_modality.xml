<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_stat_card"
    android:padding="14dp"
    android:layout_marginBottom="8dp">

    <!-- Top Row: Name and Status Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/lblModalityName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="MRI 1.5T (Philips)"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#0F172A" />

        <TextView
            android:id="@+id/lblModalityStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_status_completed"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="ACTIVE"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#059669" />
    </LinearLayout>

    <!-- Middle: Current Patient -->
    <TextView
        android:id="@+id/lblModalityPatient"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Current: Idle / Available"
        android:textSize="12.5sp"
        android:textStyle="bold"
        android:textColor="#4F46E5" />

    <!-- Next Slot -->
    <TextView
        android:id="@+id/lblModalityNextSlot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Next Slot: 11:30 AM"
        android:textSize="11.5sp"
        android:textColor="#64748B" />

    <!-- Bottom: Daily Load Progress -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/lblModalityLoad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Load: 45%"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:textColor="#334155" />

        <ProgressBar
            android:id="@+id/progressModalityLoad"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="6dp"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:max="100"
            android:progress="45"
            android:progressTint="#4F46E5" />
    </LinearLayout>
</LinearLayout>
