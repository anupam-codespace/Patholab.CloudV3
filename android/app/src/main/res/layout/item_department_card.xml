<?xml version="1.0" encoding="utf-8"?>
<!-- Modern Sapphire Bento Laboratory Department Item Card -->
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="18dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardPreventCornerOverlap="false"
    android:layout_marginStart="4dp"
    android:layout_marginEnd="4dp"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="14dp">

        <FrameLayout
            android:id="@+id/frameDeptIcon"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_mod_icon_blue">

            <ImageView
                android:id="@+id/imgDeptIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_flask"
                android:tint="#0D6EFD" />

        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/lblDeptName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Clinical Biochemistry"
                android:textSize="15.5sp"
                android:textStyle="bold"
                android:textColor="#0F172A" />

            <TextView
                android:id="@+id/lblDeptDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Serum electrolytes, enzymes, glucose, lipid and renal profiles"
                android:textSize="12sp"
                android:textColor="#64748B" />

        </LinearLayout>

        <!-- Tests Count Badge with Crisp Pure White Text -->
        <TextView
            android:id="@+id/lblDeptTestCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_wallet_pill"
            android:backgroundTint="#0D6EFD"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:text="38 Tests"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
