<?xml version="1.0" encoding="utf-8"?>
<!-- Modern Profile Avatar Popup Menu -->
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="230dp"
    android:layout_height="wrap_content"
    app:cardCornerRadius="20dp"
    app:cardElevation="14dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp"
        android:background="#FFFFFF">

        <!-- User mini-header row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:paddingTop="6dp"
            android:paddingBottom="10dp">

            <!-- Mini avatar initial circle -->
            <FrameLayout
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_mod_icon_blue">

                <TextView
                    android:id="@+id/popupAvatarInitial"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="M"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#2563EB" />

            </FrameLayout>

            <!-- Name and Role -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="10dp">

                <TextView
                    android:id="@+id/popupUserName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Monowar Hussain"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#0F172A"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/popupUserRole"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="Lab Owner"
                    android:textSize="11sp"
                    android:textColor="#64748B"
                    android:singleLine="true"
                    android:ellipsize="end" />

            </LinearLayout>

        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="4dp"
            android:background="#F1F5F9" />

        <!-- Option 1: Profile Settings -->
        <LinearLayout
            android:id="@+id/popupBtnProfileSettings"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="10dp"
            android:background="@drawable/bg_popup_item_ripple"
            android:clickable="true"
            android:focusable="true">

            <FrameLayout
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_mod_icon_blue">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_gear"
                    android:tint="#2563EB" />

            </FrameLayout>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="Profile Settings"
                android:textSize="13.5sp"
                android:textStyle="bold"
                android:textColor="#1E293B" />

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_chevron_right"
                android:tint="#94A3B8" />

        </LinearLayout>

        <!-- Option 2: Sign Out -->
        <LinearLayout
            android:id="@+id/popupBtnSignOut"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="10dp"
            android:layout_marginTop="2dp"
            android:background="@drawable/bg_popup_item_red_ripple"
            android:clickable="true"
            android:focusable="true">

            <FrameLayout
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_mod_icon_rose">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_close_circle"
                    android:tint="#EF4444" />

            </FrameLayout>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="Sign Out"
                android:textSize="13.5sp"
                android:textStyle="bold"
                android:textColor="#EF4444" />

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_chevron_right"
                android:tint="#FCA5A5" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
