<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/lblMacroSheetTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Add Macro Snippet"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#0F172A" />
        <ImageView
            android:id="@+id/btnMacroSheetClose"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_close" />
    </LinearLayout>

    <EditText
        android:id="@+id/inputMacroName"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_input_field"
        android:hint="Macro Title (e.g. Normal Chest)"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">
        <EditText
            android:id="@+id/inputMacroModality"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_input_field"
            android:hint="Modality (e.g. X-Ray)"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textSize="13sp" />
        <EditText
            android:id="@+id/inputMacroCategory"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_input_field"
            android:hint="Category"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textSize="13sp" />
    </LinearLayout>

    <EditText
        android:id="@+id/inputMacroBody"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_input_field"
        android:hint="Impression / Finding Body Text"
        android:gravity="top"
        android:padding="12dp"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/lblMacroError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#DC2626"
        android:textSize="12sp"
        android:visibility="gone" />

    <Button
        android:id="@+id/btnSaveMacro"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_btn_primary"
        android:text="Save Macro"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />

    <ProgressBar
        android:id="@+id/progressSaveMacro"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="8dp"
        android:visibility="gone" />
</LinearLayout>
