<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ── HEADER BANNER (Vibrant Blue curved header) ────────────── -->
        <FrameLayout
            android:id="@+id/walletHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header_curved"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="50dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Back Button -->
                <FrameLayout
                    android:id="@+id/btnWalletBack"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_bell_btn"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_back_arrow"
                        android:tint="#FFFFFF" />

                </FrameLayout>

                <!-- Title & Subtitle -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Wallet &amp; Billing"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:letterSpacing="-0.02" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Clinical Credits &amp; Ledger"
                        android:textSize="12sp"
                        android:textColor="#BAE6FD" />

                </LinearLayout>

                <!-- Recharge Quick Action Pill -->
                <LinearLayout
                    android:id="@+id/btnHeaderRecharge"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_pill_white"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_plus"
                        android:tint="#0D6EFD" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="Recharge"
                        android:textSize="12.5sp"
                        android:textStyle="bold"
                        android:textColor="#0D6EFD" />

                </LinearLayout>

            </LinearLayout>

        </FrameLayout>

        <!-- ── MAIN SCROLLABLE CONTENT ───────────────────────────────── -->
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/walletSwipeRefresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="40dp">

                    <!-- ── HERO AVAILABLE BALANCE CARD ──────────────────────── -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/bg_wallet_hero_card"
                        android:padding="20dp"
                        android:elevation="4dp"
                        android:layout_marginBottom="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="AVAILABLE CREDITS"
                                android:textSize="11.5sp"
                                android:textStyle="bold"
                                android:textColor="#93C5FD"
                                android:letterSpacing="0.08" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_pill_glass"
                                android:paddingStart="8dp"
                                android:paddingEnd="8dp"
                                android:paddingTop="3dp"
                                android:paddingBottom="3dp"
                                android:gravity="center">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="✓ Ledger Verified"
                                    android:textSize="10.5sp"
                                    android:textStyle="bold"
                                    android:textColor="#34D399" />

                            </LinearLayout>

                        </LinearLayout>

                        <TextView
                            android:id="@+id/txtWalletBalanceHero"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="₹0.00"
                            android:textSize="38sp"
                            android:textStyle="bold"
                            android:textColor="#34D399"
                            android:letterSpacing="-0.02" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#334155"
                            android:layout_marginTop="16dp"
                            android:layout_marginBottom="12dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="VALIDITY"
                                    android:textSize="10sp"
                                    android:textStyle="bold"
                                    android:textColor="#94A3B8"
                                    android:letterSpacing="0.06" />

                                <TextView
                                    android:id="@+id/txtWalletValidity"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="No Expiry"
                                    android:textSize="12.5sp"
                                    android:textStyle="bold"
                                    android:textColor="#E2E8F0" />

                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:gravity="end">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="DEDUCTION RATE"
                                    android:textSize="10sp"
                                    android:textStyle="bold"
                                    android:textColor="#94A3B8"
                                    android:letterSpacing="0.06" />

                                <TextView
                                    android:id="@+id/txtWalletDeduction"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="₹2.50 / Patient"
                                    android:textSize="12.5sp"
                                    android:textStyle="bold"
                                    android:textColor="#E2E8F0" />

                            </LinearLayout>

                        </LinearLayout>

                    </LinearLayout>

                    <!-- ── 2 STATS CARDS (Total Recharged & Total Consumed) ─── -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="20dp">

                        <!-- Card 1: Total Recharged -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/bg_module_card"
                            android:padding="14dp"
                            android:elevation="1dp"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:layout_marginBottom="8dp">

                                <FrameLayout
                                    android:layout_width="28dp"
                                    android:layout_height="28dp"
                                    android:background="@drawable/bg_mod_icon_emerald">

                                    <ImageView
                                        android:layout_width="16dp"
                                        android:layout_height="16dp"
                                        android:layout_gravity="center"
                                        android:src="@drawable/ic_arrow_down_left"
                                        android:tint="#059669" />

                                </FrameLayout>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"
                                    android:text="RECHARGED"
                                    android:textSize="10.5sp"
                                    android:textStyle="bold"
                                    android:textColor="#64748B"
                                    android:letterSpacing="0.06" />

                            </LinearLayout>

                            <TextView
                                android:id="@+id/txtTotalRecharged"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="₹0.00"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="#0F172A" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Lifetime additions"
                                android:textSize="10.5sp"
                                android:textColor="#94A3B8" />

                        </LinearLayout>

                        <!-- Card 2: Total Consumed -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_module_card"
                            android:padding="14dp"
                            android:elevation="1dp"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:layout_marginBottom="8dp">

                                <FrameLayout
                                    android:layout_width="28dp"
                                    android:layout_height="28dp"
                                    android:background="@drawable/bg_mod_icon_rose">

                                    <ImageView
                                        android:layout_width="16dp"
                                        android:layout_height="16dp"
                                        android:layout_gravity="center"
                                        android:src="@drawable/ic_arrow_up_right_vector"
                                        android:tint="#E11D48" />

                                </FrameLayout>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"
                                    android:text="CONSUMED"
                                    android:textSize="10.5sp"
                                    android:textStyle="bold"
                                    android:textColor="#64748B"
                                    android:letterSpacing="0.06" />

                            </LinearLayout>

                            <TextView
                                android:id="@+id/txtTotalConsumed"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="₹0.00"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="#0F172A" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Clinical operations"
                                android:textSize="10.5sp"
                                android:textColor="#94A3B8" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- ── LEDGER & TRANSACTIONS SECTION ─────────────────────── -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📊 LEDGER &amp; TRANSACTION HISTORY"
                        android:textSize="11.5sp"
                        android:textStyle="bold"
                        android:textColor="#64748B"
                        android:letterSpacing="0.06"
                        android:layout_marginStart="4dp"
                        android:layout_marginBottom="12dp" />

                    <!-- Search Filter Box -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_module_card"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:layout_marginBottom="12dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_search"
                            android:tint="#94A3B8" />

                        <EditText
                            android:id="@+id/editSearchTx"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginStart="8dp"
                            android:background="@null"
                            android:hint="Search transactions..."
                            android:textColor="#0F172A"
                            android:textColorHint="#94A3B8"
                            android:textSize="13.5sp"
                            android:inputType="text" />

                    </LinearLayout>

                    <!-- High-Contrast Category Tabs -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="14dp">

                        <TextView
                            android:id="@+id/tabAll"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="4dp"
                            android:background="@drawable/bg_tab_pill_active"
                            android:gravity="center"
                            android:text="All History"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            android:textSize="12.5sp"
                            android:clickable="true"
                            android:focusable="true" />

                        <TextView
                            android:id="@+id/tabRecharge"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:layout_marginStart="2dp"
                            android:layout_marginEnd="2dp"
                            android:background="@drawable/bg_tab_pill_inactive"
                            android:gravity="center"
                            android:text="Recharges"
                            android:textColor="#64748B"
                            android:textStyle="bold"
                            android:textSize="12.5sp"
                            android:clickable="true"
                            android:focusable="true" />

                        <TextView
                            android:id="@+id/tabDebit"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:layout_marginStart="4dp"
                            android:background="@drawable/bg_tab_pill_inactive"
                            android:gravity="center"
                            android:text="Deductions"
                            android:textColor="#64748B"
                            android:textStyle="bold"
                            android:textSize="12.5sp"
                            android:clickable="true"
                            android:focusable="true" />

                    </LinearLayout>

                    <!-- Transaction List Container -->
                    <LinearLayout
                        android:id="@+id/txContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <!-- Empty State -->
                    <LinearLayout
                        android:id="@+id/layoutEmptyTx"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:paddingTop="36dp"
                        android:paddingBottom="36dp"
                        android:visibility="gone">

                        <FrameLayout
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:background="@drawable/bg_bell_btn">

                            <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_mod_wallet"
                                android:tint="#94A3B8" />

                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="No Transactions Found"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="#475569" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Your ledger entries and recharge history will show here"
                            android:textSize="12sp"
                            android:textColor="#94A3B8"
                            android:gravity="center" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.core.widget.NestedScrollView>

        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
