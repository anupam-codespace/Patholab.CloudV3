<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ══════════════════════════════════════════════════════════════
             HERO HEADER — Deep Navy Gradient with Support Title & CTA
             ══════════════════════════════════════════════════════════════ -->
        <LinearLayout
            android:id="@+id/supportHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_support_hero_card"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="36dp"
            android:paddingBottom="22dp">

            <!-- Tier 1: Action Navigation Bar (Back, Refresh, New Ticket CTA) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <FrameLayout
                    android:id="@+id/btnSupportBack"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_glass_back_btn"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_back_arrow"
                        android:tint="#FFFFFF"
                        app:tint="#FFFFFF" />
                </FrameLayout>

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <!-- New Ticket Action Button — White Luxury Capsule CTA -->
                <LinearLayout
                    android:id="@+id/btnHeaderNewTicket"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_white_pill_btn"
                    android:elevation="3dp"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="16dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_plus"
                        android:tint="#0D6EFD"
                        app:tint="#0D6EFD"
                        android:layout_marginEnd="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="New Ticket"
                        android:textColor="#0D6EFD"
                        android:textSize="13.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>

            <!-- Tier 2: Hero Header Greeting & Subtitle (Full Unrestricted Width) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Help &amp; Support"
                    android:textSize="23sp"
                    android:fontFamily="sans-serif-black"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:letterSpacing="-0.02" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="24/7 Dedicated Assistance Desk &amp; Ticket Tracker"
                    android:textSize="12.5sp"
                    android:textColor="#C7DFFF" />
            </LinearLayout>

            <!-- Tier 3: 3 Frosted Glass Bento KPI Stat Cards -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp">

                <!-- Card 1: Open Requests -->
                <LinearLayout
                    android:id="@+id/cardKpiOpen"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_glass_kpi_card"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <View
                            android:layout_width="6dp"
                            android:layout_height="6dp"
                            android:background="@drawable/shape_dot_rose"
                            android:layout_marginEnd="5dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="OPEN"
                            android:textSize="10.5sp"
                            android:textStyle="bold"
                            android:textColor="#FCA5A5"
                            android:letterSpacing="0.05" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvKpiOpenCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="0"
                        android:textSize="21sp"
                        android:fontFamily="sans-serif-black"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="Awaiting review"
                        android:textSize="10sp"
                        android:textColor="#C7DFFF" />
                </LinearLayout>

                <!-- Card 2: In Progress -->
                <LinearLayout
                    android:id="@+id/cardKpiProgress"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_glass_kpi_card"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <View
                            android:layout_width="6dp"
                            android:layout_height="6dp"
                            android:background="@drawable/shape_dot_amber"
                            android:layout_marginEnd="5dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="PROGRESS"
                            android:textSize="10.5sp"
                            android:textStyle="bold"
                            android:textColor="#FDE68A"
                            android:letterSpacing="0.05" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvKpiProgressCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="0"
                        android:textSize="21sp"
                        android:fontFamily="sans-serif-black"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="Being handled"
                        android:textSize="10sp"
                        android:textColor="#C7DFFF" />
                </LinearLayout>

                <!-- Card 3: Resolved -->
                <LinearLayout
                    android:id="@+id/cardKpiResolved"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_glass_kpi_card"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <View
                            android:layout_width="6dp"
                            android:layout_height="6dp"
                            android:background="@drawable/shape_dot_emerald"
                            android:layout_marginEnd="5dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="RESOLVED"
                            android:textSize="10.5sp"
                            android:textStyle="bold"
                            android:textColor="#A7F3D0"
                            android:letterSpacing="0.05" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvKpiResolvedCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="0"
                        android:textSize="21sp"
                        android:fontFamily="sans-serif-black"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="Completed"
                        android:textSize="10sp"
                        android:textColor="#C7DFFF" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- Main Scrollable Body wrapped in SwipeRefreshLayout -->
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefreshLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.core.widget.NestedScrollView
                android:id="@+id/nestedScrollView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Search Box -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_search_input_field"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_search"
                            android:tint="#94A3B8" />

                        <EditText
                            android:id="@+id/etSearchTickets"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@null"
                            android:hint="Search tickets by subject or ID..."
                            android:textColor="#0F172A"
                            android:textColorHint="#94A3B8"
                            android:textSize="13sp"
                            android:paddingStart="10dp"
                            android:paddingEnd="8dp"
                            android:imeOptions="actionSearch"
                            android:inputType="text" />

                        <ImageView
                            android:id="@+id/btnClearSearch"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_close_cross"
                            android:tint="#94A3B8"
                            android:visibility="gone"
                            android:clickable="true"
                            android:focusable="true" />
                    </LinearLayout>

                    <!-- Filter Chips / Tabs -->
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:scrollbars="none">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <!-- Tab All -->
                            <TextView
                                android:id="@+id/tabAll"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:background="@drawable/bg_chip_active"
                                android:gravity="center"
                                android:paddingStart="14dp"
                                android:paddingEnd="14dp"
                                android:text="All Tickets"
                                android:textColor="#FFFFFF"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:clickable="true"
                                android:focusable="true" />

                            <!-- Tab Open -->
                            <TextView
                                android:id="@+id/tabOpen"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:layout_marginStart="8dp"
                                android:background="@drawable/bg_chip_inactive"
                                android:gravity="center"
                                android:paddingStart="14dp"
                                android:paddingEnd="14dp"
                                android:text="Open"
                                android:textColor="#475569"
                                android:textSize="12sp"
                                android:clickable="true"
                                android:focusable="true" />

                            <!-- Tab In Progress -->
                            <TextView
                                android:id="@+id/tabProgress"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:layout_marginStart="8dp"
                                android:background="@drawable/bg_chip_inactive"
                                android:gravity="center"
                                android:paddingStart="14dp"
                                android:paddingEnd="14dp"
                                android:text="In Progress"
                                android:textColor="#475569"
                                android:textSize="12sp"
                                android:clickable="true"
                                android:focusable="true" />

                            <!-- Tab Resolved -->
                            <TextView
                                android:id="@+id/tabResolved"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:layout_marginStart="8dp"
                                android:background="@drawable/bg_chip_inactive"
                                android:gravity="center"
                                android:paddingStart="14dp"
                                android:paddingEnd="14dp"
                                android:text="Resolved"
                                android:textColor="#475569"
                                android:textSize="12sp"
                                android:clickable="true"
                                android:focusable="true" />

                        </LinearLayout>
                    </HorizontalScrollView>

                    <!-- Section Header: My Tickets & Count -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="My Tickets"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#0F172A" />

                        <TextView
                            android:id="@+id/tvTicketsTotalLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 tickets"
                            android:textSize="12sp"
                            android:textColor="#64748B" />
                    </LinearLayout>

                    <!-- Loading State Indicator -->
                    <ProgressBar
                        android:id="@+id/pbTicketsLoading"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="24dp"
                        android:visibility="gone" />

                    <!-- Empty State View -->
                    <LinearLayout
                        android:id="@+id/layoutEmptyState"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="32dp"
                        android:background="@drawable/bg_card_white"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/ic_support_lifebuoy"
                            android:tint="#94A3B8" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="No Tickets Found"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="#0F172A" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="You have no open support requests in this view. Need assistance? Create a ticket below."
                            android:textSize="12sp"
                            android:textColor="#64748B"
                            android:textAlignment="center" />

                        <Button
                            android:id="@+id/btnEmptyCreateTicket"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:layout_marginTop="16dp"
                            android:background="@drawable/bg_btn_primary"
                            android:text="Create New Ticket"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:textAllCaps="false"
                            android:paddingStart="20dp"
                            android:paddingEnd="20dp" />
                    </LinearLayout>

                    <!-- Tickets Container (Dynamic List) -->
                    <LinearLayout
                        android:id="@+id/containerTicketsList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <!-- ══════════════════════════════════════════════════════════
                         DIRECT ASSISTANCE CHANNELS CARD (REDESIGNED LUXURY CARD)
                         ══════════════════════════════════════════════════════════ -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:layout_marginBottom="28dp"
                        android:background="@drawable/bg_card_white"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <!-- Header with Title, Subtitle & Live Status Pill -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="14dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Direct Assistance Channels"
                                    android:textSize="15.5sp"
                                    android:textStyle="bold"
                                    android:textColor="#0F172A" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="Connect directly with our clinical technical desk"
                                    android:textSize="12sp"
                                    android:textColor="#64748B" />
                            </LinearLayout>

                            <!-- Live Status Indicator Pill -->
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_tag_emerald"
                                android:gravity="center_vertical"
                                android:paddingStart="8dp"
                                android:paddingEnd="10dp"
                                android:paddingTop="4dp"
                                android:paddingBottom="4dp">

                                <View
                                    android:layout_width="7dp"
                                    android:layout_height="7dp"
                                    android:background="@drawable/bg_status_wave_green"
                                    android:layout_marginEnd="5dp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="LIVE DESK"
                                    android:textColor="#059669"
                                    android:textSize="10.5sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Action 1: Priority Phone Line -->
                        <LinearLayout
                            android:id="@+id/btnCallSupport"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_interactive_row"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:paddingTop="11dp"
                            android:paddingBottom="11dp"
                            android:clickable="true"
                            android:focusable="true">

                            <FrameLayout
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:background="@drawable/bg_squircle_blue_soft">

                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_phone"
                                    android:tint="#2563EB"
                                    app:tint="#2563EB" />
                            </FrameLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:layout_marginStart="12dp"
                                android:layout_marginEnd="8dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Priority Technical Hotline"
                                    android:textSize="13.5sp"
                                    android:textColor="#0F172A"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="1.5dp"
                                    android:text="+91 98765 43210 • Toll-Free Emergency"
                                    android:textSize="11.5sp"
                                    android:textColor="#64748B" />
                            </LinearLayout>

                            <!-- Action Badge -->
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_tag_blue"
                                android:gravity="center_vertical"
                                android:paddingStart="9dp"
                                android:paddingEnd="7dp"
                                android:paddingTop="5dp"
                                android:paddingBottom="5dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="CALL"
                                    android:textSize="11sp"
                                    android:textColor="#2563EB"
                                    android:textStyle="bold" />

                                <ImageView
                                    android:layout_width="12dp"
                                    android:layout_height="12dp"
                                    android:layout_marginStart="3dp"
                                    android:src="@drawable/ic_chevron_right"
                                    android:tint="#2563EB"
                                    app:tint="#2563EB" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Action 2: WhatsApp Concierge -->
                        <LinearLayout
                            android:id="@+id/btnWhatsAppSupport"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_interactive_row"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:paddingTop="11dp"
                            android:paddingBottom="11dp"
                            android:layout_marginTop="8dp"
                            android:clickable="true"
                            android:focusable="true">

                            <FrameLayout
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:background="@drawable/bg_squircle_green_soft">

                                <ImageView
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_whatsapp_official"
                                    android:scaleType="fitCenter" />
                            </FrameLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:layout_marginStart="12dp"
                                android:layout_marginEnd="8dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="WhatsApp Concierge Desk"
                                    android:textSize="13.5sp"
                                    android:textColor="#0F172A"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="1.5dp"
                                    android:text="Instant chat, live reports &amp; media support"
                                    android:textSize="11.5sp"
                                    android:textColor="#64748B" />
                            </LinearLayout>

                            <!-- Action Badge -->
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_tag_emerald"
                                android:gravity="center_vertical"
                                android:paddingStart="9dp"
                                android:paddingEnd="7dp"
                                android:paddingTop="5dp"
                                android:paddingBottom="5dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="CHAT"
                                    android:textSize="11sp"
                                    android:textColor="#059669"
                                    android:textStyle="bold" />

                                <ImageView
                                    android:layout_width="12dp"
                                    android:layout_height="12dp"
                                    android:layout_marginStart="3dp"
                                    android:src="@drawable/ic_chevron_right"
                                    android:tint="#059669"
                                    app:tint="#059669" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Action 3: Official Support Desk -->
                        <LinearLayout
                            android:id="@+id/btnEmailSupport"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_interactive_row"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:paddingTop="11dp"
                            android:paddingBottom="11dp"
                            android:layout_marginTop="8dp"
                            android:clickable="true"
                            android:focusable="true">

                            <FrameLayout
