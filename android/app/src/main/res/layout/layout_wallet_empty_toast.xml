<?xml version="1.0" encoding="utf-8"?>
<!-- Floating Toast Layout for Empty Wallet Notification -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardWalletEmptyToast"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_wallet_empty_toast"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="14dp"
    android:paddingBottom="14dp"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:layout_marginTop="12dp"
    android:layout_marginBottom="12dp"
    android:elevation="8dp"
    android:clickable="true"
    android:focusable="true">

    <!-- Red Circle Badge with White ❌ Icon -->
    <FrameLayout
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/bg_pill_white"
        android:backgroundTint="#EF4444"
        android:layout_marginEnd="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="✕"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

    </FrameLayout>

    <!-- Message Body -->
    <TextView
        android:id="@+id/lblWalletToastMessage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="Wallet balance is empty. Paid actions like Patient Registration are currently locked. Please recharge."
        android:textSize="13.5sp"
        android:textStyle="bold"
        android:textColor="#0F172A"
        android:lineSpacingExtra="3dp" />

    <!-- Optional Quick Recharge Pill -->
    <TextView
        android:id="@+id/btnToastRecharge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_pill_white"
        android:backgroundTint="#EFF6FF"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:text="⚡ Top-up"
        android:textSize="11.5sp"
        android:textStyle="bold"
        android:textColor="#0D6EFD"
        android:visibility="gone" />

</LinearLayout>
