<?xml version="1.0" encoding="utf-8"?>
<!-- Modern Help & Support Popup Menu matching Profile Menu Aesthetic -->
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="250dp"
    android:layout_height="wrap_content"
    app:cardCornerRadius="20dp"
    app:cardElevation="14dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp"
        android:background="#FFFFFF">

        <!-- Top Header row: Lifebuoy icon + Help & Support title + subtitle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:paddingTop="6dp"
            android:paddingBottom="10dp">

            <!-- Support lifebuoy icon badge -->
            <FrameLayout
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_mod_icon_blue">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_support_lifebuoy"
                    android:tint="#2563EB"
                    app:tint="#2563EB" />

            </FrameLayout>

            <!-- Title and Subtitle -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="10dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Help &amp; Support"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#0F172A"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="24/7 Priority Support"
                    android:textSize="11sp"
                    android:textColor="#64748B"
                    android:singleLine="true"
                    android:ellipsize="end" />

            </LinearLayout>

        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="4dp"
            android:background="#F1F5F9" />

        <!-- Option 1: Priority Call -->
        <LinearLayout
            android:id="@+id/helpBtnCall"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="10dp"
            android:background="@drawable/bg_popup_item_ripple"
            android:clickable="true"
            android:focusable="true">

            <FrameLayout
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_mod_icon_blue">

                <ImageView
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_phone"
                    android:tint="#2563EB"
                    app:tint="#2563EB" />

            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Call Support"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#1E293B" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+91 8402010207"
                    android:textSize="10.5sp"
                    android:textColor="#64748B" />

            </LinearLayout>

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_chevron_right"
                android:tint="#94A3B8"
                app:tint="#94A3B8" />

        </LinearLayout>

        <!-- Option 2: WhatsApp Chat -->
        <LinearLayout
            android:id="@+id/helpBtnWhatsApp"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="10dp"
            android:layout_marginTop="2dp"
            android:background="@drawable/bg_popup_item_ripple"
            android:clickable="true"
            android:focusable="true">

            <FrameLayout
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_mod_icon_emerald">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_whatsapp"
                    android:tint="#16A34A"
                    app:tint="#16A34A" />

            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WhatsApp Chat"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#1E293B" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Instant assistance"
                    android:textSize="10.5sp"
                    android:textColor="#64748B" />

            </LinearLayout>

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_chevron_right"
                android:tint="#94A3B8"
                app:tint="#94A3B8" />

        </LinearLayout>

        <!-- Option 3: Email Support -->
        <LinearLayout
            android:id="@+id/helpBtnEmail"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="10dp"
            android:layout_marginTop="2dp"
            android:background="@drawable/bg_popup_item_ripple"
            android:clickable="true"
            android:focusable="true">

            <FrameLayout
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_mod_icon_purple">

                <ImageView
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_envelope"
                    android:tint="#7C3AED"
                    app:tint="#7C3AED" />

            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Email Support"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#1E293B" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="support@patholab.cloud"
                    android:textSize="10.5sp"
                    android:textColor="#64748B"
                    android:singleLine="true"
                    android:ellipsize="end" />

            </LinearLayout>

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_chevron_right"
                android:tint="#94A3B8"
                app:tint="#94A3B8" />

        </LinearLayout>

        <!-- Option 4: Support Portal -->
        <LinearLayout
            android:id="@+id/helpBtnDashboard"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="10dp"
            android:layout_marginTop="2dp"
            android:background="@drawable/bg_popup_item_ripple"
            android:clickable="true"
            android:focusable="true">

            <FrameLayout
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_mod_icon_amber">

                <ImageView
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_external_link"
                    android:tint="#D97706"
                    app:tint="#D97706" />

            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Support Portal"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#1E293B" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Guides &amp; FAQs"
                    android:textSize="10.5sp"
                    android:textColor="#64748B" />

            </LinearLayout>

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_chevron_right"
                android:tint="#94A3B8"
                app:tint="#94A3B8" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
