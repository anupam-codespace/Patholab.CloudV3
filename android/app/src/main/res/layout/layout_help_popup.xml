<?xml version="1.0" encoding="utf-8"?>
<!-- Ultra-Premium Customer Support Concierge Card (Android) -->
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="285dp"
    android:layout_height="wrap_content"
    app:cardCornerRadius="22dp"
    app:cardElevation="18dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardPreventCornerOverlap="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="12dp"
        android:paddingBottom="10dp"
        android:background="#FFFFFF">

        <!-- Top Header: Customer Care Concierge with Online Pulse -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:paddingTop="2dp"
            android:paddingBottom="8dp">

            <!-- Modern Headset Icon (Replacing Nautical Lifebuoy) -->
            <FrameLayout
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_mod_icon_indigo">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_headset_modern"
                    android:tint="#4F46E5"
                    app:tint="#4F46E5" />

            </FrameLayout>

            <!-- Title & Online Status Badge -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Support Desk"
                        android:textSize="14.5sp"
                        android:textStyle="bold"
                        android:textColor="#0F172A"
                        android:singleLine="true" />

                    <!-- Live Online Status Pill -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_status_ready"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:paddingTop="1.5dp"
                        android:paddingBottom="1.5dp"
                        android:text="● Online"
                        android:textSize="9.5sp"
                        android:textStyle="bold"
                        android:textColor="#059669" />

                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="24/7 Priority Laboratory Concierge"
                    android:textSize="11sp"
                    android:textColor="#64748B"
                    android:singleLine="true" />

            </LinearLayout>

        </LinearLayout>

        <!-- Elegant Subtle Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="6dp"
            android:background="#F1F5F9" />

        <!-- 1. Direct Phone Call Option -->
        <LinearLayout
            android:id="@+id/helpBtnCall"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="10dp"
            android:background="@drawable/bg_popup_item_ripple"
            android:clickable="true"
            android:focusable="true">

            <FrameLayout
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_mod_icon_blue">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_phone_call_modern"
                    android:tint="#2563EB"
                    app:tint="#2563EB" />

            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Call Support"
                    android:textSize="13.5sp"
                    android:textStyle="bold"
                    android:textColor="#0F172A" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+91 8402010207"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#2563EB" />

            </LinearLayout>

            <!-- Toll-Free Tag + Chevron -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_status_processing"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:text="Direct"
                android:textSize="9.5sp"
                android:textStyle="bold"
                android:textColor="#2563EB"
                android:layout_marginEnd="6dp" />

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_chevron_right"
                android:tint="#94A3B8"
                app:tint="#94A3B8" />

        </LinearLayout>

        <!-- 2. Authentic WhatsApp Chat Option -->
        <LinearLayout
            android:id="@+id/helpBtnWhatsApp"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="10dp"
            android:layout_marginTop="2dp"
            android:background="@drawable/bg_popup_item_ripple"
            android:clickable="true"
            android:focusable="true">

            <!-- Official WhatsApp Logo -->
            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_whatsapp_official"
                android:scaleType="fitCenter" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WhatsApp Support"
                    android:textSize="13.5sp"
                    android:textStyle="bold"
                    android:textColor="#0F172A" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Instant assistance on chat"
                    android:textSize="11sp"
                    android:textColor="#64748B" />

            </LinearLayout>

            <!-- Fastest Pill + Chevron -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_status_ready"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:text="Fastest"
                android:textSize="9.5sp"
                android:textStyle="bold"
                android:textColor="#16A34A"
                android:layout_marginEnd="6dp" />

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_chevron_right"
                android:tint="#94A3B8"
                app:tint="#94A3B8" />

        </LinearLayout>

        <!-- 3. Official Gmail / Email Option -->
        <LinearLayout
            android:id="@+id/helpBtnEmail"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="10dp"
            android:layout_marginTop="2dp"
            android:background="@drawable/bg_popup_item_ripple"
            android:clickable="true"
            android:focusable="true">

            <!-- Official Google Gmail Logo -->
            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_gmail_official"
                android:scaleType="fitCenter" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Email Support"
                    android:textSize="13.5sp"
                    android:textStyle="bold"
                    android:textColor="#0F172A" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="support@patholab.cloud"
                    android:textSize="11sp"
                    android:textColor="#64748B"
                    android:singleLine="true"
                    android:ellipsize="end" />

            </LinearLayout>

            <!-- Official Tag + Chevron -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_setting_item"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:text="Official"
                android:textSize="9.5sp"
                android:textStyle="bold"
                android:textColor="#64748B"
                android:layout_marginEnd="6dp" />

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_chevron_right"
                android:tint="#94A3B8"
                app:tint="#94A3B8" />

        </LinearLayout>

        <!-- 4. Support Tickets & Helpdesk (Distinct, non-repetitive) -->
        <LinearLayout
            android:id="@+id/helpBtnDashboard"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="10dp"
            android:layout_marginTop="2dp"
            android:background="@drawable/bg_popup_item_ripple"
            android:clickable="true"
            android:focusable="true">

            <FrameLayout
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_mod_icon_indigo">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_ticket_portal"
                    android:tint="#4F46E5"
                    app:tint="#4F46E5" />

            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Support Tickets"
                    android:textSize="13.5sp"
                    android:textStyle="bold"
                    android:textColor="#0F172A" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Track issues &amp; knowledge base"
                    android:textSize="11sp"
                    android:textColor="#64748B" />

            </LinearLayout>

            <!-- Portal Tag + Chevron -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_mod_icon_indigo"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:text="Portal"
                android:textSize="9.5sp"
                android:textStyle="bold"
                android:textColor="#4F46E5"
                android:layout_marginEnd="6dp" />

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_chevron_right"
                android:tint="#94A3B8"
                app:tint="#94A3B8" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
