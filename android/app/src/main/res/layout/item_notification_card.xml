<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardNotificationRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#FFFFFF"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:id="@+id/containerNotificationInner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Top Row: Icon, Title, Time, Unread Dot -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="top">

            <!-- Category Icon Badge -->
            <FrameLayout
                android:id="@+id/containerCategoryIcon"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_circle_icon_sky">

                <ImageView
                    android:id="@+id/imgCategoryIcon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_testtube"
                    app:tint="#0D6EFD" />
            </FrameLayout>

            <!-- Title & Sub-header -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/lblNotificationTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Notification Title"
                        android:textColor="#0F172A"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <!-- Unread Indicator Dot -->
                    <View
                        android:id="@+id/dotUnreadIndicator"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_notif_dot"
                        android:visibility="visible" />
                </LinearLayout>

                <TextView
                    android:id="@+id/lblNotificationTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="5m ago"
                    android:textColor="#94A3B8"
                    android:textSize="11sp" />
            </LinearLayout>

        </LinearLayout>

        <!-- Notification Message Body -->
        <TextView
            android:id="@+id/lblNotificationMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="2dp"
            android:text="Notification description content here..."
            android:textColor="#334155"
            android:textSize="13sp" />

        <!-- Rich Image Attachment (Optional) -->
        <ImageView
            android:id="@+id/imgNotificationAttachment"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:layout_marginTop="10dp"
            android:scaleType="centerCrop"
            android:background="#F1F5F9"
            android:visibility="gone" />

        <!-- Link Button (Optional) -->
        <LinearLayout
            android:id="@+id/containerNotificationLink"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_pill_glass"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/lblLinkActionText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="View Details →"
                android:textColor="#0D6EFD"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
