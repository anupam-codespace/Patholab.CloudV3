<?xml version="1.0" encoding="utf-8"?>
<!-- ══ Clean & Professional Financial Analytics Console (Android) ══ -->
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipeRefreshDashboard"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ══════════════════════════════════════════════════════════════
                 HEADER SECTION — Deep Sapphire Gradient
                 ══════════════════════════════════════════════════════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_billing_header"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="24dp"
                android:paddingBottom="20dp">

                <!-- Top Action Bar -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="14dp">

                    <FrameLayout
                        android:id="@+id/btnDashboardBack"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_glass_back_btn"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_back_arrow"
                            android:tint="#FFFFFF"
                            app:tint="#FFFFFF" />

                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Financial Analytics"
                            android:textSize="18.5sp"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF" />

                        <TextView
                            android:id="@+id/lblDashboardUserRoleLab"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:text="Overview of your enterprise's financial health"
                            android:textSize="11.5sp"
                            android:textColor="#93C5FD" />

                    </LinearLayout>

                    <FrameLayout
                        android:id="@+id/btnDashboardRefresh"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_glass_back_btn"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:id="@+id/imgDashboardRefreshIcon"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_refresh_cw"
                            android:tint="#FFFFFF"
                            app:tint="#FFFFFF" />

                    </FrameLayout>

                </LinearLayout>

            </LinearLayout>

            <!-- ══════════════════════════════════════════════════════════════
                 MAIN BODY CONTENT
                 ══════════════════════════════════════════════════════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="16dp"
                android:paddingBottom="40dp">

                <!-- ── 1. PRIMARY METRICS BENTO GRID (Row 1: Revenue & Expenses) ── -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <!-- Total Revenue Card -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_dashboard_bento"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:elevation="1dp"
                        android:layout_marginEnd="6dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TOTAL REVENUE"
                            android:textSize="10.5sp"
                            android:textStyle="bold"
                            android:textColor="#64748B"
                            android:letterSpacing="0.05" />

                        <TextView
                            android:id="@+id/lblDashTotalRevenue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="₹0"
                            android:textSize="22sp"
                            android:fontFamily="sans-serif-black"
                            android:textStyle="bold"
                            android:textColor="#059669" />

                    </LinearLayout>

                    <!-- Total Expenses Card -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_dashboard_bento"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:elevation="1dp"
                        android:layout_marginStart="6dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TOTAL EXPENSES"
                            android:textSize="10.5sp"
                            android:textStyle="bold"
                            android:textColor="#64748B"
                            android:letterSpacing="0.05" />

                        <TextView
                            android:id="@+id/lblDashTotalExpenses"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="₹0"
                            android:textSize="22sp"
                            android:fontFamily="sans-serif-black"
                            android:textStyle="bold"
                            android:textColor="#E11D48" />

                    </LinearLayout>

                </LinearLayout>

                <!-- ── 2. PRIMARY METRICS BENTO GRID (Row 2: Net Profit & Pending Collections) ── -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="18dp">

                    <!-- Net Profit Card -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_dashboard_bento"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:elevation="1dp"
                        android:layout_marginEnd="6dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="NET PROFIT"
                            android:textSize="10.5sp"
                            android:textStyle="bold"
                            android:textColor="#64748B"
                            android:letterSpacing="0.05" />

                        <TextView
                            android:id="@+id/lblDashNetProfit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="₹0"
                            android:textSize="22sp"
                            android:fontFamily="sans-serif-black"
                            android:textStyle="bold"
                            android:textColor="#0D6EFD" />

                    </LinearLayout>

                    <!-- Pending Collections Card -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_dashboard_bento"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:elevation="1dp"
                        android:layout_marginStart="6dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="PENDING DUE"
                            android:textSize="10.5sp"
                            android:textStyle="bold"
                            android:textColor="#64748B"
                            android:letterSpacing="0.05" />

                        <TextView
                            android:id="@+id/lblDashPendingDue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="₹0"
                            android:textSize="22sp"
                            android:fontFamily="sans-serif-black"
                            android:textStyle="bold"
                            android:textColor="#D97706" />

                    </LinearLayout>

                </LinearLayout>

                <!-- ── 4. DETAILED LEDGERS (Interactive Tabs for Invoices & Expenses) ── -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <!-- Tab Recent Invoices -->
                    <TextView
                        android:id="@+id/tabLedgerInvoices"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="Recent Invoices"
                        android:textSize="12.5sp"
                        android:textStyle="bold"
                        android:textColor="#0D6EFD"
                        android:background="@drawable/bg_chip_toggle_active"
                        android:layout_marginEnd="6dp"
                        android:clickable="true"
                        android:focusable="true" />

                    <!-- Tab Recent Expenses -->
                    <TextView
                        android:id="@+id/tabLedgerExpenses"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="Recent Expenses"
                        android:textSize="12.5sp"
                        android:textStyle="bold"
                        android:textColor="#64748B"
                        android:background="@drawable/bg_chip_toggle_inactive"
                        android:layout_marginStart="6dp"
                        android:clickable="true"
                        android:focusable="true" />

                </LinearLayout>

                <!-- Dynamic Ledger List Container -->
                <LinearLayout
                    android:id="@+id/containerLedgerItems"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <!-- Empty State Message -->
                <TextView
                    android:id="@+id/lblLedgerEmptyState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="No records found"
                    android:textSize="13sp"
                    android:textColor="#94A3B8"
                    android:paddingTop="24dp"
                    android:paddingBottom="24dp"
                    android:visibility="gone" />

                <!-- Quick Action: Full Invoices Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnViewAllInvoices"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="16dp"
                    android:text="View Full Invoices &amp; Billing"
                    android:textSize="14.5sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#0D6EFD"
                    app:cornerRadius="14dp"
                    app:elevation="2dp"
                    app:rippleColor="#33FFFFFF"
                    android:letterSpacing="0.01"
                    android:textAllCaps="false" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
