<?xml version="1.0" encoding="utf-8"?>
<!-- ══ Clean & Professional Financial Analytics Console (Android) ══ -->
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipeRefreshDashboard"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ══════════════════════════════════════════════════════════════
                 HEADER SECTION — Deep Sapphire Gradient
                 ══════════════════════════════════════════════════════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_home_header"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingTop="18dp"
                android:paddingBottom="20dp">

                <!-- Top Row: Back + Title + Refresh Button -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <FrameLayout
                        android:id="@+id/btnDashboardBack"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_glass_back_btn"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_back_arrow"
                            android:tint="#FFFFFF"
                            app:tint="#FFFFFF" />

                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Financial Analytics"
                            android:textSize="19sp"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF"
                            android:letterSpacing="-0.01" />

                        <TextView
                            android:id="@+id/lblDashboardUserRoleLab"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Lab Owner • Care Diagnostic Hub"
                            android:textSize="11.5sp"
                            android:textColor="#C7DFFF" />

                    </LinearLayout>

                    <!-- Refresh Button -->
                    <FrameLayout
                        android:id="@+id/btnRefreshDashboard"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_glass_back_btn"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:id="@+id/imgRefreshIcon"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_refresh_cw"
                            android:tint="#FFFFFF"
                            app:tint="#FFFFFF" />

                    </FrameLayout>

                </LinearLayout>

                <!-- Live Logged-in User Identity Card -->
                <LinearLayout
                    android:id="@+id/cardDashboardUserProfile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_timeframe_sapphire_pill"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp">

                    <!-- Avatar with Initial -->
                    <FrameLayout
                        android:id="@+id/containerDashboardAvatar"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_bell_btn">

                        <TextView
                            android:id="@+id/lblDashboardAvatarInitial"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="U"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                    </FrameLayout>

                    <!-- User Name & Email & Lab Details -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="10dp">

                        <TextView
                            android:id="@+id/lblDashboardUserName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="User"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/lblDashboardUserEmail"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:text="user@patholab.cloud"
                            android:textColor="#C7DFFF"
                            android:textSize="11sp" />

                    </LinearLayout>

                    <!-- Active Workspace Badge -->
                    <TextView
                        android:id="@+id/lblDashboardLabBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_emerald_glass"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp"
                        android:text="Live Sync"
                        android:textColor="#34D399"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- Secondary Header Controls: Timeframe Selector Pill + Wallet Era Badge -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- Frosted Sapphire Timeframe Pill -->
                    <LinearLayout
                        android:id="@+id/btnTimeframePill"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_timeframe_sapphire_pill"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_marginEnd="8dp">

                        <ImageView
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:src="@drawable/ic_calendar"
                            android:tint="#CBD5E1"
                            app:tint="#CBD5E1" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="7dp"
                            android:text="TIMEFRAME:"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="#CBD5E1"
                            android:letterSpacing="0.06" />

                        <TextView
                            android:id="@+id/lblTimeframeSelected"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:text="All Time"
                            android:textSize="11.5sp"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@drawable/ic_chevron_right"
                            android:rotation="90"
                            android:tint="#FFFFFF"
                            app:tint="#FFFFFF" />

                    </LinearLayout>

                    <!-- Wallet Era Status Pill -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_badge_emerald_glass"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp">

                        <View
                            android:layout_width="6dp"
                            android:layout_height="6dp"
                            android:background="@drawable/shape_dot_emerald"
                            android:layout_marginEnd="6dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Wallet Active"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <!-- ══════════════════════════════════════════════════════════════
                 MAIN BODY CONTENT
                 ══════════════════════════════════════════════════════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="16dp"
                android:paddingBottom="36dp">

                <!-- ── 1. PRIMARY METRICS BENTO GRID (Row 1: Revenue & Expenses) ── -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <!-- Total Revenue Card -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_dashboard_bento"
                        android:orientation="vertical"
                        android:padding="14dp"
                        android:elevation="1dp"
                        android:layout_marginEnd="6dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TOTAL REVENUE"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="#64748B"
                            android:letterSpacing="0.05" />

                        <TextView
                            android:id="@+id/lblDashTotalRevenue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="₹0"
                            android:textSize="20sp"
                            android:fontFamily="sans-serif-black"
                            android:textStyle="bold"
                            android:textColor="#059669" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Non-cancelled invoices"
                            android:textSize="9.5sp"
                            android:textColor="#94A3B8" />

                    </LinearLayout>

                    <!-- Total Expenses Card -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_dashboard_bento"
                        android:orientation="vertical"
                        android:padding="14dp"
                        android:elevation="1dp"
                        android:layout_marginStart="6dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TOTAL EXPENSES"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="#64748B"
                            android:letterSpacing="0.05" />

                        <TextView
                            android:id="@+id/lblDashTotalExpenses"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="₹0"
                            android:textSize="20sp"
                            android:fontFamily="sans-serif-black"
                            android:textStyle="bold"
                            android:textColor="#E11D48" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Operational &amp; lab costs"
                            android:textSize="9.5sp"
                            android:textColor="#94A3B8" />

                    </LinearLayout>

                </LinearLayout>

                <!-- ── 2. PRIMARY METRICS BENTO GRID (Row 2: Net Profit & Pending Collections) ── -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <!-- Net Profit Card -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_dashboard_bento"
                        android:orientation="vertical"
                        android:padding="14dp"
                        android:elevation="1dp"
                        android:layout_marginEnd="6dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="NET PROFIT"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:textColor="#64748B"
                                android:letterSpacing="0.05" />

                            <TextView
                                android:id="@+id/lblDashProfitMargin"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0.0%"
                                android:textSize="9.5sp"
                                android:textStyle="bold"
                                android:textColor="#059669"
                                android:background="@drawable/bg_tag_emerald"
                                android:paddingStart="5dp"
                                android:paddingEnd="5dp"
                                android:paddingTop="2dp"
                                android:paddingBottom="2dp" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/lblDashNetProfit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="₹0"
                            android:textSize="20sp"
                            android:fontFamily="sans-serif-black"
                            android:textStyle="bold"
                            android:textColor="#0D6EFD" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Revenue minus expenses"
                            android:textSize="9.5sp"
                            android:textColor="#94A3B8" />

                    </LinearLayout>

                    <!-- Pending Collections Card -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_dashboard_bento"
                        android:orientation="vertical"
                        android:padding="14dp"
                        android:elevation="1dp"
                        android:layout_marginStart="6dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="PENDING DUE"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="#64748B"
                            android:letterSpacing="0.05" />

                        <TextView
                            android:id="@+id/lblDashPendingDue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="₹0"
                            android:textSize="20sp"
                            android:fontFamily="sans-serif-black"
                            android:textStyle="bold"
                            android:textColor="#D97706" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Uncollected invoices"
                            android:textSize="9.5sp"
                            android:textColor="#94A3B8" />

                    </LinearLayout>

                </LinearLayout>



                <!-- Operational Counts Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="20dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_dashboard_bento"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="10dp"
                        android:layout_marginEnd="5dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Invoices Generated"
                            android:textSize="11.5sp"
                            android:textColor="#475569" />

                        <TextView
                            android:id="@+id/lblDashInvoicesCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#0D6EFD" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_dashboard_bento"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="10dp"
                        android:layout_marginStart="5dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Patients Billed"
                            android:textSize="11.5sp"
                            android:textColor="#475569" />

                        <TextView
                            android:id="@+id/lblDashPatientsCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#059669" />

                    </LinearLayout>

                </LinearLayout>

                <!-- ── 4. DETAILED LEDGERS (Interactive Tabs for Invoices & Expenses) ── -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <!-- Tab Recent Invoices -->
                    <TextView
                        android:id="@+id/tabLedgerInvoices"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="Recent Invoices (0)"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#0D6EFD"
                        android:background="@drawable/bg_chip_toggle_active"
                        android:layout_marginEnd="6dp"
                        android:clickable="true"
                        android:focusable="true" />

                    <!-- Tab Recent Expenses -->
                    <TextView
                        android:id="@+id/tabLedgerExpenses"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="Recent Expenses (0)"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#64748B"
                        android:background="@drawable/bg_chip_toggle_inactive"
                        android:layout_marginStart="6dp"
                        android:clickable="true"
                        android:focusable="true" />

                </LinearLayout>

                <!-- Dynamic Ledger List Container -->
                <LinearLayout
                    android:id="@+id/containerLedgerItems"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <!-- Empty State Message -->
                <TextView
                    android:id="@+id/lblLedgerEmptyState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="No records found"
                    android:textSize="13sp"
                    android:textColor="#94A3B8"
                    android:paddingTop="24dp"
                    android:paddingBottom="24dp"
                    android:visibility="gone" />

                <!-- Quick Actions Row: Log Expense + View Billing -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="16dp">

                    <!-- + Log Expense Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnLogExpense"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:text="+ Log Expense"
                        android:textSize="13.5sp"
                        android:textStyle="bold"
                        android:textColor="#0D6EFD"
                        android:backgroundTint="#EFF6FF"
                        app:strokeColor="#0D6EFD"
                        app:strokeWidth="1dp"
                        app:cornerRadius="12dp"
                        android:layout_marginEnd="6dp"
                        android:textAllCaps="false" />

                    <!-- View Full Billing Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnViewAllInvoices"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:text="All Invoices"
                        android:textSize="13.5sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#0D6EFD"
                        app:cornerRadius="12dp"
                        android:layout_marginStart="6dp"
                        android:textAllCaps="false" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
