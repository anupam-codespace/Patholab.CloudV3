<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card_white"
    android:padding="16dp"
    android:layout_marginBottom="10dp"
    android:clickable="true"
    android:focusable="true">

    <!-- Row 1: Ticket Number + Priority Chip + Status Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Ticket Number Badge -->
        <TextView
            android:id="@+id/tvTicketNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_ticket_number"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="TKT-1001"
            android:fontFamily="monospace"
            android:textColor="#334155"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Category Chip -->
        <TextView
            android:id="@+id/tvTicketCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_ticket_number"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="TECHNICAL"
            android:textColor="#475569"
            android:textSize="10sp"
            android:textStyle="bold" />

        <!-- Priority Chip -->
        <TextView
            android:id="@+id/tvTicketPriority"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_ticket_number"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="HIGH"
            android:textColor="#D97706"
            android:textSize="10sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Status Badge -->
        <TextView
            android:id="@+id/tvTicketStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_ticket_badge_open"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="OPEN"
            android:textColor="#DC2626"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.04" />
    </LinearLayout>

    <!-- Row 2: Subject -->
    <TextView
        android:id="@+id/tvTicketSubject"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Unable to generate automated PDF patient report"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#0F172A" />

    <!-- Row 3: Description preview -->
    <TextView
        android:id="@+id/tvTicketDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="When clicking the print button on patient page, the system throws an error dialog..."
        android:textSize="12sp"
        android:textColor="#64748B"
        android:maxLines="2"
        android:ellipsize="end"
        android:lineSpacingExtra="2dp" />

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#F1F5F9"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="10dp" />

    <!-- Row 4: Meta Footer (Date + Messages Count + Chevron) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Date -->
        <ImageView
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@drawable/ic_clock_outline"
            android:tint="#94A3B8" />

        <TextView
            android:id="@+id/tvTicketDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="2 hrs ago"
            android:textSize="11sp"
            android:textColor="#94A3B8" />

        <!-- Messages Count -->
        <ImageView
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@drawable/ic_chat_bubble"
            android:tint="#94A3B8"
            android:layout_marginStart="14dp" />

        <TextView
            android:id="@+id/tvTicketMessagesCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="3 messages"
            android:textSize="11sp"
            android:textColor="#94A3B8" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="View Ticket"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#2563EB"
            android:layout_marginEnd="4dp" />

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_chevron_right"
            android:tint="#2563EB" />
    </LinearLayout>

</LinearLayout>
