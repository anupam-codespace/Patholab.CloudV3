<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:scrollbars="none">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- 1. DASHBOARD SKELETON (default) -->
        <LinearLayout
            android:id="@+id/skeletonDashboard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible">

            <!-- Top Welcome Header Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_skeleton_card">
                
                <View
                    android:layout_width="200dp"
                    android:layout_height="22dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_skeleton_line" />
                
                <View
                    android:layout_width="120dp"
                    android:layout_height="14dp"
                    android:background="@drawable/bg_skeleton_line" />
            </LinearLayout>

            <!-- KPI Grid -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">
                
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="100dp"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_skeleton_card">
                    <View
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginBottom="12dp"
                        android:background="@drawable/bg_skeleton_circle" />
                    <View
                        android:layout_width="80dp"
                        android:layout_height="16dp"
                        android:background="@drawable/bg_skeleton_line" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="100dp"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_skeleton_card">
                    <View
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginBottom="12dp"
                        android:background="@drawable/bg_skeleton_circle" />
                    <View
                        android:layout_width="60dp"
                        android:layout_height="16dp"
                        android:background="@drawable/bg_skeleton_line" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">
                
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="100dp"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_skeleton_card">
                    <View
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginBottom="12dp"
                        android:background="@drawable/bg_skeleton_circle" />
                    <View
                        android:layout_width="70dp"
                        android:layout_height="16dp"
                        android:background="@drawable/bg_skeleton_line" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="100dp"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_skeleton_card">
                    <View
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginBottom="12dp"
                        android:background="@drawable/bg_skeleton_circle" />
                    <View
                        android:layout_width="90dp"
                        android:layout_height="16dp"
                        android:background="@drawable/bg_skeleton_line" />
                </LinearLayout>
            </LinearLayout>

            <!-- Chart Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_skeleton_card">
                <View
                    android:layout_width="140dp"
                    android:layout_height="18dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_skeleton_line" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="bottom"
                    android:paddingBottom="8dp">
                    <View android:layout_width="0dp" android:layout_weight="1" android:layout_height="80dp" android:layout_margin="4dp" android:background="@drawable/bg_skeleton_line" />
                    <View android:layout_width="0dp" android:layout_weight="1" android:layout_height="120dp" android:layout_margin="4dp" android:background="@drawable/bg_skeleton_line" />
                    <View android:layout_width="0dp" android:layout_weight="1" android:layout_height="60dp" android:layout_margin="4dp" android:background="@drawable/bg_skeleton_line" />
                    <View android:layout_width="0dp" android:layout_weight="1" android:layout_height="140dp" android:layout_margin="4dp" android:background="@drawable/bg_skeleton_line" />
                    <View android:layout_width="0dp" android:layout_weight="1" android:layout_height="100dp" android:layout_margin="4dp" android:background="@drawable/bg_skeleton_line" />
                    <View android:layout_width="0dp" android:layout_weight="1" android:layout_height="160dp" android:layout_margin="4dp" android:background="@drawable/bg_skeleton_line" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- 2. LIST/TABLE SKELETON (Patients, Categories, Billing, Reports) -->
        <LinearLayout
            android:id="@+id/skeletonList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Filter / Search Row Placeholder -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp"
                android:gravity="center_vertical">
                <View
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="44dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_skeleton_card" />
                <View
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_skeleton_card" />
            </LinearLayout>

            <!-- Table Rows -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_skeleton_card"
                android:padding="16dp">
                
                <!-- Repeat list row 6 times -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="18dp">
                    <View android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/bg_skeleton_circle" />
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="12dp" android:layout_gravity="center_vertical">
                        <View android:layout_width="140dp" android:layout_height="14dp" android:layout_marginBottom="6dp" android:background="@drawable/bg_skeleton_line" />
                        <View android:layout_width="90dp" android:layout_height="10dp" android:background="@drawable/bg_skeleton_line" />
                    </LinearLayout>
                    <View android:layout_width="60dp" android:layout_height="20dp" android:layout_gravity="center_vertical" android:background="@drawable/bg_skeleton_line" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="18dp">
                    <View android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/bg_skeleton_circle" />
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="12dp" android:layout_gravity="center_vertical">
                        <View android:layout_width="180dp" android:layout_height="14dp" android:layout_marginBottom="6dp" android:background="@drawable/bg_skeleton_line" />
                        <View android:layout_width="110dp" android:layout_height="10dp" android:background="@drawable/bg_skeleton_line" />
                    </LinearLayout>
                    <View android:layout_width="60dp" android:layout_height="20dp" android:layout_gravity="center_vertical" android:background="@drawable/bg_skeleton_line" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="18dp">
                    <View android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/bg_skeleton_circle" />
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="12dp" android:layout_gravity="center_vertical">
                        <View android:layout_width="120dp" android:layout_height="14dp" android:layout_marginBottom="6dp" android:background="@drawable/bg_skeleton_line" />
                        <View android:layout_width="70dp" android:layout_height="10dp" android:background="@drawable/bg_skeleton_line" />
                    </LinearLayout>
                    <View android:layout_width="60dp" android:layout_height="20dp" android:layout_gravity="center_vertical" android:background="@drawable/bg_skeleton_line" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="18dp">
                    <View android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/bg_skeleton_circle" />
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="12dp" android:layout_gravity="center_vertical">
                        <View android:layout_width="160dp" android:layout_height="14dp" android:layout_marginBottom="6dp" android:background="@drawable/bg_skeleton_line" />
                        <View android:layout_width="100dp" android:layout_height="10dp" android:background="@drawable/bg_skeleton_line" />
                    </LinearLayout>
                    <View android:layout_width="60dp" android:layout_height="20dp" android:layout_gravity="center_vertical" android:background="@drawable/bg_skeleton_line" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="18dp">
                    <View android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/bg_skeleton_circle" />
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="12dp" android:layout_gravity="center_vertical">
                        <View android:layout_width="110dp" android:layout_height="14dp" android:layout_marginBottom="6dp" android:background="@drawable/bg_skeleton_line" />
                        <View android:layout_width="80dp" android:layout_height="10dp" android:background="@drawable/bg_skeleton_line" />
                    </LinearLayout>
                    <View android:layout_width="60dp" android:layout_height="20dp" android:layout_gravity="center_vertical" android:background="@drawable/bg_skeleton_line" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <View android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/bg_skeleton_circle" />
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="12dp" android:layout_gravity="center_vertical">
                        <View android:layout_width="150dp" android:layout_height="14dp" android:layout_marginBottom="6dp" android:background="@drawable/bg_skeleton_line" />
                        <View android:layout_width="95dp" android:layout_height="10dp" android:background="@drawable/bg_skeleton_line" />
                    </LinearLayout>
                    <View android:layout_width="60dp" android:layout_height="20dp" android:layout_gravity="center_vertical" android:background="@drawable/bg_skeleton_line" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- 3. FORM SKELETON (New Registration, Settings editing) -->
        <LinearLayout
            android:id="@+id/skeletonForm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Card wrapper -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_skeleton_card"
                android:padding="20dp">

                <View
                    android:layout_width="160dp"
                    android:layout_height="20dp"
                    android:layout_marginBottom="24dp"
                    android:background="@drawable/bg_skeleton_line" />

                <!-- Input group 1 -->
                <View
                    android:layout_width="100dp"
                    android:layout_height="12dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_skeleton_line" />
                <View
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_skeleton_line" />

                <!-- Input group 2 -->
                <View
                    android:layout_width="80dp"
                    android:layout_height="12dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_skeleton_line" />
                <View
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_skeleton_line" />

                <!-- Input group 3 -->
                <View
                    android:layout_width="120dp"
                    android:layout_height="12dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_skeleton_line" />
                <View
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginBottom="24dp"
                    android:background="@drawable/bg_skeleton_line" />

                <!-- Form Action Buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="end">
                    <View
                        android:layout_width="90dp"
                        android:layout_height="38dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/bg_skeleton_line" />
                    <View
                        android:layout_width="120dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_skeleton_line" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- 4. GRID SKELETON (Alternative Dashboard/Analytics) -->
        <LinearLayout
            android:id="@+id/skeletonGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <View
                android:layout_width="160dp"
                android:layout_height="22dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_skeleton_line" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">
                
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="140dp"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_skeleton_card">
                    <View android:layout_width="40dp" android:layout_height="40dp" android:layout_marginBottom="16dp" android:background="@drawable/bg_skeleton_circle" />
                    <View android:layout_width="80dp" android:layout_height="16dp" android:layout_marginBottom="8dp" android:background="@drawable/bg_skeleton_line" />
                    <View android:layout_width="50dp" android:layout_height="12dp" android:background="@drawable/bg_skeleton_line" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="140dp"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_skeleton_card">
                    <View android:layout_width="40dp" android:layout_height="40dp" android:layout_marginBottom="16dp" android:background="@drawable/bg_skeleton_circle" />
                    <View android:layout_width="90dp" android:layout_height="16dp" android:layout_marginBottom="8dp" android:background="@drawable/bg_skeleton_line" />
                    <View android:layout_width="60dp" android:layout_height="12dp" android:background="@drawable/bg_skeleton_line" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">
                
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="140dp"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_skeleton_card">
                    <View android:layout_width="40dp" android:layout_height="40dp" android:layout_marginBottom="16dp" android:background="@drawable/bg_skeleton_circle" />
                    <View android:layout_width="70dp" android:layout_height="16dp" android:layout_marginBottom="8dp" android:background="@drawable/bg_skeleton_line" />
                    <View android:layout_width="40dp" android:layout_height="12dp" android:background="@drawable/bg_skeleton_line" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="140dp"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_skeleton_card">
                    <View android:layout_width="40dp" android:layout_height="40dp" android:layout_marginBottom="16dp" android:background="@drawable/bg_skeleton_circle" />
                    <View android:layout_width="85dp" android:layout_height="16dp" android:layout_marginBottom="8dp" android:background="@drawable/bg_skeleton_line" />
                    <View android:layout_width="55dp" android:layout_height="12dp" android:background="@drawable/bg_skeleton_line" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- 5. DETAIL SKELETON (Alternative Profile/Details view) -->
        <LinearLayout
            android:id="@+id/skeletonDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Large Top Profile Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="20dp"
                android:layout_marginBottom="16dp"
                android:gravity="center_vertical"
                android:background="@drawable/bg_skeleton_card">
                
                <View
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:background="@drawable/bg_skeleton_circle" />
                
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="16dp">
                    <View
                        android:layout_width="140dp"
                        android:layout_height="18dp"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/bg_skeleton_line" />
                    <View
                        android:layout_width="90dp"
                        android:layout_height="12dp"
                        android:background="@drawable/bg_skeleton_line" />
                </LinearLayout>
            </LinearLayout>

            <!-- Detailed List rows -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_skeleton_card"
                android:padding="16dp">
                
                <View android:layout_width="120dp" android:layout_height="16dp" android:layout_marginBottom="16dp" android:background="@drawable/bg_skeleton_line" />

                <!-- Details Rows -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginBottom="16dp">
                    <View android:layout_width="80dp" android:layout_height="12dp" android:layout_marginBottom="6dp" android:background="@drawable/bg_skeleton_line" />
                    <View android:layout_width="match_parent" android:layout_height="16dp" android:background="@drawable/bg_skeleton_line" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginBottom="16dp">
                    <View android:layout_width="100dp" android:layout_height="12dp" android:layout_marginBottom="6dp" android:background="@drawable/bg_skeleton_line" />
                    <View android:layout_width="match_parent" android:layout_height="16dp" android:background="@drawable/bg_skeleton_line" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <View android:layout_width="60dp" android:layout_height="12dp" android:layout_marginBottom="6dp" android:background="@drawable/bg_skeleton_line" />
                    <View android:layout_width="match_parent" android:layout_height="16dp" android:background="@drawable/bg_skeleton_line" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

    </FrameLayout>
</ScrollView>
