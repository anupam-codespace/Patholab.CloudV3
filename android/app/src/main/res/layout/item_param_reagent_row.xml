<?xml version="1.0" encoding="utf-8"?>
<!-- Linked Reagent Row Item -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_setting_item"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:layout_marginBottom="8dp">

    <!-- Reagent Inventory Item Selector -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.6"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Inventory Catalog Reagent *"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:textColor="#475569"
            android:layout_marginBottom="4dp" />

        <Spinner
            android:id="@+id/spinnerReagentItem"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:background="@drawable/bg_input_field"
            android:paddingStart="6dp"
            android:paddingEnd="6dp" />

    </LinearLayout>

    <!-- Quantity per Test -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="8dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Qty / Test *"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:textColor="#475569"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/inputReagentQuantity"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:background="@drawable/bg_input_field"
            android:hint="e.g. 50"
            android:inputType="numberDecimal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:textSize="13sp"
            android:textColor="#0F172A"
            android:singleLine="true" />

    </LinearLayout>

    <!-- Delete Reagent Button -->
    <ImageView
        android:id="@+id/btnDeleteReagentRow"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="16dp"
        android:src="@drawable/ic_trash"
        android:tint="#E11D48"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="5dp"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>
