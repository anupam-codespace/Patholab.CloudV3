<?xml version="1.0" encoding="utf-8"?>
<!-- Native Independent Patient Registration & Clinical Accession Console (Following Exact Web Pattern) -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8FAFC">

    <!-- ── TOP CURVED SAPPHIRE HEADER ─────────────────────────────── -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_home_header"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Top Row: Back + Title + Clear -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <FrameLayout
                    android:id="@+id/btnRegBack"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_bell_btn"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_back_arrow"
                        android:tint="#0D6EFD" />

                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Patient Registration"
                        android:textSize="19sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:letterSpacing="-0.02" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="Search Database &amp; Test Accession"
                        android:textSize="12sp"
                        android:textColor="#BAE6FD" />

                </LinearLayout>

                <TextView
                    android:id="@+id/btnRegReset"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_pill_white"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="Clear"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    android:textColor="#0D6EFD"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

            <!-- Mode Selector Tabs: [ Search Database ] and [ New Registration ] -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:orientation="horizontal"
                android:background="#26FFFFFF"
                android:padding="3dp"
                android:layout_marginTop="16dp">

                <TextView
                    android:id="@+id/tabModeSearch"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:background="@drawable/bg_pill_white"
                    android:text="Search Database"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#0D6EFD"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/tabModeNewReg"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:background="@android:color/transparent"
                    android:text="+ New Registration"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

        </LinearLayout>

    </FrameLayout>

    <!-- ── TAB 1: SEARCH DATABASE & ACCESSION (Web /workspace/registration) ── -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollSearchSection"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Omnibar Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_white"
                android:padding="16dp"
                android:elevation="2dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="EXISTING PATIENT LOOKUP"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    android:textColor="#0D6EFD"
                    android:letterSpacing="0.06"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Search database by mobile number or patient name to find past records or book a new visit."
                    android:textSize="13sp"
                    android:textColor="#64748B"
                    android:lineSpacingExtra="2dp"
                    android:layout_marginBottom="14dp" />

                <!-- Search Mode (Phone vs Name) & Input -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <Spinner
                        android:id="@+id/spinnerSearchType"
                        android:layout_width="105dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_input_field"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp" />

                    <EditText
                        android:id="@+id/inputOmnibar"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_input_field"
                        android:hint="Enter 10-digit mobile..."
                        android:inputType="phone"
                        android:maxLength="10"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:textSize="14.5sp"
                        android:textColor="#0F172A"
                        android:textColorHint="#94A3B8"
                        android:singleLine="true" />

                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOmnibarSearch"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Search Database"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#0D6EFD"
                    app:cornerRadius="12dp" />

            </LinearLayout>

            <!-- Loading Spinner for Search -->
            <ProgressBar
                android:id="@+id/progressSearch"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:indeterminateTint="#0D6EFD"
                android:visibility="gone" />

            <!-- Case A: Match Found Card -->
            <LinearLayout
                android:id="@+id/cardMatchFound"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_white"
                android:padding="16dp"
                android:elevation="3dp"
                android:layout_marginBottom="16dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <FrameLayout
                        android:layout_width="48dp"
                        android:layout_height="48dp">

                        <androidx.cardview.widget.CardView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            app:cardCornerRadius="24dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="#EFF6FF">

                            <TextView
                                android:id="@+id/lblMatchAvatarInitial"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:text="P"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="#0D6EFD" />

                        </androidx.cardview.widget.CardView>

                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">

                        <TextView
                            android:id="@+id/lblMatchName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pooja Sharma"
                            android:textSize="16.5sp"
                            android:textStyle="bold"
                            android:textColor="#0F172A" />

                        <TextView
                            android:id="@+id/lblMatchDemographics"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="28Y • FEMALE"
                            android:textSize="12.5sp"
                            android:textColor="#64748B" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/lblMatchUHID"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_bento_blue"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:text="P-00142"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#0D6EFD" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#F1F5F9"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/lblMatchPhone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mobile: 9876543210"
                    android:textSize="13sp"
                    android:textColor="#475569"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/lblMatchAddress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Location: Mumbai, India"
                    android:textSize="13sp"
                    android:textColor="#475569"
                    android:layout_marginBottom="16dp" />

                <!-- 1-Tap Action: Proceed to Accession -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnProceedToAccession"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Proceed to Accession &amp; Tests →"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#0D6EFD"
                    app:cornerRadius="12dp" />

            </LinearLayout>

            <!-- Case B: No Match Found Card -->
            <LinearLayout
                android:id="@+id/cardNoMatch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:background="@drawable/bg_card_white"
                android:padding="24dp"
                android:elevation="2dp"
                android:layout_marginBottom="16dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_search"
                    android:tint="#94A3B8"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No Patient Found"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#0F172A"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/lblNoMatchDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No record found matching this query in the database."
                    android:textSize="13sp"
                    android:textColor="#64748B"
                    android:gravity="center"
                    android:layout_marginBottom="18dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRegisterNewFromSearch"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="+ Register New Patient Profile"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#0D6EFD"
                    app:cornerRadius="12dp" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- ── TAB 2: NEW REGISTRATION & ACCESSION (Web /workspace/patients/new & /accession) ── -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollNewRegSection"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ── CARD 1: PATIENT DEMOGRAPHICS ──────────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_white"
                android:padding="16dp"
                android:elevation="2dp"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PATIENT DEMOGRAPHICS"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    android:textColor="#64748B"
                    android:letterSpacing="0.06"
                    android:layout_marginBottom="12dp" />

                <!-- Title & Full Name Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="10dp">

                    <Spinner
                        android:id="@+id/spinnerTitle"
                        android:layout_width="85dp"
                        android:layout_height="46dp"
                        android:background="@drawable/bg_input_field"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp" />

                    <EditText
                        android:id="@+id/inputPatientName"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_input_field"
                        android:hint="Full Name *"
                        android:inputType="textPersonName|textCapWords"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textSize="14sp"
                        android:textColor="#0F172A"
                        android:textColorHint="#94A3B8"
                        android:singleLine="true" />

                </LinearLayout>

                <!-- Phone & Gender Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="10dp">

                    <EditText
                        android:id="@+id/inputPatientPhone"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_input_field"
                        android:hint="Mobile (10 Digits) *"
                        android:inputType="phone"
                        android:maxLength="10"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textSize="14sp"
                        android:textColor="#0F172A"
                        android:textColorHint="#94A3B8"
                        android:singleLine="true" />

                    <Spinner
                        android:id="@+id/spinnerGender"
                        android:layout_width="110dp"
                        android:layout_height="46dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_input_field"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp" />

                </LinearLayout>

                <!-- Age & Age Unit Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="10dp">

                    <EditText
                        android:id="@+id/inputPatientAge"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_input_field"
                        android:hint="Age *"
                        android:inputType="number"
                        android:maxLength="3"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textSize="14sp"
                        android:textColor="#0F172A"
                        android:textColorHint="#94A3B8"
                        android:singleLine="true" />

                    <Spinner
                        android:id="@+id/spinnerAgeUnit"
                        android:layout_width="110dp"
                        android:layout_height="46dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_input_field"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp" />

                </LinearLayout>

                <!-- Email & Address -->
                <EditText
                    android:id="@+id/inputPatientEmail"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_input_field"
                    android:hint="Email Address (Optional)"
                    android:inputType="textEmailAddress"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textSize="14sp"
                    android:textColor="#0F172A"
                    android:textColorHint="#94A3B8"
                    android:layout_marginBottom="10dp"
                    android:singleLine="true" />

                <EditText
                    android:id="@+id/inputPatientAddress"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_input_field"
                    android:hint="Address / Location (Optional)"
                    android:inputType="textPostalAddress"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textSize="14sp"
                    android:textColor="#0F172A"
                    android:textColorHint="#94A3B8"
                    android:singleLine="true" />

            </LinearLayout>

            <!-- ── CARD 2: CLINICAL REFERRAL & COLLECTION ──────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_white"
                android:padding="16dp"
                android:elevation="2dp"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CLINICAL REFERRAL &amp; COLLECTION"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    android:textColor="#64748B"
                    android:letterSpacing="0.06"
                    android:layout_marginBottom="12dp" />

                <!-- Referring Doctor Trigger -->
                <LinearLayout
                    android:id="@+id/btnSelectDoctor"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_input_field"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:layout_marginBottom="10dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_stethoscope"
                        android:tint="#0D6EFD" />

                    <TextView
                        android:id="@+id/lblSelectedDoctor"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:text="Doctor: Self (No Doctor)"
                        android:textSize="13.5sp"
                        android:textStyle="bold"
                        android:textColor="#0F172A" />

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_arrow_right"
                        android:tint="#94A3B8" />

                </LinearLayout>

                <!-- Referring Agency Trigger -->
                <LinearLayout
                    android:id="@+id/btnSelectAgency"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_input_field"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:layout_marginBottom="10dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_card"
                        android:tint="#EA580C" />

                    <TextView
                        android:id="@+id/lblSelectedAgency"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:text="Agency: Direct Walk-in"
                        android:textSize="13.5sp"
                        android:textStyle="bold"
                        android:textColor="#0F172A" />

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_arrow_right"
                        android:tint="#94A3B8" />

                </LinearLayout>

                <!-- Sample Collector Spinner -->
                <Spinner
                    android:id="@+id/spinnerCollector"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_input_field"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp" />

            </LinearLayout>

            <!-- ── CARD 3: DIAGNOSTIC TESTS & PACKAGES ACCESSION ──────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_white"
                android:padding="16dp"
                android:elevation="2dp"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="DIAGNOSTIC TESTS &amp; PROFILES"
                        android:textSize="11.5sp"
                        android:textStyle="bold"
                        android:textColor="#64748B"
                        android:letterSpacing="0.06" />

                    <TextView
                        android:id="@+id/lblTestsCountBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 selected"
                        android:textSize="11.5sp"
                        android:textStyle="bold"
                        android:textColor="#0D6EFD" />

                </LinearLayout>

                <!-- Selected Tests Container -->
                <LinearLayout
                    android:id="@+id/containerSelectedTests"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <!-- Add Tests Trigger Button -->
                <LinearLayout
                    android:id="@+id/btnAddTestsModal"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_setting_item"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="4dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_plus"
                        android:tint="#0D6EFD" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Add Tests / Profiles from Catalog"
                        android:textSize="13.5sp"
                        android:textStyle="bold"
                        android:textColor="#0D6EFD" />

                </LinearLayout>

            </LinearLayout>

            <!-- ── CARD 4: LIVE BILLING & PAYMENT ────────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_white"
                android:padding="16dp"
                android:elevation="2dp"
                android:layout_marginBottom="80dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BILLING &amp; PAYMENT MODE"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    android:textColor="#64748B"
                    android:letterSpacing="0.06"
                    android:layout_marginBottom="12dp" />

                <!-- Gross Amount -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Gross Amount"
                        android:textSize="13.5sp"
                        android:textColor="#64748B" />

                    <TextView
                        android:id="@+id/lblGrossTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₹0.00"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#0F172A" />

                </LinearLayout>

                <!-- Discount (₹) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Discount (₹)"
                        android:textSize="13.5sp"
                        android:textColor="#64748B" />

                    <EditText
                        android:id="@+id/inputDiscount"
                        android:layout_width="90dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_input_field"
                        android:hint="0"
                        android:inputType="numberDecimal"
                        android:gravity="center"
                        android:textSize="13.5sp"
                        android:textStyle="bold"
                        android:textColor="#0F172A"
                        android:textColorHint="#94A3B8"
                        android:singleLine="true" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#F1F5F9"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="10dp" />

                <!-- Net Payable -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Net Payable"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#0F172A" />

                    <TextView
                        android:id="@+id/lblNetPayable"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₹0.00"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#0D6EFD" />

                </LinearLayout>

                <!-- Payment Mode Spinner -->
                <Spinner
                    android:id="@+id/spinnerPaymentMode"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_input_field"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- ── STICKY BOTTOM ACTION BAR FOR NEW REGISTRATION ─────────── -->
    <FrameLayout
        android:id="@+id/stickyBottomBar"
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:background="#FFFFFF"
        android:elevation="12dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total Payable"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    android:textColor="#64748B" />

                <TextView
                    android:id="@+id/lblStickyTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₹0.00"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#0F172A" />

            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSubmitRegistration"
                android:layout_width="wrap_content"
                android:layout_height="50dp"
                android:text="Register &amp; Book Tests"
                android:textSize="14.5sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#0D6EFD"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                app:cornerRadius="16dp" />

        </LinearLayout>

    </FrameLayout>

</LinearLayout>
