<?xml version="1.0" encoding="utf-8"?>
<!-- Native Dedicated Online Booking & Public Portal Management Console -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ── TOP CURVED SAPPHIRE HEADER ─────────────────────────────── -->
        <FrameLayout
            android:id="@+id/bookingHeaderLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_home_header"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="32dp"
            android:paddingBottom="42dp">

            <!-- Top Row: Back + Title + Actions -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <FrameLayout
                    android:id="@+id/btnBookingBack"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_glass_back_btn"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_back_arrow"
                        android:tint="#FFFFFF"
                        app:tint="#FFFFFF" />

                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Online Bookings"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:letterSpacing="-0.02" />

                    <TextView
                        android:id="@+id/lblBookingSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Verify patient payments and track booking lifecycle."
                        android:textSize="11.5sp"
                        android:textColor="#C7DFFF"
                        android:singleLine="true"
                        android:ellipsize="end" />

                </LinearLayout>

                <!-- Portal Settings Button -->
                <FrameLayout
                    android:id="@+id/btnPortalSettings"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_wallet_pill"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_mod_clean_settings"
                        android:tint="#FFFFFF"
                        app:tint="#FFFFFF" />

                </FrameLayout>

                <!-- Refresh Button -->
                <FrameLayout
                    android:id="@+id/btnRefreshBookings"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_wallet_pill"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/imgRefreshBookingsIcon"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_refresh_cw"
                        android:tint="#FFFFFF"
                        app:tint="#FFFFFF" />

                </FrameLayout>

            </LinearLayout>

        </FrameLayout>

        <!-- ── DEDICATED LIVE PUBLIC PORTAL BANNER (MATCHING WEB SCREENSHOT 3) ── -->
        <FrameLayout
            android:id="@+id/cardLivePortalBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="-28dp"
            android:background="@drawable/bg_live_portal_banner"
            android:elevation="3dp"
            android:padding="14dp">

            <!-- Active / Live State -->
            <LinearLayout
                android:id="@+id/layoutPortalActiveBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <FrameLayout
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_circle_icon_sky">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_globe_vector"
                            android:tint="#2563EB"
                            app:tint="#2563EB" />

                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="YOUR PUBLIC BOOKING URL IS LIVE"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="#1E40AF"
                            android:letterSpacing="0.04" />

                        <TextView
                            android:id="@+id/lblLivePortalUrl"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="app.patholab.cloud/book/portal"
                            android:textSize="12.5sp"
                            android:textStyle="bold"
                            android:textColor="#2563EB"
                            android:singleLine="true"
                            android:ellipsize="end" />

                    </LinearLayout>

                    <ImageView
                        android:id="@+id/btnOpenPortalBrowser"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_copy_pill"
                        android:padding="7dp"
                        android:src="@drawable/ic_external_link"
                        android:tint="#2563EB"
                        app:tint="#2563EB"
                        android:clickable="true"
                        android:focusable="true" />

                </LinearLayout>

                <!-- Quick Action Buttons: Copy URL & WhatsApp Share -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="10dp">

                    <LinearLayout
                        android:id="@+id/btnCopyPortalUrl"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:background="@drawable/bg_copy_pill"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_marginEnd="8dp">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@drawable/ic_document"
                            android:tint="#475569"
                            app:tint="#475569" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="Copy URL"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#334155" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btnShareWhatsAppPortal"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1.35"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:background="@drawable/bg_whatsapp_pill"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:src="@drawable/ic_whatsapp_white" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="Share to WhatsApp"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <!-- Disabled / Offline State -->
            <LinearLayout
                android:id="@+id/layoutPortalOfflineBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_warning_triangle"
                    android:tint="#D97706"
                    app:tint="#D97706" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PUBLIC PORTAL IS OFFLINE"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#92400E" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="Enable your portal to allow patients to book online."
                        android:textSize="11.5sp"
                        android:textColor="#B45309" />

                </LinearLayout>

                <Button
                    android:id="@+id/btnEnablePortalFromBanner"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="Enable"
                    android:textSize="11sp"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#2563EB" />

            </LinearLayout>

        </FrameLayout>

        <!-- ── 4 KPI METRICS CARDS (EXACT WEB PARITY) ────────────────── -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="6dp"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Card 1: Total Bookings (Web: Total Bookings with calendar icon) -->
                <LinearLayout
                    android:layout_width="145dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_setting_item"
                    android:padding="12dp"
                    android:layout_marginEnd="8dp"
                    android:elevation="1.5dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="TOTAL BOOKINGS"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="#64748B"
                            android:letterSpacing="0.04" />

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@drawable/ic_calendar"
                            android:tint="#94A3B8"
                            app:tint="#94A3B8" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/lblKpiTotalBookings"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="0"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#0F172A" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="All Bookings"
                        android:textSize="11sp"
                        android:textColor="#94A3B8" />

                </LinearLayout>

                <!-- Card 2: Pending Verification (Web: Pending Verification with warning icon) -->
                <LinearLayout
                    android:layout_width="155dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_setting_item"
                    android:padding="12dp"
                    android:layout_marginEnd="8dp"
                    android:elevation="1.5dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="PENDING VERIFY"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="#B45309"
                            android:letterSpacing="0.04" />

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@drawable/ic_warning_triangle"
                            android:tint="#D97706"
                            app:tint="#D97706" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/lblKpiPendingBookings"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="0"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#D97706" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Pending Action"
                        android:textSize="11sp"
                        android:textColor="#94A3B8" />

                </LinearLayout>

                <!-- Card 3: Verified (Web: Verified with check-circle icon) -->
                <LinearLayout
                    android:layout_width="145dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_setting_item"
                    android:padding="12dp"
                    android:layout_marginEnd="8dp"
                    android:elevation="1.5dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="VERIFIED"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="#15803D"
                            android:letterSpacing="0.04" />

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@drawable/ic_check_bold"
                            android:tint="#16A34A"
                            app:tint="#16A34A" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/lblKpiVerifiedBookings"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="0"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#16A34A" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Confirmed Orders"
                        android:textSize="11sp"
                        android:textColor="#94A3B8" />

                </LinearLayout>

                <!-- Card 4: Verified Revenue (Web: Verified Revenue with shield-check icon) -->
                <LinearLayout
                    android:layout_width="155dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_setting_item"
                    android:padding="12dp"
                    android:elevation="1.5dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="VERIFIED REVENUE"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="#1E40AF"
                            android:letterSpacing="0.04" />

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@drawable/ic_shield_check"
                            android:tint="#2563EB"
                            app:tint="#2563EB" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/lblKpiRevenueBookings"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="₹0"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#2563EB" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Online Value"
                        android:textSize="11sp"
                        android:textColor="#94A3B8" />

                </LinearLayout>

            </LinearLayout>

        </HorizontalScrollView>

        <!-- ── SEARCH BAR (Web Placeholder Match) ───────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_setting_item"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="9dp"
            android:paddingBottom="9dp"
            android:gravity="center_vertical"
            android:elevation="1dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_search"
                android:tint="#94A3B8"
                app:tint="#94A3B8" />

            <EditText
                android:id="@+id/inputSearchBookings"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:layout_marginStart="8dp"
                android:hint="Search by patient, phone, track ID, or test..."
                android:textSize="13sp"
                android:textColor="#1E293B"
                android:textColorHint="#94A3B8"
                android:singleLine="true"
                android:imeOptions="actionSearch" />

            <ImageView
                android:id="@+id/btnClearSearchBookings"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_close_cross"
                android:tint="#94A3B8"
                app:tint="#94A3B8"
                android:visibility="gone"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

        <!-- ── FILTER CHIPS ───────────────────────────────────────────── -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginTop="8dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:clipToPadding="false">

            <LinearLayout
                android:id="@+id/containerBookingFilterChips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <!-- Programmatically populated with chips: All Bookings, Pending Verification, Verified, Home Collection, Lab Visit, Cancelled -->
            </LinearLayout>

        </HorizontalScrollView>

        <!-- ── PROGRESS INDICATOR ─────────────────────────────────────── -->
        <ProgressBar
            android:id="@+id/progressBookings"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:indeterminate="true"
            android:layout_marginTop="6dp"
            android:visibility="gone" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- ── RECYCLER VIEW FOR BOOKINGS ─────────────────────────── -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerBookings"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="6dp"
                android:paddingBottom="84dp"
                android:clipToPadding="false"
                android:scrollbars="vertical" />

            <!-- ── EMPTY STATE CONTAINER (COMPACT & RESPONSIVE) ──────── -->
            <LinearLayout
                android:id="@+id/emptyStateBookings"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingTop="12dp"
                android:paddingBottom="40dp"
                android:visibility="gone">

                <FrameLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_circle_icon_sky">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_calendar"
                        android:tint="#2563EB"
                        app:tint="#2563EB" />

                </FrameLayout>

                <TextView
                    android:id="@+id/lblEmptyBookingTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="No Online Bookings Yet"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#1E293B" />

                <TextView
                    android:id="@+id/lblEmptyBookingSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Appointments booked through your public portal will appear here in real-time."
                    android:textSize="12sp"
                    android:textColor="#64748B"
                    android:gravity="center"
                    android:maxWidth="280dp"
                    android:lineSpacingExtra="2dp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp">

                    <Button
                        android:id="@+id/btnEmptyShareLink"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Share Booking Link"
                        android:textSize="12sp"
                        android:backgroundTint="#2563EB"
                        android:textColor="#FFFFFF"
                        android:layout_marginEnd="8dp" />

                    <Button
                        android:id="@+id/btnEmptyEnablePortal"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Portal Settings"
                        android:textSize="12sp"
                        android:backgroundTint="#F1F5F9"
                        android:textColor="#334155" />

                </LinearLayout>

            </LinearLayout>

        </FrameLayout>

    </LinearLayout>

    <!-- ── EXTENDED FLOATING ACTION BUTTON ────────────────────────── -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabNewBooking"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="20dp"
        android:text="New Booking"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="13sp"
        app:icon="@drawable/ic_plus"
        app:iconTint="#FFFFFF"
        app:backgroundTint="#2563EB"
        android:elevation="6dp" />

</FrameLayout>

