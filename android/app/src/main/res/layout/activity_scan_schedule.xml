<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8FAFC">

    <!-- Header -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_home_header"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="36dp"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <FrameLayout
                android:id="@+id/btnScanScheduleBack"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_glass_back_btn"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_back_arrow"
                    app:tint="#FFFFFF" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="14dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Scan Schedule"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Radiology Appointments &amp; Modality Worklist"
                    android:textSize="11.5sp"
                    android:textColor="#C7DFFF" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/btnScanScheduleRefresh"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_glass_back_btn"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:id="@+id/imgScanScheduleRefreshIcon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_refresh"
                    app:tint="#FFFFFF" />
            </FrameLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Main Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- New Scan Appointment CTA -->
        <Button
            android:id="@+id/btnNewScanAppointment"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="@drawable/bg_btn_primary"
            android:text="+ New Scan Appointment"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Tabs -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/tabScanAll"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="All"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/bg_tab_pill_active"
                android:textColor="#FFFFFF" />
            <TextView
                android:id="@+id/tabScanToday"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:gravity="center"
                android:text="Today"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/bg_tab_pill_inactive"
                android:textColor="#64748B" />
            <TextView
                android:id="@+id/tabScanPending"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:gravity="center"
                android:text="Pending"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/bg_tab_pill_inactive"
                android:textColor="#64748B" />
            <TextView
                android:id="@+id/tabScanCompleted"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:gravity="center"
                android:text="Completed"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/bg_tab_pill_inactive"
                android:textColor="#64748B" />
        </LinearLayout>

        <!-- Search Omnibar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_search_input_field"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">
            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_search"
                app:tint="#94A3B8" />
            <EditText
                android:id="@+id/inputScanSearch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@null"
                android:hint="Search patient, modality, doctor..."
                android:textSize="13sp"
                android:textColor="#1E293B"
                android:singleLine="true" />
            <ImageView
                android:id="@+id/btnClearScanSearch"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_close"
                android:visibility="gone"
                app:tint="#94A3B8" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressScanSchedule"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="20dp"
            android:visibility="gone" />

        <!-- Empty State -->
        <LinearLayout
            android:id="@+id/emptyScanSchedule"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No Scheduled Scans"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#64748B" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Appointments booked in the app or web will show here."
                android:textSize="12sp"
                android:textColor="#94A3B8" />
        </LinearLayout>

        <!-- Recycler View -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerScanSchedule"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="10dp" />

    </LinearLayout>
</LinearLayout>
