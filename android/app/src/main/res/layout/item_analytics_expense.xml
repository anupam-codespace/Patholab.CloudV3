<?xml version="1.0" encoding="utf-8"?>
<!-- Clean Bento Card for Expenses Ledger (Android) -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dashboard_bento"
    android:padding="14dp"
    android:elevation="1dp"
    android:layout_marginBottom="8dp">

    <!-- Top Row: Category Badge, Payment Mode -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/lblExpenseCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LAB SUPPLIES"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#64748B"
            android:background="@drawable/bg_chip_inactive"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/lblExpenseMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="UPI"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#0D6EFD"
            android:background="@drawable/bg_mod_icon_blue"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp" />

    </LinearLayout>

    <!-- Middle Row: Expense Title / Description -->
    <TextView
        android:id="@+id/lblExpenseTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Reagents Batch A &amp; Calibration Kits"
        android:textSize="14.5sp"
        android:textStyle="bold"
        android:textColor="#0F172A" />

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#F1F5F9"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp" />

    <!-- Bottom Row: Date, Amount -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/lblExpenseDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="02 Sep 2026"
            android:textSize="11.5sp"
            android:textColor="#64748B" />

        <TextView
            android:id="@+id/lblExpenseAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-₹2,500.00"
            android:textSize="15sp"
            android:fontFamily="sans-serif-black"
            android:textStyle="bold"
            android:textColor="#E11D48" />

    </LinearLayout>

</LinearLayout>
