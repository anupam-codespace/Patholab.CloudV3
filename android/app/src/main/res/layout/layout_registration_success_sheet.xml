<?xml version="1.0" encoding="utf-8"?>
<!-- Celebratory Registration Success Sheet -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_payment_success_dialog"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="28dp"
    android:paddingBottom="36dp">

    <!-- Sparkle / Confetti background icon -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_gravity="top|center_horizontal"
        android:src="@drawable/ic_sparkle_confetti"
        android:alpha="0.22"
        android:scaleType="centerInside" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Glowing Green Checkmark Circle with ripple -->
        <FrameLayout
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_marginBottom="20dp">

            <View
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:background="@drawable/bg_success_check_circle"
                android:alpha="0.25" />

            <View
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_success_check_circle"
                android:alpha="0.45" />

            <FrameLayout
                android:id="@+id/iconSuccessCheck"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_success_check_circle">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_check_bold"
                    android:tint="#FFFFFF" />

            </FrameLayout>

        </FrameLayout>

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Registration Successful!"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:letterSpacing="-0.02"
            android:gravity="center" />

        <!-- Subtitle -->
        <TextView
            android:id="@+id/lblSuccessPatientName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Patient profile &amp; tests have been accessioned into worklist."
            android:textSize="13.5sp"
            android:textColor="#94A3B8"
            android:gravity="center"
            android:lineSpacingExtra="3dp" />

        <!-- UHID & Bill Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#0F172A"
            android:padding="16dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PATIENT UHID"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#64748B"
                        android:letterSpacing="0.05" />

                    <TextView
                        android:id="@+id/lblSuccessUHID"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="P-00142"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="#38BDF8" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="end">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="NET AMOUNT"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#64748B"
                        android:letterSpacing="0.05" />

                    <TextView
                        android:id="@+id/lblSuccessAmount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="₹1,250.00"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="#4ADE80" />

                </LinearLayout>

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#1E293B"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/lblSuccessDoctor"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Dr: Self • Cash"
                    android:textSize="12sp"
                    android:textColor="#94A3B8" />

                <TextView
                    android:id="@+id/lblSuccessTestsCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3 Tests Booked"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#CBD5E1" />

            </LinearLayout>

        </LinearLayout>

        <!-- Action Buttons: WhatsApp Share + Print Receipt -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSuccessWhatsAppShare"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Send WhatsApp Receipt"
                android:textSize="14.5sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#25D366"
                app:cornerRadius="16dp"
                app:icon="@drawable/ic_whatsapp_official"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconTint="@null"
                app:iconSize="22dp"
                android:layout_marginBottom="10dp"
                android:elevation="4dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSuccessPrintReceipt"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="View Invoice &amp; Worklist"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#0D6EFD"
                app:cornerRadius="16dp"
                android:elevation="4dp" />

        </LinearLayout>

        <!-- Dismiss / Return to Dashboard -->
        <TextView
            android:id="@+id/btnSuccessDone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Back to Dashboard"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#94A3B8"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

</FrameLayout>
