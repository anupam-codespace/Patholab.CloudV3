<?xml version="1.0" encoding="utf-8"?>
<!-- Modern Floating Dropdown Menu for Dashboard Timeframe Selection -->
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="260dp"
    android:layout_height="wrap_content"
    app:cardCornerRadius="18dp"
    app:cardElevation="14dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardPreventCornerOverlap="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp"
        android:background="#FFFFFF">

        <!-- Dropdown Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_calendar_clock"
                android:tint="#2563EB"
                app:tint="#2563EB" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="SELECT TIMEFRAME"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#64748B"
                android:letterSpacing="0.05" />

        </LinearLayout>

        <!-- Divider Line -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#F1F5F9"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:layout_marginBottom="4dp" />

        <!-- Item 1: Today -->
        <LinearLayout
            android:id="@+id/itemRangeToday"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:layout_marginBottom="2dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/lblTitleToday"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Today"
                    android:textSize="13.5sp"
                    android:textStyle="bold"
                    android:textColor="#0F172A" />

                <TextView
                    android:id="@+id/lblSubToday"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="Live real-time transactions &amp; tests"
                    android:textSize="11sp"
                    android:textColor="#64748B" />

            </LinearLayout>

            <ImageView
                android:id="@+id/imgCheckToday"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_check_bold"
                android:tint="#2563EB"
                app:tint="#2563EB"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Item 2: Last 7 Days -->
        <LinearLayout
            android:id="@+id/itemRange7D"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:layout_marginBottom="2dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/lblTitle7D"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Last 7 Days"
                    android:textSize="13.5sp"
                    android:textStyle="bold"
                    android:textColor="#0F172A" />

                <TextView
                    android:id="@+id/lblSub7D"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="Past 7 days performance &amp; trends"
                    android:textSize="11sp"
                    android:textColor="#64748B" />

            </LinearLayout>

            <ImageView
                android:id="@+id/imgCheck7D"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_check_bold"
                android:tint="#2563EB"
                app:tint="#2563EB"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Item 3: Last 30 Days -->
        <LinearLayout
            android:id="@+id/itemRange30D"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:layout_marginBottom="2dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/lblTitle30D"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Last 30 Days"
                    android:textSize="13.5sp"
                    android:textStyle="bold"
                    android:textColor="#0F172A" />

                <TextView
                    android:id="@+id/lblSub30D"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="Month-to-date overview (Default)"
                    android:textSize="11sp"
                    android:textColor="#64748B" />

            </LinearLayout>

            <ImageView
                android:id="@+id/imgCheck30D"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_check_bold"
                android:tint="#2563EB"
                app:tint="#2563EB"
                android:visibility="visible" />

        </LinearLayout>

        <!-- Item 4: This Month -->
        <LinearLayout
            android:id="@+id/itemRangeMonth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:layout_marginBottom="2dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/lblTitleMonth"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="This Month"
                    android:textSize="13.5sp"
                    android:textStyle="bold"
                    android:textColor="#0F172A" />

                <TextView
                    android:id="@+id/lblSubMonth"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="Current calendar month (1st to now)"
                    android:textSize="11sp"
                    android:textColor="#64748B" />

            </LinearLayout>

            <ImageView
                android:id="@+id/imgCheckMonth"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_check_bold"
                android:tint="#2563EB"
                app:tint="#2563EB"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Item 5: This Year -->
        <LinearLayout
            android:id="@+id/itemRangeYear"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/lblTitleYear"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="This Year"
                    android:textSize="13.5sp"
                    android:textStyle="bold"
                    android:textColor="#0F172A" />

                <TextView
                    android:id="@+id/lblSubYear"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="Fiscal year cumulative statistics"
                    android:textSize="11sp"
                    android:textColor="#64748B" />

            </LinearLayout>

            <ImageView
                android:id="@+id/imgCheckYear"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_check_bold"
                android:tint="#2563EB"
                app:tint="#2563EB"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
