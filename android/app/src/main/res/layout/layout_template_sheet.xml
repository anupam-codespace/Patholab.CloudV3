<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/lblTemplateSheetTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Report Template Builder"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#0F172A" />
        <ImageView
            android:id="@+id/btnTemplateSheetClose"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_close"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="TEMPLATE NAME"
        android:textSize="10sp"
        android:textStyle="bold"
        android:textColor="#64748B"
        android:letterSpacing="0.04" />

    <EditText
        android:id="@+id/inputTemplateName"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_input_field"
        android:hint="e.g. Official Header Template"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textColor="#0F172A"
        android:textSize="13sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="HEADER MODE"
        android:textSize="10sp"
        android:textStyle="bold"
        android:textColor="#64748B"
        android:letterSpacing="0.04" />

    <Spinner
        android:id="@+id/spinnerTemplateMode"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_input_field"
        android:spinnerMode="dropdown" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="HEADER TITLE / LAB NAME"
        android:textSize="10sp"
        android:textStyle="bold"
        android:textColor="#64748B"
        android:letterSpacing="0.04" />

    <EditText
        android:id="@+id/inputTemplateHeader"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_input_field"
        android:hint="Lab Name / Diagnostic Center Header"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textColor="#0F172A"
        android:textSize="13sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="FOOTER DISCLAIMER TEXT"
        android:textSize="10sp"
        android:textStyle="bold"
        android:textColor="#64748B"
        android:letterSpacing="0.04" />

    <EditText
        android:id="@+id/inputTemplateFooter"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_input_field"
        android:hint="Computer generated diagnostic report..."
        android:gravity="top"
        android:padding="10dp"
        android:textColor="#0F172A"
        android:textSize="13sp" />

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/switchTemplateShowLogo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Show Lab Brand Logo"
        android:textSize="13sp"
        android:textColor="#1E293B" />

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/switchTemplateShowNabl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Show NABL / ISO Accreditation Badge"
        android:textSize="13sp"
        android:textColor="#1E293B" />

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/switchTemplateShowSig"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Include Doctor &amp; Tech Signatures"
        android:textSize="13sp"
        android:textColor="#1E293B" />

    <TextView
        android:id="@+id/lblTemplateError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#DC2626"
        android:textSize="12sp"
        android:visibility="gone" />

    <Button
        android:id="@+id/btnSaveTemplate"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_btn_primary"
        android:text="Save Template"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />

    <ProgressBar
        android:id="@+id/progressSaveTemplate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="8dp"
        android:visibility="gone" />
</LinearLayout>
