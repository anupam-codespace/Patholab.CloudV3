<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardTemplateContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_card_white"
    android:elevation="1.5dp"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Top Row: Template Name + Badges -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/lblTemplateName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Official Pathology Letterhead"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#0F172A" />

        <TextView
            android:id="@+id/lblTemplateMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_pill_indigo_soft"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="STANDARD"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:textColor="#4F46E5" />

        <TextView
            android:id="@+id/lblTemplateActive"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_status_ready"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="✓ ACTIVE"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:textColor="#059669" />

    </LinearLayout>

    <!-- Preview Box -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="#F8FAFC"
        android:orientation="vertical"
        android:padding="8dp">

        <TextView
            android:id="@+id/lblTemplatePreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Standard Layout • Computer generated diagnostic report"
            android:textSize="11.5sp"
            android:textColor="#64748B"
            android:maxLines="2"
            android:ellipsize="end" />

    </LinearLayout>

    <!-- Action Buttons Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/btnActivateTemplate"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_primary"
            android:text="Set as Active"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingStart="10dp"
            android:paddingEnd="10dp" />

        <Button
            android:id="@+id/btnEditTemplate"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_pill_slate"
            android:text="Edit"
            android:textAllCaps="false"
            android:textColor="#334155"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

        <FrameLayout
            android:id="@+id/btnDuplicateTemplate"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_circle_slate"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_document"
                android:tint="#475569"
                app:tint="#475569" />

        </FrameLayout>

        <FrameLayout
            android:id="@+id/btnDeleteTemplate"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_circle_slate"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_trash"
                android:tint="#EF4444"
                app:tint="#EF4444" />

        </FrameLayout>

    </LinearLayout>

</LinearLayout>
