<?xml version="1.0" encoding="utf-8"?>
<!-- Bottom Sheet Dialog: Public Portal Settings Management (Matches Web Screenshots 1 & 4) -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="36dp">

            <!-- Drag Handle -->
            <View
                android:layout_width="38dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:background="#CBD5E1"
                android:layout_marginBottom="14dp" />

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Public Portal Settings"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#0F172A" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Configure how your B2B2C booking website appears to the public."
                        android:textSize="11.5sp"
                        android:textColor="#64748B" />

                </LinearLayout>

                <ImageView
                    android:id="@+id/btnPortalClose"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_close_cross"
                    android:tint="#94A3B8"
                    app:tint="#94A3B8"
                    android:padding="5dp"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

            <!-- Card: Public Booking Portal -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_setting_item"
                android:padding="16dp"
                android:layout_marginTop="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Public Booking Portal"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#1E293B" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Allow patients to book tests directly online. Claim your unique lab URL below."
                    android:textSize="12sp"
                    android:textColor="#64748B"
                    android:lineSpacingExtra="1dp" />

                <!-- Status Switch Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="14dp">

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchPortalStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/lblPortalSwitchTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="Portal is Enabled"
                        android:textSize="13.5sp"
                        android:textStyle="bold"
                        android:textColor="#1E293B" />

                </LinearLayout>

                <!-- Slug & URL Configuration Container -->
                <LinearLayout
                    android:id="@+id/containerPortalConfig"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="16dp">

                    <TextView
                        android:text="YOUR PUBLIC URL"
                        android:textSize="10.5sp"
                        android:textStyle="bold"
                        android:textColor="#64748B"
                        android:letterSpacing="0.04"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal"
                        android:background="@drawable/bg_input_field"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:gravity="center_vertical"
                            android:paddingStart="12dp"
                            android:paddingEnd="6dp"
                            android:text="app.patholab.cloud/book/"
                            android:textSize="12sp"
                            android:textColor="#64748B"
                            android:background="#F1F5F9" />

                        <EditText
                            android:id="@+id/inputPortalSlugField"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@null"
                            android:paddingStart="8dp"
                            android:paddingEnd="12dp"
                            android:hint="e.g., careee"
                            android:textSize="13sp"
                            android:textColor="#1E293B"
                            android:textColorHint="#94A3B8"
                            android:singleLine="true" />

                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Use only letters, numbers, and hyphens."
                        android:textSize="11sp"
                        android:textColor="#94A3B8" />

                </LinearLayout>

                <!-- Save Changes Button -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp">

                    <Button
                        android:id="@+id/btnSavePortalConfig"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:text="Save Changes"
                        android:textSize="13.5sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#2563EB" />

                    <ProgressBar
                        android:id="@+id/progressSavePortal"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:indeterminateTint="#FFFFFF"
                        android:visibility="gone" />

                </FrameLayout>

                <!-- Action Buttons: Copy, WhatsApp Share, Live Preview -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="10dp">

                    <Button
                        android:id="@+id/btnCopyPortalLink"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:text="Copy URL"
                        android:textSize="11.5sp"
                        android:textColor="#2563EB"
                        android:backgroundTint="#EFF6FF"
                        android:layout_marginEnd="6dp" />

                    <Button
                        android:id="@+id/btnSharePortalLink"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1.2"
                        android:text="WhatsApp Share"
                        android:textSize="11.5sp"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#25D366"
                        android:layout_marginEnd="6dp" />

                    <Button
                        android:id="@+id/btnVisitPortalLink"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="0.9"
                        android:text="Visit Portal"
                        android:textSize="11.5sp"
                        android:textColor="#7C3AED"
                        android:backgroundTint="#F3E8FF" />

                </LinearLayout>

            </LinearLayout>

            <!-- Secure Routing Info Card (Matching Web Screenshot 1) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="#EFF6FF"
                android:padding="14dp"
                android:layout_marginTop="14dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_shield_check"
                    android:tint="#2563EB"
                    app:tint="#2563EB" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Secure Routing"
                        android:textSize="12.5sp"
                        android:textStyle="bold"
                        android:textColor="#1E40AF" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="When patients book Home Collection, the system automatically checks your Service Areas to route the appointment to the correct branch."
                        android:textSize="11.5sp"
                        android:textColor="#3B82F6"
                        android:lineSpacingExtra="2dp" />

                </LinearLayout>

            </LinearLayout>

            <!-- Test Visibility Info Card (Matching Web Screenshot 1) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="#F8FAFC"
                android:padding="14dp"
                android:layout_marginTop="10dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_flask"
                    android:tint="#64748B"
                    app:tint="#64748B" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Test Visibility"
                        android:textSize="12.5sp"
                        android:textStyle="bold"
                        android:textColor="#334155" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Not all tests are shown on your public portal. You can hide specific B2B tests from your Test Catalog settings."
                        android:textSize="11.5sp"
                        android:textColor="#64748B"
                        android:lineSpacingExtra="2dp" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</FrameLayout>

