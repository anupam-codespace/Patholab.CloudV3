<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_stat_card"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/lblLogPatient"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Patient Name"
            android:textSize="14.5sp"
            android:textStyle="bold"
            android:textColor="#0F172A" />

        <TextView
            android:id="@+id/lblLogStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_status_pending"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="ASSIGNED"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/lblLogSlot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Slot: 09:00 AM - 10:30 AM"
        android:textSize="12sp"
        android:textColor="#64748B" />

    <TextView
        android:id="@+id/lblLogAddress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Flat 402, Green Glen Heights, Bengaluru"
        android:textSize="12sp"
        android:textColor="#334155" />

    <TextView
        android:id="@+id/lblLogRider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Rider: Rajesh (9876543210)"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#2563EB" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="end">
        <TextView
            android:id="@+id/btnLogCall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="14dp"
            android:text="Call"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#059669" />
        <TextView
            android:id="@+id/btnLogWa"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="14dp"
            android:text="WhatsApp"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#059669" />
        <TextView
            android:id="@+id/btnLogStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Update Status"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#2563EB" />
    </LinearLayout>
</LinearLayout>
