<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet"
    android:padding="20dp">

    <!-- Handle Bar -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="#CBD5E1"
        android:layout_marginBottom="16dp" />

    <!-- Icon & Title Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_mod_icon_amber"
            android:layout_marginEnd="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="🔑"
                android:textSize="18sp" />

        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reset Password"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#0F172A" />

            <TextView
                android:id="@+id/lblResetPasswordStaffName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Updating credentials for staff member"
                android:textSize="12sp"
                android:textColor="#64748B" />

        </LinearLayout>

        <ImageView
            android:id="@+id/btnCloseResetPassword"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_close_cross"
            android:tint="#94A3B8"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="4dp" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#F1F5F9"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="16dp" />

    <!-- Password Input -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="NEW PASSWORD *"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="#64748B"
        android:letterSpacing="0.05" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_setting_item"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:layout_marginTop="6dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_lock"
            android:tint="#64748B" />

        <EditText
            android:id="@+id/inputNewPassword"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@null"
            android:hint="Minimum 6 characters"
            android:textColorHint="#94A3B8"
            android:textColor="#0F172A"
            android:textSize="14sp"
            android:layout_marginStart="10dp"
            android:inputType="textPassword" />

    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="The user will be required to use this new password on next login."
        android:textSize="11.5sp"
        android:textColor="#94A3B8" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginTop="20dp">

        <Button
            android:id="@+id/btnCancelResetPassword"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:background="@drawable/bg_btn_outline"
            android:text="Cancel"
            android:textColor="#64748B"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginEnd="10dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp" />

        <Button
            android:id="@+id/btnSubmitResetPassword"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:background="@drawable/bg_btn_primary"
            android:text="Update Password"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:paddingStart="20dp"
            android:paddingEnd="20dp" />

    </LinearLayout>

</LinearLayout>
