<?xml version="1.0" encoding="utf-8"?>
<!-- Native Independent Diagnostic Reports & Dispatch Console -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8FAFC">

    <!-- ── TOP CURVED SAPPHIRE HEADER WITH EMBEDDED FROSTED BENTO CARDS ───── -->
    <FrameLayout
        android:id="@+id/reportsHeaderLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_home_header"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="32dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Tier 1: Action Navigation Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <FrameLayout
                    android:id="@+id/btnReportsBack"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_glass_back_btn"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_back_arrow"
                        android:tint="#FFFFFF"
                        app:tint="#FFFFFF" />

                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Reports &amp; Dispatch"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:letterSpacing="-0.02" />

                    <TextView
                        android:id="@+id/lblReportsSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Download, print, amend, and share verified reports with patients"
                        android:textSize="11.5sp"
                        android:textColor="#C7DFFF"
                        android:singleLine="true"
                        android:ellipsize="end" />

                </LinearLayout>

                <!-- Refresh Button -->
                <FrameLayout
                    android:id="@+id/btnRefreshReports"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_glass_back_btn"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/imgRefreshReportsIcon"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_refresh_cw"
                        android:tint="#FFFFFF"
                        app:tint="#FFFFFF" />

                </FrameLayout>

            </LinearLayout>

            <!-- Tier 2: 4 Frosted Glass Bento KPI Stat Cards -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginTop="16dp"
                android:clipToPadding="false">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- KPI 1: Ready to Dispatch -->
                    <LinearLayout
                        android:layout_width="155dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/bg_billing_kpi_card"
                        android:paddingStart="13dp"
                        android:paddingEnd="13dp"
                        android:paddingTop="11dp"
                        android:paddingBottom="11dp"
                        android:layout_marginEnd="10dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <View
                                android:layout_width="6dp"
                                android:layout_height="6dp"
                                android:background="@drawable/bg_dot_emerald"
                                android:layout_marginEnd="6dp" />

                            <TextView
                                android:text="READY TO DISPATCH"
                                android:textSize="9.5sp"
                                android:textStyle="bold"
                                android:textColor="#C7DFFF"
                                android:letterSpacing="0.04"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/lblKpiReadyCount"
                            android:text="0"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF"
                            android:layout_marginTop="4dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                        <TextView
                            android:text="Verified &amp; Signed"
                            android:textSize="10.5sp"
                            android:textColor="#C7DFFF"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                    </LinearLayout>

                    <!-- KPI 2: Dispatched -->
                    <LinearLayout
                        android:layout_width="155dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/bg_billing_kpi_card"
                        android:paddingStart="13dp"
                        android:paddingEnd="13dp"
                        android:paddingTop="11dp"
                        android:paddingBottom="11dp"
                        android:layout_marginEnd="10dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <View
                                android:layout_width="6dp"
                                android:layout_height="6dp"
                                android:background="@drawable/bg_dot_cyan"
                                android:layout_marginEnd="6dp" />

                            <TextView
                                android:text="DISPATCHED"
                                android:textSize="9.5sp"
                                android:textStyle="bold"
                                android:textColor="#C7DFFF"
                                android:letterSpacing="0.04"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/lblKpiSentCount"
                            android:text="0"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF"
                            android:layout_marginTop="4dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                        <TextView
                            android:text="WhatsApp &amp; SMS Sent"
                            android:textSize="10.5sp"
                            android:textColor="#C7DFFF"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                    </LinearLayout>

                    <!-- KPI 3: Under Review -->
                    <LinearLayout
                        android:layout_width="155dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/bg_billing_kpi_card"
                        android:paddingStart="13dp"
                        android:paddingEnd="13dp"
                        android:paddingTop="11dp"
                        android:paddingBottom="11dp"
                        android:layout_marginEnd="10dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <View
                                android:layout_width="6dp"
                                android:layout_height="6dp"
                                android:background="@drawable/bg_dot_amber"
                                android:layout_marginEnd="6dp" />

                            <TextView
                                android:text="UNDER REVIEW"
                                android:textSize="9.5sp"
                                android:textStyle="bold"
                                android:textColor="#C7DFFF"
                                android:letterSpacing="0.04"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/lblKpiDraftCount"
                            android:text="0"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF"
                            android:layout_marginTop="4dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                        <TextView
                            android:text="Pending Doctor Sign"
                            android:textSize="10.5sp"
                            android:textColor="#C7DFFF"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                    </LinearLayout>

                    <!-- KPI 4: Amended -->
                    <LinearLayout
                        android:layout_width="155dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/bg_billing_kpi_card"
                        android:paddingStart="13dp"
                        android:paddingEnd="13dp"
                        android:paddingTop="11dp"
                        android:paddingBottom="11dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <View
                                android:layout_width="6dp"
                                android:layout_height="6dp"
                                android:background="@drawable/bg_dot_active"
                                android:layout_marginEnd="6dp" />

                            <TextView
                                android:text="AMENDED"
                                android:textSize="9.5sp"
                                android:textStyle="bold"
                                android:textColor="#C7DFFF"
                                android:letterSpacing="0.04"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/lblKpiAmendedCount"
                            android:text="0"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF"
                            android:layout_marginTop="4dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                        <TextView
                            android:text="Revision History v2+"
                            android:textSize="10.5sp"
                            android:textColor="#C7DFFF"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                    </LinearLayout>

                </LinearLayout>

            </HorizontalScrollView>

        </LinearLayout>

    </FrameLayout>

    <!-- ── SEARCH OMNIBAR ─────────────────────────────────────────── -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_search_input_field"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_search"
                android:tint="#94A3B8"
                app:tint="#94A3B8" />

            <EditText
                android:id="@+id/inputSearchReports"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="Search by patient name, phone, report ID..."
                android:textColor="#0F172A"
                android:textColorHint="#94A3B8"
                android:textSize="13.5sp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:singleLine="true"
                android:imeOptions="actionSearch" />

            <ImageView
                android:id="@+id/btnClearSearchReports"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_close_cross"
                android:tint="#94A3B8"
                app:tint="#94A3B8"
                android:visibility="gone"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

    </FrameLayout>

    <!-- ── FILTER CHIPS ───────────────────────────────────────────── -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/containerReportsFilterChips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />

    </HorizontalScrollView>

    <!-- Loading Spinner -->
    <ProgressBar
        android:id="@+id/progressReports"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="24dp"
        android:indeterminateTint="#0D6EFD"
        android:visibility="gone" />

    <!-- Reports List Recycler -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerReportsList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="6dp"
        android:paddingBottom="16dp"
        android:clipToPadding="false" />

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/emptyStateReports"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:background="@drawable/bg_mod_icon_sky"
            android:layout_marginBottom="12dp">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_mod_clean_reports" />

        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No Reports Found"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#0F172A"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No diagnostic reports matched your search or status filter."
            android:textSize="13sp"
            android:textColor="#64748B"
            android:gravity="center" />

    </LinearLayout>

</LinearLayout>
