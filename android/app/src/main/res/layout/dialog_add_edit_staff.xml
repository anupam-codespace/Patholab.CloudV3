<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Handle Bar -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:background="#CBD5E1"
            android:layout_marginBottom="16dp" />

        <!-- Title & Subtitle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/lblStaffDialogTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Add Staff Member"
                    android:textSize="18.5sp"
                    android:textStyle="bold"
                    android:textColor="#0F172A" />

                <TextView
                    android:id="@+id/lblStaffDialogSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="System will auto-generate a 9-digit Employee ID."
                    android:textSize="12sp"
                    android:textColor="#64748B" />

            </LinearLayout>

            <ImageView
                android:id="@+id/btnCloseStaffDialog"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_close_cross"
                android:tint="#94A3B8"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="4dp" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#F1F5F9"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="16dp" />

        <!-- Row 1: Full Name & Phone -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Full Name -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FULL NAME *"
                    android:textSize="10.5sp"
                    android:textStyle="bold"
                    android:textColor="#64748B"
                    android:letterSpacing="0.05" />

                <EditText
                    android:id="@+id/inputStaffName"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_setting_item"
                    android:hint="Dr. Jane Doe"
                    android:textColorHint="#94A3B8"
                    android:textColor="#0F172A"
                    android:textSize="13.5sp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:singleLine="true" />

            </LinearLayout>

            <!-- Phone -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PHONE *"
                    android:textSize="10.5sp"
                    android:textStyle="bold"
                    android:textColor="#64748B"
                    android:letterSpacing="0.05" />

                <EditText
                    android:id="@+id/inputStaffPhone"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_setting_item"
                    android:hint="9876543210"
                    android:textColorHint="#94A3B8"
                    android:textColor="#0F172A"
                    android:textSize="13.5sp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:inputType="phone"
                    android:singleLine="true" />

            </LinearLayout>

        </LinearLayout>

        <!-- Row 2: Email & Branch -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <!-- Email (Login ID) -->
            <LinearLayout
                android:id="@+id/containerStaffEmail"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="EMAIL (LOGIN ID) *"
                    android:textSize="10.5sp"
                    android:textStyle="bold"
                    android:textColor="#64748B"
                    android:letterSpacing="0.05" />

                <EditText
                    android:id="@+id/inputStaffEmail"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_setting_item"
                    android:hint="staff@patholab.cloud"
                    android:textColorHint="#94A3B8"
                    android:textColor="#0F172A"
                    android:textSize="13.5sp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:inputType="textEmailAddress"
                    android:singleLine="true" />

            </LinearLayout>

            <!-- Branch Assignment -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BRANCH ASSIGNMENT"
                    android:textSize="10.5sp"
                    android:textStyle="bold"
                    android:textColor="#64748B"
                    android:letterSpacing="0.05" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_setting_item">

                    <Spinner
                        android:id="@+id/spinnerStaffBranch"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp" />

                </FrameLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- Row 3: System Role & Position Title -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <!-- System Role -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SYSTEM ROLE *"
                    android:textSize="10.5sp"
                    android:textStyle="bold"
                    android:textColor="#64748B"
                    android:letterSpacing="0.05" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_setting_item">

                    <Spinner
                        android:id="@+id/spinnerStaffRole"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp" />

                </FrameLayout>

            </LinearLayout>

            <!-- Position Title -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="POSITION TITLE *"
                    android:textSize="10.5sp"
                    android:textStyle="bold"
                    android:textColor="#64748B"
                    android:letterSpacing="0.05" />

                <EditText
                    android:id="@+id/inputStaffPosition"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_setting_item"
                    android:hint="e.g. Senior Biochemist"
                    android:textColorHint="#94A3B8"
                    android:textColor="#0F172A"
                    android:textSize="13.5sp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:singleLine="true" />

            </LinearLayout>

        </LinearLayout>

        <!-- Row 4: Department & Salary -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <!-- Department -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DEPARTMENT"
                    android:textSize="10.5sp"
                    android:textStyle="bold"
                    android:textColor="#64748B"
                    android:letterSpacing="0.05" />

                <EditText
                    android:id="@+id/inputStaffDepartment"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_setting_item"
                    android:hint="e.g. Pathology"
                    android:textColorHint="#94A3B8"
                    android:textColor="#0F172A"
                    android:textSize="13.5sp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:singleLine="true" />

            </LinearLayout>

            <!-- Salary -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MONTHLY SALARY (₹)"
                    android:textSize="10.5sp"
                    android:textStyle="bold"
                    android:textColor="#64748B"
                    android:letterSpacing="0.05" />

                <EditText
                    android:id="@+id/inputStaffSalary"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_setting_item"
                    android:hint="e.g. 35000"
                    android:textColorHint="#94A3B8"
                    android:textColor="#0F172A"
                    android:textSize="13.5sp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:inputType="numberDecimal"
                    android:singleLine="true" />

            </LinearLayout>

        </LinearLayout>

        <!-- Custom Password Box (Add Mode Only) -->
        <LinearLayout
            android:id="@+id/containerStaffPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_bento_amber"
            android:padding="12dp"
            android:layout_marginTop="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CUSTOM PASSWORD (OPTIONAL)"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:textColor="#92400E"
                android:letterSpacing="0.05" />

            <EditText
                android:id="@+id/inputStaffPassword"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_card_white"
                android:hint="Leave blank for Password@123"
                android:textColorHint="#94A3B8"
                android:textColor="#0F172A"
                android:textSize="13.5sp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:inputType="textPassword"
                android:singleLine="true" />

        </LinearLayout>

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginTop="20dp">

            <Button
                android:id="@+id/btnCancelStaffDialog"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="@drawable/bg_btn_outline"
                android:text="Cancel"
                android:textColor="#64748B"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginEnd="10dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp" />

            <Button
                android:id="@+id/btnSubmitStaffDialog"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="@drawable/bg_btn_primary"
                android:text="Create Account"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:paddingStart="22dp"
                android:paddingEnd="22dp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
