<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_auth_gradient"
    android:orientation="vertical">

    <View android:id="@+id/statusBarSpacer" android:layout_width="match_parent" android:layout_height="0dp" />

    <!-- Header -->
    <LinearLayout
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="14dp">

        <FrameLayout
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_glass_back_btn"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_back_arrow"
                android:tint="#FFFFFF"
                app:tint="#FFFFFF" />

        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Reset Password"
                android:textColor="#FFFFFF"
                android:textSize="32sp"
                android:textStyle="bold"
                android:letterSpacing="-0.03"
                android:fontFamily="sans-serif-black"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Enter your new password below."
                android:textColor="#C7D2FE"
                android:textSize="13.5sp" />

        </LinearLayout>

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_white_card_top"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="32dp"
            android:paddingBottom="32dp">

            <LinearLayout
                android:id="@+id/errorBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:background="@drawable/bg_error_banner"
                android:padding="14dp"
                android:visibility="gone"
                android:orientation="horizontal">
                <TextView android:id="@+id/tvError"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textColor="@color/errorRed" android:textSize="14sp" />
            </LinearLayout>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="New Password"
                android:textColor="@color/textPrimary" android:textSize="14sp" android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <RelativeLayout android:layout_width="match_parent" android:layout_height="52dp">
                <EditText android:id="@+id/etNewPassword"
                    android:layout_width="match_parent" android:layout_height="match_parent"
                    android:background="@drawable/bg_input"
                    android:hint="Min. 8 characters"
                    android:inputType="textPassword"
                    android:paddingStart="16dp" android:paddingEnd="52dp"
                    android:textColor="@color/textPrimary" android:textColorHint="@color/textHint"
                    android:textSize="15sp" android:singleLine="true" />
                <ImageView android:id="@+id/ivToggleNew"
                    android:layout_width="44dp" android:layout_height="44dp"
                    android:layout_alignParentEnd="true" android:layout_centerVertical="true"
                    android:layout_marginEnd="4dp" android:padding="12dp"
                    android:src="@drawable/ic_eye_closed"
                    android:tint="@color/textHint" android:contentDescription="Toggle" />
            </RelativeLayout>
            <TextView android:id="@+id/tvNewPasswordError"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/errorRed" android:textSize="12sp"
                android:visibility="gone" android:layout_marginBottom="12dp" />

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Confirm New Password"
                android:textColor="@color/textPrimary" android:textSize="14sp" android:textStyle="bold"
                android:layout_marginTop="16dp" android:layout_marginBottom="8dp" />

            <RelativeLayout android:layout_width="match_parent" android:layout_height="52dp">
                <EditText android:id="@+id/etConfirmPassword"
                    android:layout_width="match_parent" android:layout_height="match_parent"
                    android:background="@drawable/bg_input"
                    android:hint="Re-enter new password"
                    android:inputType="textPassword"
                    android:paddingStart="16dp" android:paddingEnd="52dp"
                    android:textColor="@color/textPrimary" android:textColorHint="@color/textHint"
                    android:textSize="15sp" android:singleLine="true" />
                <ImageView android:id="@+id/ivToggleConfirm"
                    android:layout_width="44dp" android:layout_height="44dp"
                    android:layout_alignParentEnd="true" android:layout_centerVertical="true"
                    android:layout_marginEnd="4dp" android:padding="12dp"
                    android:src="@drawable/ic_eye_closed"
                    android:tint="@color/textHint" android:contentDescription="Toggle" />
            </RelativeLayout>
            <TextView android:id="@+id/tvConfirmError"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/errorRed" android:textSize="12sp"
                android:visibility="gone" android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnReset"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_btn_primary"
                android:text="Reset Password"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="normal"
                android:fontFamily="sans-serif-medium"
                android:textAllCaps="false"
                android:letterSpacing="0.01"
                android:stateListAnimator="@null" />

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="12dp"
                android:indeterminateTint="@color/indigoMid"
                android:visibility="gone" />

            <!-- Legal Links -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvTerms"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Terms &amp; Conditions"
                    android:textColor="@color/textSecondary"
                    android:textSize="11sp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:text="•"
                    android:textColor="@color/textHint"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/tvPrivacy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Privacy Policy"
                    android:textColor="@color/textSecondary"
                    android:textSize="11sp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:text="•"
                    android:textColor="@color/textHint"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/tvRefunds"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Refund Policy"
                    android:textColor="@color/textSecondary"
                    android:textSize="11sp"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="© 2026 Globizhub India Pvt. Ltd. · All rights reserved"
                android:textColor="@color/textHint"
                android:textSize="12sp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
