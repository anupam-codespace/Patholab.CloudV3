<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_auth_gradient"
    android:orientation="vertical">

    <View android:id="@+id/statusBarSpacer" android:layout_width="match_parent" android:layout_height="0dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingTop="20dp"
        android:paddingBottom="36dp">

        <LinearLayout
            android:id="@+id/btnBack"
            android:layout_width="40dp" android:layout_height="40dp"
            android:background="@drawable/bg_back_btn"
            android:gravity="center" android:layout_marginBottom="20dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="‹" android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold" />
        </LinearLayout>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Reset Password"
            android:textColor="#FFFFFF" android:textSize="32sp" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Enter your new password below."
            android:textColor="#C7D2FE" android:textSize="14sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_white_card_top"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="32dp"
            android:paddingBottom="32dp">

            <LinearLayout
                android:id="@+id/errorBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:background="@drawable/bg_error_banner"
                android:padding="14dp"
                android:visibility="gone"
                android:orientation="horizontal">
                <TextView android:id="@+id/tvError"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textColor="@color/errorRed" android:textSize="14sp" />
            </LinearLayout>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="New Password"
                android:textColor="@color/textPrimary" android:textSize="14sp" android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <RelativeLayout android:layout_width="match_parent" android:layout_height="52dp">
                <EditText android:id="@+id/etNewPassword"
                    android:layout_width="match_parent" android:layout_height="match_parent"
                    android:background="@drawable/bg_input"
                    android:hint="Min. 8 characters"
                    android:inputType="textPassword"
                    android:paddingStart="16dp" android:paddingEnd="52dp"
                    android:textColor="@color/textPrimary" android:textColorHint="@color/textHint"
                    android:textSize="15sp" android:singleLine="true" />
                <ImageView android:id="@+id/ivToggleNew"
                    android:layout_width="44dp" android:layout_height="44dp"
                    android:layout_alignParentEnd="true" android:layout_centerVertical="true"
                    android:layout_marginEnd="4dp" android:padding="12dp"
                    android:src="@android:drawable/ic_menu_view"
                    android:tint="@color/textHint" android:contentDescription="Toggle" />
            </RelativeLayout>
            <TextView android:id="@+id/tvNewPasswordError"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/errorRed" android:textSize="12sp"
                android:visibility="gone" android:layout_marginBottom="12dp" />

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Confirm New Password"
                android:textColor="@color/textPrimary" android:textSize="14sp" android:textStyle="bold"
                android:layout_marginTop="16dp" android:layout_marginBottom="8dp" />

            <RelativeLayout android:layout_width="match_parent" android:layout_height="52dp">
                <EditText android:id="@+id/etConfirmPassword"
                    android:layout_width="match_parent" android:layout_height="match_parent"
                    android:background="@drawable/bg_input"
                    android:hint="Re-enter new password"
                    android:inputType="textPassword"
                    android:paddingStart="16dp" android:paddingEnd="52dp"
                    android:textColor="@color/textPrimary" android:textColorHint="@color/textHint"
                    android:textSize="15sp" android:singleLine="true" />
                <ImageView android:id="@+id/ivToggleConfirm"
                    android:layout_width="44dp" android:layout_height="44dp"
                    android:layout_alignParentEnd="true" android:layout_centerVertical="true"
                    android:layout_marginEnd="4dp" android:padding="12dp"
                    android:src="@android:drawable/ic_menu_view"
                    android:tint="@color/textHint" android:contentDescription="Toggle" />
            </RelativeLayout>
            <TextView android:id="@+id/tvConfirmError"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/errorRed" android:textSize="12sp"
                android:visibility="gone" android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnReset"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_btn_primary"
                android:text="Reset Password"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:stateListAnimator="@null" />

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="12dp"
                android:indeterminateTint="@color/indigoMid"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
