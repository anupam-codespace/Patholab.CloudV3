<?xml version="1.0" encoding="utf-8"?>
<!-- Clean, Modern Custom Field Bento Card -->
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="18dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardPreventCornerOverlap="false"
    android:layout_marginStart="4dp"
    android:layout_marginEnd="4dp"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Top Row: Type Badge + Layout Pill + Print Badge + Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Field Type Badge -->
            <TextView
                android:id="@+id/lblCustomFieldType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_mod_icon_teal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:text="DROPDOWN"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#0D9488" />

            <!-- Report Layout Pill -->
            <TextView
                android:id="@+id/lblCustomFieldLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_setting_item"
                android:paddingStart="7dp"
                android:paddingEnd="7dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:text="Full Width"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:textColor="#475569" />

            <!-- Printable Pill -->
            <TextView
                android:id="@+id/lblCustomFieldPrintable"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_tag_emerald"
                android:paddingStart="7dp"
                android:paddingEnd="7dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:text="Print On Report"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:textColor="#059669" />

            <!-- Spacer -->
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Edit Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEditCustomField"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:backgroundTint="#EFF6FF"
                app:cornerRadius="9dp"
                app:strokeColor="#BFDBFE"
                app:strokeWidth="1dp"
                android:elevation="0dp"
                app:icon="@drawable/ic_edit_pen"
                app:iconTint="#2563EB"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                android:padding="0dp" />

            <!-- Delete Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDeleteCustomField"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="6dp"
                android:backgroundTint="#FFF1F2"
                app:cornerRadius="9dp"
                app:strokeColor="#FECDD3"
                app:strokeWidth="1dp"
                android:elevation="0dp"
                app:icon="@drawable/ic_trash"
                app:iconTint="#E11D48"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                android:padding="0dp" />

        </LinearLayout>

        <!-- Field Name -->
        <TextView
            android:id="@+id/lblCustomFieldName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Clinical History &amp; Drug Intake"
            android:textSize="15.5sp"
            android:textStyle="bold"
            android:textColor="#0F172A" />

        <!-- Options Container (for dropdowns) -->
        <TextView
            android:id="@+id/lblCustomFieldOptions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Options: Diabetic, Hypertensive, On Antibiotics, Nil"
            android:textSize="12sp"
            android:textColor="#64748B"
            android:visibility="gone" />

        <!-- Bottom Row: Usage Count Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/lblCustomFieldUsedIn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_bento_blue"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:text="Used in 4 Test Templates"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#0D6EFD" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
