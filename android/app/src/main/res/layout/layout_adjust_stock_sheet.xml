<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Adjust Stock Quantity"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#0F172A" />
        <ImageView
            android:id="@+id/btnAdjustStockClose"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_close" />
    </LinearLayout>

    <TextView
        android:id="@+id/lblAdjustStockItem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Item Name"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#2563EB" />

    <TextView
        android:id="@+id/lblAdjustCurrentQty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Current Stock: 100 units"
        android:textSize="12.5sp"
        android:textColor="#64748B" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/chipAdjustAdd"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="+ Add Stock (Restock)"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/bg_chip_active"
            android:textColor="#FFFFFF" />
        <TextView
            android:id="@+id/chipAdjustSubtract"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:text="- Reduce (Consumed)"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/bg_chip_inactive"
            android:textColor="#64748B" />
    </LinearLayout>

    <EditText
        android:id="@+id/inputAdjustQty"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_input_field"
        android:hint="Quantity Change (e.g. 50)"
        android:inputType="number"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/inputAdjustReason"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_input_field"
        android:hint="Reason / Reference (e.g. New Batch PO-492)"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/lblAdjustError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#DC2626"
        android:textSize="12sp"
        android:visibility="gone" />

    <Button
        android:id="@+id/btnConfirmAdjust"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_btn_primary"
        android:text="Confirm Stock Adjustment"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />

    <ProgressBar
        android:id="@+id/progressAdjustStock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="8dp"
        android:visibility="gone" />
</LinearLayout>
