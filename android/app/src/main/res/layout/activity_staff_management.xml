<?xml version="1.0" encoding="utf-8"?>
<!-- Native Independent Staff Directory & Access Management Console -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8FAFC">

    <!-- ── TOP CURVED SAPPHIRE HEADER ─────────────────────────────── -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_home_header"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="26dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Top Row: Back + Title & Badge + Actions -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <FrameLayout
                    android:id="@+id/btnStaffBack"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_glass_back_btn"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_back_arrow"
                        android:tint="#FFFFFF"
                        app:tint="#FFFFFF" />

                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Staff Directory"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:letterSpacing="-0.02" />

                    <TextView
                        android:id="@+id/lblStaffCountBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:visibility="gone" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Manage access, roles, and branch assignments."
                        android:textSize="11.5sp"
                        android:textColor="#C7DFFF" />

                </LinearLayout>

                <!-- Refresh Button -->
                <FrameLayout
                    android:id="@+id/btnRefreshStaff"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_glass_back_btn"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/imgRefreshStaffIcon"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_refresh_cw"
                        android:tint="#FFFFFF"
                        app:tint="#FFFFFF" />

                </FrameLayout>

                <!-- + Add Staff Button -->
                <LinearLayout
                    android:id="@+id/btnAddStaffHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:background="@drawable/bg_wallet_pill"
                    android:paddingStart="12dp"
                    android:paddingEnd="14dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_plus"
                        android:tint="#FFFFFF"
                        app:tint="#FFFFFF"
                        android:layout_marginEnd="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Add Staff"
                        android:textSize="12.5sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </FrameLayout>

    <!-- ── KPI STATISTICS CARDS (Horizontal Scroll) ────────────────── -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="4dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Card 1: Total Staff -->
            <LinearLayout
                android:layout_width="144dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_setting_item"
                android:padding="12dp"
                android:layout_marginEnd="8dp"
                android:elevation="2dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TOTAL STAFF"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="#64748B"
                    android:letterSpacing="0.05" />

                <TextView
                    android:id="@+id/lblKpiTotalStaff"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="0"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#0D6EFD" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="All Lab Members"
                    android:textSize="11sp"
                    android:textColor="#94A3B8" />

            </LinearLayout>

            <!-- Card 2: Active Access -->
            <LinearLayout
                android:layout_width="144dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_setting_item"
                android:padding="12dp"
                android:layout_marginEnd="8dp"
                android:elevation="2dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ACTIVE ACCESS"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="#64748B"
                    android:letterSpacing="0.05" />

                <TextView
                    android:id="@+id/lblKpiActiveStaff"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="0"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#059669" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="Active Logins"
                    android:textSize="11sp"
                    android:textColor="#94A3B8" />

            </LinearLayout>

            <!-- Card 3: Suspended -->
            <LinearLayout
                android:layout_width="144dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_setting_item"
                android:padding="12dp"
                android:layout_marginEnd="8dp"
                android:elevation="2dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SUSPENDED"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="#64748B"
                    android:letterSpacing="0.05" />

                <TextView
                    android:id="@+id/lblKpiSuspendedStaff"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="0"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#DC2626" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="Revoked Access"
                    android:textSize="11sp"
                    android:textColor="#94A3B8" />

            </LinearLayout>

            <!-- Card 4: Technicians -->
            <LinearLayout
                android:layout_width="144dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_setting_item"
                android:padding="12dp"
                android:layout_marginEnd="8dp"
                android:elevation="2dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TECHNICIANS"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="#64748B"
                    android:letterSpacing="0.05" />

                <TextView
                    android:id="@+id/lblKpiTechnicians"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="0"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#7C3AED" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="Lab Processing"
                    android:textSize="11sp"
                    android:textColor="#94A3B8" />

            </LinearLayout>

            <!-- Card 5: Doctors / Pathologists -->
            <LinearLayout
                android:layout_width="144dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_setting_item"
                android:padding="12dp"
                android:layout_marginEnd="8dp"
                android:elevation="2dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DOCTORS"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="#64748B"
                    android:letterSpacing="0.05" />

                <TextView
                    android:id="@+id/lblKpiDoctors"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="0"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#0284C7" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="Medical &amp; Approvals"
                    android:textSize="11sp"
                    android:textColor="#94A3B8" />

            </LinearLayout>

            <!-- Card 6: Receptionists -->
            <LinearLayout
                android:layout_width="144dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_setting_item"
                android:padding="12dp"
                android:elevation="2dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RECEPTIONISTS"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="#64748B"
                    android:letterSpacing="0.05" />

                <TextView
                    android:id="@+id/lblKpiReceptionists"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="0"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#D97706" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="Billing &amp; Accession"
                    android:textSize="11sp"
                    android:textColor="#94A3B8" />

            </LinearLayout>

        </LinearLayout>

    </HorizontalScrollView>

    <!-- ── SEARCH OMNIBAR ─────────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_setting_item"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginTop="6dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_search"
            android:tint="#94A3B8" />

        <EditText
            android:id="@+id/inputSearchStaff"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:hint="Search staff ID, name, email, role..."
            android:textColorHint="#94A3B8"
            android:textColor="#0F172A"
            android:textSize="13.5sp"
            android:layout_marginStart="10dp"
            android:singleLine="true"
            android:imeOptions="actionSearch" />

        <ImageView
            android:id="@+id/btnClearSearchStaff"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_close_circle"
            android:tint="#94A3B8"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <!-- ── FILTER CHIPS (Horizontal Scroll) ───────────────────────── -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="8dp"
        android:paddingBottom="6dp"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/containerStaffFilterChips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />

    </HorizontalScrollView>

    <!-- ── RECYCLER VIEW & STATES CONTAINER ───────────────────────── -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Progress Bar -->
        <ProgressBar
            android:id="@+id/progressStaff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="#0D6EFD"
            android:visibility="gone" />

        <!-- Staff Recycler View -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerStaffDirectory"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingBottom="88dp"
            android:clipToPadding="false" />

        <!-- Empty State View -->
        <LinearLayout
            android:id="@+id/emptyStateStaff"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👥"
                android:textSize="48sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="No Staff Members Found"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#0F172A" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="No staff members matched your search or filter criteria."
                android:textSize="13sp"
                android:textColor="#64748B"
                android:gravity="center" />

            <Button
                android:id="@+id/btnAddStaffEmpty"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_btn_primary"
                android:text="+ Add First Staff Member"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:paddingStart="20dp"
                android:paddingEnd="20dp" />

        </LinearLayout>

        <!-- ── EXTENDED FLOATING ACTION BUTTON (+ ADD STAFF) ────────── -->
        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/fabAddStaff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="18dp"
            android:layout_marginBottom="24dp"
            android:text="+ Add Staff"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            app:icon="@drawable/ic_plus"
            app:iconTint="#FFFFFF"
            app:backgroundTint="#0D6EFD"
            android:elevation="6dp" />

    </FrameLayout>

</LinearLayout>
