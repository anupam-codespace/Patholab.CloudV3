<?xml version="1.0" encoding="utf-8"?>
<!-- Biological Reference Range Condition Card Item -->
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="14dp"
    app:cardElevation="1dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardPreventCornerOverlap="false"
    android:layout_marginBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Top Row: Condition Title & Delete Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/lblRangeConditionTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Condition Interval #1"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#0F172A" />

            <ImageView
                android:id="@+id/btnDeleteRangeRow"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_trash"
                android:tint="#E11D48"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="4dp"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

        <!-- Report Display Text (Qualitative/Text Override) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Report Display Text (Ref Range Column)"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:textColor="#475569"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/inputRangeTextValue"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:background="@drawable/bg_input_field"
            android:hint="e.g. 13.5 - 17.5 g/dL"
            android:inputType="text"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:textSize="13sp"
            android:textColor="#0F172A"
            android:textColorHint="#94A3B8"
            android:layout_marginBottom="10dp"
            android:singleLine="true" />

        <!-- Gender / Condition & Custom Label -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.2"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gender / Cohort *"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    android:textColor="#475569"
                    android:layout_marginBottom="4dp" />

                <Spinner
                    android:id="@+id/spinnerRangeGender"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_input_field"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.2"
                android:layout_marginStart="8dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Custom Label"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    android:textColor="#475569"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/inputRangeCustomLabel"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_input_field"
                    android:hint="e.g. Child / Infant"
                    android:inputType="text"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:textSize="13sp"
                    android:textColor="#0F172A"
                    android:textColorHint="#94A3B8"
                    android:singleLine="true" />

            </LinearLayout>

        </LinearLayout>

        <!-- Age Interval (Min Age, Max Age, Age Unit) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Min Age *"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    android:textColor="#475569"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/inputRangeMinAge"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_input_field"
                    android:hint="0"
                    android:inputType="number"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:textSize="13sp"
                    android:textColor="#0F172A"
                    android:singleLine="true" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Max Age *"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    android:textColor="#475569"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/inputRangeMaxAge"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_input_field"
                    android:hint="100"
                    android:inputType="number"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:textSize="13sp"
                    android:textColor="#0F172A"
                    android:singleLine="true" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.1"
                android:layout_marginStart="8dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Age Unit *"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    android:textColor="#475569"
                    android:layout_marginBottom="4dp" />

                <Spinner
                    android:id="@+id/spinnerRangeAgeUnit"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_input_field"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Numeric Values: Normal Low, Normal High, Panic Low, Panic High -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Low (Num)"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#059669"
                    android:layout_marginBottom="3dp" />

                <EditText
                    android:id="@+id/inputRangeLowValue"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_input_field"
                    android:hint="0.0"
                    android:inputType="numberDecimal"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:textSize="12.5sp"
                    android:textColor="#0F172A"
                    android:singleLine="true" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="High (Num)"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#059669"
                    android:layout_marginBottom="3dp" />

                <EditText
                    android:id="@+id/inputRangeHighValue"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_input_field"
                    android:hint="0.0"
                    android:inputType="numberDecimal"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:textSize="12.5sp"
                    android:textColor="#0F172A"
                    android:singleLine="true" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Panic Low"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#DC2626"
                    android:layout_marginBottom="3dp" />

                <EditText
                    android:id="@+id/inputRangeCriticalLow"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_mod_icon_rose"
                    android:hint="Panic"
                    android:inputType="numberDecimal"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:textSize="12.5sp"
                    android:textColor="#DC2626"
                    android:singleLine="true" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Panic High"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#DC2626"
                    android:layout_marginBottom="3dp" />

                <EditText
                    android:id="@+id/inputRangeCriticalHigh"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_mod_icon_rose"
                    android:hint="Panic"
                    android:inputType="numberDecimal"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:textSize="12.5sp"
                    android:textColor="#DC2626"
                    android:singleLine="true" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
