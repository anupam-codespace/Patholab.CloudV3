<?xml version="1.0" encoding="utf-8"?>
<!-- ══ Premium Billing & Invoices Console ══ -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F0F4FF">

    <!-- ══════════════════════════════════════════════════════════════
         HEADER SECTION — Deep Navy Gradient
         ══════════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_home_header"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="14dp">

        <!-- Top Row: Back + Title -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="0dp">

            <FrameLayout
                android:id="@+id/btnBillingBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_white_circle_btn"
                android:elevation="3dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_back_arrow"
                    android:tint="#0D6EFD"
                    app:tint="#0D6EFD" />

            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Billing &amp; Invoices"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:letterSpacing="-0.02" />

                <TextView
                    android:id="@+id/lblBillingSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Financial Ledger &amp; Revenue Hub"
                    android:textSize="12sp"
                    android:textColor="#C7DFFF" />

            </LinearLayout>

        </LinearLayout>

        <!-- 2x2 Clean Responsive Grid for KPI Cards -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical">

            <!-- ROW 1: TOTAL REVENUE & THIS MONTH -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <!-- KPI 1: Total Revenue -->
                <LinearLayout
                    android:id="@+id/cardKpiTotalRevenue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/bg_billing_kpi_card"
                    android:paddingStart="13dp"
                    android:paddingEnd="13dp"
                    android:paddingTop="11dp"
                    android:paddingBottom="11dp"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <View
                            android:layout_width="6dp"
                            android:layout_height="6dp"
                            android:background="@drawable/shape_dot_emerald"
                            android:layout_marginEnd="6dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TOTAL REVENUE"
                            android:textSize="9.5sp"
                            android:textStyle="bold"
                            android:textColor="#93C5FD"
                            android:letterSpacing="0.06" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/lblKpiTotalRevenue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="₹0"
                        android:textSize="20sp"
                        android:fontFamily="sans-serif-black"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/lblKpiTotalSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="All time collections"
                        android:textSize="10sp"
                        android:textColor="#BFDBFE"
                        android:maxLines="1"
                        android:ellipsize="end" />

                </LinearLayout>

                <!-- KPI 2: This Month Revenue -->
                <LinearLayout
                    android:id="@+id/cardKpiMonthlyRevenue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/bg_billing_kpi_card_cyan"
                    android:paddingStart="13dp"
                    android:paddingEnd="13dp"
                    android:paddingTop="11dp"
                    android:paddingBottom="11dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <View
                            android:layout_width="6dp"
                            android:layout_height="6dp"
                            android:background="@drawable/shape_dot_cyan"
                            android:layout_marginEnd="6dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="THIS MONTH"
                            android:textSize="9.5sp"
                            android:textStyle="bold"
                            android:textColor="#7DD3FC"
                            android:letterSpacing="0.06" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/lblKpiMonthlyRevenue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="₹0"
                        android:textSize="20sp"
                        android:fontFamily="sans-serif-black"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/lblKpiMonthlySubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Current month"
                        android:textSize="10sp"
                        android:textColor="#BAE6FD"
                        android:maxLines="1"
                        android:ellipsize="end" />

                </LinearLayout>

            </LinearLayout>

            <!-- ROW 2: SETTLED INVOICES & TOTAL INVOICES -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- KPI 3: Settled Invoices -->
                <LinearLayout
                    android:id="@+id/cardKpiSettled"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/bg_billing_kpi_card_emerald"
                    android:paddingStart="13dp"
                    android:paddingEnd="13dp"
                    android:paddingTop="11dp"
                    android:paddingBottom="11dp"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <View
                            android:layout_width="6dp"
                            android:layout_height="6dp"
                            android:background="@drawable/shape_dot_emerald"
                            android:layout_marginEnd="6dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SETTLED INVOICES"
                            android:textSize="9.5sp"
                            android:textStyle="bold"
                            android:textColor="#6EE7B7"
                            android:letterSpacing="0.06" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/lblKpiSettledCount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="0"
                        android:textSize="20sp"
                        android:fontFamily="sans-serif-black"
                        android:textStyle="bold"
                        android:textColor="#34D399"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/lblKpiSettledSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Fully paid"
                        android:textSize="10sp"
                        android:textColor="#A7F3D0"
                        android:maxLines="1"
                        android:ellipsize="end" />

                </LinearLayout>

                <!-- KPI 4: Total Invoices -->
                <LinearLayout
                    android:id="@+id/cardKpiTotalInvoices"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/bg_billing_kpi_card_indigo"
                    android:paddingStart="13dp"
                    android:paddingEnd="13dp"
                    android:paddingTop="11dp"
                    android:paddingBottom="11dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <View
                            android:layout_width="6dp"
                            android:layout_height="6dp"
                            android:background="@drawable/shape_dot_indigo"
                            android:layout_marginEnd="6dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TOTAL INVOICES"
                            android:textSize="9.5sp"
                            android:textStyle="bold"
                            android:textColor="#A5B4FC"
                            android:letterSpacing="0.06" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/lblKpiTotalInvoicesCount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="0"
                        android:textSize="20sp"
                        android:fontFamily="sans-serif-black"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/lblKpiTotalInvoicesSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="All generated"
                        android:textSize="10sp"
                        android:textColor="#C7D2FE"
                        android:maxLines="1"
                        android:ellipsize="end" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- ══════════════════════════════════════════════════════════════
         SEARCH + FILTER SECTION
         ══════════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="4dp">

        <!-- Search Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_input_field"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:elevation="2dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_search"
                android:tint="#94A3B8" />

            <EditText
                android:id="@+id/inputSearchInvoices"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:background="@android:color/transparent"
                android:hint="Search by invoice #, patient name, phone..."
                android:inputType="text"
                android:textSize="13.5sp"
                android:textColor="#0F172A"
                android:textColorHint="#94A3B8"
                android:singleLine="true" />

            <ImageView
                android:id="@+id/btnClearSearchInvoices"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_close_cross"
                android:tint="#94A3B8"
                android:visibility="gone"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

        <!-- Filter Chips Row -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/containerBillingFilterChips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />

        </HorizontalScrollView>

    </LinearLayout>

    <!-- Loading Spinner -->
    <ProgressBar
        android:id="@+id/progressBilling"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:indeterminateTint="#1D4ED8"
        android:visibility="gone" />

    <!-- ══════════════════════════════════════════════════════════════
         INVOICE LIST RECYCLER
         ══════════════════════════════════════════════════════════════ -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerInvoicesList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="4dp"
        android:paddingBottom="12dp"
        android:clipToPadding="false" />

    <!-- ══════════════════════════════════════════════════════════════
         EMPTY STATE
         ══════════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/emptyStateBilling"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/bg_mod_icon_blue"
            android:layout_marginBottom="16dp">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_mod_clean_billing" />

        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No Invoices Found"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#1E3A8A"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No invoice transactions matched your search or status filter."
            android:textSize="13sp"
            android:textColor="#64748B"
            android:gravity="center" />

    </LinearLayout>

</LinearLayout>
