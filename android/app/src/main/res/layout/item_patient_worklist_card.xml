<?xml version="1.0" encoding="utf-8"?>
<!-- Native Bento Patient Visit Worklist Card Layout -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="6dp"
    android:paddingEnd="6dp"
    android:paddingTop="5dp"
    android:paddingBottom="5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_setting_item"
        android:padding="16dp"
        android:elevation="2dp">

        <!-- Top Header Row: Visit ID + TAT Clock + Status Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Visit ID Badge -->
            <TextView
                android:id="@+id/lblWorklistVisitId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_white"
                android:backgroundTint="#F1F5F9"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:text="INV-1001"
                android:textSize="11.5sp"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:textColor="#0F172A" />

            <!-- Turnaround Time (TAT) Badge -->
            <LinearLayout
                android:id="@+id/containerTatBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_pill_white"
                android:backgroundTint="#ECFDF5"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp">

                <ImageView
                    android:id="@+id/lblTatIcon"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ic_clock_outline"
                    android:tint="#059669"
                    app:tint="#059669" />

                <TextView
                    android:id="@+id/lblTatDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="01h 45m"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#059669" />

            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Status Badge -->
            <TextView
                android:id="@+id/lblWorklistStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_white"
                android:backgroundTint="#ECFDF5"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:text="Ready &amp; Approved"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#059669" />

        </LinearLayout>

        <!-- Patient Demographics Row with Standardized Avatar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="10dp">

            <!-- Standardized Patient Avatar -->
            <ImageView
                android:id="@+id/lblWorklistPatientAvatar"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:src="@drawable/ic_patient_avatar"
                android:scaleType="centerCrop" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="10dp">

                <TextView
                    android:id="@+id/lblWorklistPatientName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PRATIMA GHOSH"
                    android:textSize="15.5sp"
                    android:textStyle="bold"
                    android:textColor="#0F172A" />

                <TextView
                    android:id="@+id/lblWorklistPatientDetails"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="45 Yrs • Female • UHID: P-00096"
                    android:textSize="11.5sp"
                    android:textColor="#64748B" />

            </LinearLayout>

        </LinearLayout>

        <!-- Referral Doctor & Agency -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="6dp">

            <TextView
                android:id="@+id/lblWorklistDoctor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_white"
                android:backgroundTint="#FEF08A"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:text="Dr. Subhajit Mondal"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#0F172A" />

        </LinearLayout>

        <!-- Investigation Tests Assigned Box -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#F8FAFC"
            android:padding="10dp"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/lblWorklistTestsList"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="5dp"
                android:text="Complete Blood Count (CBC) [Ready] • Vitamin D (25-OH) [Ready]"
                android:textSize="12.5sp"
                android:textStyle="bold"
                android:textColor="#1E293B" />

            <!-- Financial Breakdown Row -->
            <TextView
                android:id="@+id/lblWorklistFinancials"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Total Bill: ₹2,450 • Paid: ₹2,450 • Due: ₹0 (PAID)"
                android:textSize="11sp"
                android:textColor="#64748B" />

        </LinearLayout>

        <!-- Action Buttons Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical">

            <!-- Enter Results Button -->
            <TextView
                android:id="@+id/btnWorklistEnterResults"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.2"
                android:background="@drawable/bg_pill_white"
                android:backgroundTint="#EFF6FF"
                android:gravity="center"
                android:text="Enter Results"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#0D6EFD"
                android:clickable="true"
                android:focusable="true" />

            <!-- View Report Button with Official Report Folder Icon -->
            <LinearLayout
                android:id="@+id/btnWorklistViewReport"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.1"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_pill_white"
                android:backgroundTint="#ECFDF5"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_report_folder" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Report"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#059669" />

            </LinearLayout>

            <!-- Invoice Slip -->
            <FrameLayout
                android:id="@+id/btnWorklistInvoiceSlip"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_pill_white"
                android:backgroundTint="#F1F5F9"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_document"
                    android:tint="#475569"
                    app:tint="#475569" />

            </FrameLayout>

            <!-- WhatsApp Share with Official WhatsApp Logo -->
            <FrameLayout
                android:id="@+id/btnWorklistWhatsapp"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_pill_white"
                android:backgroundTint="#DCFCE7"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_whatsapp_logo" />

            </FrameLayout>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
