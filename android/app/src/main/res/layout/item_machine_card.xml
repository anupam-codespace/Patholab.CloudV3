<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_stat_card"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/lblMachineName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Machine Name"
            android:textSize="14.5sp"
            android:textStyle="bold"
            android:textColor="#0F172A" />

        <TextView
            android:id="@+id/lblMachineModality"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_pill_indigo_soft"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="CT"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#4F46E5" />

        <TextView
            android:id="@+id/lblMachineStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_status_ready"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="ACTIVE"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#059669" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/lblMachineAeTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="AE: SOMATOM_CT"
            android:textSize="12sp"
            android:textColor="#475569" />
        <TextView
            android:id="@+id/lblMachineIp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="IP: 192.168.1.100:104"
            android:textSize="12sp"
            android:textColor="#64748B" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="end">
        <TextView
            android:id="@+id/btnEditMachine"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:text="Edit"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#2563EB" />
        <TextView
            android:id="@+id/btnDeleteMachine"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Delete"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#DC2626" />
    </LinearLayout>
</LinearLayout>
