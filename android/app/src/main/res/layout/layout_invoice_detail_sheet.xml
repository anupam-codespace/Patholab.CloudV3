<?xml version="1.0" encoding="utf-8"?>
<!-- Invoice Detail & Receipt Breakdown Bottom Sheet -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="44dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="#CBD5E1" />

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/lblSheetInvoiceNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Invoice #INV-10492"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#0F172A"
                android:letterSpacing="-0.01" />

            <TextView
                android:id="@+id/lblSheetInvoiceDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Date: 01 Sep, 2026 • 02:45 PM"
                android:textSize="12.5sp"
                android:textColor="#64748B" />

        </LinearLayout>

        <FrameLayout
            android:id="@+id/btnCloseInvoiceSheet"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_bell_btn"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_close_cross"
                android:tint="#475569" />

        </FrameLayout>

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#F1F5F9" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Patient Demographic Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#F8FAFC"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="14dp">

                    <ImageView
                        android:id="@+id/imgSheetPatientAvatar"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:src="@drawable/ic_patient_avatar"
                        android:scaleType="centerCrop" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="10dp">

                        <TextView
                            android:id="@+id/lblSheetPatientName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ramesh Sen"
                            android:textSize="15.5sp"
                            android:textStyle="bold"
                            android:textColor="#0F172A" />

                        <TextView
                            android:id="@+id/lblSheetPatientMeta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Phone: +91 98765 43210 • 42Y, Male • Ref: Self"
                            android:textSize="12.5sp"
                            android:textColor="#64748B" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Itemized Investigation Line Items Heading -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Investigation Items"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#475569"
                android:layout_marginBottom="8dp" />

            <!-- Tests Container List -->
            <LinearLayout
                android:id="@+id/containerInvoiceItemsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp" />

            <!-- Financial Summary Box -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#EFF6FF"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Subtotal -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="6dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Subtotal"
                            android:textSize="13sp"
                            android:textColor="#475569" />

                        <TextView
                            android:id="@+id/lblSheetSubtotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="₹1,250.00"
                            android:textSize="13.5sp"
                            android:textStyle="bold"
                            android:textColor="#0F172A" />

                    </LinearLayout>

                    <!-- Discount -->
                    <LinearLayout
                        android:id="@+id/rowSheetDiscount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="6dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Discount"
                            android:textSize="13sp"
                            android:textColor="#475569" />

                        <TextView
                            android:id="@+id/lblSheetDiscount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="- ₹0.00"
                            android:textSize="13.5sp"
                            android:textStyle="bold"
                            android:textColor="#059669" />

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#DBEAFE"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="10dp" />

                    <!-- Grand Total -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Grand Total"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="#0F172A" />

                        <TextView
                            android:id="@+id/lblSheetGrandTotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="₹1,250.00"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="#0D6EFD" />

                    </LinearLayout>

                    <!-- Paid Amount -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/lblSheetPaidAmount"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Paid: ₹1,250.00"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#059669" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Close Action Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDoneInvoiceDetail"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Close Receipt"
                android:textSize="14.5sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#0D6EFD"
                app:cornerRadius="16dp"
                android:textAllCaps="false" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>
