<?xml version="1.0" encoding="utf-8"?>
<!-- Test Card container for Results Entry workstation -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_pill_white"
    android:backgroundTint="#FFFFFF"
    android:elevation="1dp">

    <!-- Dark Slate Test Title Strip -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:background="@drawable/bg_pill_white"
        android:backgroundTint="#0F172A"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:id="@+id/lblCardTestName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Complete Blood Count"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/lblCardTestStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PENDING"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#94A3B8"
            android:background="@drawable/bg_pill_white"
            android:backgroundTint="#1E293B"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp" />

    </LinearLayout>

    <!-- Dynamic Parameter Rows Container -->
    <LinearLayout
        android:id="@+id/containerCardParams"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <!-- Rows inflated from item_results_param_row.xml -->
    </LinearLayout>

    <!-- Notes and Impression Area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#F8FAFC">

        <!-- Internal Lab Notes -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="INTERNAL LAB NOTES"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:textColor="#64748B" />

        <EditText
            android:id="@+id/inputCardNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="54dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_pill_white"
            android:backgroundTint="#FFFFFF"
            android:hint="Add technical remarks or observations..."
            android:textColorHint="#94A3B8"
            android:textColor="#0F172A"
            android:textSize="13sp"
            android:gravity="top|start"
            android:padding="10dp"
            android:inputType="textMultiLine" />

        <!-- Doctor's Clinical Impression -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="DOCTOR'S CLINICAL IMPRESSION"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:textColor="#64748B" />

        <EditText
            android:id="@+id/inputCardImpression"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="54dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_pill_white"
            android:backgroundTint="#FFFFFF"
            android:hint="Clinical impression (prints on official diagnostic report)..."
            android:textColorHint="#94A3B8"
            android:textColor="#0F172A"
            android:textSize="13sp"
            android:gravity="top|start"
            android:padding="10dp"
            android:inputType="textMultiLine" />

    </LinearLayout>

</LinearLayout>
