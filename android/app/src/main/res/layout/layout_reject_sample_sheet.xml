<?xml version="1.0" encoding="utf-8"?>
<!-- Bottom Sheet Modal for Specimen Quality Rejection & Recollection -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet"
    android:padding="24dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_skeleton_line"
        android:layout_marginBottom="16dp" />

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_pill_white"
            android:backgroundTint="#FEF2F2">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_alert_triangle"
                android:tint="#EF4444" />

        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reject Specimen / Flag Quality"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#991B1B" />

            <TextView
                android:id="@+id/lblRejectSampleSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Flag sample for recollection or laboratory quality rejection"
                android:textSize="12sp"
                android:textColor="#64748B" />

        </LinearLayout>

    </LinearLayout>

    <!-- Medical Rejection Reasons Spinner -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Select Rejection Reason (NABL / CAP Standard)"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#475569" />

    <Spinner
        android:id="@+id/spinnerRejectReason"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_setting_item"
        android:paddingStart="14dp"
        android:paddingEnd="14dp" />

    <!-- Phlebotomist / Lab Notes -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Quality Remarks / Re-draw Instructions"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#475569" />

    <EditText
        android:id="@+id/inputRejectNotes"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_setting_item"
        android:hint="e.g. Sample severely hemolyzed during venipuncture. Phlebotomy team notified for immediate redraw."
        android:textColorHint="#94A3B8"
        android:textColor="#0F172A"
        android:textSize="13sp"
        android:padding="12dp"
        android:gravity="top|start" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCancelReject"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:backgroundTint="#F1F5F9"
            android:text="Cancel"
            android:textColor="#475569"
            android:textStyle="bold"
            app:cornerRadius="12dp" />

        <Button
            android:id="@+id/btnConfirmReject"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.6"
            android:layout_marginStart="10dp"
            android:backgroundTint="#DC2626"
            android:text="Confirm Rejection"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            app:cornerRadius="12dp" />

    </LinearLayout>

</LinearLayout>
