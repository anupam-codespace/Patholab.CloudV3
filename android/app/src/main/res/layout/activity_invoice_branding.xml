<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8FAFC">

    <!-- ══════════════════════════════════════════════════════════════
         HERO HEADER — Deep Navy & Sapphire Luxury Gradient
         ══════════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/brandingHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_support_hero_card"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="36dp"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Frosted Glass Back Button -->
            <FrameLayout
                android:id="@+id/btnBrandingBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_glass_back_btn"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_back_arrow"
                    android:tint="#FFFFFF"
                    app:tint="#FFFFFF" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Invoice Branding"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="-0.02" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="2dp">

                    <View
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:background="@drawable/bg_dot_emerald"
                        android:layout_marginEnd="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Live Sync with Web • Reports &amp; Invoices"
                        android:textSize="12sp"
                        android:textColor="#C7DFFF" />
                </LinearLayout>
            </LinearLayout>

            <!-- Frosted Glass Refresh Button -->
            <FrameLayout
                android:id="@+id/btnBrandingRefresh"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_glass_back_btn"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/imgBrandingRefreshIcon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_refresh"
                    android:tint="#FFFFFF"
                    app:tint="#FFFFFF" />
            </FrameLayout>
        </LinearLayout>

        <!-- Loading Progress Bar -->
        <ProgressBar
            android:id="@+id/progressBrandingLoading"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="16dp"
            android:indeterminate="true"
            android:indeterminateTint="#93C5FD"
            android:visibility="gone" />
    </LinearLayout>

    <!-- ══════════════════════════════════════════════════════════════
         SCROLLABLE CONTENT AREA — 4 Branding Assets
         ══════════════════════════════════════════════════════════════ -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="20dp"
            android:paddingBottom="40dp">

            <!-- Section Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Branding Assets"
                android:textSize="19sp"
                android:textStyle="bold"
                android:textColor="#0F172A" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="18dp"
                android:text="Tap 'Choose File' or click the preview area to select an image from your device."
                android:textSize="12.5sp"
                android:textColor="#64748B" />

            <!-- ══════════════════════════════════════════════════════
                 01. Lab Logo
                 ══════════════════════════════════════════════════════ -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <!-- Header Row: [01] + Title -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_pill_index"
                            android:text="01"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="#1D4ED8"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:paddingTop="3dp"
                            android:paddingBottom="3dp"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Lab Logo"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#0F172A" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Square image displayed on patient invoices &amp; lab receipts."
                        android:textSize="12.5sp"
                        android:textColor="#64748B" />

                    <!-- Logo Dropzone Container -->
                    <FrameLayout
                        android:id="@+id/boxLogoPreview"
                        android:layout_width="140dp"
                        android:layout_height="140dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="12dp"
                        android:background="@drawable/bg_upload_dashed_box"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:id="@+id/imgLogoPreview"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="fitCenter"
                            android:padding="8dp"
                            android:visibility="gone" />

                        <LinearLayout
                            android:id="@+id/layoutLogoPlaceholder"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:orientation="vertical"
                            android:gravity="center">

                            <FrameLayout
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:background="@drawable/bg_squircle_blue_soft">

                                <ImageView
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_gallery_upload"
                                    android:tint="#2563EB"
                                    app:tint="#2563EB" />
                            </FrameLayout>

                            <TextView
                                android:id="@+id/lblLogoPlaceholder"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="Tap to choose"
                                android:textSize="12sp"
                                android:textColor="#1E293B"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Square PNG / JPG"
                                android:textSize="10.5sp"
                                android:textColor="#94A3B8" />
                        </LinearLayout>
                    </FrameLayout>

                    <!-- Active File Pill Badge (Hidden when empty) -->
                    <TextView
                        android:id="@+id/lblLogoStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:background="@drawable/bg_pill_success_soft"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:text="✓ Logo active"
                        android:textSize="11.5sp"
                        android:textColor="#059669"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp"
                        android:visibility="gone" />

                    <!-- Actions Row -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <Button
                            android:id="@+id/btnUploadLogo"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_btn_primary"
                            app:backgroundTint="@null"
                            android:text="Choose File"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:paddingStart="22dp"
                            android:paddingEnd="22dp"
                            android:textAllCaps="false"
                            android:stateListAnimator="@null" />

                        <TextView
                            android:id="@+id/btnRemoveLogo"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_pill_danger_soft"
                            android:gravity="center"
                            android:text="Remove"
                            android:textColor="#DC2626"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginStart="14dp"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:visibility="gone" />
                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- ══════════════════════════════════════════════════════
                 02. Letterhead Header
                 ══════════════════════════════════════════════════════ -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <!-- Header Row: [02] + Title -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_pill_index"
                            android:text="02"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="#1D4ED8"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:paddingTop="3dp"
                            android:paddingBottom="3dp"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Letterhead Header"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#0F172A" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Full-width top header banner for PDF reports &amp; invoice printouts."
                        android:textSize="12.5sp"
                        android:textColor="#64748B" />

                    <!-- Letterhead Banner Preview -->
                    <FrameLayout
                        android:id="@+id/boxLetterheadPreview"
                        android:layout_width="match_parent"
                        android:layout_height="125dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="12dp"
                        android:background="@drawable/bg_upload_dashed_box"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:id="@+id/imgLetterheadPreview"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:visibility="gone" />

                        <LinearLayout
                            android:id="@+id/layoutLetterheadPlaceholder"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:orientation="vertical"
                            android:gravity="center">

                            <FrameLayout
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:background="@drawable/bg_squircle_blue_soft">

                                <ImageView
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_gallery_upload"
                                    android:tint="#2563EB"
                                    app:tint="#2563EB" />
                            </FrameLayout>

                            <TextView
                                android:id="@+id/lblLetterheadPlaceholder"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="Tap to choose banner"
                                android:textSize="12sp"
                                android:textColor="#1E293B"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Landscape banner (~800×150 px)"
                                android:textSize="10.5sp"
                                android:textColor="#94A3B8" />
                        </LinearLayout>
                    </FrameLayout>

                    <!-- Active File Pill Badge (Hidden when empty) -->
                    <TextView
                        android:id="@+id/lblLetterheadStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:background="@drawable/bg_pill_success_soft"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:text="✓ Letterhead active"
                        android:textSize="11.5sp"
                        android:textColor="#059669"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp"
                        android:visibility="gone" />

                    <!-- Actions Row -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <Button
                            android:id="@+id/btnUploadLetterhead"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_btn_primary"
                            app:backgroundTint="@null"
                            android:text="Choose File"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:paddingStart="22dp"
                            android:paddingEnd="22dp"
                            android:textAllCaps="false"
                            android:stateListAnimator="@null" />

                        <TextView
                            android:id="@+id/btnRemoveLetterhead"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_pill_danger_soft"
                            android:gravity="center"
                            android:text="Remove"
                            android:textColor="#DC2626"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginStart="14dp"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:visibility="gone" />
                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- ══════════════════════════════════════════════════════
                 03. Footer Image
                 ══════════════════════════════════════════════════════ -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <!-- Header Row: [03] + Title -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_pill_index"
                            android:text="03"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="#1D4ED8"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:paddingTop="3dp"
                            android:paddingBottom="3dp"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Footer Image"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#0F172A" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Full-width bottom footer banner with accreditations &amp; contact info."
                        android:textSize="12.5sp"
                        android:textColor="#64748B" />

                    <!-- Footer Banner Preview -->
                    <FrameLayout
                        android:id="@+id/boxFooterPreview"
                        android:layout_width="match_parent"
                        android:layout_height="105dp"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/bg_upload_dashed_box"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:id="@+id/imgFooterPreview"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:visibility="gone" />

                        <LinearLayout
                            android:id="@+id/layoutFooterPlaceholder"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:orientation="vertical"
                            android:gravity="center">

                            <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:src="@drawable/ic_gallery_upload"
                                android:tint="#94A3B8"
                                app:tint="#94A3B8"
                                android:layout_marginBottom="6dp" />

                            <TextView
                                android:id="@+id/lblFooterPlaceholder"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Tap to choose footer"
                                android:textColor="#94A3B8"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </FrameLayout>

                    <!-- File Info / Metadata Row -->
                    <TextView
                        android:id="@+id/lblFooterStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:text="No file chosen"
                        android:textSize="12sp"
                        android:textColor="#64748B"
                        android:layout_marginBottom="14dp" />

                    <!-- Actions Row -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <Button
                            android:id="@+id/btnUploadFooter"
                            android:layout_width="wrap_content"
                            android:layout_height="38dp"
                            android:background="@drawable/bg_btn_primary_gradient"
                            app:backgroundTint="@null"
                            android:text="Choose File"
                            android:textColor="#FFFFFF"
                            android:textSize="12.5sp"
                            android:textStyle="bold"
                            android:paddingStart="22dp"
                            android:paddingEnd="22dp"
                            android:textAllCaps="false"
                            android:stateListAnimator="@null" />

                        <TextView
                            android:id="@+id/btnRemoveFooter"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_pill_danger_soft"
                            android:gravity="center"
                            android:text="Remove"
                            android:textColor="#DC2626"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginStart="14dp"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:visibility="gone" />
                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- ══════════════════════════════════════════════════════
                 04. Signature
                 ══════════════════════════════════════════════════════ -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <!-- Header Row: [04] + Title -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_pill_index"
                            android:text="04"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="#1D4ED8"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:paddingTop="3dp"
                            android:paddingBottom="3dp"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Signature"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#0F172A" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Authorized signatory image for digital validation."
                        android:textSize="12.5sp"
                        android:textColor="#64748B" />

                    <!-- Signature Dropzone Container -->
                    <FrameLayout
                        android:id="@+id/boxSignaturePreview"
                        android:layout_width="210dp"
                        android:layout_height="90dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/bg_upload_dashed_box"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:id="@+id/imgSignaturePreview"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="fitCenter"
                            android:padding="8dp"
                            android:src="@drawable/ic_gallery_upload"
                            android:tint="#94A3B8"
                            app:tint="#94A3B8" />

                        <TextView
                            android:id="@+id/lblSignaturePlaceholder"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom|center_horizontal"
                            android:layout_marginBottom="8dp"
                            android:text="Tap to choose"
                            android:textSize="11sp"
                            android:textColor="#94A3B8"
                            android:textStyle="bold" />
                    </FrameLayout>

                    <!-- File Info / Metadata Row -->
                    <TextView
                        android:id="@+id/lblSignatureStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:text="No file chosen"
                        android:textSize="12sp"
                        android:textColor="#64748B"
                        android:layout_marginBottom="14dp" />

                    <!-- Actions Row -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <Button
                            android:id="@+id/btnUploadSignature"
                            android:layout_width="wrap_content"
                            android:layout_height="38dp"
                            android:background="@drawable/bg_btn_primary_gradient"
                            app:backgroundTint="@null"
                            android:text="Choose File"
                            android:textColor="#FFFFFF"
                            android:textSize="12.5sp"
                            android:textStyle="bold"
                            android:paddingStart="22dp"
                            android:paddingEnd="22dp"
                            android:textAllCaps="false"
                            android:stateListAnimator="@null" />

                        <TextView
                            android:id="@+id/btnRemoveSignature"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_pill_danger_soft"
                            android:gravity="center"
                            android:text="Remove"
                            android:textColor="#DC2626"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginStart="14dp"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:visibility="gone" />
                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- ══════════════════════════════════════════════════════
                 SAVE BRANDING PRIMARY ACTION CARD
                 ══════════════════════════════════════════════════════ -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/lblPendingChangesHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="No pending changes to save"
                        android:textSize="12.5sp"
                        android:textColor="#64748B"
                        android:layout_marginBottom="12dp" />

                    <Button
                        android:id="@+id/btnSaveBranding"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_btn_primary"
                        app:backgroundTint="@null"
                        android:text="Save Branding"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        android:textAllCaps="false"
                        android:letterSpacing="0.01"
                        android:stateListAnimator="@null" />

                    <ProgressBar
                        android:id="@+id/progressBrandingSaving"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:layout_marginTop="12dp"
                        android:indeterminateTint="#0D6EFD"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/lblSaveStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#059669"
                        android:visibility="gone" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
