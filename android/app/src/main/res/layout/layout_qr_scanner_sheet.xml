<?xml version="1.0" encoding="utf-8"?>
<!-- ══ Modern Barcode & QR Code Scanner Bottom Sheet (Android) ══ -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="44dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:background="#CBD5E1" />

    <!-- Sheet Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp">

        <FrameLayout
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_mod_icon_blue"
            android:layout_marginEnd="12dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_qr_code_scanner"
                android:tint="#0D6EFD"
                app:tint="#0D6EFD" />

        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="QR &amp; Barcode Scanner"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#0F172A" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Scan sample tubes, receipts or web login QR"
                android:textSize="11.5sp"
                android:textColor="#64748B" />

        </LinearLayout>

        <FrameLayout
            android:id="@+id/btnQrScannerClose"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_bell_btn"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_close_cross"
                android:tint="#475569"
                app:tint="#475569" />

        </FrameLayout>

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#F1F5F9"
        android:layout_marginBottom="14dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <!-- Target Scan Mode Chips -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="14dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipModeSample"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:text="🔬 Sample Barcode"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_btn_primary"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/chipModePatient"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:text="👤 Patient UHID"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#475569"
                    android:background="@drawable/bg_chip_inactive"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/chipModeReport"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:text="📄 Report QR"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#475569"
                    android:background="@drawable/bg_chip_inactive"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/chipModeWebSync"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:text="💻 Web Sync"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#475569"
                    android:background="@drawable/bg_chip_inactive"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

        </HorizontalScrollView>

        <!-- Viewfinder Box (Camera Preview Container) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:background="#0F172A"
            android:layout_marginBottom="16dp"
            android:clipToOutline="true">

            <!-- Simulated viewfinder camera overlay -->
            <ImageView
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_qr_code_scanner"
                android:tint="#38BDF8"
                app:tint="#38BDF8"
                android:alpha="0.4" />

            <!-- Animated Laser Scan Line -->
            <View
                android:id="@+id/viewScanLaser"
                android:layout_width="200dp"
                android:layout_height="2dp"
                android:layout_gravity="center"
                android:background="#38BDF8" />

            <!-- Hint overlay -->
            <TextView
                android:id="@+id/lblScannerHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="14dp"
                android:text="Align barcode / QR within frame to scan"
                android:textSize="11.5sp"
                android:textColor="#E2E8F0"
                android:background="#80000000"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />

            <!-- Flash / Torch Toggle -->
            <FrameLayout
                android:id="@+id/btnScannerFlash"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_glass_back_btn"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/imgFlashIcon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_sun"
                    android:tint="#FFFFFF"
                    app:tint="#FFFFFF" />

            </FrameLayout>

        </FrameLayout>

        <!-- Manual Code Entry Fallback -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/txtManualBarcode"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input_field"
                android:hint="Or enter Barcode / UHID manually..."
                android:textSize="13.5sp"
                android:textColor="#0F172A"
                android:textColorHint="#94A3B8"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:inputType="textCapCharacters"
                android:layout_marginEnd="8dp" />

            <android.widget.Button
                android:id="@+id/btnSubmitManualCode"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:background="@drawable/bg_btn_primary"
                android:text="Process"
                android:textSize="13.5sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:textAllCaps="false"
                android:paddingStart="16dp"
                android:paddingEnd="16dp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
