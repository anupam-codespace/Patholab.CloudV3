<?xml version="1.0" encoding="utf-8"?>
<!-- Corporate Agency Card Item -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_setting_item"
    android:padding="14dp"
    android:layout_marginBottom="10dp"
    android:elevation="2dp">

    <!-- 1. Top Bar: Agency Tier + Commission Pill -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/lblAgencyTierBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TIER 1 (SILVER)"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:textColor="#0284C7"
            android:background="#E0F2FE"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp" />

        <TextView
            android:id="@+id/lblAgencyPortalBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="PORTAL ACTIVE"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:textColor="#059669"
            android:background="#D1FAE5"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Default Commission Rate -->
        <TextView
            android:id="@+id/lblAgencyCommissionRate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="15% Comm"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#4338CA"
            android:background="#EEF2FF"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp" />

    </LinearLayout>

    <!-- 2. Agency Name & Contact Person -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="10dp">

        <FrameLayout
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_mod_icon_teal">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_building"
                android:tint="#0F766E"
                app:tint="#0F766E" />

        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="10dp">

            <TextView
                android:id="@+id/lblAgencyName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Apollo Diagnostics Hub"
                android:textSize="14.5sp"
                android:textStyle="bold"
                android:textColor="#0F172A" />

            <TextView
                android:id="@+id/lblAgencyContactPerson"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="Contact: Rajesh Kumar • +91 98765 43210"
                android:textSize="12sp"
                android:textColor="#64748B" />

        </LinearLayout>

    </LinearLayout>

    <!-- 3. Email & PAN Info -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/lblAgencyEmail"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="rajesh@apollodiag.com"
            android:textSize="11.5sp"
            android:textColor="#475569"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/lblAgencyPan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PAN: ABCDE1234F"
            android:textSize="11sp"
            android:textColor="#94A3B8" />

    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#F1F5F9"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp" />

    <!-- 4. Financial & Referral Stats Bento -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#F8FAFC"
        android:padding="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:text="TOTAL TESTS"
                android:textSize="9.5sp"
                android:textStyle="bold"
                android:textColor="#64748B"
                android:letterSpacing="0.04"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/lblAgencyTestsCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#0F172A" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.2"
            android:orientation="vertical">

            <TextView
                android:text="BILLED VOLUME"
                android:textSize="9.5sp"
                android:textStyle="bold"
                android:textColor="#64748B"
                android:letterSpacing="0.04"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/lblAgencyBilledVolume"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹0"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#0D9488" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.2"
            android:orientation="vertical">

            <TextView
                android:text="PENDING PAYOUT"
                android:textSize="9.5sp"
                android:textStyle="bold"
                android:textColor="#64748B"
                android:letterSpacing="0.04"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/lblAgencyPendingPayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹0"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#D97706" />

        </LinearLayout>

    </LinearLayout>

    <!-- 5. Action Buttons Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical">

        <!-- Call Contact -->
        <FrameLayout
            android:id="@+id/btnAgencyCall"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_copy_pill"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="6dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_phone_call_modern"
                android:tint="#0D6EFD"
                app:tint="#0D6EFD" />

        </FrameLayout>

        <!-- WhatsApp Contact -->
        <FrameLayout
            android:id="@+id/btnAgencyWhatsApp"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_copy_pill"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="6dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_whatsapp"
                android:tint="#16A34A"
                app:tint="#16A34A" />

        </FrameLayout>

        <!-- View Ledger / Transactions -->
        <LinearLayout
            android:id="@+id/btnAgencyLedger"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/bg_copy_pill"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="6dp">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_receipt_vector"
                android:tint="#334155"
                app:tint="#334155" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:text="Ledger"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:textColor="#334155" />

        </LinearLayout>

        <!-- Edit Agency -->
        <FrameLayout
            android:id="@+id/btnAgencyEdit"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_copy_pill"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="6dp">

            <ImageView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_edit_pen"
                android:tint="#475569"
                app:tint="#475569" />

        </FrameLayout>

        <!-- Delete Agency -->
        <FrameLayout
            android:id="@+id/btnAgencyDelete"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_copy_pill"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_trash"
                android:tint="#DC2626"
                app:tint="#DC2626" />

        </FrameLayout>

    </LinearLayout>

</LinearLayout>
