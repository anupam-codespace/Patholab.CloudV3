<?xml version="1.0" encoding="utf-8"?>
<!-- Download Success Pop-up Modal Dialog -->
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="24dp"
    app:cardElevation="16dp"
    app:cardBackgroundColor="#FFFFFF"
    android:layout_margin="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingTop="26dp"
        android:paddingBottom="20dp">

        <!-- Emerald Success Circle Badge -->
        <FrameLayout
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@drawable/bg_success_check_circle"
            android:layout_marginBottom="16dp">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_check_bold"
                app:tint="#FFFFFF" />
        </FrameLayout>

        <!-- Title -->
        <TextView
            android:id="@+id/lblDownloadSuccessTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Download Successful!"
            android:textSize="18.5sp"
            android:textStyle="bold"
            android:textColor="#0F172A"
            android:textAlignment="center"
            android:layout_marginBottom="6dp" />

        <!-- Subtitle & File Details -->
        <TextView
            android:id="@+id/lblDownloadSuccessDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Download successful! Report has been saved to your device."
            android:textSize="13sp"
            android:textColor="#64748B"
            android:textAlignment="center"
            android:lineSpacingExtra="3dp"
            android:layout_marginBottom="22dp" />

        <!-- Action 1: Open / View PDF (Icon-free, Clean & Professional) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSuccessOpenPdf"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="50dp"
            android:text="Open &amp; View PDF"
            android:textSize="14.5sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#0D6EFD"
            app:cornerRadius="14dp"
            android:singleLine="true"
            android:maxLines="1"
            android:ellipsize="end"
            android:elevation="0dp"
            android:textAllCaps="false"
            android:layout_marginBottom="14dp" />

        <!-- Action 2: Share via WhatsApp (Icon-free, Clean & Professional) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSuccessShareWhatsApp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="50dp"
            android:text="Share with Patient on WhatsApp"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#059669"
            android:backgroundTint="#ECFDF5"
            app:cornerRadius="14dp"
            app:strokeColor="#A7F3D0"
            app:strokeWidth="1.2dp"
            android:singleLine="true"
            android:maxLines="1"
            android:ellipsize="end"
            android:elevation="0dp"
            android:textAllCaps="false"
            android:layout_marginBottom="12dp" />

        <!-- Action 3: Done / Dismiss -->
        <TextView
            android:id="@+id/btnSuccessDismiss"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="Done"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#64748B"
            android:gravity="center"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
