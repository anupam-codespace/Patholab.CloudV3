<?xml version="1.0" encoding="utf-8"?>
<!-- Dialog Layout for Barcode Sticker Label Printing -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card_white"
    android:padding="24dp">

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Specimen Barcode Label Preview"
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="#0F172A" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Ready for 50x25mm thermal label sticker printer"
        android:textSize="12sp"
        android:textColor="#64748B" />

    <!-- Thermal Label Preview Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:padding="16dp"
        android:layout_marginTop="16dp"
        android:elevation="3dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/lblLabelPatientName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="PRATIMA GHOSH"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#000000" />

            <TextView
                android:id="@+id/lblLabelPatientDemographics"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="45Y/F • P-00096"
                android:textSize="12sp"
                android:textColor="#000000" />

        </LinearLayout>

        <!-- Simulated Barcode Lines -->
        <TextView
            android:id="@+id/lblLabelBarcodeVisual"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="||| | |||| | ||||| || ||| |||| |"
            android:textSize="24sp"
            android:textColor="#000000"
            android:letterSpacing="0.1" />

        <TextView
            android:id="@+id/lblLabelBarcodeNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:text="*SMP-10928-EDTA*"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#000000" />

        <TextView
            android:id="@+id/lblLabelTests"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="CBC, ESR, Blood Group • EDTA Tube"
            android:textSize="11sp"
            android:textColor="#333333" />

    </LinearLayout>

    <!-- Print / Close Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCloseBarcodeDialog"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:backgroundTint="#F1F5F9"
            android:text="Close"
            android:textColor="#475569"
            android:textStyle="bold"
            app:cornerRadius="12dp" />

        <Button
            android:id="@+id/btnPrintBarcodeDirect"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.6"
            android:layout_marginStart="10dp"
            android:backgroundTint="#0D6EFD"
            android:text="🖨️ Print Label"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            app:cornerRadius="12dp" />

    </LinearLayout>

</LinearLayout>
