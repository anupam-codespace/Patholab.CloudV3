<?xml version="1.0" encoding="utf-8"?>
<!-- Bottom Sheet for Quick Wallet Recharge & Payment Order -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet"
    android:paddingTop="12dp"
    android:paddingBottom="28dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="44dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="#CBD5E1" />

    <!-- Sheet Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="22dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Recharge Credits"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#0F172A"
                android:letterSpacing="-0.02" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Select a pack or enter custom credits"
                android:textSize="12.5sp"
                android:textColor="#64748B" />

        </LinearLayout>

        <FrameLayout
            android:id="@+id/btnRechargeClose"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_bell_btn"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_close_cross"
                android:tint="#475569" />

        </FrameLayout>

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#F1F5F9"
        android:layout_marginBottom="16dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <!-- Quick Amount Selection Grid -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="QUICK TOP-UP PACKS"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#64748B"
            android:letterSpacing="0.06"
            android:layout_marginBottom="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="4"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/btnPack500"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_tab_pill_inactive"
                android:gravity="center"
                android:text="₹ 500"
                android:textColor="#334155"
                android:textStyle="bold"
                android:textSize="13sp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btnPack1000"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:background="@drawable/bg_tab_pill_active"
                android:gravity="center"
                android:text="₹ 1,000"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="13sp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btnPack2000"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:background="@drawable/bg_tab_pill_inactive"
                android:gravity="center"
                android:text="₹ 2,000"
                android:textColor="#334155"
                android:textStyle="bold"
                android:textSize="13sp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btnPack5000"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_tab_pill_inactive"
                android:gravity="center"
                android:text="₹ 5,000"
                android:textColor="#334155"
                android:textStyle="bold"
                android:textSize="13sp"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

        <!-- Custom Base Amount Input -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CUSTOM CREDIT AMOUNT (₹)"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#64748B"
            android:letterSpacing="0.06"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/editRechargeAmount"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_profile_input"
            android:hint="Minimum ₹ 100"
            android:text="1000"
            android:textColor="#0F172A"
            android:textStyle="bold"
            android:textSize="16sp"
            android:inputType="numberDecimal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:layout_marginBottom="16dp" />

        <!-- Live Bill Summary Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_white"
            android:padding="14dp"
            android:layout_marginBottom="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="6dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Base Wallet Credits"
                    android:textSize="12.5sp"
                    android:textColor="#64748B" />
                <TextView
                    android:id="@+id/txtSummaryBase"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₹ 1,000.00"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    android:textColor="#0F172A"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:paddingEnd="4dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="GST (18% Govt Tax)"
                    android:textSize="12.5sp"
                    android:textColor="#64748B" />
                <TextView
                    android:id="@+id/txtSummaryGst"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₹ 180.00"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    android:textColor="#0F172A"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:paddingEnd="4dp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E2E8F0"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Total Amount Payable"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#0F172A" />
                <TextView
                    android:id="@+id/txtSummaryTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₹ 1,180.00"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif"
                    android:textFontWeight="800"
                    android:textColor="#059669"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:paddingEnd="4dp" />
            </LinearLayout>

        </LinearLayout>

        <!-- Proceed / Pay Button -->
        <android.widget.Button
            android:id="@+id/btnProceedRecharge"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_btn_primary"
            android:text="Proceed to Secure Recharge"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textAllCaps="false" />

    </LinearLayout>

</LinearLayout>
