<?xml version="1.0" encoding="utf-8"?>
<!-- Premium Floating Wallet Empty Warning Toast Card -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Bottom subtle red accent shadow/line -->
    <item
        android:top="2dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="#FEE2E2" />
        </shape>
    </item>
    <!-- Main white card -->
    <item
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="#FFFFFF" />
            <stroke
                android:width="1dp"
                android:color="#CBD5E1" />
        </shape>
    </item>
</layer-list>
