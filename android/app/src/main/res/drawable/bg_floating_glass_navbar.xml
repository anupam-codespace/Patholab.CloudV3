<?xml version="1.0" encoding="utf-8"?>
<!-- Floating Glassmorphic Pill Navigation Bar Background with Gradient -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="90"
        android:startColor="#F4F8FD"
        android:centerColor="#FCFDFF"
        android:endColor="#FFFFFF" />
    <corners android:radius="34dp" />
    <stroke
        android:width="1.5dp"
        android:color="#E2E8F0" />
</shape>
