<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Smooth horizontal fade: 100% sapphire on left edge seamlessly dissolving into the card background, clear over the scientist -->
    <item>
        <shape>
            <gradient
                android:type="linear"
                android:angle="0"
                android:startColor="#FF0D6EFD"
                android:centerColor="#550D6EFD"
                android:endColor="#000D6EFD"
                android:centerX="0.32" />
        </shape>
    </item>

    <!-- Subtle atmospheric sapphire tint across the photo to tie it harmoniously into the sapphire card theme -->
    <item>
        <shape>
            <gradient
                android:type="linear"
                android:angle="0"
                android:startColor="#400A58CA"
                android:endColor="#080A58CA" />
        </shape>
    </item>
</layer-list>

