            android:windowSoftInputMode="adjustResize"
            android:screenOrientation="portrait"
            android:exported="true"
        />

        <activity
            android:name=".ReportsActivity"
            android:theme="@style/AppTheme.NoActionBar"
            android:windowSoftInputMode="adjustResize"
            android:screenOrientation="portrait"
            android:exported="true"
        />

        <activity
            android:name=".SamplesActivity"
            android:theme="@style/AppTheme.NoActionBar"
            android:windowSoftInputMode="adjustResize"
            android:screenOrientation="portrait"
            android:exported="true"
        />

        <activity
            android:name=".ReportPreviewActivity"
            android:theme="@style/AppTheme.NoActionBar"
            android:windowSoftInputMode="adjustResize"
            android:screenOrientation="portrait"
            android:exported="false"
        />

        <activity
            android:name=".PatientWorklistActivity"
            android:theme="@style/AppTheme.NoActionBar"
            android:windowSoftInputMode="adjustResize"
            android:screenOrientation="portrait"
            android:exported="true"
        />

        <activity
            android:name=".ResultsActivity"
            android:theme="@style/AppTheme.NoActionBar"
            android:windowSoftInputMode="adjustResize"
            android:screenOrientation="portrait"
            android:exported="true"
        />

        <activity
            android:name=".StaffManagementActivity"
            android:theme="@style/AppTheme.NoActionBar"
            android:windowSoftInputMode="adjustResize"
            android:screenOrientation="portrait"
            android:exported="true"
        />

        <activity
            android:name=".NotificationsActivity"
            android:theme="@style/AppTheme.NoActionBar"
            android:windowSoftInputMode="adjustResize"
            android:screenOrientation="portrait"
            android:exported="true"
        />

        <activity
            android:name=".OnlineBookingActivity"
            android:theme="@style/AppTheme.NoActionBar"
            android:windowSoftInputMode="adjustResize"
            android:screenOrientation="portrait"
            android:exported="true"
        />

        <activity
            android:name=".B2BActivity"
            android:theme="@style/AppTheme.NoActionBar"
            android:windowSoftInputMode="adjustResize"
            android:screenOrientation="portrait"
            android:exported="true"
        />

        <activity
            android:name=".B2BSettingsActivity"
            android:theme="@style/AppTheme.NoActionBar"
            android:windowSoftInputMode="adjustResize"
            android:screenOrientation="portrait"
            android:exported="true"
        />

        <activity
            android:name=".ReferralDoctorsActivity"
            android:theme="@style/AppTheme.NoActionBar"
            android:windowSoftInputMode="adjustResize"
            android:screenOrientation="portrait"
            android:exported="true"
        />

        <activity
