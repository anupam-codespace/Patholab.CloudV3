            android:theme="@style/AppTheme.NoActionBar"
            android:windowSoftInputMode="adjustResize"
            android:screenOrientation="portrait"
            android:exported="true"
        />

        <!-- ── RIS / Radiology Modules ─────────────────────────────────── -->
        <activity
            android:name=".RISDashboardActivity"
            android:theme="@style/AppTheme.NoActionBar"
            android:windowSoftInputMode="adjustResize"
            android:screenOrientation="portrait"
            android:exported="true"
        />

        <activity
