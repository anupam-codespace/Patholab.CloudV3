<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:installLocation="auto">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <!-- ── LAUNCHER: SplashActivity checks session and routes ────────── -->
        <activity
            android:name=".auth.SplashActivity"
            android:theme="@style/AppTheme.NoActionBar"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ── Onboarding screen (pure white background) ─────────────── -->
        <activity
            android:name=".auth.OnboardingActivity"
            android:theme="@style/AppTheme.NoActionBar"
            android:screenOrientation="portrait"
            android:exported="false"
        />

        <!-- ── Auth screens (all portrait, indigo theme) ────────────────── -->
        <activity
            android:name=".auth.LoginActivity"
            android:theme="@style/AppTheme.Auth"
            android:windowSoftInputMode="adjustResize"
            android:screenOrientation="portrait"
            android:exported="false"
        />

        <activity
            android:name=".auth.RegisterActivity"
            android:theme="@style/AppTheme.Auth"
            android:windowSoftInputMode="adjustResize"
            android:screenOrientation="portrait"
            android:exported="false"
        />

        <activity
            android:name=".auth.ForgotPasswordActivity"
            android:theme="@style/AppTheme.Auth"
            android:windowSoftInputMode="adjustResize"
            android:screenOrientation="portrait"
            android:exported="false"
        />

        <activity
            android:name=".auth.OtpVerifyActivity"
            android:theme="@style/AppTheme.Auth"
            android:windowSoftInputMode="adjustResize"
            android:screenOrientation="portrait"
            android:exported="false"
        />

        <activity
            android:name=".auth.ResetPasswordActivity"
            android:theme="@style/AppTheme.Auth"
            android:windowSoftInputMode="adjustResize"
            android:screenOrientation="portrait"
            android:exported="false"
        />

        <!-- ── Main app: Capacitor BridgeActivity (post-auth) ──────────── -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBar"
            android:screenOrientation="portrait"
            android:launchMode="singleTask"
            android:exported="true"
        />

        <activity
            android:name=".LegalActivity"
            android:theme="@style/AppTheme.NoActionBar"
            android:screenOrientation="portrait"
            android:exported="false"
        />

        <activity
            android:name=".ProfileSettingsActivity"
            android:theme="@style/AppTheme.NoActionBar"
            android:windowSoftInputMode="adjustResize"
            android:screenOrientation="portrait"
            android:exported="true"
        />

        <activity
            android:name=".WalletActivity"
            android:theme="@style/AppTheme.NoActionBar"
            android:windowSoftInputMode="adjustResize"
            android:screenOrientation="portrait"
            android:exported="true"
        />

        <activity
            android:name=".SupportActivity"
            android:theme="@style/AppTheme.NoActionBar"
            android:windowSoftInputMode="adjustResize"
            android:screenOrientation="portrait"
            android:exported="true"
        />

        <activity
            android:name=".QRScannerActivity"
            android:theme="@style/AppTheme.NoActionBar"
            android:screenOrientation="portrait"
            android:exported="false"
        />

        <activity
            android:name=".RegistrationActivity"
            android:theme="@style/AppTheme.NoActionBar"
            android:windowSoftInputMode="adjustResize"
            android:screenOrientation="portrait"
            android:exported="true"
        />

        <activity
            android:name=".TestManagementActivity"
            android:theme="@style/AppTheme.NoActionBar"
            android:windowSoftInputMode="adjustResize"
            android:screenOrientation="portrait"
            android:exported="true"
        />

        <activity
            android:name=".DashboardActivity"
            android:theme="@style/AppTheme.NoActionBar"
            android:windowSoftInputMode="adjustResize"
            android:screenOrientation="portrait"
            android:exported="false"
        />

        <activity
            android:name=".FinancialAnalyticsActivity"
            android:theme="@style/AppTheme.NoActionBar"
            android:windowSoftInputMode="adjustResize"
            android:screenOrientation="portrait"
            android:exported="false"
        />

        <activity
            android:name=".LabDashboardActivity"
            android:theme="@style/AppTheme.NoActionBar"
            android:windowSoftInputMode="adjustResize"
            android:screenOrientation="portrait"
            android:exported="true"
        />

        <activity
