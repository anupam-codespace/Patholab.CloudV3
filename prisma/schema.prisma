model TestResultCustomField {
  id     String @id @default(cuid())
  testId String
  test   Test   @relation(fields: [testId], references: [id], onDelete: Cascade)

  fieldDefId String
  fieldDef   CustomFieldDefinition @relation(fields: [fieldDefId], references: [id])
