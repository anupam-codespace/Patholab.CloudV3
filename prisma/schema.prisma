}

model TicketMessage {
  id         String        @id @default(cuid())
  ticketId   String
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  message    String
  isStaff    Boolean       @default(false)
  senderName String?
  createdAt  DateTime      @default(now())
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
}

enum NotificationType {
  TEST
  PAYMENT
  SYSTEM
  LAB_UPDATE
}

model Notification {
  id      String @id @default(cuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id])

  title   String
  message String
  type    String @default("SYSTEM") 

  link     String? 
  imageUrl String? 

  isRead  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ActivityLog {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  action      String
  entity      String
  entityId    String
  description String
  createdAt   DateTime @default(now())
}

model UsageMetric {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id])
  month          Int
  year           Int
  testsCount     Int          @default(0)
  storageUsedGB  Float        @default(0)

  @@unique([subscriptionId, month, year])
}

model Discount {
  id         String       @id @default(cuid())
  labId      String
  lab        Lab          @relation(fields: [labId], references: [id])
  branchId   String?
  branch     Branch?      @relation(fields: [branchId], references: [id])
  code       String       @unique
  value      Decimal      @db.Decimal(10, 2)
  type       DiscountType
  validUntil DateTime?
  isActive   Boolean      @default(true)
  createdAt  DateTime     @default(now())

  @@index([labId])
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

model Invitation {
  id        String   @id @default(cuid())
  email     String
  name      String
  labName   String?
  role      Role     @default(LAB_OWNER)
  token     String   @unique
  expiresAt DateTime

  inviterId String
  inviter   User   @relation(fields: [inviterId], references: [id])

  status    InviteStatus @default(PENDING)
  createdAt DateTime     @default(now())

  @@index([token])
  @@index([email])
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
}

model Page {
  id          String  @id @default(cuid())
  title       String
  slug        String  @unique 
  content     String  
  metaTitle   String? 
  metaDesc    String? 
  isPublished Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
}

model Lead {
  id      String     @id @default(cuid())
  name    String
  email   String
  phone   String
  labName String?
  message String?
  status  LeadStatus @default(NEW)
  source  String     @default("WEBSITE_DEMO")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum LeadStatus {
  NEW
  CONTACTED
  CONVERTED
  CLOSED
}

model CustomFieldDefinition {
  id           String @id @default(cuid())
  labId        String
  lab          Lab    @relation(fields: [labId], references: [id])

  name         String 
  type         FieldType @default(TEXT) 
  options      String[] 
  reportLayout String?   @default("FULL")

  printOnReport Boolean @default(true) 

  createdAt DateTime @default(now())

  usedInTests TestTemplateField[]
  results     TestResultCustomField[]

  @@unique([labId, name])
}

model TestTemplateField {
  id         String       @id @default(cuid())
  templateId String
  template   TestTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  fieldDefId String
  fieldDef   CustomFieldDefinition @relation(fields: [fieldDefId], references: [id])

  order    Int     @default(0) 
  required Boolean @default(false)

  @@unique([templateId, fieldDefId])
}

model TestResultCustomField {
  id         String @id @default(cuid())
  testId     String
  test       Test   @relation(fields: [testId], references: [id], onDelete: Cascade)

  fieldDefId String
  fieldDef   CustomFieldDefinition @relation(fields: [fieldDefId], references: [id])
  layout     Json?

  value String 

  @@unique([testId, fieldDefId])
}

enum FieldType {
  TEXT 
  LONG_TEXT 
  DROPDOWN 
  DATE 
  IMAGE 
  RICH_TEXT 
}

model WebhookLog {
  id           String        @id @default(cuid())
  source       String        @default("WOOCOMMERCE")
  event        String
  payload      Json
  status       WebhookStatus @default(PENDING)
  errorMessage String?       @db.Text
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status])
  @@index([createdAt])
}

enum WebhookStatus {
  PENDING
  SUCCESS
  FAILED
  IGNORED
}