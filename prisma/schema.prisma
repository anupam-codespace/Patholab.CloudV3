enum TripStatus {
  SCHEDULED
  STARTED
  IN_PROGRESS
  COMPLETED
}

// B2B2C Booking & Apppointment Logistics
model Appointment {
  id        String  @id @default(cuid())
  patientId String
  patient   Patient @relation(fields: [patientId], references: [id])
  labId     String
  branchId  String?
  branch    Branch? @relation(fields: [branchId], references: [id])

  source    BookingSource @default(WALK_IN)

  tripId String?
  trip   HomeCollectionTrip? @relation(fields: [tripId], references: [id])

  appointmentDate DateTime
  timeSlot        String? 

  // Address overrides for collection
  collectionMode    CollectionMode @default(LAB_VISIT)
  collectionAddress String?
  pincode           String?
  latitude          Float?
  longitude         Float?
  routeOrder        Int     @default(0)
  
  // On-Site Payment Tracking
  paymentCollected  Decimal? @default(0.00) @db.Decimal(10, 2)
  paymentMode       String?  // CASH, UPI, LINK
  
  tests      Test[] 
  invoiceId  String?   @unique
  invoice    Invoice?  @relation(fields: [invoiceId], references: [id])

  status            AppointmentStatus @default(SCHEDULED)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

enum BookingSource {
  WALK_IN
  PHONE_CALL
  ONLINE_PORTAL
  AGENCY_API
}

enum AppointmentStatus {
  PENDING_PAYMENT
  SCHEDULED
  ASSIGNED
  EN_ROUTE
  ARRIVED
  SAMPLE_COLLECTED
  HANDED_OVER
  COMPLETED
  CANCELLED
  RESCHEDULED
}

model Test {
  id         String @id @default(cuid())
  labId      String
  lab        Lab    @relation(fields: [labId], references: [id])
  
  branchId   String?
  branch     Branch? @relation(fields: [branchId], references: [id])
  
  testNumber String

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id])

  categoryId String?
  category   TestCategory? @relation(fields: [categoryId], references: [id])

  testTemplateId String?
  testTemplate   TestTemplate? @relation(fields: [testTemplateId], references: [id])
  report         Report?
  
  appointmentId  String?
  appointment    Appointment? @relation(fields: [appointmentId], references: [id])

  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id])

  sampleId String?
  sample   Sample? @relation(fields: [sampleId], references: [id])

  testName String
  testCode String

  resultNotes Json?      

  status   TestStatus   @default(PENDING)
  priority TestPriority @default(NORMAL)

  referredBy String?
  doctorId   String?
  doctor     Doctor? @relation("DoctorReferral", fields: [doctorId], references: [id])
  agencyId   String?
  agency     Agency? @relation("AgencyReferral", fields: [agencyId], references: [id])

  scheduledAt         DateTime?
  sampleCollectedAt   DateTime?
  processingStartedAt DateTime?
  completedAt         DateTime?
  approvedAt          DateTime?
  approvedBy          String?
  reportGeneratedAt   DateTime?
  sampleReceivedAt    DateTime?

  reportUrl  String?
  notes      String?
  impression String?

  price      Decimal @db.Decimal(10, 2)
  discount   Decimal @default(0.00) @db.Decimal(10, 2)
  finalPrice Decimal @db.Decimal(10, 2)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? 

  commissions      Commission[]
  results          TestResultParameter[]
  inventoryUsage   InventoryTransaction[]
  aiPrediction     AIPrediction?
  customResults    TestResultCustomField[]

  @@unique([labId, testNumber])
  @@index([patientId])
  @@index([branchId, status, createdAt]) 
}

enum ResultFlag {
  NORMAL
  LOW
  HIGH
  CRITICAL_LOW
  CRITICAL_HIGH
}

model TestResultParameter {
  id      String @id @default(cuid())
  testId  String
  test    Test   @relation(fields: [testId], references: [id], onDelete: Cascade)

  parameterName String
  value         String
  numericValue  Float? 
  unit          String?

  refRangeMin  Float?
  refRangeMax  Float?
  refRangeText String?

  isAbnormal    Boolean    @default(false)
  isCritical    Boolean    @default(false)
  
  flag          ResultFlag @default(NORMAL)
  isHighlighted Boolean    @default(false) 

  analyzerId  String?
  analyzer    LabAnalyzer? @relation(fields: [analyzerId], references: [id])
  entryMethod EntryMethod  @default(MANUAL)

  order Int @default(0)

  @@index([testId])
}

enum EntryMethod {
  MANUAL
  MACHINE_INTERFACE
  FILE_UPLOAD
}

model AIPrediction {
  id      String @id @default(cuid())
  testId String @unique
  test   Test   @relation(fields: [testId], references: [id])

  summary         String
  riskScore       Float?
  recommendations Json?
