}

enum TestStatus {
  PENDING
  SCHEDULED
  SAMPLE_COLLECTED
  IN_PROGRESS
  COMPLETED
  APPROVED
  DELIVERED
  CANCELLED
}

enum TestPriority {
  NORMAL
  URGENT
  CRITICAL
}

