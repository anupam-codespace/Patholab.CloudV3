// ==========================================
// CONFIG & GENERATOR
// ==========================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// SYSTEM CONFIGURATION (Full SEO)
// ==========================================

model SystemConfig {
  id              String  @id @default(cuid())
  
  // 1. Core Branding
  systemName      String  @default("Patholab Cloud")
  systemLogo      String? 
  favicon         String? 
  primaryColor    String  @default("#3b82f6")
  secondaryColor  String  @default("#8b5cf6")

  // 2. Global SEO & Marketing
  seoTitle        String? @default("Patholab Cloud - Modern LIMS")
  seoDescription  String? @db.Text
  seoKeywords     String? 
  ogImage         String? 
  googleAnalyticsId String? 
  facebookPixelId   String? 
  socialLinks       Json?   

  // 3. Business & Contact Info
  systemEmail   String?
  systemPhone   String?
  systemAddress String?

  // 4. Billing & Compliance
  gstNumber     String?
  panNumber     String?
  invoicePrefix String  @default("SAAS")
  nextInvoiceNo Int     @default(1)
  currency      String  @default("INR")
  currencySymbol String @default("₹")
  taxRate       Decimal @default(18.0) @db.Decimal(5, 2)

  // 5. Integrations & API Keys
  enableABDM        Boolean @default(false)
  abdmClientId      String?
  abdmClientSecret  String?
  razorpayKeyId     String?
  razorpayKeySecret String?

  smtpHost     String?
  smtpPort     Int?
  smtpUser     String?
  smtpPassword String?
  
  landingPage  Json?

  // NEW: Global Portal Toggle
  enablePatientPortal Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// USER MANAGEMENT & RBAC
// ==========================================

model User {
  id               String           @id @default(cuid())
  email            String           @unique
  password         String
  name             String
  phone            String?
  role             Role             @default(LAB_OWNER)
  emailVerified    Boolean          @default(false)
  onboardingStatus OnboardingStatus @default(REGISTERED)
  isActive         Boolean          @default(false)
  avatar           String?

  abhaNumber  String? @unique
  abhaAddress String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? 

  // Relations
  lab                Lab?                 @relation("LabOwner")
  staffLabs          LabStaff[]
  otp                OTP?
  notifications      Notification[]
  supportTickets     SupportTicket[]
  activityLogs       ActivityLog[]
  doctor             Doctor?
  agency             Agency?
  patientProfile     Patient?             @relation("UserPatient") // Links online accounts to clinical records
  phlebotomistTrips  HomeCollectionTrip[] 
  sentInvitations    Invitation[]
  technicianReports  Report[]             @relation("TechnicianReports")
  seniorTechReports  Report[]             @relation("SeniorTechReports")
  pathologistReports Report[]             @relation("PathologistReports")

  @@index([email])
  @@index([role])
}

enum OnboardingStatus {
  REGISTERED
  VERIFIED
  LAB_SETUP
  COMPLETED
}

enum Role {
  SUPER_ADMIN
  LAB_OWNER
  TECHNICIAN
  LAB_MANAGER
  RECEPTIONIST
  DOCTOR
  AGENCY
  PATIENT       // For Public Portal Login
  PHLEBOTOMIST  // For Home Collection App
}

model OTP {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String
  type      OTPType  @default(EMAIL_VERIFICATION)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

enum OTPType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

// ==========================================
// LABORATORY CORE & ENTERPRISE MULTI-BRANCH
// ==========================================

model Lab {
  id String @id @default(cuid())

  name           String
  portalSlug     String?  @unique // Public Booking Link (e.g. patholab.cloud/book/city-lab)
  labCode        String?  @unique 
  upiId          String?  
  address        String
  city           String
  state          String
  pincode        String
  phone          String
  email          String
  licenseNumber  String  @unique
  registrationNo String?
  taxId          String?

  gstNumber  String?
  panNumber  String?
  entityType String?

  bankName      String?
  accountNumber String?
  ifscCode      String?
  accountHolder String?

  logo       String?
  letterhead String?
  footer     String?
  signature  String?
  isActive   Boolean @default(true)

  whatsappApiKey   String?
  whatsappPhoneId  String?
  smsApiKey        String?
  smsSenderId      String?

  defaultDoctorCommission Decimal?       @default(10.0) @db.Decimal(5, 2)
  defaultAgencyCommission Decimal?       @default(5.0) @db.Decimal(5, 2)
  commissionType          CommissionType @default(PERCENTAGE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  ownerId String @unique
  owner   User   @relation("LabOwner", fields: [ownerId], references: [id])

  branches               Branch[]              
  serviceAreas           ServiceArea[]
  subscription           Subscription?
  staff                  LabStaff[]
  patients               Patient[]
  tests                  Test[]
  invoices               Invoice[]
  doctors                Doctor[]
  agencies               Agency[]
  discounts              Discount[]
  samples                Sample[]
  expenses               Expense[]
  analyzers              LabAnalyzer[]
  homeTrips              HomeCollectionTrip[]
  testPricing            LabTestPricing[]      
  testCategories         TestCategory[]
  testParameters         LabTestParameter[]
  reportTemplates        ReportTemplate[]
  unmappedCodes          UnmappedMachineCode[]
  containerTypes         ContainerType[]
  departments            Department[]
  sampleTypes            SampleType[]
  testHeadings           TestHeading[]
  reports                Report[]
  inventoryItems         InventoryItem[]
  inventoryBatches       InventoryBatch[]
  suppliers              Supplier[]
  customFieldDefinitions CustomFieldDefinition[]
  customTestTemplates    TestTemplate[]        

  @@index([ownerId])
  @@index([licenseNumber])
  @@index([deletedAt])
}

model Branch {
  id            String   @id @default(cuid())
  labId         String
  lab           Lab      @relation(fields: [labId], references: [id], onDelete: Cascade)
  
  name          String   
  code          String?  
  branchCode    String?  
  isMainBranch  Boolean  @default(false)

  // Branding Overrides
  logo          String?
  letterhead    String?
  footer        String?
  signature     String?
  
  address       String
  city          String
  state         String
  pincode       String
  phone         String?
  email         String?
  isActive      Boolean  @default(true)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  // Inverse Enterprise Relations
  serviceAreas        ServiceArea[] // Pin code mappings
  staff               LabStaff[]
  patients            Patient[]
  samples             Sample[]
  appointments        Appointment[]
  tests               Test[]
  invoices            Invoice[]
  expenses            Expense[]
  doctors             Doctor[]
  agencies            Agency[]
  discounts           Discount[]
  analyzers           LabAnalyzer[]
  inventoryBatches    InventoryBatch[]
  radiologyAppointments RadiologyAppointment[]
  radiologyStudies    RadiologyStudy[]
  modalities          Modality[]
  testPricings        LabTestPricing[]
  testTemplates       TestTemplate[]
  reportTemplates     ReportTemplate[]
  reports             Report[]
  homeTrips           HomeCollectionTrip[]
  auditLogs           AuditLog[]

  @@index([labId])
}

// LOGISTICS: Service Areas for Home Collection Assignment
model ServiceArea {
  id          String   @id @default(cuid())
  labId       String
  lab         Lab      @relation(fields: [labId], references: [id], onDelete: Cascade)
  branchId    String
  branch      Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  
  pincode     String
  areaName    String?
  deliveryFee Decimal  @default(0.00) @db.Decimal(10, 2)
  
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@unique([labId, branchId, pincode])
}

model LabStaff {
  id         String  @id @default(cuid())
  labId      String
  lab        Lab     @relation(fields: [labId], references: [id], onDelete: Cascade)
  userId     String
  employeeId String? @unique  
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  branchId   String?
  branch     Branch? @relation(fields: [branchId], references: [id])

  position   String
  department String?
  salary     Decimal?  @db.Decimal(10, 2)
  joinDate   DateTime  @default(now())
  isActive   Boolean   @default(true)

  permissions String[] @default([])

  createdAt  DateTime @default(now())

  @@unique([labId, userId])
  @@index([labId])
}

// ==========================================
// SAAS PLAN DEFINITIONS
// ==========================================

model Plan {
  id          String  @id @default(cuid())
  name        String  @unique 
  displayName String  
  description String?

  price        Decimal      @db.Decimal(10, 2)
  currency     String       @default("INR")
  billingCycle BillingCycle @default(MONTHLY)
  razorpayId   String?  

  maxTestsPerMonth Int   @default(100) 
  maxPatientsTotal Int   @default(1000) 
  maxStaff         Int   @default(2) 
  maxStorageGB     Float @default(1.0) 
  maxBranches      Int   @default(1)     

  // SaaS Level Module Gatekeeping Toggles
  hasInventory    Boolean @default(false)
  hasAnalytics    Boolean @default(false)
  hasB2bBilling   Boolean @default(false) 
  hasEmailReports Boolean @default(true)
  hasWhatsapp     Boolean @default(false)
  hasAiPrediction Boolean @default(false)
  hasApiAccess    Boolean @default(false) 
  hasWhiteLabel   Boolean @default(false) 
  hasLogistics    Boolean @default(false) 
  hasMachineIoT   Boolean @default(false) 
  hasRadiology    Boolean @default(false) 
  hasExpenses     Boolean @default(true)  

  isActive  Boolean @default(true)
  isPopular Boolean @default(false)
  
  features  String[] @default([]) 

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  YEARLY
  LIFETIME
}

// ==========================================
// SAAS ADD-ONS & SUBSCRIPTIONS
// ==========================================

model AddOn {
  id          String  @id @default(cuid())
  name        String  
  description String? 

  price      Decimal @db.Decimal(10, 2)
  currency   String  @default("INR")
  razorpayId String?  

  type  AddOnType
  value Int 

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments Payment[] 
}

enum AddOnType {
  TEST_LIMIT 
  STORAGE_LIMIT 
  PATIENT_LIMIT 
  STAFF_LIMIT 
  BRANCH_LIMIT 
}

model Subscription {
  id      String @id @default(cuid())
  labId   String @unique
  lab     Lab    @relation(fields: [labId], references: [id], onDelete: Cascade)

  planId String
  plan   Plan   @relation(fields: [planId], references: [id])
  
  unlockedFeatures String[] @default([]) 

  status SubStatus @default(TRIAL)

  startDate DateTime @default(now())
  endDate   DateTime

  razorpaySubId String? @unique

  boosterTests    Int   @default(0)
  boosterStorage  Float @default(0.0)
  boosterStaff    Int   @default(0)
  boosterPatients Int   @default(0)
  boosterBranches Int   @default(0) 

  bonusTests    Int   @default(0)
  bonusStorage  Float @default(0.0)
  bonusBranches Int   @default(0) 

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments     Payment[]
  usage        UsageMetric[] 
  currentUsage CurrentUsage? 
}

enum SubStatus {
  PENDING_LAB_SETUP
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

model CurrentUsage {
  id             String       @id @default(cuid())
  subscriptionId String       @unique
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  testsUsed     Int   @default(0) 
  patientsCount Int   @default(0) 
  staffCount    Int   @default(1) 
  branchesCount Int   @default(1) 
  storageUsedGB Float @default(0.0) 

  lastUpdated DateTime @updatedAt
}

// ==========================================
// SAAS BILLING & PAYMENTS
// ==========================================

model Payment {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id])

  addOnId String?
  addOn   AddOn?  @relation(fields: [addOnId], references: [id])

  amount    Decimal       @db.Decimal(10, 2)
  taxAmount Decimal?      @db.Decimal(10, 2)
  currency  String        @default("INR")
  status    PaymentStatus @default(PENDING)

  razorpayOrderId   String? @unique
  razorpayPaymentId String? @unique

  invoiceNumber String?   @unique
  invoiceDate   DateTime? @default(now())
  invoiceUrl    String?

  billingSnapshot Json?

  createdAt DateTime @default(now())
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

// ==========================================
// TEST ENGINE & STRUCTURED RESULTS 
// ==========================================

model Department {
  id       String  @id @default(cuid())
  labId    String?
  lab      Lab?    @relation(fields: [labId], references: [id], onDelete: Cascade)
  isGlobal Boolean @default(false)

  name         String
  code         String?
  displayOrder Int      @default(0)

  testTemplates TestTemplate[] 
  createdAt     DateTime @default(now())

  @@unique([labId, name])
}

model SampleType {
  id       String  @id @default(cuid())
  labId    String?
  lab      Lab?    @relation(fields: [labId], references: [id], onDelete: Cascade)
  isGlobal Boolean @default(false)

  name String
  code String? 

  testTemplates TestTemplate[] 
  patientSamples Sample[]      
  
  createdAt     DateTime @default(now())

  @@unique([labId, name])
}

model ContainerType {
  id       String  @id @default(cuid())
  labId    String?
  lab      Lab?    @relation(fields: [labId], references: [id])
  isGlobal Boolean @default(false)

  name     String 
  code     String 
  capColor String? 

  templates  TestTemplate[]
  parameters LabTestParameter[]
  patientSamples Sample[]      

  createdAt DateTime @default(now())

  @@unique([labId, name])
}

model TestCategory {
  id          String  @id @default(cuid())
  labId       String?
  lab         Lab?    @relation(fields: [labId], references: [id])
  isGlobal    Boolean @default(false)

  name        String
  description String?
  icon        String?
  isActive    Boolean @default(true)

  testTemplates TestTemplate[]
  tests         Test[]

  createdAt DateTime @default(now())

  @@unique([labId, name])
}

model TestHeading {
  id       String  @id @default(cuid())
  labId    String?
  lab      Lab?    @relation(fields: [labId], references: [id], onDelete: Cascade)
  isGlobal Boolean @default(false)

  name       String 
  parameters TestTemplateParameter[]
  createdAt  DateTime @default(now())

  @@unique([labId, name])
}

model LabTestParameter {
  id       String  @id @default(cuid())
  labId    String?
  lab      Lab?    @relation(fields: [labId], references: [id])
  isGlobal Boolean @default(false)

  forkedFromId    String?
  forkedFrom      LabTestParameter?  @relation("ParamOverrides", fields: [forkedFromId], references: [id])
  forks           LabTestParameter[] @relation("ParamOverrides")

  name      String 
  printName String? 
  code      String 
  unit      String? 

  isDerived Boolean @default(false)
  formula   String? 

  inputType ParameterInputType @default(NUMBER)
  decimals  Int                @default(2) 
  method    String? 
  price     Decimal            @default(0.00) @db.Decimal(10, 2)
  options   String[] 

  usedInTemplates TestTemplateParameter[]
  referenceRanges ParameterReferenceRange[]
  reagents        TestParameterReagent[]

  containerTypeId String?
  containerType   ContainerType? @relation(fields: [containerTypeId], references: [id])

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([labId, code])
  @@index([labId])
}

model ParameterReferenceRange {
  id          String           @id @default(cuid())
  parameterId String
  parameter   LabTestParameter @relation(fields: [parameterId], references: [id], onDelete: Cascade)

  gender Gender 

  minAge   Int    @default(0)
  maxAge   Int    @default(100)
  ageUnit  String @default("YEAR") 

  lowValue  Float? 
  highValue Float? 

  criticalLow  Float? 
  criticalHigh Float? 

  textValue   String? 
  displayText String? 

  customLabel String?

  createdAt DateTime @default(now())

  @@index([parameterId])
}

model TestTemplateParameter {
  id String @id @default(cuid())

  templateId String
  template   TestTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  parameterId String
  parameter   LabTestParameter @relation(fields: [parameterId], references: [id])

  order     Int @default(0)
  headingId String?
  heading   TestHeading? @relation(fields: [headingId], references: [id])

  @@unique([templateId, parameterId])
  @@index([templateId])
}

enum ParameterInputType {
  NUMBER
  TEXT
  LONG_TEXT
  DROPDOWN
  HEADING 
}

enum TestType {
  SINGLE 
  BUNDLE 
  PROFILE 
}

model TestTemplate {
  id       String  @id @default(cuid())
  labId    String?
  lab      Lab?    @relation(fields: [labId], references: [id], onDelete: Cascade)
  isGlobal Boolean @default(false)

  // Branch Specific Overrides
  branchId       String?
  branch         Branch?    @relation(fields: [branchId], references: [id], onDelete: Cascade)

  categoryId String?
  category   TestCategory? @relation(fields: [categoryId], references: [id])

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  sampleTypeId String?
  sampleType   SampleType? @relation(fields: [sampleTypeId], references: [id])

  containerTypeId String?
  containerType   ContainerType? @relation(fields: [containerTypeId], references: [id])

  name        String
  printName   String?
  code        String
  @@unique([labId, code, branchId])

  description String?
  
  // Public Portal Visibility
  isPublic     Boolean @default(true)
  isPopular    Boolean @default(false)
  preRequistes String?

  price    Decimal  @db.Decimal(10, 2)
  b2bPrice Decimal? @default(0.00) @db.Decimal(10, 2)
  cost     Decimal? @default(0.00) @db.Decimal(10, 2)
  tat String?  // Time Around Time in Hours
  method   String?

  volume       String?
  duration     Int?
  requirements String?

  predefinedNotes Json?

  type      TestType @default(SINGLE)
  isActive  Boolean  @default(true)
  isNabl    Boolean  @default(false)
  
  defaultTextReport String? 

  parameters        TestTemplateParameter[]
  patientTests      Test[]
  customFields      TestTemplateField[]
  doctorCommissions DoctorTestCommission[]
  agencyCommissions AgencyTestCommission[]
  labPricing        LabTestPricing[]

  bundleItems   TestTemplateBundle[] @relation("BundleParent")
  partOfBundles TestTemplateBundle[] @relation("BundleChild")
  
  forkedFromId    String?
  forkedFrom      TestTemplate?  @relation("TemplateOverrides", fields: [forkedFromId], references: [id])
  forks           TestTemplate[] @relation("TemplateOverrides")

  referenceData Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([departmentId])
  @@index([labId])
  @@index([branchId])
}

model TestTemplateBundle {
  id        String       @id @default(cuid())
  
  parentId  String
  parent    TestTemplate @relation("BundleParent", fields: [parentId], references: [id], onDelete: Cascade)
  
  childId   String
  child     TestTemplate @relation("BundleChild", fields: [childId], references: [id], onDelete: Cascade)

  order     Int          @default(0) 

  @@unique([parentId, childId])
}

model LabTestPricing {
  id             String       @id @default(cuid())
  labId          String
  lab            Lab          @relation(fields: [labId], references: [id], onDelete: Cascade)
  
  branchId       String?
  branch         Branch?      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  
  testTemplateId String
  testTemplate   TestTemplate @relation(fields: [testTemplateId], references: [id], onDelete: Cascade)

  price    Decimal  @db.Decimal(10, 2)
  b2bPrice Decimal? @default(0.00) @db.Decimal(10, 2)
  cost     Decimal? @default(0.00) @db.Decimal(10, 2)
  tat String?
  
  isActive Boolean @default(true)

  @@unique([labId, testTemplateId, branchId])
  @@index([labId])
  @@index([branchId])
}

// ==========================================
// TEST EXECUTION & LOGISTICS
// ==========================================

model Patient {
  id        String  @id @default(cuid())
  labId     String
  lab       Lab     @relation(fields: [labId], references: [id])
  branchId  String?
  branch    Branch? @relation(fields: [branchId], references: [id])
  patientId String

  // Online Portal Links
  userId    String? @unique
  user      User?   @relation("UserPatient", fields: [userId], references: [id])

  name          String
  email         String?
  phone         String
  dateOfBirth   DateTime?
  age           Int?
  ageUnit       String    @default("Years") 
  gender        Gender?
  bloodGroup    String?
  address       String?
  pincode       String? // Route Assignment

  srfId          String?
  passportNumber String?

  gstNumber         String?
  walletBalance     Decimal  @default(0.00) @db.Decimal(10, 2)
  loyaltyPoints     Int      @default(0)
  membershipTier    String   @default("SILVER")
  chronicConditions String[]

  doctorId String?
  doctor   Doctor? @relation("PatientDefaultDoctor", fields: [doctorId], references: [id])

  agencyId String?
  agency   Agency? @relation("PatientDefaultAgency", fields: [agencyId], references: [id])

  medicalHistory Json?
  allergies      String?

  abhaNumber String?
  healthId   String?
  
  dataConsentGranted Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? 

  tests                 Test[]
  appointments          Appointment[]
  samples               Sample[]
  invoices              Invoice[]
  reports               Report[]
  radiologyAppointments RadiologyAppointment[]
  radiologyStudies      RadiologyStudy[]

  @@unique([labId, patientId])
  @@unique([labId, abhaNumber])
  @@index([phone])
}

enum Gender {
  MALE
  FEMALE
  OTHER
  BOTH
  CUSTOM
}

model Sample {
  id        String  @id @default(cuid())
  labId     String
  lab       Lab     @relation(fields: [labId], references: [id])
  branchId  String?
  branch    Branch? @relation(fields: [branchId], references: [id])

  sampleId      String
  barcodeFormat String @default("CODE128")

  tests     Test[]
  patientId String
  patient   Patient @relation(fields: [patientId], references: [id])

  sampleTypeId    String?
  sampleType      SampleType?    @relation(fields: [sampleTypeId], references: [id])

  containerTypeId String?
  containerType   ContainerType? @relation(fields: [containerTypeId], references: [id])

  collectionMode    CollectionMode @default(LAB_VISIT)
  collectedAt       DateTime?
  collectedBy       String?
  collectionLat     Float?
  collectionLng     Float?
  collectionAddress String?

  courierName        String?
  trackingNumber     String?
  transitTemperature String?

  status SampleStatus @default(COLLECTED)

  storageLocation String?
  temperature     String?

  receivedAt DateTime?
  receivedBy String?
  condition  String?

  machineId    String?
  rackPosition String?

  rejectionReason String?

  timeline  SampleLog[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  deletedAt DateTime?

  @@unique([labId, sampleId])
  @@index([sampleId])
  @@index([labId, status, createdAt]) 
}

enum SampleStatus {
  COLLECTED
  IN_TRANSIT
  RECEIVED
  PROCESSING
  PROCESSED
  STORED
  REJECTED
}

enum CollectionMode {
  LAB_VISIT
  HOME_COLLECTION
  HOSPITAL_PICKUP
}

model SampleLog {
  id        String       @id @default(cuid())
  sampleId  String
  sample    Sample       @relation(fields: [sampleId], references: [id])
  status    SampleStatus
  timestamp DateTime     @default(now())
  actor     String
  notes     String?
  location  String?
}

model HomeCollectionTrip {
  id             String  @id @default(cuid())
  labId          String
  lab            Lab     @relation(fields: [labId], references: [id])
  branchId       String?
  branch         Branch? @relation(fields: [branchId], references: [id])
  phlebotomistId String
  phlebotomist   User    @relation(fields: [phlebotomistId], references: [id])

  scheduledDate DateTime
  startLocation String?
  endLocation   String?
  totalDistance Float?
  status        TripStatus @default(SCHEDULED)

