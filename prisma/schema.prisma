// ==========================================
// 1. PLAN DEFINITIONS (The Base Tier)
// ==========================================

model Plan {
  id          String  @id @default(cuid())
  name        String  @unique // Internal slug (e.g. "starter_monthly", "pro_yearly")
  displayName String // Public name (e.g. "Starter Plan")
  description String?

  // --- Pricing ---
  price        Float
  currency     String       @default("INR")
  billingCycle BillingCycle @default(MONTHLY)
  razorpayId   String? // Razorpay Plan ID for auto-recurring

  // --- Hard Limits (Base Monthly Allowance) ---
  // Set -1 for Unlimited
  maxTestsPerMonth Int   @default(100) // Resets every month
  maxPatientsTotal Int   @default(1000) // Total DB records allowed
  maxStaff         Int   @default(2) // Active staff accounts
  maxStorageGB     Float @default(1.0) // File storage cap

  // --- Feature Flags (Module Access) ---
  hasInventory    Boolean @default(false)
  hasAnalytics    Boolean @default(false)
  hasB2bBilling   Boolean @default(false) // Doctor/Agency commissions
  hasEmailReports Boolean @default(true)
  hasWhatsapp     Boolean @default(false)
  hasAiPrediction Boolean @default(false)
  hasApiAccess    Boolean @default(false) // <--- ADD THIS BACK
  hasWhiteLabel   Boolean @default(false) // Remove your branding

  // --- UI/Marketing ---
  isActive  Boolean @default(true)
  isPopular Boolean @default(false)
  features  Json    @default("[]") // Array of strings for pricing page

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  YEARLY
  LIFETIME
}

// ==========================================
// 2. ADD-ONS (Booster Packs)
// ==========================================

model AddOn {
  id          String  @id @default(cuid())
  name        String // e.g. "50 Test Booster"
  description String? // e.g. "Valid for current month only"

  // Pricing
  price      Float
  currency   String  @default("INR")
  razorpayId String? // Optional linked Razorpay Item ID

  // Functionality
  type  AddOnType
  value Int // The numeric amount to add (e.g. 50, 1, 1024)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  payments Payment[] // Linked to payments for invoicing
}

enum AddOnType {
  TEST_LIMIT // Adds to monthly test quota
  STORAGE_LIMIT // Adds to storage quota (GB)
  PATIENT_LIMIT // Adds to total patient capacity
  STAFF_LIMIT // Adds extra staff seat
}

// ==========================================
// 3. SUBSCRIPTIONS (The License State)
// ==========================================

model Subscription {
  id    String @id @default(cuid())
  labId String @unique
  lab   Lab    @relation(fields: [labId], references: [id], onDelete: Cascade)

  planId String
  plan   Plan   @relation(fields: [planId], references: [id])

  status SubStatus @default(TRIAL)

  startDate DateTime @default(now())
  endDate   DateTime

  razorpaySubId String? @unique

  // --- DYNAMIC LIMITS (The Logic) ---
  // Total Limit = Plan.Limit + Booster + Bonus

  // 1. Paid Add-ons (Reset these to 0 every month via Cron)
  boosterTests    Int   @default(0)
  boosterStorage  Float @default(0.0)
  boosterStaff    Int   @default(0)
  boosterPatients Int   @default(0)

  // 2. Admin Overrides (Permanent or goodwill adjustments)
  bonusTests   Int   @default(0)
  bonusStorage Float @default(0.0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments     Payment[]
  usage        UsageMetric[] // Historical reporting
  currentUsage CurrentUsage? // Real-time consumption tracker
}

enum SubStatus {
  PENDING_LAB_SETUP
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

