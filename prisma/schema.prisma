// ==========================================
// CONFIG & GENERATOR
// ==========================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// SYSTEM CONFIGURATION
// ==========================================

model SystemConfig {
  id            String  @id @default(cuid())
  systemName    String  @default("Patholab Cloud") // Your SaaS Name
  systemLogo    String?
  systemEmail   String?
  systemPhone   String?
  systemAddress String?

  // ✅ NEW: SaaS Legal Details (For "Bill From" on Invoices)
  gstNumber     String? // Your Company's GST
  panNumber     String? // Your Company's PAN
  invoicePrefix String  @default("SAAS") // Prefix for invoices (e.g. SAAS-1001)
  nextInvoiceNo Int     @default(1) // Auto-increment counter

  primaryColor   String @default("#3b82f6")
  secondaryColor String @default("#8b5cf6")
  currency       String @default("INR")
  currencySymbol String @default("₹")
  taxRate        Float  @default(18.0)
  landingPage    Json?

  // Integrations
  enableABDM        Boolean @default(false)
  abdmClientId      String?
  abdmClientSecret  String?
  razorpayKeyId     String?
  razorpayKeySecret String?

  // Email
  smtpHost     String?
  smtpPort     Int?
  smtpUser     String?
  smtpPassword String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// USER MANAGEMENT & RBAC
// ==========================================

model User {
  id               String           @id @default(cuid())
  email            String           @unique
  password         String
  name             String
  phone            String?
  role             Role             @default(LAB_OWNER)
  emailVerified    Boolean          @default(false)
  // ✅ CHANGE 1: Add Onboarding Status
  onboardingStatus OnboardingStatus @default(REGISTERED)

  // ✅ CHANGE 2: Default isActive to false until payment
  isActive Boolean @default(false)

  avatar String?

  // ABDM Integration
  abhaNumber  String? @unique
  abhaAddress String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  lab                Lab?                 @relation("LabOwner")
  staffLabs          LabStaff[]
  otp                OTP?
  notifications      Notification[]
  supportTickets     SupportTicket[]
  activityLogs       ActivityLog[]
  doctor             Doctor?
  agency             Agency?
  phlebotomistTrips  HomeCollectionTrip[]
  sentInvitations    Invitation[]
  technicianReports  Report[]             @relation("TechnicianReports")
  seniorTechReports  Report[]             @relation("SeniorTechReports")
  pathologistReports Report[]             @relation("PathologistReports")

  @@index([email])
  @@index([role])
}

enum OnboardingStatus {
  REGISTERED // Step 2 complete (Account created)
  VERIFIED // Step 3 complete (OTP done)
  LAB_SETUP // Step 4 complete (Lab details saved)
  COMPLETED // Step 5 complete (Payment done)
}

enum Role {
  SUPER_ADMIN
  LAB_OWNER
  TECHNICIAN
  LAB_MANAGER
  RECEPTIONIST
  DOCTOR
  AGENCY
}

model OTP {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String
  type      OTPType  @default(EMAIL_VERIFICATION)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

enum OTPType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

// ==========================================
// LABORATORY CORE
// ==========================================

model Lab {
  id String @id @default(cuid())

  // Basic Info
  name           String
  address        String
  city           String
  state          String
  pincode        String
  phone          String
  email          String
  licenseNumber  String     @unique
  registrationNo String?
  taxId          String?
 

  // GST & Legal
  gstNumber  String?
  panNumber  String?
  entityType String?

  // Banking
  bankName      String?
  accountNumber String?
  ifscCode      String?
  accountHolder String?

  // Branding
  logo       String?
  letterhead String?
  footer     String?
  signature  String?
  isActive   Boolean @default(true)

  // Commission Settings
  defaultDoctorCommission Float?         @default(10)
  defaultAgencyCommission Float?         @default(5)
  commissionType          CommissionType @default(PERCENTAGE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Owner
  ownerId String @unique
  owner   User   @relation("LabOwner", fields: [ownerId], references: [id])

  // Relations
  subscription   Subscription?
  staff          LabStaff[]
  patients       Patient[]
  tests          Test[]
  testCategories TestCategory[]
  testParameters LabTestParameter[]
  invoices       Invoice[]
  doctors        Doctor[]
  agencies       Agency[]
  discounts      Discount[]
  samples        Sample[]

  reportTemplates ReportTemplate[]
  unmappedCodes UnmappedMachineCode[]

  // ✅ ADD THIS LINE TO FIX THE ERROR:
  containerTypes ContainerType[]

  departments  Department[]
  sampleTypes  SampleType[]
  testHeadings TestHeading[]
  reports      Report[]
  expenses       Expense[]

  // Inventory & IoT Relations
  inventoryItems   InventoryItem[]
  inventoryBatches InventoryBatch[]
  suppliers        Supplier[]
  analyzers        LabAnalyzer[]
  homeTrips        HomeCollectionTrip[]

  customFieldDefinitions CustomFieldDefinition[]

  @@index([ownerId])
  @@index([licenseNumber])
}

model LabStaff {
  id     String @id @default(cuid())
  labId  String
  lab    Lab    @relation(fields: [labId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  position   String
  department String?
  salary     Float?
  joinDate   DateTime @default(now())
  isActive   Boolean  @default(true)

  customPermissions Json?

  createdAt DateTime @default(now())

  @@unique([labId, userId])
  @@index([labId])
}


// ==========================================
// INVENTORY MANAGEMENT (Catalog & Batch Architecture)
// ==========================================

model Supplier {
  id            String  @id @default(cuid())
  labId         String
  lab           Lab     @relation(fields: [labId], references: [id])
  name          String
  contactPerson String?
  email         String?
  phone         String?
  address       String?
  gstNumber     String?

  inventoryItems InventoryItem[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([labId])
}

// 1. The Item Master (The Catalog Definition - NO stock levels here)
model InventoryItem {
  id    String @id @default(cuid())
  labId String
  lab   Lab    @relation(fields: [labId], references: [id])

  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id])

  name        String
  sku         String?
  description String?
  category    String?

  // Setup for Unit Conversion (e.g., Buy "Box", Use "ml")
  purchaseUnit     String @default("Box")
  usageUnit        String @default("ml")
  conversionFactor Float  @default(1.0)
  minStockLevel    Float  @default(10) // Alert when total active batch stock drops below this
  reorderLevel     Float?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  batches InventoryBatch[]
  recipes TestParameterReagent[] // Maps to tests consuming this

  @@unique([labId, name])
  @@index([labId])
}

// 2. The Physical Batch/Lot (The Shelf Stock)
model InventoryBatch {
  id    String @id @default(cuid())
  labId String
  lab   Lab    @relation(fields: [labId], references: [id])

  itemId String
  item   InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  batchNumber String
  expiryDate  DateTime

  // Stock logic for this specific batch
  initialQuantity Float
  currentQuantity Float @default(0)

  costPrice Float?
  mrp       Float?
  location  String? // e.g., "Fridge A", "Store Room"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions InventoryTransaction[]

  @@unique([itemId, batchNumber])
  @@index([itemId])
  @@index([labId])
}

// 3. The Transaction Log (The Ledger)
model InventoryTransaction {
  id String @id @default(cuid())

  // ✅ CHANGED: Now points to the Batch, not the Item
  batchId String?
  batch   InventoryBatch? @relation(fields: [batchId], references: [id], onDelete: Cascade)

  quantity Float // Positive (+ addition), Negative (- consumption)          
  type     StockType

  // Context
  testId String?
  test   Test?   @relation(fields: [testId], references: [id])

  notes       String?
  performedBy String?
  createdAt   DateTime @default(now())

  @@index([batchId])
  @@index([type])
}

// 4. The Consumption Recipe (Links Test Parameters -> Reagents)
model TestParameterReagent {
  id String @id @default(cuid())

  parameterId String
  parameter   LabTestParameter @relation(fields: [parameterId], references: [id], onDelete: Cascade)

  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  // Amount consumed PER TEST (e.g. 1.5). This uses the `usageUnit` from InventoryItem
  quantity Float

  createdAt DateTime @default(now())

  @@unique([parameterId, inventoryItemId])
}

enum StockType {
  PURCHASE
  CONSUMPTION
  RETURN
  WASTAGE
  EXPIRED
  ADJUSTMENT
}

// ==========================================
// TEST ENGINE & STRUCTURED RESULTS
// ==========================================
model TestCategory {
  id    String  @id @default(cuid())
  labId String?
  lab   Lab?    @relation(fields: [labId], references: [id])

  name        String
  description String?
  icon        String?
  isActive    Boolean @default(true)
  isGlobal    Boolean @default(false)

  testTemplates TestTemplate[]
  tests         Test[]

  createdAt DateTime @default(now())

  @@unique([labId, name])
}

model TestTemplate {
  id String @id @default(cuid())

  categoryId String?
  category   TestCategory? @relation(fields: [categoryId], references: [id])

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  sampleTypeId String?
  sampleType   SampleType? @relation(fields: [sampleTypeId], references: [id])

  // ✅ LINK TO CONTAINER MASTER (Crucial for Barcode Logic)
  containerTypeId String?
  containerType   ContainerType? @relation(fields: [containerTypeId], references: [id])

  legacySampleType String? @map("sampleType")

  name        String
  printName   String?
  code        String
  description String?

  price    Float
  b2bPrice Float?  @default(0)
  cost     Float?  @default(0)
  tat      String?
  method   String?

  // Configuration
  volume       String?
  duration     Int?
  requirements String?

  type     TestType @default(SINGLE)
  isActive Boolean  @default(true)
  isNabl   Boolean  @default(false)
  
  // ✅ DIAGNOSTICS: Pre-filled standard text (HTML) for Radiology/Cardio tests
  defaultTextReport String? 

  parameters   TestTemplateParameter[]
  patientTests Test[]
  customFields TestTemplateField[]

  // ✅ NEW: Relations to the custom Doctor/Agency commission lists
  doctorCommissions DoctorTestCommission[]
  agencyCommissions AgencyTestCommission[]

  referenceData Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  @@index([departmentId])
}

// ==========================================
// NEW LIMS MASTER DATA (Departments, Samples, Headings)
// ==========================================

model Department {
  id    String @id @default(cuid())
  labId String
  lab   Lab    @relation(fields: [labId], references: [id], onDelete: Cascade)

  name         String // e.g., "Hematology", "Biochemistry"
  code         String? // e.g., "HEM"
  displayOrder Int     @default(0)

  testTemplates TestTemplate[] // Links to the Test Master

  createdAt DateTime @default(now())

  @@unique([labId, name])
}

model SampleType {
  id    String @id @default(cuid())
  labId String
  lab   Lab    @relation(fields: [labId], references: [id], onDelete: Cascade)

  name String // e.g., "Serum", "EDTA Whole Blood"
  code String? // e.g., "SER"

  testTemplates TestTemplate[] // Links to the Test Master

  createdAt DateTime @default(now())

  @@unique([labId, name])
}

model TestHeading {
  id    String @id @default(cuid())
  labId String
  lab   Lab    @relation(fields: [labId], references: [id], onDelete: Cascade)

  name String // e.g., "LIPID PROFILE", "COMPLETE BLOOD COUNT"

  // Used to group parameters inside a test template
  parameters TestTemplateParameter[]

  createdAt DateTime @default(now())

  @@unique([labId, name])
}

model Test {
  id         String @id @default(cuid())
  labId      String
  lab        Lab    @relation(fields: [labId], references: [id])
  testNumber String

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id])

  categoryId String?
  category   TestCategory? @relation(fields: [categoryId], references: [id])

  testTemplateId String?
  testTemplate   TestTemplate? @relation(fields: [testTemplateId], references: [id])

  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id])

  // ✅ LINK BACK TO SAMPLE (The Fix: Many Tests -> One Sample)
  sampleId String?
  sample   Sample? @relation(fields: [sampleId], references: [id])

  testName String
  testCode String

  status   TestStatus   @default(PENDING)
  priority TestPriority @default(NORMAL)

  referredBy String?
  doctorId   String?
  doctor     Doctor? @relation("DoctorReferral", fields: [doctorId], references: [id])
  agencyId   String?
  agency     Agency? @relation("AgencyReferral", fields: [agencyId], references: [id])

  // Timestamps
  scheduledAt         DateTime?
  sampleCollectedAt   DateTime?
  processingStartedAt DateTime?
  completedAt         DateTime?
  approvedAt          DateTime?
  approvedBy          String?
  reportGeneratedAt   DateTime?
  sampleReceivedAt    DateTime?

  reportUrl  String?
  notes      String?
  impression String?

  price      Float
  discount   Float @default(0)
  finalPrice Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  commissions    Commission[]
  results        TestResultParameter[]
  inventoryUsage InventoryTransaction[]
  aiPrediction   AIPrediction?
  customResults  TestResultCustomField[]

  @@unique([labId, testNumber])
  @@index([patientId])
  @@index([status])
}

// Unified Result Model (Manual + Machine + AI)
model TestResultParameter {
  id     String @id @default(cuid())
  testId String
  test   Test   @relation(fields: [testId], references: [id], onDelete: Cascade)

  parameterName String
  value         String
  unit          String?

  // Reference Range Snapshot
  refRangeMin  Float?
  refRangeMax  Float?
  refRangeText String?

  // Analysis
  isAbnormal Boolean @default(false)
  isCritical Boolean @default(false)

  // Source Tracking (V3)
  analyzerId  String?
  analyzer    LabAnalyzer? @relation(fields: [analyzerId], references: [id])
  entryMethod EntryMethod  @default(MANUAL)

  order Int @default(0)

  @@index([testId])
}

enum EntryMethod {
  MANUAL
  MACHINE_INTERFACE
  FILE_UPLOAD
}

model AIPrediction {
  id     String @id @default(cuid())
  testId String @unique
  test   Test   @relation(fields: [testId], references: [id])

  summary         String
  riskScore       Float?
  recommendations Json?
  modelUsed       String?
  createdAt       DateTime @default(now())
}

enum TestStatus {
  PENDING
  SCHEDULED
  SAMPLE_COLLECTED
  IN_PROGRESS
  COMPLETED
  APPROVED
  DELIVERED
  CANCELLED
}

enum TestPriority {
  NORMAL
  URGENT
  CRITICAL
}

// ==========================================
// NEW: TEST PARAMETER DEFINITIONS (The "Library")
// ==========================================

// 1. The Reusable Parameter (e.g., "Hemoglobin", "WBC Count")
model LabTestParameter {
  id    String @id @default(cuid())
  labId String
  lab   Lab    @relation(fields: [labId], references: [id])

  name      String // e.g., "Hemoglobin"
  printName String? // ✅ e.g., "Hemoglobin (Hb)"
  code      String // e.g., "HB"
  unit      String? // e.g., "g/dL"

  // ✅ NEW: Professional Features
  inputType ParameterInputType @default(NUMBER)
  decimals  Int                @default(2) // e.g. 12.50 vs 12.5
  method    String? // e.g. "Photometry"
  formula   String? // ✅ e.g., "(a/b)*100" (For Globulin/Ratios)

  price Float @default(0)

  options String[] // Dropdown values

  // Relations
  usedInTemplates TestTemplateParameter[]
  referenceRanges ParameterReferenceRange[]
  reagents        TestParameterReagent[]

  // ✅ Add this so single parameters know their tube type
  containerTypeId String?
  containerType   ContainerType? @relation(fields: [containerTypeId], references: [id])

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([labId, code])
  @@index([labId])
}

// 2. Reference Ranges (Smart High/Low Logic)
model ParameterReferenceRange {
  id          String           @id @default(cuid())
  parameterId String
  parameter   LabTestParameter @relation(fields: [parameterId], references: [id], onDelete: Cascade)

  // Demographics
  gender Gender // MALE, FEMALE, OTHER, BOTH (Handle BOTH in logic)

  // ✅ NEW: Flexible Age Logic
  minAge  Int    @default(0)
  maxAge  Int    @default(100)
  ageUnit String @default("YEAR") // YEAR, MONTH, DAY (Crucial for babies)

  // Values
  lowValue  Float? // Normal Low
  highValue Float? // Normal High

  // ✅ NEW: Panic Values
  criticalLow  Float? // Panic Low (Triggers red alert)
  criticalHigh Float? // Panic High

  textValue   String? // For qualitative tests (e.g., "Negative")
  displayText String? // What to show on report if normal (Optional)

  customLabel String?

  createdAt DateTime @default(now())

  @@index([parameterId])
}

// 3. The Linker (Connects Parameters to Billable Tests)
model TestTemplateParameter {
  id String @id @default(cuid())

  templateId String
  template   TestTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  parameterId String
  parameter   LabTestParameter @relation(fields: [parameterId], references: [id])

  order Int @default(0)

  // ✅ NEW: Grouping inside the test
  headingId String?
  heading   TestHeading? @relation(fields: [headingId], references: [id])

  @@unique([templateId, parameterId])
  @@index([templateId])
}

enum ParameterInputType {
  NUMBER
  TEXT
  LONG_TEXT
  DROPDOWN
  HEADING // Useful for grouping sections in a report (e.g. "MICROSCOPY")
}

enum TestType {
  SINGLE // One parameter only
  BUNDLE // Multiple parameters (CBC, LFT)
  PROFILE // Complex grouping
}

// ==========================================
// REFERRAL & COMMISSION
// ==========================================

model Doctor {
  id             String  @id @default(cuid())
  labId          String
  lab            Lab     @relation(fields: [labId], references: [id])

  // ✅ 1. Made User relation optional
  userId         String? @unique
  user           User?   @relation(fields: [userId], references: [id])

  // ✅ 2. Added direct contact info for quick tracking without a user account
  name           String  @default("Legacy Doctor")
  email          String? 
  phone          String? 

  // ✅ 3. Made registrationNo optional
  registrationNo String? 
  specialization String?
  qualification  String?
  clinic         String?

  commissionRate Float?
  commissionType CommissionType @default(PERCENTAGE)
  customTestCommissions DoctorTestCommission[]

  totalReferrals  Int   @default(0)
  totalCommission Float @default(0)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tests       Test[]       @relation("DoctorReferral")
  commissions Commission[]
  patients    Patient[]    @relation("PatientDefaultDoctor")

  @@unique([labId, registrationNo])
  @@index([labId])
}

model Agency {
  id             String  @id @default(cuid())
  labId          String
  lab            Lab     @relation(fields: [labId], references: [id])

  // ✅ 1. Made User relation optional
  userId         String? @unique
  user           User?   @relation(fields: [userId], references: [id])

  // ✅ 2. Added direct contact info
  agencyName     String @default("Legacy Agency")
  contactPerson  String?
  email          String? 
  phone          String? 
  panNumber      String?

  commissionRate Float?
  commissionType CommissionType @default(PERCENTAGE)

  totalReferrals  Int   @default(0)
  totalCommission Float @default(0)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tests       Test[]       @relation("AgencyReferral")
  commissions Commission[]
  invoices    Invoice[]
  patients    Patient[]    @relation("PatientDefaultAgency")
  customTestCommissions AgencyTestCommission[]

  @@index([labId])
}

model Commission {
  id     String @id @default(cuid())
  testId String
  test   Test   @relation(fields: [testId], references: [id])

  doctorId String?
  doctor   Doctor? @relation(fields: [doctorId], references: [id])

  agencyId String?
  agency   Agency? @relation(fields: [agencyId], references: [id])

  amount Float
  type   CommissionType
  rate   Float
  status CommissionStatus @default(PENDING)

  paidAt         DateTime?
  transactionRef String?

  createdAt DateTime @default(now())

  @@index([testId])
  @@index([status])
}

enum CommissionType {
  PERCENTAGE
  FIXED
}

enum CommissionStatus {
  PENDING
  APPROVED
  PAID
  CANCELLED
}

// ==========================================
// REPORT MANAGEMENT
// ==========================================

model Report {
  id    String @id @default(cuid())
  labId String
  lab   Lab    @relation(fields: [labId], references: [id])

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id])

  // Relations to User (Fixes your error)
  technicianId String?
  technician   User?   @relation("TechnicianReports", fields: [technicianId], references: [id])

  seniorTechId String?
  seniorTech   User?   @relation("SeniorTechReports", fields: [seniorTechId], references: [id])

  pathologistId String?
  pathologist   User?   @relation("PathologistReports", fields: [pathologistId], references: [id])

  // Report Details
  reportUrl String? // Link to PDF
  status    ReportStatus @default(GENERATED)

  approvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([labId])
  @@index([patientId])
}

enum ReportStatus {
  GENERATED
  APPROVED
  PRINTED
  SENT_TO_PATIENT
}

// ==========================================
// PATIENT & LOGISTICS (Unified)
// ==========================================

model Patient {
  id        String @id @default(cuid())
  labId     String
  lab       Lab    @relation(fields: [labId], references: [id])
  patientId String

  name        String
  email       String?
  phone       String
  dateOfBirth DateTime?
  age         Int?
  ageUnit     String    @default("Years") // ✅ KEPT (Prevents data loss)
  gender      Gender?
  bloodGroup  String?
  address     String?

  // IDs (Added based on your new flow)
  srfId          String?
  passportNumber String?

  // V3 Upgrades
  gstNumber         String?
  walletBalance     Float    @default(0)
  loyaltyPoints     Int      @default(0)
  membershipTier    String   @default("SILVER")
  chronicConditions String[]

  doctorId String?
  doctor   Doctor? @relation("PatientDefaultDoctor", fields: [doctorId], references: [id])

  agencyId String?
  agency   Agency? @relation("PatientDefaultAgency", fields: [agencyId], references: [id])

  medicalHistory Json?
  allergies      String?

  // ABDM
  abhaNumber String?
  healthId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tests        Test[]
  appointments Appointment[]
  samples      Sample[]
  invoices     Invoice[]
  reports      Report[]

  //Radiology
  radiologyAppointments RadiologyAppointment[]
  radiologyStudies      RadiologyStudy[]

  @@unique([labId, patientId])
  @@unique([labId, abhaNumber])
  @@index([phone])
}

enum Gender {
  MALE
  FEMALE
  OTHER
  BOTH
  CUSTOM
}

model Sample {
  id    String @id @default(cuid())
  labId String
  lab   Lab    @relation(fields: [labId], references: [id])

  // ✅ 1. IDENTITY (The Barcode)
  sampleId      String
  barcodeFormat String @default("CODE128")

  // ✅ 2. THE RELATIONSHIP FIX (One Sample -> Many Tests)
  tests Test[]

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id])

  // ✅ 3. SAMPLE DEFINITION
  sampleType    String // e.g. "Whole Blood"
  containerType String? // e.g. "Lavender Top"

  // ✅ 4. LOGISTICS
  collectionMode    CollectionMode @default(LAB_VISIT)
  collectedAt       DateTime?
  collectedBy       String?
  collectionLat     Float?
  collectionLng     Float?
  collectionAddress String?

  courierName        String?
  trackingNumber     String?
  transitTemperature String?

  status SampleStatus @default(COLLECTED)

  // ✅ 5. LAB PROCESSING
  storageLocation String?
  temperature     String?

  receivedAt DateTime?
  receivedBy String?
  condition  String?

  // ✅ 6. MACHINE INTEGRATION
  machineId    String?
  rackPosition String?

  // ✅ 7. QC
  rejectionReason String?

  timeline  SampleLog[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([labId, sampleId])
  @@index([sampleId])
  @@index([status])
}

enum SampleStatus {
  COLLECTED
  IN_TRANSIT
  RECEIVED
  PROCESSING
  PROCESSED
  STORED
  REJECTED
}

enum CollectionMode {
  LAB_VISIT
  HOME_COLLECTION
  HOSPITAL_PICKUP
}

model SampleLog {
  id        String       @id @default(cuid())
  sampleId  String
  sample    Sample       @relation(fields: [sampleId], references: [id])
