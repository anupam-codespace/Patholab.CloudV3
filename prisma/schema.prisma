// ==========================================
// CONFIG & GENERATOR
// ==========================================
generator client {
  provider = "prisma-client-js"
}

datasource db {
  // ✅ v3.2.2: Switched from sqlite to postgresql for Neon / managed Postgres.
  // SQLite silently serialized JS arrays into strings; Postgres enforces strict
  // typing, which is why the old `String` declaration broke on Neon when the
  // Lab/Staff modules API wrote `["b2b","inventory",...]` into a TEXT column.
  // The four fields that hold arrays are now correctly typed as `String[]`:
  //   - User.activeModules
  //   - Lab.activeModules
  //   - Branch.activeModules
  //   - LabStaff.permissions
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// SYSTEM CONFIGURATION
// ==========================================
model SystemConfig {
  id                  String   @id @default(uuid())
  systemName          String   @default("Patholab Cloud")
  systemLogo          String?
  favicon             String?
  primaryColor        String   @default("#3b82f6")
  secondaryColor      String   @default("#8b5cf6")
  seoTitle            String?  @default("Patholab Cloud - Modern LIMS")
  seoDescription      String?
  seoKeywords         String?
  ogImage             String?
  defaultRegFee       Decimal  @default(2.50)
  defaultMinRecharge  Decimal  @default(100.00)
  googleAnalyticsId   String?
  facebookPixelId     String?
  socialLinks         Json? // ✅ v3.2.2: Json? — typically holds {facebook, twitter, instagram, linkedin} object
  systemEmail         String?
  systemPhone         String?
  systemAddress       String?
  gstNumber           String?
  panNumber           String?
  invoicePrefix       String   @default("SAAS")
  nextInvoiceNo       Int      @default(1)
  currency            String   @default("INR")
  currencySymbol      String   @default("₹")
  taxRate             Decimal  @default(18.0)
  enableABDM          Boolean  @default(false)
  abdmClientId        String?
  abdmClientSecret    String?
  razorpayKeyId       String?
  razorpayKeySecret   String?
  smtpHost            String?
  smtpPort            Int?
  smtpUser            String?
  smtpPassword        String?
  landingPage         String?
  enablePatientPortal Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

// ==========================================
// USER MANAGEMENT & RBAC
// ==========================================
model User {
  id               String           @id @default(uuid())
  email            String           @unique
  password         String
  name             String
  phone            String?
  role             Role             @default(LAB_OWNER)
  emailVerified    Boolean          @default(false)
  onboardingStatus OnboardingStatus @default(REGISTERED)
  isActive         Boolean          @default(false)
  activeModules    String[]         @default([]) // ✅ v3.2.2: Postgres native String[] array (was String on SQLite)
  avatar           String?
  abhaNumber       String?          @unique
  abhaAddress      String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deletedAt        DateTime? // Soft Delete Restored

  // Relations
  lab                Lab?                 @relation("LabOwner")
  staffLabs          LabStaff[]
  otp                OTP?
  activityLogs       ActivityLog[]
  doctor             Doctor?
  agency             Agency?
  patientProfile     Patient[]            @relation("UserPatient")
  phlebotomistTrips  HomeCollectionTrip[]
  technicianReports  Report[]             @relation("TechnicianReports")
  seniorTechReports  Report[]             @relation("SeniorTechReports")
  pathologistReports Report[]             @relation("PathologistReports")
  SupportTicket      SupportTicket[]

  @@index([email])
  @@index([role])
}

model ActivityLog {
  id          String   @id @default(uuid())
  labId       String
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  action      String
  entity      String
  entityId    String
  entityType  String
  description String
  details     String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([labId])
}

enum OnboardingStatus {
  REGISTERED
  VERIFIED
  LAB_SETUP
  COMPLETED
}

enum Role {
  SUPER_ADMIN
  LAB_OWNER
  TECHNICIAN
  LAB_MANAGER
  RECEPTIONIST
  DOCTOR
  AGENCY
  PATIENT
  PHLEBOTOMIST
  B2B_PARTNER
}

model OTP {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String
  type      OTPType  @default(EMAIL_VERIFICATION)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

enum OTPType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

// ==========================================
// INFRASTRUCTURE: MEDIA & EVENT BUS
// ==========================================
model DomainEvent {
  id            String   @id @default(uuid())
  eventType     String
  aggregateType String
  aggregateId   String
  payload       String
  processed     Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([processed, eventType])
}

model MediaAsset {
  id        String   @id @default(uuid())
  provider  String
  bucket    String
  path      String
  mimeType  String
  size      Int
  checksum  String?
  createdAt DateTime @default(now())
}

// ==========================================
// LABORATORY CORE & MULTI-BRANCH
// ==========================================
model Lab {
  id              String  @id @default(uuid())
  name            String
  portalSlug      String? @unique
  labCode         String? @unique
  upiId           String?
  upiQrCode       String? // ✅ RESTORED
  address         String?
  city            String?
  state           String?
  pincode         String?
  phone           String
  email           String
  licenseNumber   String? @unique
  registrationNo  String?
  gstNumber       String?
  panNumber       String?
  entityType      String?
  bankName        String?
  accountNumber   String?
  ifscCode        String?
  accountHolder   String?
  logo            String?
  letterhead      String?
  footer          String?
  signature       String?
  isActive        Boolean @default(true)
  whatsappApiKey  String?
  whatsappPhoneId String?
  smsApiKey       String?
  smsSenderId     String?

  activeModules String[] @default([]) // ✅ v3.2.2: Postgres native String[] array

  defaultDoctorCommission Decimal?       @default(10.0)
  defaultAgencyCommission Decimal?       @default(5.0)
  commissionType          CommissionType @default(PERCENTAGE)
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
  deletedAt               DateTime? // Soft Delete

  ownerId               String                  @unique
  owner                 User                    @relation("LabOwner", fields: [ownerId], references: [id])
  wallet                LabWallet?
  branches              Branch[]
  serviceAreas          ServiceArea[]
  staff                 LabStaff[]
  patients              Patient[]
  tests                 Test[]
  invoices              Invoice[]
  doctors               Doctor[]
  agencies              Agency[]
  discounts             Discount[]
  samples               Sample[]
  expenses              Expense[]
  analyzers             LabAnalyzer[]
  homeTrips             HomeCollectionTrip[]
  testPricing           LabTestPricing[]
  testCategories        TestCategory[]
  testParameters        LabTestParameter[]
  reportTemplates       ReportTemplate[]
  unmappedCodes         UnmappedMachineCode[]
  containerTypes        ContainerType[]
  departments           Department[]
  sampleTypes           SampleType[]
  testHeadings          TestHeading[]
  reports               Report[]
  inventoryItems        InventoryItem[]
  inventoryBatches      InventoryBatch[]
  suppliers             Supplier[]
  TestTemplate          TestTemplate[]
  CustomFieldDefinition CustomFieldDefinition[]

  @@index([ownerId])
  @@index([licenseNumber])
  @@index([deletedAt])
}

model Branch {
  id           String  @id @default(uuid())
  labId        String
  lab          Lab     @relation(fields: [labId], references: [id], onDelete: Cascade)
  name         String
  code         String?
  branchCode   String?
  isMainBranch Boolean @default(false)
  logo         String?
  letterhead   String?
  footer       String?
  signature    String?
  address      String
  city         String
  state        String
  pincode      String
  phone        String?
  email        String?
  isActive     Boolean @default(true)

  activeModules String[] @default([]) // ✅ v3.2.2: Postgres native String[] array for branch-level module locking

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Soft Delete

  serviceAreas          ServiceArea[]
  staff                 LabStaff[]
  patients              Patient[]
  samples               Sample[]
  appointments          Appointment[]
  tests                 Test[]
  invoices              Invoice[]
  expenses              Expense[]
  doctors               Doctor[]
  agencies              Agency[]
  discounts             Discount[]
  analyzers             LabAnalyzer[]
  inventoryBatches      InventoryBatch[]
  radiologyAppointments RadiologyAppointment[]
  radiologyStudies      RadiologyStudy[]
  modalities            Modality[]
  testPricings          LabTestPricing[]
  reports               Report[]
  homeTrips             HomeCollectionTrip[]
  auditLogs             AuditLog[]

  @@index([labId])
}

model ServiceArea {
  id          String   @id @default(uuid())
  labId       String
  lab         Lab      @relation(fields: [labId], references: [id], onDelete: Cascade)
  branchId    String
  branch      Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  pincode     String
  areaName    String?
  deliveryFee Decimal  @default(0.00)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@unique([labId, branchId, pincode])
}

model LabStaff {
  id         String   @id @default(uuid())
  labId      String
  lab        Lab      @relation(fields: [labId], references: [id], onDelete: Cascade)
  userId     String
  employeeId String?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  branchId   String?
  branch     Branch?  @relation(fields: [branchId], references: [id])
  position   String
  department String?
  salary     Decimal?
  joinDate   DateTime @default(now())
  isActive   Boolean  @default(true)

  permissions String[] @default([]) // ✅ v3.2.2: Postgres native String[] array for granular auth checks

  createdAt DateTime @default(now())

  @@unique([labId, userId])
  @@index([labId])
}

// ==========================================
// NEW WALLET PAY-AS-YOU-GO REVENUE MODEL
// ==========================================
model LabWallet {
  id                   String              @id @default(uuid())
  labId                String              @unique
  lab                  Lab                 @relation(fields: [labId], references: [id], onDelete: Cascade)
  balance              Decimal             @default(0.00)
  perPatientFee        Decimal             @default(2.50)
  minimumRecharge      Decimal             @default(100.00)
  validityEndDate      DateTime?
  isActive             Boolean             @default(true)
  isLisIntegrationPaid Boolean             @default(false)
  transactions         WalletTransaction[]
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
}

model WalletTransaction {
  id             String          @id @default(uuid())
  labId          String
  wallet         LabWallet       @relation(fields: [labId], references: [labId], onDelete: Cascade)
  type           TransactionType
  amount         Decimal
  closingBalance Decimal
  description    String?
  createdAt      DateTime        @default(now())

  @@index([labId])
}

enum TransactionType {
  RECHARGE
  DEDUCTION
  REFUND
  SETUP_FEE
}

// ==========================================
// DICTIONARIES & METADATA
// ==========================================
model Department {
  id           String         @id @default(uuid())
  labId        String?
  lab          Lab?           @relation(fields: [labId], references: [id], onDelete: Cascade)
  isGlobal     Boolean        @default(false)
  name         String
  code         String?
  displayOrder Int            @default(0)
  createdAt    DateTime       @default(now())
  TestTemplate TestTemplate[]

  @@unique([labId, name])
}

model SampleType {
  id           String         @id @default(uuid())
  labId        String?
  lab          Lab?           @relation(fields: [labId], references: [id], onDelete: Cascade)
  isGlobal     Boolean        @default(false)
  name         String
  code         String?
  samples      Sample[]
  createdAt    DateTime       @default(now())
  TestTemplate TestTemplate[]

  @@unique([labId, name])
}

model ContainerType {
  id           String             @id @default(uuid())
  labId        String?
  lab          Lab?               @relation(fields: [labId], references: [id])
  isGlobal     Boolean            @default(false)
  name         String
  code         String
  capColor     String?
  parameters   LabTestParameter[]
  samples      Sample[]
  createdAt    DateTime           @default(now())
  TestTemplate TestTemplate[]

  @@unique([labId, name])
}

model TestCategory {
  id           String         @id @default(uuid())
  labId        String?
  lab          Lab?           @relation(fields: [labId], references: [id])
  isGlobal     Boolean        @default(false)
  name         String
  description  String?
  icon         String?
  isActive     Boolean        @default(true)
  tests        Test[]
  createdAt    DateTime       @default(now())
  TestTemplate TestTemplate[]

  @@unique([labId, name])
}

model TestHeading {
  id        String   @id @default(uuid())
  labId     String?
  lab       Lab?     @relation(fields: [labId], references: [id], onDelete: Cascade)
  isGlobal  Boolean  @default(false)
  name      String
  createdAt DateTime @default(now())

  @@unique([labId, name])
}

model LabTestParameter {
  id              String             @id @default(uuid())
  labId           String?
  lab             Lab?               @relation(fields: [labId], references: [id])
  isGlobal        Boolean            @default(false)
  name            String
  printName       String?
  code            String
  unit            String?
  isDerived       Boolean            @default(false)
  formula         String?
  decimals        Int                @default(2)
  method          String?
  price           Decimal            @default(0.00)
  options         String?            @default("")
  containerTypeId String?
  containerType   ContainerType?     @relation(fields: [containerTypeId], references: [id])
  isActive        Boolean            @default(true)
  forkedFromId    String?
  forkedFrom      LabTestParameter?  @relation("ParameterForks", fields: [forkedFromId], references: [id])
  forks           LabTestParameter[] @relation("ParameterForks")

  referenceRanges ParameterReferenceRange[]
  reagents        TestParameterReagent[]

  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  TestTemplateParameter TestTemplateParameter[]

  @@unique([labId, code])
  @@index([labId])
}

model ParameterReferenceRange {
  id           String           @id @default(uuid())
  parameterId  String
  parameter    LabTestParameter @relation(fields: [parameterId], references: [id], onDelete: Cascade)
  gender       Gender
  minAge       Int              @default(0)
  maxAge       Int              @default(100)
  ageUnit      String           @default("YEAR")
  lowValue     Float?
  highValue    Float?
  criticalLow  Float?
  criticalHigh Float?
  textValue    String?
  displayText  String?
  customLabel  String?
  createdAt    DateTime         @default(now())

  @@index([parameterId])
}

model LabTestPricing {
  id             String   @id @default(uuid())
  labId          String
  lab            Lab      @relation(fields: [labId], references: [id], onDelete: Cascade)
  branchId       String?
  branch         Branch?  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  testTemplateId String
  price          Decimal
  b2bPrice       Decimal? @default(0.00)
  cost           Decimal? @default(0.00)
  tat            String?
  isActive       Boolean  @default(true)

  @@index([labId])
  @@index([branchId])
}

// ==========================================
// TEST EXECUTION & LOGISTICS
// ==========================================
model Patient {
  id                 String    @id @default(uuid())
  isGlobal           Boolean   @default(false)
  labId              String
  userId             String?
  user               User?     @relation("UserPatient", fields: [userId], references: [id])
  lab                Lab       @relation(fields: [labId], references: [id])
  branchId           String?
  branch             Branch?   @relation(fields: [branchId], references: [id])
  patientId          String
  name               String
  email              String?
  phone              String?
  dateOfBirth        DateTime?
  age                Int?
  ageUnit            String    @default("Years")
  gender             Gender?
  bloodGroup         String?
  address            String?
  pincode            String?
  srfId              String?
  passportNumber     String?
  gstNumber          String?
  walletBalance      Decimal   @default(0.00)
  loyaltyPoints      Int       @default(0)
  membershipTier     String    @default("SILVER")
  chronicConditions  String?   @default("")
  doctorId           String?
  doctor             Doctor?   @relation("PatientDefaultDoctor", fields: [doctorId], references: [id])
  agencyId           String?
  agency             Agency?   @relation("PatientDefaultAgency", fields: [agencyId], references: [id])
  medicalHistory     String?
  allergies          String?
  abhaNumber         String?
  healthId           String?
  dataConsentGranted Boolean   @default(true)

  deletedAt DateTime? // ✅ RESTORED
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tests                 Test[]
  appointments          Appointment[]
  samples               Sample[]
  invoices              Invoice[]
  reports               Report[]
  radiologyAppointments RadiologyAppointment[]
  radiologyStudies      RadiologyStudy[]

  @@unique([labId, patientId])
  @@unique([labId, abhaNumber])
  @@index([phone])
}

enum Gender {
  MALE
  FEMALE
  OTHER
  BOTH
  CUSTOM
}

model Sample {
  id       String  @id @default(uuid())
  labId    String
  lab      Lab     @relation(fields: [labId], references: [id])
  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  sampleId      String
  barcodeFormat String @default("CODE128")

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id])

  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])

  sampleTypeId    String?
  sampleType      SampleType?    @relation(fields: [sampleTypeId], references: [id])
  containerTypeId String?
  containerType   ContainerType? @relation(fields: [containerTypeId], references: [id])

  collectionMode CollectionMode @default(LAB_VISIT)

  collectedAt DateTime?
  collectedBy String?
  status      SampleStatus @default(COLLECTED)
  receivedAt  DateTime?
  receivedBy  String?

  collectionLat      Float?
  collectionLng      Float?
  collectionAddress  String?
  courierName        String?
  trackingNumber     String?
  transitTemperature String?

  storageLocation String?
  temperature     String?
  condition       String?
  machineId       String?
  rackPosition    String?
  rejectionReason String?

  deletedAt DateTime? // ✅ RESTORED
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tests    Test[]
  timeline SampleLog[]

  @@unique([labId, sampleId])
  @@index([sampleId])
  @@index([labId, status, createdAt])
}

enum SampleStatus {
  COLLECTED
  IN_TRANSIT
  RECEIVED
  PROCESSING
  PROCESSED
  STORED
  REJECTED
}

enum CollectionMode {
  LAB_VISIT
  HOME_COLLECTION
  HOSPITAL_PICKUP
}

model SampleLog {
  id        String       @id @default(uuid())
  sampleId  String
  sample    Sample       @relation(fields: [sampleId], references: [id])
  status    SampleStatus
  timestamp DateTime     @default(now())
  actor     String
  notes     String?
  location  String?
}

model HomeCollectionTrip {
  id             String        @id @default(uuid())
  labId          String
  lab            Lab           @relation(fields: [labId], references: [id])
  branchId       String?
  branch         Branch?       @relation(fields: [branchId], references: [id])
  phlebotomistId String
  phlebotomist   User          @relation(fields: [phlebotomistId], references: [id])
  scheduledDate  DateTime
  startLocation  String?
  endLocation    String?
  totalDistance  Float?
  status         TripStatus    @default(SCHEDULED)
  startedAt      DateTime?
  completedAt    DateTime?
  notes          String?
  appointments   Appointment[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

enum TripStatus {
  SCHEDULED
  STARTED
  IN_PROGRESS
  COMPLETED
}

model Appointment {
  id String @id @default(uuid())

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id])
  labId     String
  branchId  String?
  branch    Branch? @relation(fields: [branchId], references: [id])

  tripId     String?
  trip       HomeCollectionTrip? @relation(fields: [tripId], references: [id])
  routeOrder Int                 @default(0)

  source          BookingSource  @default(WALK_IN)
  collectionMode  CollectionMode @default(LAB_VISIT)
  appointmentDate DateTime
  timeSlot        String?

  collectionAddress String?
  pincode           String?
  latitude          Float?
  longitude         Float?

  paymentCollected Decimal? @default(0.00)
  paymentMode      String?
  transactionId    String? // ✅ RESTORED
  invoiceId        String?  @unique
  invoice          Invoice? @relation(fields: [invoiceId], references: [id])

  // ✅ v3.2: Unique tracking ID for public tracking page
  trackId           String?   @unique
  // ✅ v3.2: Payment verification status for online bookings
  paymentVerified   Boolean   @default(false)
  paymentVerifiedAt DateTime?
  paymentVerifiedBy String?

  status    AppointmentStatus @default(SCHEDULED)
  deletedAt DateTime? // ✅ RESTORED
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  tests   Test[]
  samples Sample[]
}

enum BookingSource {
  WALK_IN
  PHONE_CALL
  ONLINE_PORTAL
  AGENCY_API
}

enum AppointmentStatus {
  PENDING_PAYMENT
  CONFIRMED
  SCHEDULED
  ASSIGNED
  EN_ROUTE
  ARRIVED
  COMPLETED
  CANCELLED
  RESCHEDULED
  RECEIVED_AT_LAB // ✅ RESTORED
  RESULT_ENTERED // ✅ RESTORED
  SAMPLE_COLLECTED @map("DEPRECATED_SAMPLE_COLLECTED")
  HANDED_OVER      @map("DEPRECATED_HANDED_OVER")
}

model Test {
  id            String        @id @default(uuid())
  labId         String
  lab           Lab           @relation(fields: [labId], references: [id])
  branchId      String?
  branch        Branch?       @relation(fields: [branchId], references: [id])
  testNumber    String
  patientId     String
  patient       Patient       @relation(fields: [patientId], references: [id])
  categoryId    String?
  category      TestCategory? @relation(fields: [categoryId], references: [id])
  appointmentId String?
  appointment   Appointment?  @relation(fields: [appointmentId], references: [id])
  invoiceId     String?
  invoice       Invoice?      @relation(fields: [invoiceId], references: [id])
  sampleId      String?
  sample        Sample?       @relation(fields: [sampleId], references: [id])

  testTemplateId String?
  testTemplate   TestTemplate? @relation(fields: [testTemplateId], references: [id])

  testName            String
  testCode            String
  resultNotes         String?
  status              TestStatus   @default(PENDING)
  priority            TestPriority @default(NORMAL)
  referredBy          String?
  doctorId            String?
  doctor              Doctor?      @relation("DoctorReferral", fields: [doctorId], references: [id])
  agencyId            String?
  agency              Agency?      @relation("AgencyReferral", fields: [agencyId], references: [id])
  scheduledAt         DateTime?
  sampleCollectedAt   DateTime?
  processingStartedAt DateTime?
  completedAt         DateTime?
  checkedAt           DateTime?
  checkedBy           String?
  approvedAt          DateTime?
  approvedBy          String?
  reportGeneratedAt   DateTime?
  sampleReceivedAt    DateTime?
  reportUrl           String?
  notes               String?
  impression          String?
  price               Decimal
  discount            Decimal      @default(0.00)
  finalPrice          Decimal

  deletedAt DateTime? // ✅ RESTORED
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  report      Report?
  commissions Commission[]
  results     TestResultParameter[]

  customResults TestResultCustomField[]

  inventoryUsage InventoryTransaction[]
  aiPrediction   AIPrediction?

  @@unique([labId, testNumber])
  @@index([patientId])
  @@index([branchId, status, createdAt])
}

model TestResultParameter {
  id     String @id @default(uuid())
  testId String
  test   Test   @relation(fields: [testId], references: [id], onDelete: Cascade)

  parameterCode      String
  printName          String
  method             String?
  referenceRangeText String?
  numericValue       Float?
  textValue          String?
  flag               String?

  analyzerId  String?
  analyzer    LabAnalyzer? @relation(fields: [analyzerId], references: [id])
  entryMethod EntryMethod  @default(MANUAL)
  order       Int          @default(0)

  @@index([testId])
  @@index([parameterCode])
  @@index([flag])
  @@index([numericValue])
}

enum EntryMethod {
  MANUAL
  MACHINE_INTERFACE
  FILE_UPLOAD
}

model AIPrediction {
  id              String   @id @default(uuid())
  testId          String   @unique
  test            Test     @relation(fields: [testId], references: [id])
  summary         String
  riskScore       Float?
  recommendations String?
  modelUsed       String?
  createdAt       DateTime @default(now())
}

enum TestStatus {
  PENDING
  SCHEDULED
  SAMPLE_COLLECTED
  IN_PROGRESS
  COMPLETED
  APPROVED
  DELIVERED
  CANCELLED
}

enum TestPriority {
  NORMAL
  URGENT
  CRITICAL
}

// ==========================================
// REFERRAL & COMMISSION
// ==========================================
model Doctor {
  id                    String                   @id @default(uuid())
  labId                 String
  lab                   Lab                      @relation(fields: [labId], references: [id])
  branchId              String?
  branch                Branch?                  @relation(fields: [branchId], references: [id])
  userId                String?                  @unique
  user                  User?                    @relation(fields: [userId], references: [id])
  name                  String                   @default("Legacy Doctor")
  email                 String?
  phone                 String?
  registrationNo        String?
  specialization        String?
  qualification         String?
  clinic                String?
  commissionRate        Decimal?
  commissionType        CommissionType           @default(PERCENTAGE)
  customTestCommissions DoctorCustomCommission[]
  totalReferrals        Int                      @default(0)
  totalCommission       Decimal                  @default(0.00)
  isActive              Boolean                  @default(true)
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  deletedAt             DateTime?

  tests       Test[]       @relation("DoctorReferral")
  commissions Commission[]
  patients    Patient[]    @relation("PatientDefaultDoctor")
  Invoice     Invoice[] // Added to resolve the DoctorId relation restored below

  @@unique([labId, registrationNo])
  @@index([labId])
  @@index([branchId])
}

model DoctorCustomCommission {
  id             String @id @default(uuid())
  doctorId       String
  testTemplateId String
  commissionRate Float
  commissionType String @default("PERCENTAGE")

  doctor       Doctor       @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  testTemplate TestTemplate @relation(fields: [testTemplateId], references: [id], onDelete: Cascade)

  @@unique([doctorId, testTemplateId])
}

model Agency {
  id            String  @id @default(uuid())
  labId         String
  lab           Lab     @relation(fields: [labId], references: [id])
  branchId      String?
  branch        Branch? @relation(fields: [branchId], references: [id])
  userId        String? @unique
  user          User?   @relation(fields: [userId], references: [id])
  agencyName    String  @default("Legacy Agency")
  contactPerson String?
  email         String?
  phone         String?
  panNumber     String?

  agencyTier    String @default("STANDARD")
  monthlyVolume Int    @default(0)

  commissionRate  Decimal?
  commissionType  CommissionType @default(PERCENTAGE)
  totalReferrals  Int            @default(0)
  totalCommission Decimal        @default(0.00)

  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tests       Test[]       @relation("AgencyReferral")
  commissions Commission[]
  invoices    Invoice[]
  patients    Patient[]    @relation("PatientDefaultAgency")

  customTestCommissions AgencyCustomCommission[]

  @@index([labId])
  @@index([branchId])
}

model AgencyCustomCommission {
  id             String @id @default(uuid())
  agencyId       String
  testTemplateId String

  commissionRate Float?
  commissionType CommissionType @default(PERCENTAGE)
  netPrice       Decimal?

  agency       Agency       @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  testTemplate TestTemplate @relation(fields: [testTemplateId], references: [id], onDelete: Cascade)

  @@unique([agencyId, testTemplateId])
}

model Commission {
  id             String           @id @default(uuid())
  testId         String
  test           Test             @relation(fields: [testId], references: [id])
  doctorId       String?
  doctor         Doctor?          @relation(fields: [doctorId], references: [id])
  agencyId       String?
  agency         Agency?          @relation(fields: [agencyId], references: [id])
  amount         Decimal
  type           CommissionType
  rate           Decimal
  status         CommissionStatus @default(PENDING)
  paidAt         DateTime?
  transactionRef String?
  createdAt      DateTime         @default(now())

  @@index([testId])
  @@index([status])
}

enum CommissionType {
  PERCENTAGE
  FIXED
  NET_PRICE
}

enum CommissionStatus {
  PENDING
  APPROVED
  PAID
  CANCELLED
}

// ==========================================
// REPORT MANAGEMENT
// ==========================================
model Report {
  id            String  @id @default(uuid())
  labId         String
  lab           Lab     @relation(fields: [labId], references: [id])
  branchId      String?
  branch        Branch? @relation(fields: [branchId], references: [id])
  testId        String? @unique
  test          Test?   @relation(fields: [testId], references: [id])
  patientId     String
  patient       Patient @relation(fields: [patientId], references: [id])
  technicianId  String?
  technician    User?   @relation("TechnicianReports", fields: [technicianId], references: [id])
  seniorTechId  String?
  seniorTech    User?   @relation("SeniorTechReports", fields: [seniorTechId], references: [id])
  pathologistId String?
  pathologist   User?   @relation("PathologistReports", fields: [pathologistId], references: [id])

  reportData      String?
  renderedHtml    String?
  signedHash      String?
  versionParentId String?

  reportUrl       String?
  pdfUrl          String?
  version         Int          @default(1)
  status          ReportStatus @default(DRAFT)
  isSigned        Boolean      @default(false)
  signedById      String?
  signedAt        DateTime?
  isAmended       Boolean      @default(false)
  amendmentReason String?
  previousPdfUrl  String?
  approvedAt      DateTime?

  deletedAt DateTime? // ✅ RESTORED
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([labId])
  @@index([branchId])
  @@index([patientId])
}

enum ReportStatus {
  DRAFT
  GENERATED
  APPROVED
  FINAL
  AMENDED
  PRINTED
  SENT_TO_PATIENT
}

model ReportTemplate {
  id           String  @id @default(uuid())
  labId        String
  lab          Lab     @relation(fields: [labId], references: [id], onDelete: Cascade)
  name         String  @default("Standard Clinical Report")
  isActive     Boolean @default(false)
  pageSize     String  @default("A4")
  orientation  String  @default("PORTRAIT")
  primaryColor String? @default("#000000")
  accentColor  String? @default("#2563eb")
  fontFamily   String? @default("Inter")
  logoUrl      String?
  signatureUrl String?
  headerImage  String?
  footerImage  String?
  isoMarkUrl   String?
  watermarkUrl String?
  config       String?

  isSystem Boolean @default(false) // ✅ RESTORED
  type     String? // ✅ RESTORED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([labId])
}

// ==========================================
// INVENTORY MANAGEMENT
// ==========================================
model Supplier {
  id            String   @id @default(uuid())
  labId         String
  lab           Lab      @relation(fields: [labId], references: [id])
  name          String
  contactPerson String?
  email         String?
  phone         String?
  address       String?
  gstNumber     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  inventoryItems InventoryItem[]

  @@index([labId])
}

model InventoryItem {
  id                   String                 @id @default(uuid())
  labId                String
  lab                  Lab                    @relation(fields: [labId], references: [id])
  name                 String
  category             String? // ✅ RESTORED
  sku                  String? // ✅ RESTORED
  minStockLevel        Float? // ✅ RESTORED
  purchaseUnit         String? // ✅ RESTORED
  usageUnit            String? // ✅ RESTORED
  conversionFactor     Float? // ✅ RESTORED
  supplierId           String?
  supplier             Supplier?              @relation(fields: [supplierId], references: [id])
  isActive             Boolean                @default(true)
  batches              InventoryBatch[]
  TestParameterReagent TestParameterReagent[]

  @@unique([labId, name])
  @@index([labId])
}

model InventoryBatch {
  id              String        @id @default(uuid())
  labId           String
  lab             Lab           @relation(fields: [labId], references: [id])
  branchId        String?
  branch          Branch?       @relation(fields: [branchId], references: [id])
  itemId          String
  item            InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  batchNumber     String
  expiryDate      DateTime
  initialQuantity Float
  currentQuantity Float         @default(0)
  costPrice       Decimal?
  mrp             Decimal?
  location        String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  transactions InventoryTransaction[]

  @@unique([itemId, batchNumber])
  @@index([itemId])
  @@index([labId])
}

model InventoryTransaction {
  id          String          @id @default(uuid())
  batchId     String?
  batch       InventoryBatch? @relation(fields: [batchId], references: [id], onDelete: Cascade)
  quantity    Float
  type        StockType
  testId      String?
  test        Test?           @relation(fields: [testId], references: [id])
  notes       String?
  performedBy String?
  createdAt   DateTime        @default(now())

  @@index([batchId])
  @@index([type])
}

model TestParameterReagent {
  id              String           @id @default(uuid())
  parameterId     String
  parameter       LabTestParameter @relation(fields: [parameterId], references: [id], onDelete: Cascade)
  inventoryItemId String
  inventoryItem   InventoryItem    @relation(fields: [inventoryItemId], references: [id])
  quantity        Float
  createdAt       DateTime         @default(now())

  @@unique([parameterId, inventoryItemId])
}

enum StockType {
  PURCHASE
  CONSUMPTION
  RETURN
  WASTAGE
  EXPIRED
  ADJUSTMENT
}

// ==========================================
// INVOICES & EXPENSES
// ==========================================
model Invoice {
  id             String               @id @default(uuid())
  labId          String
  lab            Lab                  @relation(fields: [labId], references: [id])
  branchId       String?
  branch         Branch?              @relation(fields: [branchId], references: [id])
  invoiceNumber  String
  notes          String?
  financialYear  String?              @default("2024-25")
  patientId      String?
  patient        Patient?             @relation(fields: [patientId], references: [id])
  agencyId       String?
  agency         Agency?              @relation(fields: [agencyId], references: [id])
  doctorId       String? // ✅ RESTORED
  doctor         Doctor?              @relation(fields: [doctorId], references: [id]) // ✅ RESTORED
  paymentStatus  InvoicePaymentStatus @default(PENDING)
  paymentMode    String?
  gatewayRef     String?
  transactionRef String?
  subtotal       Decimal
  discount       Decimal              @default(0.00)
  taxableAmount  Decimal
  cgstAmount     Decimal              @default(0.00)
  sgstAmount     Decimal              @default(0.00)
  igstAmount     Decimal              @default(0.00)
  totalTax       Decimal
  roundOff       Decimal              @default(0.00)
  grandTotal     Decimal
  placeOfSupply  String?
  isB2B          Boolean              @default(false)
  gstinCustomer  String?
  status         InvoiceStatus        @default(PENDING)
  pdfUrl         String?

  deletedAt DateTime? // ✅ RESTORED
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  items       InvoiceItem[]
  tests       Test[]
  appointment Appointment?

  @@index([labId, status, createdAt])
}

model InvoiceItem {
  id          String  @id @default(uuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  hsnSacCode  String?
  unitPrice   Decimal
  quantity    Int     @default(1)
  discount    Decimal @default(0.00)
  taxRate     Decimal
  taxAmount   Decimal
  total       Decimal
}

enum InvoicePaymentStatus {
  PENDING
  PARTIAL
  PAID
  FAILED
  REFUNDED
}

enum InvoiceStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

model Expense {
  id          String          @id @default(uuid())
  labId       String
  lab         Lab             @relation(fields: [labId], references: [id], onDelete: Cascade)
  branchId    String?
  branch      Branch?         @relation(fields: [branchId], references: [id])
  title       String
  category    ExpenseCategory
  amount      Decimal
  date        DateTime        @default(now())
  paymentMode String          @default("CASH")
  referenceNo String?
  notes       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([labId])
  @@index([date])
}

enum ExpenseCategory {
  SALARY
  RENT
  UTILITIES
  MACHINE_MAINTENANCE
  MARKETING
  OFFICE_SUPPLIES
  MISC
}

// ==========================================
// IOT & MACHINE INTEGRATION
// ==========================================
model LabAnalyzer {
  id             String    @id @default(uuid())
  labId          String
  lab            Lab       @relation(fields: [labId], references: [id])
  branchId       String?
  branch         Branch?   @relation(fields: [branchId], references: [id])
  name           String
  model          String
  serialNumber   String
  ipAddress      String?
  protocol       String?
  maintenanceDue DateTime?
  isActive       Boolean   @default(true)

  results       TestResultParameter[]
  mappings      ParameterMapping[]
  unmappedCodes UnmappedMachineCode[]
}

model ParameterMapping {
  id            String      @id @default(uuid())
  labAnalyzerId String
  machineCode   String
  parameterName String
  analyzer      LabAnalyzer @relation(fields: [labAnalyzerId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@unique([labAnalyzerId, machineCode])
  @@index([labAnalyzerId])
}

model UnmappedMachineCode {
  id            String      @id @default(uuid())
  labId         String
  labAnalyzerId String
  sampleId      String
  machineCode   String
  analyzer      LabAnalyzer @relation(fields: [labAnalyzerId], references: [id], onDelete: Cascade)
  lab           Lab         @relation(fields: [labId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@unique([labAnalyzerId, sampleId, machineCode])
  @@index([labId])
}

model AnalyzerRawPayload {
  id         String   @id @default(uuid())
  analyzerId String
  rawData    String
  processed  Boolean  @default(false)
  receivedAt DateTime @default(now())
}

// ==========================================
// RADIOLOGY INFORMATION SYSTEM (RIS)
// ==========================================
model Modality {
  id              String    @id @default(uuid())
  labId           String
  branchId        String?
  branch          Branch?   @relation(fields: [branchId], references: [id])
  name            String
  type            String
  aeTitle         String?
  ipAddress       String?
  port            Int?
  location        String?
  manufacturer    String?
  lastMaintenance DateTime?
  nextMaintenance DateTime?
  status          String    @default("ACTIVE")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  appointments RadiologyAppointment[]
  studies      RadiologyStudy[]

  @@index([labId, status])
}

model RadiologyAppointment {
  id             String    @id @default(uuid())
  labId          String
  branchId       String?
  branch         Branch?   @relation(fields: [branchId], references: [id])
  patientId      String
  patient        Patient   @relation(fields: [patientId], references: [id])
  modalityId     String
  scheduledStart DateTime
  scheduledEnd   DateTime
  scanName       String
  priority       String    @default("ROUTINE")
  notes          String?
  status         String    @default("SCHEDULED")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  modality Modality        @relation(fields: [modalityId], references: [id])
  study    RadiologyStudy?

  @@index([labId, scheduledStart])
  @@index([modalityId, status])
}

model RadiologyStudy {
  id               String    @id @default(uuid())
  labId            String
  branchId         String?
  branch           Branch?   @relation(fields: [branchId], references: [id])
  patientId        String
  patient          Patient   @relation(fields: [patientId], references: [id])
  appointmentId    String?   @unique
  modalityId       String
  accessionNumber  String    @unique
  studyInstanceUid String?   @unique
  dicomInstances   Int       @default(0)
  storageSizeMb    Float?
  scanName         String
  clinicalHistory  String?
  isContrastUsed   Boolean   @default(false)
  safetyChecklist  Json? // ✅ v3.2.2: Changed from String? to Json? — frontend stores a {idVerified, safetyCleared, consentSigned} object
  mediaStatus      String?
  referringDoctor  String?
  technicianId     String?
  radiologistId    String?
  status           String    @default("ORDERED")
  priority         String    @default("ROUTINE")
  createdAt        DateTime  @default(now())
  performedAt      DateTime?
  deletedAt        DateTime?

  appointment RadiologyAppointment? @relation(fields: [appointmentId], references: [id])
  modality    Modality              @relation(fields: [modalityId], references: [id])
  report      RadiologyReport?

  @@index([labId, status, priority])
  @@index([accessionNumber])
}

model RadiologyReport {
  id            String    @id @default(uuid())
  studyId       String    @unique
  clinicalNotes String?
  findings      String
  impression    String
  addendum      String?
  aiAnalysis    String?
  keyImages     String?
  status        String    @default("DRAFT")
  radiologistId String
  verifiedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  study RadiologyStudy @relation(fields: [studyId], references: [id], onDelete: Cascade)
}

model RadiologyMacro {
  id             String   @id @default(uuid())
  labId          String
  title          String
  modalityType   String
  shortcode      String?
  findingsText   String
  impressionText String
  isGlobal       Boolean  @default(false)
  createdById    String
  updatedAt      DateTime @updatedAt
}

// ==========================================
// SUPPORT, AUDITS & MISC
// ==========================================
model AuditLog {
  id        String   @id @default(uuid())
  labId     String
  branchId  String?
  branch    Branch?  @relation(fields: [branchId], references: [id])
  userId    String
  entity    String
  entityId  String
  action    String
  oldData   String?
  newData   String?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([labId, entity, entityId])
}

model SupportTicket {
  id           String         @id @default(uuid())
  ticketNumber String         @unique
  userId       String
  user         User           @relation(fields: [userId], references: [id])
  subject      String
  description  String
  status       TicketStatus   @default(OPEN)
  priority     TicketPriority @default(MEDIUM)
  category     String         @default("GENERAL")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  messages TicketMessage[]
}

model TicketMessage {
  id         String        @id @default(uuid())
  ticketId   String
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  message    String
  isStaff    Boolean       @default(false)
  senderName String?
  createdAt  DateTime      @default(now())
}

model Discount {
  id         String       @id @default(uuid())
  labId      String
  lab        Lab          @relation(fields: [labId], references: [id])
  branchId   String?
  branch     Branch?      @relation(fields: [branchId], references: [id])
  code       String       @unique
  value      Decimal
  type       DiscountType
  validUntil DateTime?
  isActive   Boolean      @default(true)
  createdAt  DateTime     @default(now())
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum DiscountType {
  PERCENTAGE
  FLAT
}

model Page {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String
  content     String
  metaTitle   String?
  metaDesc    String?
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ==========================================
// TEST CATALOG & TEMPLATES
// ==========================================
model TestTemplate {
  id    String  @id @default(uuid())
  labId String?
  lab   Lab?    @relation(fields: [labId], references: [id], onDelete: Cascade)

  isGlobal     Boolean        @default(false)
  forkedFromId String?
  forkedFrom   TestTemplate?  @relation("TestForks", fields: [forkedFromId], references: [id])
  forks        TestTemplate[] @relation("TestForks")

  code        String
  name        String
  printName   String?
  description String?
  method      String?
  type        String  @default("SINGLE")

  departmentId String?
  Department   Department? @relation(fields: [departmentId], references: [id])

  sampleTypeId String?
  SampleType   SampleType? @relation(fields: [sampleTypeId], references: [id])

  containerTypeId String?
  ContainerType   ContainerType? @relation(fields: [containerTypeId], references: [id])

  testCategoryId String?
  TestCategory   TestCategory? @relation(fields: [testCategoryId], references: [id])

  price        Decimal @default(0.00)
  tatHours     Int     @default(24)
  isActive     Boolean @default(true)
  isPublic     Boolean @default(true)
  preRequistes String?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  parameters             TestTemplateParameter[]
  customFields           TestTemplateCustomField[]
  Test                   Test[]
  DoctorCustomCommission DoctorCustomCommission[]
  AgencyCustomCommission AgencyCustomCommission[]

  @@index([labId])
}

model TestTemplateParameter {
  id             String           @id @default(uuid())
  testTemplateId String
  testTemplate   TestTemplate     @relation(fields: [testTemplateId], references: [id], onDelete: Cascade)
  parameterId    String
  parameter      LabTestParameter @relation(fields: [parameterId], references: [id], onDelete: Cascade)
  order          Int              @default(0)

  @@unique([testTemplateId, parameterId])
}

// ==========================================
// DYNAMIC CUSTOM FIELDS
// ==========================================
model CustomFieldDefinition {
  id            String   @id @default(uuid())
  labId         String
  lab           Lab      @relation(fields: [labId], references: [id], onDelete: Cascade)
  name          String
  type          String   @default("TEXT")
  options       String?  @default("")
  reportLayout  String   @default("FULL")
  printOnReport Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  testTemplates TestTemplateCustomField[]

  @@unique([labId, name])
  @@index([labId])
}

model TestTemplateCustomField {
  id           String                @id @default(uuid())
  templateId   String
  template     TestTemplate          @relation(fields: [templateId], references: [id], onDelete: Cascade)
  fieldId      String
  field        CustomFieldDefinition @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  order        Int                   @default(0)
  isRequired   Boolean               @default(false)
  defaultValue String?

  @@unique([templateId, fieldId])
}

model TestResultCustomField {
  id         String  @id @default(uuid())
  testId     String
  test       Test    @relation(fields: [testId], references: [id], onDelete: Cascade)
  fieldDefId String
  value      String
  layout     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([testId, fieldDefId])
  @@index([testId])
}
