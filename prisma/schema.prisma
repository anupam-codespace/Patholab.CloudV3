// 2. THE MAPPING (Which test uses which field?)
model TestTemplateField {
  id         String       @id @default(cuid())
  templateId String
  template   TestTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  fieldDefId String
  fieldDef   CustomFieldDefinition @relation(fields: [fieldDefId], references: [id])

  order    Int     @default(0) // Control display order
  required Boolean @default(false)

  @@unique([templateId, fieldDefId])
