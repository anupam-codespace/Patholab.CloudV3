  value String // The text or option selected

  @@unique([testId, fieldDefId])
}

enum FieldType {
  TEXT // Short Input
  LONG_TEXT // Textarea (for Interpretations)
  DROPDOWN // Select Box
  DATE // Date Picker
  IMAGE // For Graphs, ECGs, X-Rays
  RICH_TEXT // For HTML formatted text
}

// Master data for Tubes (e.g., EDTA, Serum, Urine Cup)
