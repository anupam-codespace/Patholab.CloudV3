// ==============================================================================
// RADIOLOGY INFORMATION SYSTEM (RIS) MODULES
// Enterprise & Future-Proof Edition
// ==============================================================================

// 1. Modalities (The Radiology Machines & PACS Nodes)
model Modality {
  id              String   @id @default(uuid())
  labId           String
  name            String   // e.g., "GE 1.5T MRI", "Siemens CT Room 1"
  type            String   // e.g., "MRI", "CT", "USG", "XRAY", "PET"
  
  // Network & DICOM Config
  aeTitle         String?  // PACS Application Entity Title
  ipAddress       String?  // Machine's IP on the local network
  port            Int?     // Port used for DICOM transfer (e.g., 104)
  location        String?  // e.g., "Ground Floor, Room A"
  
  // Asset Management
  manufacturer    String?  // e.g., "GE Healthcare", "Philips"
  lastMaintenance DateTime?
  nextMaintenance DateTime?
  
  status          String   @default("ACTIVE") // ACTIVE, MAINTENANCE, INACTIVE
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  appointments    RadiologyAppointment[]
  studies         RadiologyStudy[]

  @@index([labId, status])
}

// 2. Radiology Appointments (Time Slot Booking)
model RadiologyAppointment {
  id               String   @id @default(uuid())
  labId            String
  
  // ✅ Fixed: Added actual relation to your Patient model
  patientId        String   
  patient          Patient  @relation(fields: [patientId], references: [id]) 
  
  modalityId       String
  
  scheduledStart   DateTime 
  scheduledEnd     DateTime 
  
  // Clinical Context upfront
  scanName         String   // e.g., "MRI Brain with Contrast"
  priority         String   @default("ROUTINE") // ROUTINE, URGENT, STAT
  notes            String?  // Front desk notes (e.g., "Patient is claustrophobic")
  
  status           String   @default("SCHEDULED") // SCHEDULED, ARRIVED, IN_PROGRESS, COMPLETED, CANCELLED

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  modality         Modality @relation(fields: [modalityId], references: [id])
  study            RadiologyStudy? 

  @@index([labId, scheduledStart])
  @@index([modalityId, status])
}

// 3. The Radiology Study (The actual Scan / PACS Record)
model RadiologyStudy {
  id               String   @id @default(uuid())
  labId            String
  
  // ✅ Fixed: Added actual relation to your Patient model
  patientId        String
  patient          Patient  @relation(fields: [patientId], references: [id])

  appointmentId    String?  @unique
  modalityId       String
  
  // --- PACS INTEGRATION FIELDS ---
  accessionNumber  String   @unique // Sent to machine via Modality Worklist (MWL)
  studyInstanceUid String?  @unique // Globally unique DICOM identifier
  dicomInstances   Int      @default(0) // Total number of images/slices in this scan
  storageSizeMb    Float?   // File size on your PACS server
  // ----------------------------------------

  // Clinical & Safety Data
  scanName         String   // e.g., "CT KUB Non-Contrast"
  clinicalHistory  String?  @db.Text // Doctor's reason for scan
  isContrastUsed   Boolean  @default(false)
  
  // Safety & Compliance (JSON for flexible NABH/JCI checklists)
  // e.g., { "creatinineChecked": true, "pregnancyRuledOut": true, "metalImplants": "None" }
  safetyChecklist  Json?    
  
  // Dispatch & Media Tracking (JSON for UI mapping)
  // e.g., { "film": "PRINTED", "cd": "PENDING", "digital": "SENT" }
  mediaStatus      Json?    

  // Staffing
  referringDoctor  String?  
  technicianId     String?  // Tech who performed it
  radiologistId    String?  // Doctor assigned to read it
  
  // Flow: ORDERED -> SCANNED -> REPORTING -> VERIFIED
  status           String   @default("ORDERED") 
  priority         String   @default("ROUTINE") // ROUTINE, URGENT, STAT

  createdAt        DateTime @default(now())
  performedAt      DateTime? 

  appointment      RadiologyAppointment? @relation(fields: [appointmentId], references: [id])
  modality         Modality              @relation(fields: [modalityId], references: [id])
  report           RadiologyReport?

  @@index([labId, status, priority])
  @@index([accessionNumber])
}

// 4. The Radiology Report (The Doctor's Interpretation)
model RadiologyReport {
  id               String   @id @default(uuid())
  studyId          String   @unique
  
  clinicalNotes    String?  @db.Text // Radiologist's private notes before reporting
  
  // Core Report Data
  findings         String   @db.Text
  impression       String   @db.Text
  
  // Post-Verification Edits (Medico-legal requirement)
  addendum         String?  @db.Text 
  
  // Future-Proofing: AI Pre-reads (e.g., Qure.ai / Lunit integration)
  // Store AI insights here before the human doctor verifies them
  aiAnalysis       Json?    
  
  // Key Images (JSON Array of URLs pointing to specific annotated DICOM slices)
  keyImages        Json?

  status           String   @default("DRAFT") // DRAFT, DICTATED, FINAL
  radiologistId    String   // Link to your Doctor/User model
  verifiedAt       DateTime?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  study            RadiologyStudy @relation(fields: [studyId], references: [id], onDelete: Cascade)
}

// 5. Reporting Macros (Templates to save Radiologists time)
model RadiologyMacro {
  id               String   @id @default(uuid())
  labId            String
  
  title            String   // e.g., "Normal Chest X-Ray (PA View)"
  modalityType     String   // e.g., "XRAY", "MRI", "CT"
  
  // Trigger word for the rich text editor (e.g., "/N-CXR")
  shortcode        String?  
  
  // The pre-filled text
  findingsText     String   @db.Text
  impressionText   String   @db.Text
  
  // Scope management
  isGlobal         Boolean  @default(false) // If true, all doctors in lab can use it
  createdById      String   // Which doctor created this template

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([labId, modalityType])
}

// 6. Global DICOM & PACS Settings for the Lab
model DicomSettings {
  id              String   @id @default(uuid())
  labId           String   @unique
  
  // Local RIS Identity
  localAETitle    String   @default("GLOBIZ_RIS")
  localPort       Int      @default(104)
  
  // Primary PACS Archive
  pacsAETitle     String   @default("PACS_SERVER")
  pacsIpAddress   String   @default("192.168.1.100")
  pacsPort        Int      @default(4242)
  
  // Modality Worklist (MWL)
  enableMwl       Boolean  @default(true)
  mwlAETitle      String   @default("GLOBIZ_MWL")
  mwlPort         Int      @default(105)
  
  // Web Viewer URL (e.g., OHIF, Weasis, Osimis)
  viewerBaseUrl   String   @default("http://localhost:8042/viewer?StudyInstanceUID=")

  updatedAt       DateTime @updatedAt
}

// A temporary holding queue for machine codes the webhook couldn't map
model UnmappedMachineCode {
  id            String   @id @default(cuid())
  labId         String
  labAnalyzerId String
  sampleId      String
  machineCode   String
  
  analyzer      LabAnalyzer @relation(fields: [labAnalyzerId], references: [id], onDelete: Cascade)
  lab           Lab         @relation(fields: [labId], references: [id], onDelete: Cascade)

  createdAt     DateTime @default(now())

  // Ensure we don't spam the database with duplicates from the 5-second retries
  @@unique([labAnalyzerId, sampleId, machineCode])
  @@index([labId])
}