model LabAnalyzer {
  id       String @id @default(uuid())
  labId    String
  branchId String

  name           String // e.g., "Sysmex XN-1000"
  modelType      String
  connectionType String // "TCP", "SERIAL", "FILE"
  ipAddress      String?
  port           Int?

  isActive Boolean @default(true)

  rawPayloads AnalyzerRawPayload[]

  lab    Lab    @relation(fields: [labId], references: [id])
  branch Branch @relation(fields: [branchId], references: [id])
}

model AnalyzerRawPayload {
  id         String @id @default(uuid())
  labId      String
  analyzerId String

  // The raw HL7 or ASTM message string from the machine
  rawData String @db.Text

  processed    Boolean @default(false)
  errorMessage String? @db.Text

  // If successfully parsed, link it to the Test record
  testId String?

  analyzer LabAnalyzer @relation(fields: [analyzerId], references: [id])

  receivedAt DateTime @default(now())

  @@index([labId, analyzerId, processed])
}
