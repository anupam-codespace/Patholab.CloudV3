model FhirResourceMap {
  id    String @id @default(uuid())
  labId String

  resourceType String // e.g., "Patient", "DiagnosticReport", "Observation"
  internalId   String // Your UUID (e.g., the Patient ID or Test ID)
  fhirId       String @unique // The ID recognized by the external FHIR server

  lastSyncedAt    DateTime @default(now())
  payloadSnapshot Json? // The exact FHIR JSON sent/received

  @@index([labId, resourceType, internalId])
}
