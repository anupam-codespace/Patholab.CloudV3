model Report {
  id     String       @id @default(uuid())
  testId String       @unique
  status ReportStatus
  pdfUrl String? // Legacy support, transition to MediaAsset ID later

  // --- AUDIT & COMPLIANCE FIELDS ---
  reportData      Json? // Snapshot of all data at time of signing
  renderedHtml    String? @db.Text // Exact visual snapshot
  signedHash      String? // Cryptographic proof of signature
  version         Int     @default(1)
  versionParentId String? // If amended, link to the old report ID

  test Test @relation(fields: [testId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ReportStatus {
  DRAFT
  PARTIAL
  VERIFIED
  PUBLISHED
  AMENDED
}
