model Department {
  id           String  @id @default(uuid())
  labId        String?
  isGlobal     Boolean @default(false)
  name         String
  code         String?
  displayOrder Int     @default(0)

  createdAt DateTime @default(now())

  lab       Lab?           @relation(fields: [labId], references: [id], onDelete: Cascade)
  templates TestTemplate[]

  @@unique([labId, name])
}

model SampleType {
  id       String  @id @default(uuid())
  labId    String?
  isGlobal Boolean @default(false)
  name     String
  code     String?

  createdAt DateTime @default(now())

  lab       Lab?           @relation(fields: [labId], references: [id], onDelete: Cascade)
  templates TestTemplate[]
  samples   Sample[]

  @@unique([labId, name])
}

model ContainerType {
  id       String  @id @default(uuid())
  labId    String?
  isGlobal Boolean @default(false)
  name     String
  code     String
  capColor String?

  createdAt DateTime @default(now())

  lab        Lab?               @relation(fields: [labId], references: [id])
  templates  TestTemplate[]
  parameters LabTestParameter[]
  samples    Sample[]

  @@unique([labId, name])
}

model TestCategory {
  id          String  @id @default(uuid())
  labId       String?
  isGlobal    Boolean @default(false)
  name        String
  description String?
  icon        String?
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())

  lab       Lab?           @relation(fields: [labId], references: [id])
  templates TestTemplate[]
  tests     Test[]

  @@unique([labId, name])
}

model TestHeading {
  id       String  @id @default(uuid())
  labId    String?
  isGlobal Boolean @default(false)
  name     String

  createdAt DateTime @default(now())

  lab        Lab?                    @relation(fields: [labId], references: [id], onDelete: Cascade)
  parameters TestTemplateParameter[]

  @@unique([labId, name])
}
