model TestWorkflowStage {
  id     String @id @default(uuid())
  testId String

  stageName String // e.g., "ACCESSIONING", "GROSSING", "CULTURE", "MICROSCOPY"
  status    String // "PENDING", "ACTIVE", "COMPLETED"

  startedAt   DateTime?
  completedAt DateTime?
  actorId     String? // The LabStaff ID who completed this stage

  notes String? @db.Text

  test Test @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@index([testId])
}
