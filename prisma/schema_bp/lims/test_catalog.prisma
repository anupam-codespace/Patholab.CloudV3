model TestTemplate {
  id String @id @default(uuid())

  // 🌍 ENTERPRISE: Made optional so global master templates aren't forced to belong to a specific lab
  labId    String?
  branchId String? // Allows branch-specific overrides
  isGlobal Boolean @default(false) // Flags this as a universal template

  code        String // e.g., "CBC-01"
  name        String
  printName   String? // The name that appears on the patient report
  description String? @db.Text
  price       Decimal @db.Decimal(10, 2)
  isActive    Boolean @default(true)

  // Enterprise Logic
  isPublic  Boolean @default(true)
  isPopular Boolean @default(false)
  tatHours  Int? // Turn Around Time
  method    String?

  // Master-Local Override Pattern
  forkedFromId String?
  forkedFrom   TestTemplate?  @relation("TestFork", fields: [forkedFromId], references: [id])
  forks        TestTemplate[] @relation("TestFork")

  parameters TestTemplateParameter[]

  // Relations
  lab             Lab?           @relation(fields: [labId], references: [id])
  branch          Branch?        @relation(fields: [branchId], references: [id])
  Department      Department?    @relation(fields: [departmentId], references: [id])
  departmentId    String?
  SampleType      SampleType?    @relation(fields: [sampleTypeId], references: [id])
  sampleTypeId    String?
  ContainerType   ContainerType? @relation(fields: [containerTypeId], references: [id])
  containerTypeId String?
  TestCategory    TestCategory?  @relation(fields: [testCategoryId], references: [id])
  testCategoryId  String?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([labId, code, branchId])
  @@index([isGlobal])
  @@index([deletedAt])
  @@index([branchId])
}

model LabTestParameter {
  id String @id @default(uuid())

  // 🌍 ENTERPRISE: Made optional for global parameters
  labId    String?
  isGlobal Boolean @default(false)

  code      String
  name      String // e.g., "Hemoglobin"
  printName String? // The name on the report
  unit      String?
  method    String?

  // Enterprise Automation Logic
  isDerived        Boolean @default(false)
  formula          String? @db.Text
  autoApprove      Boolean @default(false)
  deltaCheck       Boolean @default(false)
  panicLow         Float?
  panicHigh        Float?
  repeatIfCritical Boolean @default(true)

  templates TestTemplateParameter[]

  // Master-Local Override Pattern
  forkedFromId String?
  forkedFrom   LabTestParameter?  @relation("ParameterFork", fields: [forkedFromId], references: [id])
  forks        LabTestParameter[] @relation("ParameterFork")

  // ✅ ADDED: These are required so your Server Action can save and delete ranges/reagents!
  referenceRanges ParameterReferenceRange[]
  reagents        TestParameterReagent[]

  // Relations
  lab             Lab?           @relation(fields: [labId], references: [id])
  ContainerType   ContainerType? @relation(fields: [containerTypeId], references: [id])
  containerTypeId String?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([labId, code])
  @@index([isGlobal])
}

model TestTemplateParameter {
  id           String @id @default(uuid())
  templateId   String
  parameterId  String
  displayOrder Int    @default(0)

  template      TestTemplate     @relation(fields: [templateId], references: [id], onDelete: Cascade)
  parameter     LabTestParameter @relation(fields: [parameterId], references: [id])
  TestHeading   TestHeading?     @relation(fields: [testHeadingId], references: [id])
  testHeadingId String?

  @@unique([templateId, parameterId])
}

// ==========================================
// CHILD MODELS FOR PARAMETERS (Ensure these exist!)
// ==========================================

model ParameterReferenceRange {
  id          String @id @default(uuid())
  parameterId String
  gender      Gender // Enum: MALE, FEMALE, OTHER
  minAge      Int
  maxAge      Int
  ageUnit     String // e.g., "Years", "Months", "Days"

  lowValue     Float?
  highValue    Float?
  criticalLow  Float?
  criticalHigh Float?

  textValue   String? // For text-based results like "Negative" or "Reactive"
  customLabel String? // e.g., "Adult Males", "Pregnancy Trimester 1"

  parameter LabTestParameter @relation(fields: [parameterId], references: [id], onDelete: Cascade)

  @@index([parameterId])
}

model TestParameterReagent {
  id              String @id @default(uuid())
  parameterId     String
  inventoryItemId String
  quantity        Float // Amount of reagent consumed per test

  parameter     LabTestParameter @relation(fields: [parameterId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem    @relation(fields: [inventoryItemId], references: [id])

  @@unique([parameterId, inventoryItemId])
}
