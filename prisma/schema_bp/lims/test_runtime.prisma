model Test {
  id            String  @id @default(uuid())
  labId         String
  branchId      String?
  patientId     String
  appointmentId String?
  invoiceId     String?

  testTemplateId String?
  testNumber     String // e.g., TST-10023
  testName       String
  testCode       String

  // --- ENTERPRISE STATUS & WORKFLOW ---
  status   TestStatus   @default(PENDING)
  priority TestPriority @default(NORMAL)

  // --- FINANCIALS ---
  price      Decimal @db.Decimal(10, 2)
  finalPrice Decimal @db.Decimal(10, 2)

  // --- OPERATIONAL AUDIT TIMESTAMPS ---
  scheduledAt         DateTime?
  sampleCollectedAt   DateTime?
  processingStartedAt DateTime?
  completedAt         DateTime?
  approvedAt          DateTime?
  approvedById        String? // Reference to User/LabStaff who validated the result

  // --- RELATIONS ---
  results        TestResultParameter[]
  workflowStages TestWorkflowStage[] // Links to the Workflow Engine
  report         Report?
  samples        Sample[]

  doctorId   String?
  agencyId   String?
  referredBy String?

  patient Patient @relation(fields: [patientId], references: [id])
  lab     Lab     @relation(fields: [labId], references: [id])
  branch  Branch? @relation(fields: [branchId], references: [id])

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime? // Soft delete standard (Test Cancelled)
  AIPrediction   AIPrediction?
  TestCategory   TestCategory? @relation(fields: [testCategoryId], references: [id])
  testCategoryId String?
  Appointment    Appointment?  @relation(fields: [appointmentId], references: [id])

  // --- PERFORMANCE INDEXES ---
  @@unique([labId, testNumber])
  @@index([labId, status, priority])
  @@index([patientId])
  @@index([createdAt])
}

model TestResultParameter {
  id          String  @id @default(uuid())
  testId      String
  parameterId String? // Link to catalog, but we don't rely on it for history

  // --- IMMUTABLE SNAPSHOT FIELDS ---
  parameterCode      String
  printName          String
  unit               String? // CRITICAL FIX: Snapshot the unit (e.g., mg/dL)
  method             String?
  referenceRangeText String?
  displayOrder       Int     @default(0) // Keeps reports formatted correctly

  // --- CLINICAL RESULTS ---
  numericValue Float?
  stringValue  String?
  flag         ResultFlag?
  isAbnormal   Boolean     @default(false) // Allows hyper-fast UI highlighting

  // --- AUDIT & MACHINE INTEGRATION ---
  analyzerId  String? // Which physical machine ran this?
  entryMethod EntryMethod @default(MANUAL)

  test Test @relation(fields: [testId], references: [id], onDelete: Cascade)

  // --- ENTERPRISE AI & ANALYTICS INDEXES ---
  @@index([testId])
  @@index([parameterCode])
  @@index([flag])
  @@index([numericValue])
}

// --- ENUMS ---

enum TestStatus {
  PENDING
  SAMPLE_COLLECTED
  PROCESSING
  COMPLETED
  APPROVED // Added for medical validation workflow
  CANCELLED
}

enum TestPriority {
  NORMAL
  URGENT
  STAT // Immediate life-threatening priority
}

enum ResultFlag {
  NORMAL
  LOW
  HIGH
  CRITICAL_LOW
  CRITICAL_HIGH
}

enum EntryMethod {
  MANUAL
  MACHINE_INTERFACE
  CALCULATED
}
