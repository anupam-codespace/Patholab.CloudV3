model InventoryItem {
  id               String                 @id @default(uuid())
  labId            String
  lab              Lab                    @relation(fields: [labId], references: [id])
  
  // Basic Details
  name             String
  sku              String?
  category         String?                // Added for the frontend department/category field
  
  // Unit Mapping & Conversion (Replaces unitOfMeasure)
  purchaseUnit     String                 @default("Box")
  usageUnit        String                 @default("ml")
  conversionFactor Float                  @default(1.0)
  minStockLevel    Float                  @default(10.0) // Renamed from minimumStock & changed to Float

  // Relations & Status
  supplierId       String?
  supplier         Supplier?              @relation(fields: [supplierId], references: [id])
  isActive         Boolean                @default(true) // Required for your GET route filter
  deletedAt        DateTime?

  // Infrastructure 
  batches              InventoryBatch[]
  TestParameterReagent TestParameterReagent[]

  @@unique([labId, name])
  @@index([labId])
}

model InventoryBatch {
  id       String  @id @default(uuid())
  itemId   String
  labId    String
  branchId String?

  batchNumber     String
  expiryDate      DateTime?
  currentQuantity Int       @default(0)

  transactions InventoryTransaction[]

  item InventoryItem @relation(fields: [itemId], references: [id])

  @@unique([itemId, batchNumber])
}

model InventoryTransaction {
  id      String @id @default(uuid())
  batchId String

  type           TransactionType
  reason         ConsumptionReason? // Enterprise requirement for wastage/QC tracking
  quantityChange Int // Positive for restock, negative for consumption

  // Link to LIMS runtime if this was consumed by an actual test
  testId String?

  batch     InventoryBatch @relation(fields: [batchId], references: [id])
  createdAt DateTime       @default(now())
}

enum TransactionType {
  RESTOCK
  CONSUMPTION
  ADJUSTMENT
}

enum ConsumptionReason {
  TEST_RUN
  CALIBRATION
  QC
  WASTAGE_EXPIRED
  WASTAGE_DAMAGED
}
