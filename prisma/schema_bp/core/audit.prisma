model AuditLog {
  id       String  @id @default(uuid())
  labId    String
  branchId String?
  userId   String

  entity   String // "TEST_RESULT", "PATIENT", "INVENTORY"
  entityId String
  action   String // "CREATE", "UPDATE", "DELETE", "SIGN"

  oldData Json?
  newData Json?

  ipAddress String?

  createdAt DateTime @default(now())

  branch Branch? @relation(fields: [branchId], references: [id])

  @@index([labId, entity, entityId])
}

model ActivityLog {
  id         String @id @default(uuid())
  labId      String
  userId     String
  action     String // e.g., "PATIENT_CREATED", "PATIENT_MERGED"
  entityType String // e.g., "PATIENT", "INVOICE"
  entityId   String // The UUID of the record
  details    Json? // Detailed JSON of what changed

  createdAt DateTime @default(now())

  // Relations (Make sure these models exist in your schema)
  lab       Lab      @relation(fields: [labId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
  Patient   Patient? @relation(fields: [patientId], references: [id])
  patientId String?

  @@index([labId, entityId])
}
