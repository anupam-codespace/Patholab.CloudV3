model DomainEvent {
  id            String @id @default(uuid())
  eventType     String // e.g., "REPORT_SIGNED", "INVOICE_GENERATED"
  aggregateType String // e.g., "Report", "Invoice"
  aggregateId   String
  payload       Json // The snapshot of data needed for the event

  processed    Boolean @default(false)
  errorMessage String? @db.Text

  createdAt   DateTime  @default(now())
  processedAt DateTime?

  // Hyper-fast polling for background workers
  @@index([processed, createdAt])
  @@index([aggregateType, aggregateId])
}
