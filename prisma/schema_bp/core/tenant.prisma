model Lab {
  id            String  @id @default(uuid())
  labCode       String  @unique
  name          String
  portalSlug    String? @unique
  licenseNumber String? @unique
  isActive      Boolean @default(true)

  // Tenancy Relations (Cross-file relations work perfectly in Prisma now!)
  branches Branch[]
  users    LabStaff[]
  assets   MediaAsset[]

  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  deletedAt          DateTime? // Soft delete standard
  invoice            Invoice[]
  subscription       Subscription?
  agency             Agency[]
  doctor             Doctor[]
  labAnalyzer        LabAnalyzer[]
  inventoryItem      InventoryItem[]
  patient            Patient[]
  sample             Sample[]
  department         Department[]
  SampleType         SampleType[]
  containerType      ContainerType[]
  testCategory       TestCategory[]
  testHeading        TestHeading[]
  testTemplate       TestTemplate[]
  labTestParameter   LabTestParameter[]
  test               Test[]
  appointment        Appointment[]
  homeCollectionTrip HomeCollectionTrip[]
  serviceArea        ServiceArea[]
  modality           Modality[]
  radiologyStudy     RadiologyStudy[]
  Expense            Expense[]
  ActivityLog        ActivityLog[]

  @@index([deletedAt])
}

model Branch {
  id           String  @id @default(uuid())
  labId        String
  name         String
  isMainBranch Boolean @default(false)

  address String?
  pincode String?

  lab   Lab        @relation(fields: [labId], references: [id])
  staff LabStaff[]

  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  deletedAt          DateTime?
  AuditLog           AuditLog[]
  LabAnalyzer        LabAnalyzer[]
  Patient            Patient[]
  Sample             Sample[]
  TestTemplate       TestTemplate[]
  Test               Test[]
  HomeCollectionTrip HomeCollectionTrip[]
  ServiceArea        ServiceArea[]
  Modality           Modality[]
  RadiologyStudy     RadiologyStudy[]
  Expense            Expense[]

  @@index([labId, deletedAt])
}
