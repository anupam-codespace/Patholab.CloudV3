model User {
  id       String  @id @default(uuid())
  email    String  @unique
  phone    String  @unique
  password String
  name     String
  role     Role    @default(PATIENT)
  isActive Boolean @default(true)

  // Restored Onboarding Status
  onboardingStatus OnboardingStatus @default(REGISTERED)

  staffProfiles LabStaff[]

  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  ActivityLog        ActivityLog[]
  SupportTicket      SupportTicket[]
  Notification       Notification[]
  Patient            Patient[]
  HomeCollectionTrip HomeCollectionTrip[]
}

model LabStaff {
  id       String @id @default(uuid())
  labId    String
  branchId String
  userId   String

  employeeId  String?  @unique
  position    String? // Restored Position Field
  permissions String[] @default([]) // Enterprise text array RBAC
  isActive    Boolean  @default(true)

  user   User   @relation(fields: [userId], references: [id])
  lab    Lab    @relation(fields: [labId], references: [id])
  branch Branch @relation(fields: [branchId], references: [id])

  @@unique([labId, userId])
  @@index([branchId])
}

enum Role {
  SUPER_ADMIN
  LAB_OWNER
  LAB_MANAGER
  TECHNICIAN
  RECEPTIONIST
  DOCTOR
  PATIENT
  AGENCY
}

enum OnboardingStatus {
  REGISTERED
  VERIFIED
  LAB_SETUP
  COMPLETED
}
