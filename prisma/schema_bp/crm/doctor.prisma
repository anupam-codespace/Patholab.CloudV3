model Doctor {
  id    String @id @default(uuid())
  labId String

  name           String
  registrationNo String? // Medical Council Number
  phone          String?
  email          String?
  specialization String?

  isActive Boolean @default(true)

  // Commission Logic (Percentage or Flat)
  commissionRate Decimal? @db.Decimal(5, 2)

  lab     Lab       @relation(fields: [labId], references: [id])
  Patient Patient[]

  @@unique([labId, registrationNo])
}
