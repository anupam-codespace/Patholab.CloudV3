model Agency {
  id    String @id @default(uuid())
  labId String

  name          String
  contactPerson String?
  phone         String?
  email         String?
  address       String? @db.Text

  isActive    Boolean  @default(true)
  creditLimit Decimal? @db.Decimal(10, 2) // For B2B monthly billing

  invoices Invoice[] // Links to the billing module

  lab     Lab       @relation(fields: [labId], references: [id])
  Patient Patient[]
}
