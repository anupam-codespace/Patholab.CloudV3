// 2. Add this completely new model at the bottom of your schema file
model AgencyCustomCommission {
  id             String @id @default(uuid())
  agencyId       String
  testTemplateId String

  // Use commissionRate if giving them a specific % or Flat ₹ discount
  commissionRate Float?
  commissionType CommissionType @default(PERCENTAGE)

  // OR use netPrice if giving them a strict B2B rate (e.g., CBC for ₹150)
  netPrice Decimal?

  agency       Agency       @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  testTemplate TestTemplate @relation(fields: [testTemplateId], references: [id], onDelete: Cascade)

  // Ensures an agency only has one custom rule per test
  @@unique([agencyId, testTemplateId])
}

model Commission {
