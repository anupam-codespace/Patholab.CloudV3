enum DiscountType {
  PERCENTAGE
  FLAT
}

// --- CMS / PUBLIC PAGES ---
model Page {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String
  content     String
  metaTitle   String?
  metaDesc    String?
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ==========================================
// TEST CATALOG & TEMPLATES
// ==========================================
model TestTemplate {
  id    String  @id @default(uuid())
  labId String?
  lab   Lab?    @relation(fields: [labId], references: [id], onDelete: Cascade)

  // Enterprise Forking Logic
  isGlobal     Boolean        @default(false)
  forkedFromId String?
  forkedFrom   TestTemplate?  @relation("TestForks", fields: [forkedFromId], references: [id])
  forks        TestTemplate[] @relation("TestForks")

  // Core Info
  code        String
  name        String
  printName   String?
  description String?
  method      String?
  type        String  @default("SINGLE") // SINGLE, PROFILE

  // Relations
  departmentId String?
  Department   Department? @relation(fields: [departmentId], references: [id])

  sampleTypeId String?
  SampleType   SampleType? @relation(fields: [sampleTypeId], references: [id])

  containerTypeId String?
  ContainerType   ContainerType? @relation(fields: [containerTypeId], references: [id])

  testCategoryId String?
  TestCategory   TestCategory? @relation(fields: [testCategoryId], references: [id])

  // Pricing & Logistics
  price        Decimal @default(0.00)
  tatHours     Int     @default(24)
  isActive     Boolean @default(true)
  isPublic     Boolean @default(true)
  preRequistes String?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  parameters             TestTemplateParameter[]
  customFields           TestTemplateCustomField[] // Add this line!
  Test                   Test[]
  DoctorCustomCommission DoctorCustomCommission[]
  AgencyCustomCommission AgencyCustomCommission[]

  @@index([labId])
}

model TestTemplateParameter {
  id             String           @id @default(uuid())
  testTemplateId String
  testTemplate   TestTemplate     @relation(fields: [testTemplateId], references: [id], onDelete: Cascade)
  parameterId    String
  parameter      LabTestParameter @relation(fields: [parameterId], references: [id], onDelete: Cascade)
  order          Int              @default(0)

  @@unique([testTemplateId, parameterId])
}

// ==========================================
// DYNAMIC CUSTOM FIELDS
// ==========================================
model CustomFieldDefinition {
  id            String   @id @default(uuid())
  labId         String
  lab           Lab      @relation(fields: [labId], references: [id], onDelete: Cascade)
  name          String
  type          String   @default("TEXT") // TEXT, NUMBER, DROPDOWN, DATE, LONG_TEXT
  options       String   @default("") // Used for DROPDOWN types
  reportLayout  String   @default("FULL") // FULL (occupies full row), HALF (occupies half row)
  printOnReport Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relation to attach these fields to specific test templates
  testTemplates TestTemplateCustomField[]

  @@unique([labId, name])
  @@index([labId])
}

// Junction table to link Custom Fields to Test Templates
model TestTemplateCustomField {
  id           String                @id @default(uuid())
  templateId   String
  template     TestTemplate          @relation(fields: [templateId], references: [id], onDelete: Cascade)
  fieldId      String
  field        CustomFieldDefinition @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  order        Int                   @default(0)
  isRequired   Boolean               @default(false)
  defaultValue String?

  @@unique([templateId, fieldId])
}

model TestResultCustomField {
  id         String  @id @default(uuid())
  testId     String
  test       Test    @relation(fields: [testId], references: [id], onDelete: Cascade)
  fieldDefId String
  // We use String here instead of a relation because definitions might get deleted/changed, 
  // but historical clinical results MUST remain immutable.
  value      String
  layout     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([testId, fieldDefId])
  @@index([testId])
}

model B2BTierRule {
  id   String @id @default(cuid())
  tier String // "STANDARD", "BRONZE", "SILVER", "GOLD", "PLATINUM"

  testTemplateId String
  testName       String // Cached for faster loading
  basePrice      Float // Cached original price

  ruleType String // "NET_PRICE", "PERCENTAGE", "FIXED"
  value    Float

  labId     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Ensure a test only has one rule per tier per lab
  @@unique([tier, testTemplateId, labId])
}
