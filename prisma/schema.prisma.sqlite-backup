enum TemplateType {
  GLOBAL
  LOCAL
  HEADLESS
  HEADER
  FOOTER
  PAGE
}

model ReportTemplate {
  id       String       @id @default(uuid())
  labId    String? // null = GLOBAL template
  lab      Lab?         @relation(fields: [labId], references: [id], onDelete: Cascade)
  name     String
  type     TemplateType @default(LOCAL)
  isActive Boolean      @default(false)
  isSystem Boolean      @default(false)

  // ─── Parent / Copy relation ──────────────────────
  parentId String?
  parent   ReportTemplate?  @relation("TemplateCopies", fields: [parentId], references: [id], onDelete: SetNull)
  children ReportTemplate[] @relation("TemplateCopies") // ← opposite side

  // ─── Header template relation ────────────────────
  headerTemplateId String?
  headerTemplate   ReportTemplate?  @relation("HeaderTemplates", fields: [headerTemplateId], references: [id], onDelete: SetNull)
  usedAsHeaderBy   ReportTemplate[] @relation("HeaderTemplates") // ← opposite side

  // ─── Footer template relation ────────────────────
  footerTemplateId String?
  footerTemplate   ReportTemplate?  @relation("FooterTemplates", fields: [footerTemplateId], references: [id], onDelete: SetNull)
  usedAsFooterBy   ReportTemplate[] @relation("FooterTemplates") // ← opposite side

  // ─── Content ──────────────────────────────────────
  config       String?
  content      String? // for HEADLESS / HEADER / FOOTER / PAGE
  extraPageIds String? // array of PAGE template IDs (stored as JSON)

  // ─── Visual settings ──────────────────────────────
  pageSize     String  @default("A4")
  orientation  String  @default("PORTRAIT")
  primaryColor String? @default("#1e3a8a")
  accentColor  String? @default("#2563eb")
  fontFamily   String? @default("Inter")
  logoUrl      String?
  signatureUrl String?
  headerImage  String?
  footerImage  String?
  isoMarkUrl   String?
  watermarkUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([labId])
  @@index([type])
  @@index([parentId])
}

// ==========================================
// INVENTORY MANAGEMENT
// ==========================================
model Supplier {
  id            String   @id @default(uuid())
  labId         String
  lab           Lab      @relation(fields: [labId], references: [id])
  name          String
  contactPerson String?
  email         String?
  phone         String?
  address       String?
  gstNumber     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  inventoryItems InventoryItem[]

  @@index([labId])
}

model InventoryItem {
  id    String @id @default(uuid())
  labId String
  lab   Lab    @relation(fields: [labId], references: [id])

  // Basic Details
  name     String
  sku      String?
  category String?

  // Unit Mapping & Conversion
  purchaseUnit     String @default("Box")
  usageUnit        String @default("ml")
  conversionFactor Float  @default(1.0)
  minStockLevel    Float  @default(10.0)

  // Relations & Status
  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id])
  isActive   Boolean   @default(true)
  deletedAt  DateTime?

  // Infrastructure 
  batches              InventoryBatch[]
  TestParameterReagent TestParameterReagent[]

  @@unique([labId, name])
  @@index([labId])
}

model InventoryBatch {
  id              String        @id @default(uuid())
  labId           String
  lab             Lab           @relation(fields: [labId], references: [id])
  branchId        String?
  branch          Branch?       @relation(fields: [branchId], references: [id])
  itemId          String
  item            InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  batchNumber     String
  expiryDate      DateTime
  initialQuantity Float
  currentQuantity Float         @default(0)
  costPrice       Decimal?
  mrp             Decimal?
  location        String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  transactions InventoryTransaction[]

  @@unique([itemId, batchNumber])
  @@index([itemId])
  @@index([labId])
}

model InventoryTransaction {
  id          String          @id @default(uuid())
  batchId     String?
  batch       InventoryBatch? @relation(fields: [batchId], references: [id], onDelete: Cascade)
  quantity    Float
  type        StockType
  testId      String?
  test        Test?           @relation(fields: [testId], references: [id])
  notes       String?
  performedBy String?
  createdAt   DateTime        @default(now())

  @@index([batchId])
  @@index([type])
}

model TestParameterReagent {
  id              String           @id @default(uuid())
  parameterId     String
  parameter       LabTestParameter @relation(fields: [parameterId], references: [id], onDelete: Cascade)
  inventoryItemId String
  inventoryItem   InventoryItem    @relation(fields: [inventoryItemId], references: [id])
  quantity        Float
  createdAt       DateTime         @default(now())

  @@unique([parameterId, inventoryItemId])
}

enum StockType {
  PURCHASE
  CONSUMPTION
  RETURN
  WASTAGE
  EXPIRED
  ADJUSTMENT
}

