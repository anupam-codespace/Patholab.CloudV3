// ==========================================
// CONFIG & GENERATOR
// ==========================================
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ==========================================
// SYSTEM CONFIGURATION
// ==========================================
model SystemConfig {
  id                  String   @id @default(uuid())
  systemName          String   @default("Patholab Cloud")
  systemLogo          String?
  favicon             String?
  primaryColor        String   @default("#3b82f6")
  secondaryColor      String   @default("#8b5cf6")
  seoTitle            String?  @default("Patholab Cloud - Modern LIMS")
  seoDescription      String?
  seoKeywords         String?
  ogImage             String?
  defaultRegFee       Decimal  @default(2.50)
  defaultMinRecharge  Decimal  @default(100.00)
  googleAnalyticsId   String?
  facebookPixelId     String?
  socialLinks         String?
  systemEmail         String?
  systemPhone         String?
  systemAddress       String?
  gstNumber           String?
  panNumber           String?
  invoicePrefix       String   @default("SAAS")
  nextInvoiceNo       Int      @default(1)
  currency            String   @default("INR")
  currencySymbol      String   @default("₹")
  taxRate             Decimal  @default(18.0)
  enableABDM          Boolean  @default(false)
  abdmClientId        String?
  abdmClientSecret    String?
  razorpayKeyId       String?
  razorpayKeySecret   String?
  smtpHost            String?
  smtpPort            Int?
  smtpUser            String?
  smtpPassword        String?
  landingPage         String?
  enablePatientPortal Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  letterheadHeader    String?
  letterheadFooter    String?
}

// ==========================================
// USER MANAGEMENT & RBAC
// ==========================================
model User {
  id               String           @id @default(uuid())
  email            String           @unique
  password         String
  name             String
  phone            String?
  role             Role             @default(LAB_OWNER)
  emailVerified    Boolean          @default(false)
  onboardingStatus OnboardingStatus @default(REGISTERED)
  isActive         Boolean          @default(false)
  avatar           String?
  abhaNumber       String?          @unique
  abhaAddress      String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deletedAt        DateTime? // Allowed on users, not clinical data

  // Relations
  lab                Lab?                 @relation("LabOwner")
  staffLabs          LabStaff[]
  otp                OTP?
  activityLogs       ActivityLog[]
  doctor             Doctor?
  agency             Agency?
  patientProfile     Patient[]            @relation("UserPatient")
  phlebotomistTrips  HomeCollectionTrip[]
  technicianReports  Report[]             @relation("TechnicianReports")
  seniorTechReports  Report[]             @relation("SeniorTechReports")
  pathologistReports Report[]             @relation("PathologistReports")
  SupportTicket      SupportTicket[]

  @@index([email])
  @@index([role])
}

model ActivityLog {
  id          String   @id @default(uuid())
  labId       String // Added this
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  action      String
  entity      String
  entityId    String
  entityType  String // Added this
  description String
  details     String? // Added this
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([labId]) // Added index for performance
}

enum OnboardingStatus {
  REGISTERED
  VERIFIED
  LAB_SETUP
  COMPLETED
}

enum Role {
  SUPER_ADMIN
  LAB_OWNER
  TECHNICIAN
  LAB_MANAGER
  RECEPTIONIST
  DOCTOR
  AGENCY
  PATIENT
  PHLEBOTOMIST
  B2B_PARTNER
}

model OTP {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String
  type      OTPType  @default(EMAIL_VERIFICATION)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

enum OTPType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

// ==========================================
// INFRASTRUCTURE: MEDIA & EVENT BUS
// ==========================================
model DomainEvent {
  id            String   @id @default(uuid())
  eventType     String
  aggregateType String
  aggregateId   String
  payload       String
  processed     Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([processed, eventType])
}

model MediaAsset {
  id        String   @id @default(uuid())
  provider  String
  bucket    String
  path      String
  mimeType  String
  size      Int
  checksum  String?
  createdAt DateTime @default(now())
}

// ==========================================
// LABORATORY CORE & MULTI-BRANCH
// ==========================================
model Lab {
  id                      String         @id @default(uuid())
  name                    String
  portalSlug              String?        @unique
  labCode                 String?        @unique
  upiId                   String?
  address                 String?
  city                    String?
  state                   String?
  pincode                 String?
  phone                   String
  email                   String
  licenseNumber           String?        @unique
  registrationNo          String?
  gstNumber               String?
  panNumber               String?
  entityType              String?
  bankName                String?
  accountNumber           String?
  ifscCode                String?
  accountHolder           String?
  logo                    String?
  letterhead              String?
  footer                  String?
  signature               String?
  isActive                Boolean        @default(true)
  whatsappApiKey          String?
  whatsappPhoneId         String?
  smsApiKey               String?
  smsSenderId             String?
  activeModules           String         @default("")
  defaultDoctorCommission Decimal?       @default(10.0)
  defaultAgencyCommission Decimal?       @default(5.0)
  commissionType          CommissionType @default(PERCENTAGE)
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
  deletedAt               DateTime?

  ownerId               String                  @unique
  owner                 User                    @relation("LabOwner", fields: [ownerId], references: [id])
  wallet                LabWallet?
  branches              Branch[]
  serviceAreas          ServiceArea[]
  staff                 LabStaff[]
  patients              Patient[]
  tests                 Test[]
  invoices              Invoice[]
  doctors               Doctor[]
  agencies              Agency[]
  discounts             Discount[]
  samples               Sample[]
  expenses              Expense[]
  analyzers             LabAnalyzer[]
  homeTrips             HomeCollectionTrip[]
  testPricing           LabTestPricing[]
  testCategories        TestCategory[]
  testParameters        LabTestParameter[]
  reportTemplates       ReportTemplate[]
  unmappedCodes         UnmappedMachineCode[]
  containerTypes        ContainerType[]
  departments           Department[]
  sampleTypes           SampleType[]
  testHeadings          TestHeading[]
  reports               Report[]
  inventoryItems        InventoryItem[]
  inventoryBatches      InventoryBatch[]
  suppliers             Supplier[]
  TestTemplate          TestTemplate[]
  CustomFieldDefinition CustomFieldDefinition[]

  @@index([ownerId])
  @@index([licenseNumber])
  @@index([deletedAt])
}

model Branch {
  id           String    @id @default(uuid())
  labId        String
  lab          Lab       @relation(fields: [labId], references: [id], onDelete: Cascade)
  name         String
  code         String?
  branchCode   String?
  isMainBranch Boolean   @default(false)
  logo         String?
  letterhead   String?
  footer       String?
  signature    String?
  address      String
  city         String
  state        String
  pincode      String
  phone        String?
  email        String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  serviceAreas          ServiceArea[]
  staff                 LabStaff[]
  patients              Patient[]
  samples               Sample[]
  appointments          Appointment[]
  tests                 Test[]
  invoices              Invoice[]
  expenses              Expense[]
  doctors               Doctor[]
  agencies              Agency[]
  discounts             Discount[]
  analyzers             LabAnalyzer[]
  inventoryBatches      InventoryBatch[]
  radiologyAppointments RadiologyAppointment[]
  radiologyStudies      RadiologyStudy[]
  modalities            Modality[]
  testPricings          LabTestPricing[]
  reports               Report[]
  homeTrips             HomeCollectionTrip[]
  auditLogs             AuditLog[]

  @@index([labId])
}

model ServiceArea {
  id          String   @id @default(uuid())
  labId       String
  lab         Lab      @relation(fields: [labId], references: [id], onDelete: Cascade)
  branchId    String
  branch      Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  pincode     String
  areaName    String?
  deliveryFee Decimal  @default(0.00)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@unique([labId, branchId, pincode])
}

model LabStaff {
  id          String   @id @default(uuid())
  labId       String
  lab         Lab      @relation(fields: [labId], references: [id], onDelete: Cascade)
  userId      String
  employeeId  String?  @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  branchId    String?
  branch      Branch?  @relation(fields: [branchId], references: [id])
  position    String
  department  String?
  salary      Decimal?
  joinDate    DateTime @default(now())
  isActive    Boolean  @default(true)
  permissions String   @default("")
  createdAt   DateTime @default(now())

  @@unique([labId, userId])
  @@index([labId])
}

// ==========================================
// NEW WALLET PAY-AS-YOU-GO REVENUE MODEL
// ==========================================
model LabWallet {
  id                   String              @id @default(uuid())
  labId                String              @unique
  lab                  Lab                 @relation(fields: [labId], references: [id], onDelete: Cascade)
  balance              Decimal             @default(0.00)
  perPatientFee        Decimal             @default(2.50)
  minimumRecharge      Decimal             @default(100.00)
  validityEndDate      DateTime?
  isActive             Boolean             @default(true)
  isLisIntegrationPaid Boolean             @default(false)
  transactions         WalletTransaction[]
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
}

model WalletTransaction {
  id             String          @id @default(uuid())
  labId          String
  wallet         LabWallet       @relation(fields: [labId], references: [labId], onDelete: Cascade)
  type           TransactionType
  amount         Decimal
  closingBalance Decimal
  description    String?
  createdAt      DateTime        @default(now())

  @@index([labId])
}

enum TransactionType {
  RECHARGE
  DEDUCTION
  REFUND
  SETUP_FEE
}

// ==========================================
// DICTIONARIES & METADATA
// ==========================================
model Department {
  id           String         @id @default(uuid())
  labId        String?
  lab          Lab?           @relation(fields: [labId], references: [id], onDelete: Cascade)
  isGlobal     Boolean        @default(false)
  name         String
  code         String?
  displayOrder Int            @default(0)
  createdAt    DateTime       @default(now())
  TestTemplate TestTemplate[]

  @@unique([labId, name])
}

model SampleType {
  id           String         @id @default(uuid())
  labId        String?
  lab          Lab?           @relation(fields: [labId], references: [id], onDelete: Cascade)
  isGlobal     Boolean        @default(false)
  name         String
  code         String?
  samples      Sample[]
  createdAt    DateTime       @default(now())
  TestTemplate TestTemplate[]

  @@unique([labId, name])
}

model ContainerType {
  id           String             @id @default(uuid())
  labId        String?
  lab          Lab?               @relation(fields: [labId], references: [id])
  isGlobal     Boolean            @default(false)
  name         String
  code         String
  capColor     String?
  parameters   LabTestParameter[]
  samples      Sample[]
  createdAt    DateTime           @default(now())
  TestTemplate TestTemplate[]

  @@unique([labId, name])
}

model TestCategory {
  id           String         @id @default(uuid())
  labId        String?
  lab          Lab?           @relation(fields: [labId], references: [id])
  isGlobal     Boolean        @default(false)
  name         String
  description  String?
  icon         String?
  isActive     Boolean        @default(true)
  tests        Test[]
  createdAt    DateTime       @default(now())
  TestTemplate TestTemplate[]

  @@unique([labId, name])
}

model TestHeading {
  id        String   @id @default(uuid())
  labId     String?
  lab       Lab?     @relation(fields: [labId], references: [id], onDelete: Cascade)
  isGlobal  Boolean  @default(false)
  name      String
  createdAt DateTime @default(now())

  @@unique([labId, name])
}

model LabTestParameter {
  id              String             @id @default(uuid())
  labId           String?
  lab             Lab?               @relation(fields: [labId], references: [id])
  isGlobal        Boolean            @default(false)
  name            String
  printName       String?
  code            String
  unit            String?
  isDerived       Boolean            @default(false)
  formula         String?
  decimals        Int                @default(2)
  method          String?
  price           Decimal            @default(0.00)
  options         String             @default("")
  containerTypeId String?
  containerType   ContainerType?     @relation(fields: [containerTypeId], references: [id])
  isActive        Boolean            @default(true)
  forkedFromId    String?
  forkedFrom      LabTestParameter?  @relation("ParameterForks", fields: [forkedFromId], references: [id])
  forks           LabTestParameter[] @relation("ParameterForks")

  referenceRanges ParameterReferenceRange[]
  reagents        TestParameterReagent[]

  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  TestTemplateParameter TestTemplateParameter[]

  @@unique([labId, code])
  @@index([labId])
}

model ParameterReferenceRange {
  id           String           @id @default(uuid())
  parameterId  String
  parameter    LabTestParameter @relation(fields: [parameterId], references: [id], onDelete: Cascade)
  gender       Gender
  minAge       Int              @default(0)
  maxAge       Int              @default(100)
  ageUnit      String           @default("YEAR")
  lowValue     Float?
  highValue    Float?
  criticalLow  Float?
  criticalHigh Float?
  textValue    String?
  displayText  String?
  customLabel  String?
  createdAt    DateTime         @default(now())

  @@index([parameterId])
}

model LabTestPricing {
  id             String   @id @default(uuid())
  labId          String
  lab            Lab      @relation(fields: [labId], references: [id], onDelete: Cascade)
  branchId       String?
  branch         Branch?  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  testTemplateId String
  price          Decimal
  b2bPrice       Decimal? @default(0.00)
  cost           Decimal? @default(0.00)
  tat            String?
  isActive       Boolean  @default(true)

  @@index([labId])
  @@index([branchId])
}

// ==========================================
// TEST EXECUTION & LOGISTICS
// ==========================================
model Patient {
  id                 String    @id @default(uuid())
  isGlobal           Boolean   @default(false)
  labId              String
  userId             String?
  user               User?     @relation("UserPatient", fields: [userId], references: [id])
  lab                Lab       @relation(fields: [labId], references: [id])
  branchId           String?
  branch             Branch?   @relation(fields: [branchId], references: [id])
  patientId          String
  name               String
  email              String?
  phone              String
  dateOfBirth        DateTime?
  age                Int?
  ageUnit            String    @default("Years")
  gender             Gender?
  bloodGroup         String?
  address            String?
  pincode            String?
  srfId              String?
  passportNumber     String?
  gstNumber          String?
  walletBalance      Decimal   @default(0.00)
  loyaltyPoints      Int       @default(0)
  membershipTier     String    @default("SILVER")
  chronicConditions  String    @default("")
  doctorId           String?
  doctor             Doctor?   @relation("PatientDefaultDoctor", fields: [doctorId], references: [id])
  agencyId           String?
  agency             Agency?   @relation("PatientDefaultAgency", fields: [agencyId], references: [id])
  medicalHistory     String?
  allergies          String?
  abhaNumber         String?
  healthId           String?
  dataConsentGranted Boolean   @default(true)
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Immutability: NO deletedAt
  tests                 Test[]
  appointments          Appointment[]
  samples               Sample[]
  invoices              Invoice[]
  reports               Report[]
  radiologyAppointments RadiologyAppointment[]
  radiologyStudies      RadiologyStudy[]

  @@unique([labId, patientId])
  @@unique([labId, abhaNumber])
  @@index([phone])
}

enum Gender {
  MALE
  FEMALE
  OTHER
  BOTH
  CUSTOM
}

model Sample {
  id       String  @id @default(uuid())
  labId    String
  lab      Lab     @relation(fields: [labId], references: [id])
  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  // This is the Clinical ID generated when a sample is accepted
  sampleId      String
  barcodeFormat String @default("CODE128")

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id])

  // ✅ CONNECTED: Direct link to the logistics visit (if home collection)
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])

  sampleTypeId    String?
  sampleType      SampleType?    @relation(fields: [sampleTypeId], references: [id])
  containerTypeId String?
  containerType   ContainerType? @relation(fields: [containerTypeId], references: [id])

  collectionMode CollectionMode @default(LAB_VISIT)

  // Clinical Lifecycle
  collectedAt DateTime?
  collectedBy String?
  status      SampleStatus @default(COLLECTED)
  receivedAt  DateTime? // When it physically enters the lab
  receivedBy  String?

  // Logistics metadata
  collectionLat      Float?
  collectionLng      Float?
  collectionAddress  String?
  courierName        String?
  trackingNumber     String?
  transitTemperature String?

  // Lab Processing metadata
  storageLocation String?
  temperature     String?
  condition       String? // e.g., "Hemolysed", "Lipemic"
  machineId       String?
  rackPosition    String?
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tests    Test[]
  timeline SampleLog[]

  @@unique([labId, sampleId])
  @@index([sampleId])
  @@index([labId, status, createdAt])
}

enum SampleStatus {
  COLLECTED
  IN_TRANSIT
  RECEIVED
  PROCESSING
  PROCESSED
  STORED
  REJECTED
}

enum CollectionMode {
  LAB_VISIT
  HOME_COLLECTION
  HOSPITAL_PICKUP
}

model SampleLog {
  id        String       @id @default(uuid())
  sampleId  String
  sample    Sample       @relation(fields: [sampleId], references: [id])
  status    SampleStatus
  timestamp DateTime     @default(now())
  actor     String
  notes     String?
  location  String?
}

model HomeCollectionTrip {
  id             String        @id @default(uuid())
  labId          String
  lab            Lab           @relation(fields: [labId], references: [id])
  branchId       String?
  branch         Branch?       @relation(fields: [branchId], references: [id])
  phlebotomistId String
  phlebotomist   User          @relation(fields: [phlebotomistId], references: [id])
  scheduledDate  DateTime
  startLocation  String?
  endLocation    String?
  totalDistance  Float?
  status         TripStatus    @default(SCHEDULED)
  appointments   Appointment[]
  createdAt      DateTime      @default(now())
}

enum TripStatus {
  SCHEDULED
  STARTED
  IN_PROGRESS
  COMPLETED
}

model Appointment {
  id String @id @default(uuid())

  // Logistics
  patientId String
  patient   Patient @relation(fields: [patientId], references: [id])
  labId     String
  branchId  String?
  branch    Branch? @relation(fields: [branchId], references: [id])

  // Trip & Route Scheduling
  tripId     String?
  trip       HomeCollectionTrip? @relation(fields: [tripId], references: [id])
  routeOrder Int                 @default(0)

  // Scheduling Details
  source          BookingSource  @default(WALK_IN)
  collectionMode  CollectionMode @default(LAB_VISIT)
  appointmentDate DateTime
  timeSlot        String? // e.g., "08:00 AM - 10:00 AM"

  // Location
  collectionAddress String?
  pincode           String?
  latitude          Float?
  longitude         Float?

  // Payment Snapshot at time of booking
  paymentCollected Decimal? @default(0.00)
  paymentMode      String?
  invoiceId        String?  @unique
  invoice          Invoice? @relation(fields: [invoiceId], references: [id])

  // Status tracking
  status    AppointmentStatus @default(SCHEDULED)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  // Clinical Links
  tests   Test[]
  samples Sample[] // ✅ Link added so we can see what was collected during this visit
}

enum BookingSource {
  WALK_IN
  PHONE_CALL
  ONLINE_PORTAL
  AGENCY_API
}

enum AppointmentStatus {
  PENDING_PAYMENT
  SCHEDULED
  ASSIGNED
  EN_ROUTE
  ARRIVED
  COMPLETED
  CANCELLED
  RESCHEDULED
  SAMPLE_COLLECTED @map("DEPRECATED_SAMPLE_COLLECTED")
  HANDED_OVER      @map("DEPRECATED_HANDED_OVER")
}

model Test {
  id            String        @id @default(uuid())
  labId         String
  lab           Lab           @relation(fields: [labId], references: [id])
  branchId      String?
  branch        Branch?       @relation(fields: [branchId], references: [id])
  testNumber    String
  patientId     String
  patient       Patient       @relation(fields: [patientId], references: [id])
  categoryId    String?
  category      TestCategory? @relation(fields: [categoryId], references: [id])
  appointmentId String?
  appointment   Appointment?  @relation(fields: [appointmentId], references: [id])
  invoiceId     String?
  invoice       Invoice?      @relation(fields: [invoiceId], references: [id])
  sampleId      String?
  sample        Sample?       @relation(fields: [sampleId], references: [id])

  // ✅ ADDED: Link to TestTemplate (Crucial for result entry & reporting)
  testTemplateId String?
  testTemplate   TestTemplate? @relation(fields: [testTemplateId], references: [id])

  testName            String
  testCode            String
  resultNotes         String?
  status              TestStatus   @default(PENDING)
  priority            TestPriority @default(NORMAL)
  referredBy          String?
  doctorId            String?
  doctor              Doctor?      @relation("DoctorReferral", fields: [doctorId], references: [id])
  agencyId            String?
  agency              Agency?      @relation("AgencyReferral", fields: [agencyId], references: [id])
  scheduledAt         DateTime?
  sampleCollectedAt   DateTime?
  processingStartedAt DateTime?
  completedAt         DateTime?
  approvedAt          DateTime?
  approvedBy          String?
  reportGeneratedAt   DateTime?
  sampleReceivedAt    DateTime?
  reportUrl           String?
  notes               String?
  impression          String?
  price               Decimal
  discount            Decimal      @default(0.00)
  finalPrice          Decimal
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  // Immutability: NO deletedAt
  report      Report?
  commissions Commission[]
  results     TestResultParameter[]

  // ✅ ADDED: Link to Custom Fields (If you are saving custom form data per test)
  customResults TestResultCustomField[]

  inventoryUsage InventoryTransaction[]
  aiPrediction   AIPrediction?

  @@unique([labId, testNumber])
  @@index([patientId])
  @@index([branchId, status, createdAt])
}

model TestResultParameter {
  id     String @id @default(uuid())
  testId String
  test   Test   @relation(fields: [testId], references: [id], onDelete: Cascade)

  // Snapshotted Data for Clinical Immutability
  parameterCode      String
  printName          String
  method             String?
  referenceRangeText String?
  numericValue       Float?
  textValue          String?
  flag               String?

  analyzerId  String?
  analyzer    LabAnalyzer? @relation(fields: [analyzerId], references: [id])
  entryMethod EntryMethod  @default(MANUAL)
  order       Int          @default(0)

  @@index([testId])
  @@index([parameterCode])
  @@index([flag])
  @@index([numericValue])
}

enum EntryMethod {
  MANUAL
  MACHINE_INTERFACE
  FILE_UPLOAD
}

model AIPrediction {
  id              String   @id @default(uuid())
  testId          String   @unique
  test            Test     @relation(fields: [testId], references: [id])
  summary         String
  riskScore       Float?
  recommendations String?
  modelUsed       String?
  createdAt       DateTime @default(now())
}

enum TestStatus {
  PENDING
  SCHEDULED
  SAMPLE_COLLECTED
  IN_PROGRESS
  COMPLETED
  APPROVED
  DELIVERED
  CANCELLED
}

enum TestPriority {
  NORMAL
  URGENT
  CRITICAL
}

// ==========================================
// REFERRAL & COMMISSION
// ==========================================
model Doctor {
  id                    String                   @id @default(uuid())
  labId                 String
  lab                   Lab                      @relation(fields: [labId], references: [id])
  branchId              String?
  branch                Branch?                  @relation(fields: [branchId], references: [id])
  userId                String?                  @unique
  user                  User?                    @relation(fields: [userId], references: [id])
  name                  String                   @default("Legacy Doctor")
  email                 String?
  phone                 String?
  registrationNo        String?
  specialization        String?
  qualification         String?
  clinic                String?
  commissionRate        Decimal?
  commissionType        CommissionType           @default(PERCENTAGE)
  customTestCommissions DoctorCustomCommission[]
  totalReferrals        Int                      @default(0)
  totalCommission       Decimal                  @default(0.00)
  isActive              Boolean                  @default(true)
