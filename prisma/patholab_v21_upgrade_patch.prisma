// ADD ENUMS
enum Gender {
  MALE
  FEMALE
  OTHER
  UNKNOWN
}

enum AgeUnit {
  DAYS
  MONTHS
  YEARS
}

enum FeatureType {
  LIS
  RIS
  PACS
  ABDM
  API
  WHATSAPP
  AI_REPORTING
  NABL
}

// ADD NEW MODELS

model Organization {
  id         String @id @default(uuid())
  name       String
  code       String @unique
  gstNumber  String?
  panNumber  String?
  isActive   Boolean @default(true)

  labs       Lab[]

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model WalletRecharge {
  id                String @id @default(uuid())
  labId             String
  amount            Decimal @db.Decimal(12,2)
  gstAmount         Decimal @db.Decimal(12,2)
  totalPaid         Decimal @db.Decimal(12,2)
  paymentMethod     String?
  transactionId     String?
  validityUntil     DateTime?
  createdAt         DateTime @default(now())
}

model RevenueConfig {
  id                 String @id @default(uuid())
  registrationFee    Decimal @default(2.50) @db.Decimal(10,2)
  gstPercent         Decimal @default(18.00) @db.Decimal(5,2)
  walletValidityDays Int @default(365)
}

model LabFeature {
  id          String @id @default(uuid())
  labId       String
  feature     FeatureType
  active      Boolean @default(true)
  activatedAt DateTime?
}

